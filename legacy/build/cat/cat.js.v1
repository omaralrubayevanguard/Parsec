/* Volvo truck catalog — mock-up. Every model, generation and configuration; a drawing per configuration
   (or the shop's own photo where it has one). Data researched Oct 2026; (?) = not confirmed. */
var IMG = __IMG__;
var PAINT = ['#ECEBE6', '#2D4F86', '#9C2F2A', '#4A4D50', '#B9BDC0', '#263347', '#2F4F3E', '#8A6A45', '#1F1F1E'];
