      { m: 'VNL 840', cab: 74, roof: 'mid', ax: A3, use: 'Linehaul' },
      { m: 'VNL 860', cab: 74, roof: 'high', ax: A3, use: 'Linehaul' },
      { m: 'VNL 440 Electric', cab: 42, roof: 'mid', ax: ['4x2', '6x2'], ev: 1, use: 'Regional, drayage', y: 'In development', q: 1 }] }] },
  { k: 'VNR', sub: 'Regional haul', kind: 'reg', gens: [
    { g: 'First generation', y: '2018–2025', a: 2, H: 88, cards: [
      { m: 'VNR 300', cab: 0, ax: A3, use: 'Regional', photo: 'side_blue' },
      { m: 'VNR 400', cab: 42, roof: 'flat', ax: A3, use: 'Regional' },
      { m: 'VNR 640', cab: 61, roof: 'mid', ax: A3, use: 'Regional' },
      { m: 'VNR 660', cab: 61, roof: 'high', ax: A3, use: 'Regional', y: '2020–2025' }] },
    { g: 'New VNR', y: '2026–', a: 3, H: 88, cards: [
      { m: 'VNR 300', cab: 0, ax: A3, use: 'Regional', body: 1 },
      { m: 'VNR 440', cab: 42, roof: 'mid', ax: A3, use: 'Regional', body: 1 },
      { m: 'VNR 640', cab: 62, roof: 'mid', ax: A3, use: 'Regional', body: 1 },
      { m: 'VNR 660', cab: 62, roof: 'high', ax: A3, use: 'Regional', body: 1 }] },
    { g: 'VNR Electric', y: '2021–', a: 2, H: 88, cards: [
      { m: 'VNR Electric', cab: 0, ax: A3, ev: 1, body: 1, use: 'Regional, drayage' }] }] },
  { k: 'VNX', sub: 'Heavy haul', kind: 'hw', gens: [
    { g: 'First generation', y: '2014–2017', a: 1, H: 100, cards: [
      { m: 'VNX 300', cab: 0, ax: ['6x4', '8x4', '8x6'], use: 'Heavy haul' },
      { m: 'VNX 430', cab: 42, roof: 'flat', ax: ['6x4', '8x4'], use: 'Heavy haul', q: 1 },
      { m: 'VNX 630', cab: 61, roof: 'mid', ax: ['6x4', '8x4', '8x6'], use: 'Heavy haul' }] },
    { g: 'Second generation', y: '2018–2026', a: 1, H: 100, cards: [
      { m: 'VNX 300', cab: 0, ax: ['6x4', '8x4', '8x6'], use: 'Heavy haul' },
      { m: 'VNX 400', cab: 42, roof: 'flat', ax: ['6x4', '8x4', '8x6'], use: 'Heavy haul' },
      { m: 'VNX 740', cab: 70, roof: 'mid', ax: ['6x4', '8x4', '8x6'], use: 'Heavy haul', rq: 1 }] },
    { g: 'All-new VNX', y: 'New for 2027', a: 2, H: 100, cards: [
      { m: 'VNX 300', cab: 0, ax: ['6x4', '8x4', '8x6'], use: 'Heavy haul, vocational', fb: 1, body: 1 },
      { m: 'VNX 440', cab: 42, roof: 'mid', ax: ['6x4', '8x4', '8x6'], use: 'Heavy haul, vocational', fb: 1, body: 1, rq: 1 },
      { m: 'VNX 640', cab: 62, roof: 'mid', ax: ['6x4', '8x4', '8x6'], use: 'Heavy haul', fb: 1 }] }] },
  { k: 'VHD', sub: 'Vocational — straight truck or tractor', kind: 'voc', voc: 1, gens: [
    { g: 'First generation', y: '1998–2017', a: 0, H: 86, cards: [
      { m: 'VHD 200', cab: 0, ax: ['4x2', '6x4', '8x4', '8x6'], use: 'Construction, dump, mixer', fb: 1, body: 1 },
      { m: 'VHD 300', cab: 0, ax: ['6x4', '8x4', '8x6'], use: 'Construction', fb: 1, body: 1, q: 1 },
      { m: 'VHD 430', cab: 42, roof: 'flat', ax: ['6x4', '8x4'], use: 'Vocational with a sleeper', y: '2007–2017' }] },
    { g: 'Current (redesigned 2021)', y: '2018–', a: 1, H: 86, cards: [
      { m: 'VHD 300 AF', cab: 0, fwd: 1, ax: ['4x2', '6x4', '8x4', '8x6'], use: 'Set-forward front axle — bridge-law wheelbases', body: 1 },
      { m: 'VHD 300 AB', cab: 0, ax: ['4x2', '6x4', '8x4', '8x6'], use: 'Set-back front axle — tighter turns', body: 1, photo: 'side_red' },
      { m: 'VHD 400 AF', cab: 42, roof: 'flat', fwd: 1, ax: ['6x4', '8x4', '8x6'], use: 'Sleeper, set-forward', body: 1 },
      { m: 'VHD 400 AB', cab: 42, roof: 'flat', ax: ['6x4', '8x4', '8x6'], use: 'Sleeper, set-back', body: 1 }] }] },
  { k: 'VAH', sub: 'Auto hauler — low cab, built for a head rack', kind: 'ah', gens: [
    { g: 'First generation', y: '2011–2020', a: 0, H: 82, cards: [
      { m: 'VAH 200', cab: 0, fwd: 1, ax: ['6x4'], use: 'Car carrier' }] },
    { g: 'Second generation', y: '2021–', a: 1, H: 82, cards: [
      { m: 'VAH 300', cab: 0, ax: ['6x4'], use: 'Car carrier', fb: 1 },
      { m: 'VAH 400', cab: 42, roof: 'mid', ax: ['6x4'], use: 'Car carrier', fb: 1, q: 1 },
      { m: 'VAH 600', cab: 61, roof: 'mid', ax: ['6x4'], use: 'Car carrier', fb: 1, q: 1 }] }] },
  { k: 'VNM', sub: 'Regional — the shorter hood, before the VNR', kind: 'reg', gens: [
    { g: 'VNM', y: '2000–2017', a: 1, H: 88, cards: [
      { m: 'VNM 200', cab: 0, ax: A3, use: 'Regional' },
      { m: 'VNM 430', cab: 42, roof: 'flat', ax: A3, use: 'Regional' },
      { m: 'VNM 630', cab: 61, roof: 'mid', ax: A3, use: 'Regional' }] }] },
  { k: 'VT', sub: 'Long hood', kind: 'vt', gens: [
    { g: 'VT', y: '2005–2010', yq: 1, a: 0, H: 116, cards: [
      { m: 'VT 800', cab: 0, ax: ['6x4'], use: 'Heavy haul', q: 1 },
      { m: 'VT 830', cab: 77, roof: 'mid', ax: ['6x4'], use: 'Owner-operator linehaul', y: '2006–2010' },
      { m: 'VT 880', cab: 77, roof: 'high', ax: ['6x4'], use: 'Owner-operator linehaul' }] }] }
];
var TRIM = { Core: { trim: 'gray' }, Edge: { trim: 'chrome' }, 'Edge Black': { trim: 'black' }, Ultimate: { trim: 'chrome', stripe: '#B89262' } };
var ST = { fam: 'all', need: false, show: {} };
/* every card gets an id, its paint and its current choices */
var CARDS = [], n0 = 0;
FAM.forEach(function(F){ F.gens.forEach(function(G, gi){ G.trim = G.trims ? 'Edge' : null; G.cards.forEach(function(c, i){
  c.id = 'c' + (++n0); c.F = F; c.G = G; c.ax0 = c.ax.indexOf('6x4') > -1 ? '6x4' : c.ax[0]; c.fwd0 = !!c.fwd; c.body0 = 'tractor';
  var pal = F.voc ? VOCP : PAINT; c.paint = pal[(i + gi * 3 + F.k.length) % pal.length]; c.view = c.photo ? 'photo' : 'draw'; CARDS.push(c); }); }); });
function cfgTxt(c){
  if(!c.cab) return 'Day cab';
  var roof = { flat: 'flat roof', mid: 'mid roof', high: c.G.a === 0 ? 'raised roof' : 'high roof' }[c.roof] || '';
  return c.cab + '″ sleeper · ' + roof + (c.rq ? ' (?)' : '');
}
function drawOf(c){
  var G = c.G, t = G.trim ? TRIM[G.trim] : {};
  return truckSVG({ kind: c.F.kind, a: G.a, H: c.H || G.H, cab: c.cab, roof: c.roof || 'low', ax: c.ax0, fwd: c.fwd0, ev: c.ev, body: c.body0, paint: c.paint, trim: t.trim || 'chrome', stripe: t.stripe, label: c.m + ', ' + cfgTxt(c) });
}
function chips(c, k, list, cur){ return '<span class="cc-ch" data-k="' + k + '">' + list.map(function(v){ return '<button data-v="' + v[0] + '" aria-pressed="' + (v[0] === cur) + '">' + v[1] + '</button>'; }).join('') + '</span>'; }
function cardHtml(c){
  var years = c.y || c.G.y, ph = c.photo && c.view === 'photo';
  return '<article class="cc' + (c.photo ? ' has-ph' : '') + '" id="' + c.id + '" data-fam="' + c.F.k + '">'
    + '<div class="cc-pic' + (ph ? ' ph' : '') + '">' + (ph ? '<img src="' + IMG[c.photo] + '" alt="' + c.m + '">' : drawOf(c))
    + (c.photo ? '<span class="cc-sw">' + chips(c, 'view', [['photo', 'Your photo'], ['draw', 'Drawing']], c.view) + '</span>' : '') + '</div>'
    + '<div class="cc-h"><b>' + c.m + '</b>' + (c.q ? '<i title="Not confirmed">?</i>' : '') + '<span class="cc-y">' + years + (c.G.yq && !c.y ? ' (?)' : '') + '</span></div>'
    + '<div class="cc-c">' + cfgTxt(c) + (c.ev ? ' · <span class="cc-ev">Electric</span>' : '') + '</div>'
    + '<div class="cc-o">' + (c.ax.length > 1 ? chips(c, 'ax', c.ax.map(function(a){ return [a, a]; }), c.ax0) : '<span class="cc-one">' + c.ax[0] + '</span>')
    + (c.fb ? chips(c, 'fwd', [['1', 'Set-forward'], ['0', 'Set-back']], c.fwd0 ? '1' : '0') : '')
    + (c.body ? chips(c, 'body', [['tractor', 'Tractor'], ['truck', 'Truck']], c.body0) : '') + '</div>'
    + '<div class="cc-f"><span>' + c.use + '</span>' + (c.photo ? '<em class="ok">Your photo</em>' : '<em>Needs a picture</em>') + '</div></article>';
}
function render(){
  var tot = CARDS.length, ph = CARDS.filter(function(c){ return c.photo; }).length;
  document.getElementById('sum').innerHTML = '<span><b>' + tot + '</b> configurations</span><i>·</i><span><b>' + FAM.length + '</b> families</span><i>·</i><span><b>' + ph + '</b> with your photos</span><i>·</i><span><b>' + (tot - ph) + '</b> need a picture</span>';
  var h = '';
  FAM.forEach(function(F){
    if(ST.fam !== 'all' && ST.fam !== F.k) return;
    var all = [].concat.apply([], F.gens.map(function(G){ return G.cards; })), np = all.filter(function(c){ return c.photo; }).length;
    var gh = F.gens.map(function(G){
      var cs = G.cards.filter(function(c){ return !ST.need || !c.photo; }); if(!cs.length) return '';
      return '<div class="cg"><div class="cg-h"><h3>' + G.g + '<small>' + G.y + (G.yq ? ' (?)' : '') + '</small></h3><span class="cg-n">' + G.cards.length + ' model' + (G.cards.length === 1 ? '' : 's') + '</span>'
        + (G.trims ? '<span class="cg-t"><span class="k">Trim</span>' + chips(null, 'trim', G.trims.map(function(t){ return [t, t]; }), G.trim).replace('class="cc-ch"', 'class="cc-ch" data-g="' + FAM.indexOf(F) + ':' + F.gens.indexOf(G) + '"') + '</span>' : '') + '</div>'
        + '<div class="cg-grid">' + cs.map(cardHtml).join('') + '</div></div>';
    }).join('');
    if(!gh) return;
    h += '<section class="cf" id="f-' + F.k + '"><div class="cf-h"><h2>' + F.k + '</h2><p>' + F.sub + '</p><span class="cf-n">' + all.length + ' configurations' + (np ? ' · ' + np + ' with your photo' + (np === 1 ? '' : 's') : '') + '</span></div>' + gh + '</section>';
  });
  document.getElementById('cat').innerHTML = h;
  document.querySelectorAll('[data-fam-set]').forEach(function(b){ b.classList.toggle('is-on', b.getAttribute('data-fam-set') === ST.fam); });
  document.getElementById('need').setAttribute('aria-pressed', ST.need);
}
function redraw(c){ var el = document.getElementById(c.id); if(el) el.outerHTML = cardHtml(c); }
document.addEventListener('click', function(e){
  var f = e.target.closest('[data-fam-set]'); if(f){ ST.fam = f.getAttribute('data-fam-set'); render(); window.scrollTo({ top: 0 }); return; }
  if(e.target.closest('#need')){ ST.need = !ST.need; render(); return; }
  var t = e.target.closest('[data-theme-set]'); if(t){ document.documentElement.setAttribute('data-theme', t.getAttribute('data-theme-set')); document.querySelectorAll('[data-theme-set]').forEach(function(x){ x.classList.toggle('is-on', x === t); }); return; }
  var b = e.target.closest('.cc-ch button'); if(!b) return;
  var g = b.parentNode, k = g.getAttribute('data-k'), v = b.getAttribute('data-v');
  if(k === 'trim'){ var ix = g.getAttribute('data-g').split(':'), G = FAM[+ix[0]].gens[+ix[1]]; G.trim = v; render(); return; }
  var c = CARDS.filter(function(x){ return x.id === b.closest('.cc').id; })[0]; if(!c) return;
  if(k === 'ax') c.ax0 = v; else if(k === 'fwd') c.fwd0 = v === '1'; else if(k === 'body') c.body0 = v; else if(k === 'view') c.view = v;
  redraw(c);
});
/* the model code: VNL64T760, VHD64F300, VNR 640 … */
var AXN = { 42: '4x2', 62: '6x2', 64: '6x4', 84: '8x4', 86: '8x6' };
function decode(s){
  var m = /^\s*(VNL|VNM|VNR|VNX|VHD|VAH|VT|VN)\s*-?\s*(?:(\d)(\d))?\s*([A-Z]{0,2})\s*-?\s*(\d{3})?\s*$/i.exec(String(s || ''));
  if(!m || (!m[2] && !m[5])) return null;
  var fam = m[1].toUpperCase(), ax = m[2] ? AXN[m[2] + m[3]] : null, L = (m[4] || '').toUpperCase(), code = m[5] || '';
  var F = FAM.filter(function(x){ return x.k === fam || (fam === 'VN' && x.k === 'VNL'); })[0];
  var hits = CARDS.filter(function(c){ if(c.F !== F) return false; var mm = /(\d{3})/.exec(c.m); if(!code || !mm || mm[1] !== code) return false;
    if(L.indexOf('F') > -1 && /AB$/.test(c.m)) return false; if(L.indexOf('B') > -1 && /AF$/.test(c.m)) return false; return true; });
  return { fam: fam, ax: ax, t: L.indexOf('T') > -1, fwd: L.indexOf('F') > -1 ? 'set-forward' : L.indexOf('B') > -1 ? 'set-back' : '', code: code, hits: hits };
}
function decodeShow(){
  var v = document.getElementById('dec').value, D = decode(v), out = document.getElementById('decr');
  document.querySelectorAll('.cc.hl').forEach(function(x){ x.classList.remove('hl'); });
  if(!v.trim()){ out.innerHTML = '<span class="m">Type a model code from the RO or the VIN decode — like VNL64T760 or VHD64F300</span>'; return; }
  if(!D){ out.innerHTML = '<span class="m">Not a Volvo model code this page knows</span>'; return; }
  var parts = [D.fam, D.ax, D.t ? 'tractor' : '', D.fwd].filter(Boolean);
  out.innerHTML = '<b>' + parts.join(' · ') + '</b>' + (D.hits.length ? D.hits.map(function(c){ return '<button class="dec-hit" data-id="' + c.id + '">' + c.m + ' · ' + (c.y || c.G.y) + ' · ' + cfgTxt(c) + '</button>'; }).join('') : '<span class="m">' + (D.code ? 'No ' + D.fam + ' ' + D.code + ' in the catalog' : 'Add the three-digit cab code') + '</span>');
  if(D.hits.length){
    if(ST.fam !== 'all' && ST.fam !== D.hits[0].F.k){ ST.fam = 'all'; render(); }
    D.hits.forEach(function(c){ if(D.ax && c.ax.indexOf(D.ax) > -1 && c.ax0 !== D.ax){ c.ax0 = D.ax; redraw(c); } if(D.fwd && c.fb){ c.fwd0 = D.fwd === 'set-forward'; redraw(c); } var el = document.getElementById(c.id); if(el) el.classList.add('hl'); });
  }
}
document.addEventListener('input', function(e){ if(e.target.id === 'dec') decodeShow(); });
document.addEventListener('click', function(e){ var h = e.target.closest('.dec-hit'); if(!h) return; var el = document.getElementById(h.getAttribute('data-id')); if(el){ el.scrollIntoView({ behavior: 'smooth', block: 'center' }); el.classList.remove('fl'); void el.offsetWidth; el.classList.add('fl'); } });
render(); decodeShow();
