      { m: 'VNL 860', cab: 77, roof: 'high', ax: A3, use: 'Premium linehaul', photo: 'side_gray' }] },
    { g: 'All-new VNL', y: '2025–', a: 3, H: 100, trims: ['Core', 'Edge', 'Edge Black', 'Ultimate'], cards: [
      { m: 'VNL 300', cab: 0, ax: A3, use: 'Regional' },
