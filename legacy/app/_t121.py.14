import asyncio, os, sys, json
from playwright.async_api import async_playwright
H = os.path.dirname(os.path.abspath(__file__)); OUT = os.path.join(H, "shots121"); os.makedirs(OUT, exist_ok=True)
PAGE = sys.argv[1] if len(sys.argv) > 1 else "t12.html"
fails = []
def ok(c, m):
    print(("ok   " if c else "FAIL ") + m)
    if not c: fails.append(m)
async def setup(p, w, h):
    b = await p.chromium.launch(); ctx = await b.new_context(viewport={"width": w, "height": h}, is_mobile=w < 600, has_touch=w < 600); pg = await ctx.new_page(); pg.set_default_timeout(6000); errs = []
    pg.on("pageerror", lambda e: errs.append(str(e)[:300]))
    pg.on("console", lambda m: errs.append("console: " + m.text[:200]) if m.type == "error" and "ERR_" not in m.text and "Failed to load resource" not in m.text else None)
    await pg.route("**/fonts.g*/**", lambda r: r.abort())
    if w < 600: await pg.add_init_script("try{ localStorage.setItem('tec_device','phone'); }catch(e){}")
    await pg.goto("file://" + H + "/" + PAGE); await pg.wait_for_timeout(1200)
    await pg.evaluate("__tg.loadSample25()"); await pg.evaluate("__tg.ensureDemoTeam()"); await pg.wait_for_timeout(300)
    await pg.evaluate("__tg.PG.go('triage')"); await pg.wait_for_timeout(500)
    await pg.evaluate("(()=>{ const U=__tg.UI(); U.tgView='inbox'; __tg.render(); })()"); await pg.wait_for_timeout(300)
    return b, pg, errs
SEL = "(id => { const U=__tg.UI(); U.tgSel=id; U.tgPop=null; __tg.render(); })"
GROUPS = "[...document.querySelectorAll('.tg-grp')].map(g=>g.textContent).join(' | ')"
ROW_GROUP = """(id => { let g=''; for(const n of document.querySelectorAll('.tg-grp, .tg-it')){ if(n.classList.contains('tg-grp')) g=n.firstChild.textContent; else if(n.dataset.ro===id) return g; } return null; })"""
DONE_ALL = """(id => { const r=__tg.getRO(id); __tg.STATE().punches.forEach(p=>{ if(p.roId===id && !p.stop){ p.stop=new Date(Date.now()-60000).toISOString(); p.stopReason='Complete'; } }); r.operations.forEach(o=>{ if(!o.declined){ o.jobStatus={status:'Complete', setAt:new Date().toISOString(), hand:true}; (o.parts||[]).forEach(p=>{ p.status='Installed'; }); } }); __tg.render(); })"""
async def main():
    async with async_playwright() as p:
        b, pg, errs = await setup(p, 1440, 900)
        print("groups:", await pg.evaluate(GROUPS))
        L = await pg.evaluate("(()=>{ const out={}; __tg.STATE().ros.filter(r=>!r.shop && r.id!=='ro_shop' && !r.dateClosed).forEach(r=>{ const c=(r.operations||[]).filter(o=>!o.declined).length; (out[c>0?'w':'z']=out[c>0?'w':'z']||[]).push(r.id); }); return out; })()")
        W = L["w"]; print("ROs with operations:", len(W))
        # ---------- transfer to the Parts queue, by keys ----------
        r1 = W[0]
        await pg.evaluate(SEL + f"('{r1}')"); await pg.wait_for_timeout(300)
        await pg.click('.tg-top [data-p="xfer"]'); await pg.wait_for_timeout(300)
        await pg.screenshot(path=os.path.join(OUT, "a1_xfer_dept.png"))
        ok(await pg.evaluate("document.querySelectorAll('.trx-x .trx-o').length") == 6, "step 1 shows 6 departments")
        await pg.keyboard.press("3"); await pg.wait_for_timeout(300)
        t = await pg.evaluate("document.querySelector('.trx-x').innerText")
        ok("Anyone in Parts" in t, "step 2 has Anyone in Parts")
        await pg.screenshot(path=os.path.join(OUT, "a2_xfer_people.png"))
        await pg.keyboard.press("1"); await pg.wait_for_timeout(250)
        await pg.keyboard.press("1"); await pg.wait_for_timeout(250)
        t = await pg.evaluate("document.querySelector('.trx-x').innerText")
        ok("Goal" in t and "Back by" in t, "step 4 Back by starts on the goal")
        await pg.screenshot(path=os.path.join(OUT, "a3_xfer_back.png"))
        await pg.keyboard.press("Enter"); await pg.wait_for_timeout(400)
        r = await pg.evaluate(f"(()=>{{ const r=__tg.getRO('{r1}').route; return [r.to, r.queue, r.state, r.reason, Math.round((new Date(r.back)-Date.now())/60000), __tg.rtHolderName(__tg.rtHolder(__tg.getRO('{r1}')), __tg.getRO('{r1}'))]; }})()")
        print("route:", r)
        ok(r[0] == "parts" and r[1] is True and r[2] == "accepted" and r[3] == "Parts needed" and 230 <= r[4] <= 241 and r[5] == "Anyone in Parts", "sent to the Parts queue, theirs, back by the 4 h goal")
        # ---------- transfer to a named tech, by clicks ----------
        await pg.evaluate(SEL + f"('{r1}')"); await pg.wait_for_timeout(200)
        await pg.click('.tg-top [data-p="xfer"]'); await pg.wait_for_timeout(250)
        await pg.click('.trx-x .trx-o[data-v="tech"]'); await pg.wait_for_timeout(250)
        ppl = await pg.evaluate("[...document.querySelectorAll('.trx-x .trx-o')].map(o=>o.innerText.replace(/\\s+/g,' ')).slice(0,6)")
        print("tech people:", ppl)
        ok(len(ppl) >= 3, "technicians listed with status and load")
        who = await pg.evaluate("document.querySelectorAll('.trx-x .trx-o')[1].dataset.v")
        await pg.click('.trx-x .trx-o >> nth=1'); await pg.wait_for_timeout(250)
        await pg.click('.trx-x .tg-chip >> nth=0'); await pg.wait_for_timeout(250)
        await pg.click('.trx-x .tg-chip[data-v="1h"]'); await pg.wait_for_timeout(250)
        await pg.click('.trx-x [data-action="tg-xf-go"]'); await pg.wait_for_timeout(400)
        r = await pg.evaluate(f"(()=>{{ const ro=__tg.getRO('{r1}'), r=ro.route; const ib=(__tg.STATE().ib||{{}}).items||[]; return [r.to, r.who, ro.assignedTech, r.state, Math.round((new Date(r.back)-Date.now())/60000), ib.filter(n=>n.ro===ro.id && n.to===r.who).length]; }})()")
        print("route 2:", r)
        ok(r[0] == "tech" and r[1] == who and r[2] == who and r[3] == "accepted" and 55 <= r[4] <= 70 and r[5] >= 1, "sent to " + who + ", in their Inbox, back in 1 h")
        # ---------- past back by: Held too long, red countdown ----------
        await pg.evaluate(f"(()=>{{ const r=__tg.getRO('{r1}').route; r.back=new Date(Date.now()-95*60000).toISOString(); __tg.render(); }})()"); await pg.wait_for_timeout(300)
        g = await pg.evaluate(ROW_GROUP + f"('{r1}')")
        pill = await pg.evaluate(f"(document.querySelector('.tg-it[data-ro=\"{r1}\"] .trx-late')||{{}}).textContent")
        ok(g == "Held too long" and pill and pill.startswith("+"), f"past back by → {g}, pill {pill}")
        await pg.evaluate(SEL + f"('{r1}')"); await pg.wait_for_timeout(300)
        ok(await pg.evaluate("!!document.querySelector('.tg-thread .trx-st.late')"), "thread shows past back by")
        await pg.screenshot(path=os.path.join(OUT, "a4_held.png"))
        # ---------- road test: every op done → Road test group → send → log pass → Truck checks ----------
        r2 = W[1]
        await pg.evaluate(DONE_ALL + f"('{r2}')"); await pg.wait_for_timeout(300)
        g = await pg.evaluate(ROW_GROUP + f"('{r2}')"); ok(g == "Road test", "all ops done → " + str(g))
        print("groups:", await pg.evaluate(GROUPS))
        await pg.click(f'.tg-it[data-ro="{r2}"] [data-action="tg-do"]'); await pg.wait_for_timeout(300)
        await pg.screenshot(path=os.path.join(OUT, "b1_road_send.png"))
        tech = await pg.evaluate(f"__tg.trxTechOf(__tg.getRO('{r2}'))")
        await pg.click('.trx-r [data-action="tg-rt-go"]'); await pg.wait_for_timeout(400)
        fr = await pg.evaluate(f"__tg.getRO('{r2}').fmRt")
        ok(fr and fr.get("who") and fr.get("atMs"), "road test sent to " + str(fr and fr.get("who")) + " (tech who did the work: " + str(tech) + ")")
        st = await pg.evaluate(f"__tg.trxRoadState(__tg.getRO('{r2}'))"); print("road state:", st)
        await pg.click(f'.tg-it[data-ro="{r2}"] [data-action="tg-do"]'); await pg.wait_for_timeout(300)
        ok(await pg.evaluate("!!document.querySelector('.trx-r .trx-g2')"), "opens on Log the result")
        await pg.click('.trx-r .tg-chip.tick >> nth=0'); await pg.click('.trx-r .tg-chip.tick >> nth=1'); await pg.wait_for_timeout(200)
        await pg.fill('.trx-r [data-tg-in="trx-rmi"]', "11"); await pg.fill('.trx-r [data-tg-in="trx-rnote"]', "No leaks, no codes")
        await pg.screenshot(path=os.path.join(OUT, "b2_road_log.png"))
        await pg.click('.trx-r [data-action="tg-rt-go"]'); await pg.wait_for_timeout(400)
        rt = await pg.evaluate(f"__tg.getRO('{r2}').roadTest"); print("roadTest:", rt)
        ok(rt["result"] == "Pass" and len(rt["checks"]) == 2 and rt["miles"] == "11" and "No leaks" in rt["checked"], "road test logged with checks and a note")
        g = await pg.evaluate(ROW_GROUP + f"('{r2}')"); ok(g == "Truck checks", "passed → " + str(g))
        # ---------- truck checks ----------
        await pg.click(f'.tg-it[data-ro="{r2}"] [data-action="tg-do"]'); await pg.wait_for_timeout(300)
        await pg.screenshot(path=os.path.join(OUT, "c1_checks.png"))
        n = await pg.evaluate("document.querySelectorAll('.trx-q .trx-tb').length"); ok(n == 6, f"walk-around has {n} checks")
        for i in range(n):
            await pg.click(f'.trx-q .trx-tb[data-v="{i}"]'); await pg.wait_for_timeout(120)
        q = await pg.evaluate(f"__tg.trxQc(__tg.getRO('{r2}'))"); print("qc:", {k: q[k] for k in ['n', 'of', 'all', 'aok', 'done', 'total']}, [ (a['t'], a['ok']) for a in q['auto']])
        ok(q["all"], "every walk-around ticked")
        await pg.click('.trx-q [data-action="tg-qc"][data-f="edit"]'); await pg.wait_for_timeout(200)
        await pg.fill('.trx-q [data-tg-in="trx-qadd"]', "Mud flaps on"); await pg.press('.trx-q [data-tg-in="trx-qadd"]', "Enter"); await pg.wait_for_timeout(250)
        ok(await pg.evaluate("__tg.STATE().truckCheckList.length") == 7, "added a check to the shop's list")
        await pg.screenshot(path=os.path.join(OUT, "c2_checks_edit.png"))
        await pg.click('.trx-q [data-action="tg-qc"][data-f="del"][data-v="6"]'); await pg.wait_for_timeout(200)
        ok(await pg.evaluate("__tg.STATE().truckCheckList.length") == 6, "took it off again")
        await pg.click('.trx-q [data-action="tg-qc"][data-f="edit"]'); await pg.wait_for_timeout(150)
        g = await pg.evaluate(ROW_GROUP + f"('{r2}')"); print("after checks:", g, "| aok", q["aok"])
        await pg.click('.trx-q [data-action="tg-qc-go"]'); await pg.wait_for_timeout(300)
        rl = await pg.evaluate("document.querySelector('.tg-pop.rl') ? document.querySelector('.tg-pop.rl .tg-cks').innerText : ''")
        print("release checks:", rl.replace("\n", " · "))
        ok("Truck checks" in rl and "Road test passed" in rl, "Release lists the truck checks and the road test")
        await pg.screenshot(path=os.path.join(OUT, "c3_release.png"))
        await pg.keyboard.press("Escape"); await pg.wait_for_timeout(200)
        # ---------- release before the checks are done — needs a reason ----------
        r3 = W[2]
        await pg.evaluate(DONE_ALL + f"('{r3}')"); await pg.evaluate(f"(()=>{{ const r=__tg.getRO('{r3}'); r.roadTest={{result:'Pass', miles:'5', at:new Date().toISOString()}}; __tg.render(); }})()"); await pg.wait_for_timeout(300)
        g = await pg.evaluate(ROW_GROUP + f"('{r3}')"); ok(g == "Truck checks", "road test passed, no ticks → " + str(g))
        await pg.evaluate(f"__tg.tgOpenPop('release', '{r3}')"); await pg.wait_for_timeout(300)
        bad = await pg.evaluate("[...document.querySelectorAll('.tg-pop.rl .tg-ck.no span')].map(x=>x.textContent)"); print("open:", bad)
        ok("Truck checks" in bad, "Truck checks open in Release")
        await pg.click('.tg-pop.rl [data-action="tg-rl"][data-f="any"]'); await pg.wait_for_timeout(200)
        await pg.click('.tg-pop.rl .tg-any .tg-chip >> nth=0'); await pg.wait_for_timeout(200)
        await pg.click('.tg-pop.rl [data-action="tg-rl-go"][data-v="any"]'); await pg.wait_for_timeout(500)
        rel = await pg.evaluate(f"(()=>{{ const r=__tg.getRO('{r3}'); return [r.status && r.status.status, !!r.dateClosed, JSON.stringify(r.release||r.released||'').slice(0,160)]; }})()")
        print("released:", rel); ok(rel[1] or "Released" in str(rel[0]) or "Complete" in str(rel[0]), "released anyway with a reason")
        # ---------- failed road test → back to the tech who did the work ----------
        r4 = W[3]
        await pg.evaluate(DONE_ALL + f"('{r4}')"); await pg.evaluate(SEL + f"('{r4}')"); await pg.wait_for_timeout(300)
        tech4 = await pg.evaluate(f"__tg.trxTechOf(__tg.getRO('{r4}'))")
        await pg.click('.tg-top [data-p="road"]'); await pg.wait_for_timeout(250)
        await pg.click('.trx-r [data-f="m"][data-v="log"]'); await pg.wait_for_timeout(200)
        await pg.click('.trx-r [data-f="res"][data-v="Fail"]'); await pg.wait_for_timeout(200)
        ok(await pg.evaluate("document.querySelector('.trx-r [data-action=\"tg-rt-go\"]').disabled"), "fail needs a why first")
        await pg.click('.trx-r [data-f="fw"][data-v="Noise"]'); await pg.wait_for_timeout(200)
        await pg.screenshot(path=os.path.join(OUT, "d1_road_fail.png"))
        await pg.click('.trx-r [data-action="tg-rt-go"]'); await pg.wait_for_timeout(400)
        f = await pg.evaluate(f"(()=>{{ const ro=__tg.getRO('{r4}'), r=ro.route; const ib=(__tg.STATE().ib||{{}}).items||[]; return [ro.roadTest.result, r.to, r.who, r.state, r.reason, ro.operations.filter(o=>!o.declined).map(o=>o.jobStatus&&o.jobStatus.sub), ib.filter(n=>n.ro===ro.id && n.to===r.who).length, !!ro.fmRtOk]; }})()")
        print("fail:", f, "| tech who did the work:", tech4)
        ok(f[0] == "Fail" and f[1] == "tech" and f[2] == tech4 and f[3] == "accepted" and all(x == "Road test failed" for x in f[5]) and f[6] >= 1 and f[7], "failed road test → back to " + str(tech4))
        # ---------- the Foreman's QC group is off ----------
        await pg.evaluate("__tg.PG.go('foreman')"); await pg.wait_for_timeout(500)
        fg = await pg.evaluate(GROUPS); print("foreman groups:", fg); ok("QC" not in fg, "Foreman has no QC group")
        await pg.evaluate("__tg.PG.go('triage')"); await pg.wait_for_timeout(400)
        # ---------- the Desk view ----------
        await pg.evaluate(f"(()=>{{ const U=__tg.UI(); U.tgView='desk'; U.tgSel='{r2}'; U.tgPop=null; __tg.render(); }})()"); await pg.wait_for_timeout(400)
        ok(await pg.evaluate("!!document.querySelector('.tg-dkh [data-p=\"road\"]') && !!document.querySelector('.tg-dkh [data-p=\"checks\"]')"), "Desk head has Road test and Truck checks")
        ok(await pg.evaluate("!!document.querySelector('.tg-close [data-p=\"road\"]')"), "Ready to close card has Road test")
        await pg.screenshot(path=os.path.join(OUT, "e1_desk.png"))
        await pg.evaluate("(()=>{ const U=__tg.UI(); U.tgView='inbox'; __tg.render(); })()"); await pg.wait_for_timeout(300)
        await pg.evaluate(SEL + f"('{r2}')"); await pg.wait_for_timeout(300)
        await pg.screenshot(path=os.path.join(OUT, "e2_inbox.png"))
        for th in ["ivd", "vvl", "vvd", "ivl"]:
            await pg.evaluate(f"__tg.applyTheme('{th}')"); await pg.wait_for_timeout(700)
            await pg.click('.tg-top [data-p="checks"]'); await pg.wait_for_timeout(300)
            await pg.screenshot(path=os.path.join(OUT, f"t_{th}.png"))
            await pg.keyboard.press("Escape"); await pg.wait_for_timeout(150)
        print("ERRORS desktop", errs[:6]); ok(not errs, "desktop: no console errors")
        await b.close()
        # ---------- phone ----------
        b, pg, errs = await setup(p, 390, 844)
        W = await pg.evaluate("__tg.STATE().ros.filter(r=>!r.shop && r.id!=='ro_shop' && !r.dateClosed && (r.operations||[]).some(o=>!o.declined)).map(r=>r.id)")
        await pg.evaluate(DONE_ALL + f"('{W[1]}')"); await pg.evaluate(SEL + f"('{W[1]}')"); await pg.wait_for_timeout(400)
        await pg.screenshot(path=os.path.join(OUT, "p1_inbox.png"))
        hs = await pg.evaluate("document.documentElement.scrollWidth > innerWidth"); ok(not hs, "phone: no sideways scroll")
        await pg.evaluate(f"__tg.tgOpenPop('xfer', '{W[1]}')"); await pg.wait_for_timeout(300)
        await pg.screenshot(path=os.path.join(OUT, "p2_xfer.png"))
        await pg.click('.trx-x .trx-o[data-v="parts"]'); await pg.wait_for_timeout(250)
        await pg.screenshot(path=os.path.join(OUT, "p3_xfer_people.png"))
        await pg.evaluate(f"__tg.tgOpenPop('road', '{W[1]}')"); await pg.wait_for_timeout(300)
        await pg.click('.trx-r [data-f="m"][data-v="log"]'); await pg.wait_for_timeout(200)
        await pg.screenshot(path=os.path.join(OUT, "p4_road.png"))
        await pg.evaluate(f"__tg.tgOpenPop('checks', '{W[1]}')"); await pg.wait_for_timeout(300)
        await pg.screenshot(path=os.path.join(OUT, "p5_checks.png"))
        pw = await pg.evaluate("(()=>{ const p=document.querySelector('.tg-pop'); const r=p.getBoundingClientRect(); return [Math.round(r.left), Math.round(r.right), innerWidth]; })()"); print("phone pop:", pw)
        ok(pw[0] >= 0 and pw[1] <= pw[2], "phone: pop-over fits")
        print("ERRORS phone", errs[:6]); ok(not errs, "phone: no console errors")
        await b.close()
        print("FAILS", len(fails), fails)
asyncio.run(main())
