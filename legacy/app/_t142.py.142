# Parsec 14.2 — the truck card's words and quoted hours in place, the Technician Parts tab, the sidebar order, the Time Log on your own times
import asyncio, os, sys, json
sys.argv = sys.argv[:2] if len(sys.argv) > 1 else ['x', 't12.html']
_src = open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "_t127p.py")).read().split("async def main():")[0]
exec(_src)
OUT = os.path.join(H, "shots142")
TP = "[data-pg=tech]"
async def type_in(pg, sel, text, root=None):
    await pg.keyboard.press("Control+a"); await pg.keyboard.type(text); await pg.keyboard.press("Enter"); await pg.wait_for_timeout(350)
async def main():
    async with async_playwright() as p:
        b, pg, errs = await setup(p)
        await pg.evaluate("(()=>{ localStorage.removeItem('tec_viewas'); localStorage.removeItem('tec_out'); __tg.pxSignedIn(); __tg.UI().view='tech'; __tg.render(); })()"); await pg.wait_for_timeout(900)
        # 1 · the Technician card: customer, year/make/model, unit change in place
        k = await pg.evaluate(f"[...document.querySelectorAll('{TP} .tch-band .rif')].map(x=>x.dataset.rifK)")
        ok(k[:5] == ["customerName", "year", "make", "model", "unitNumber"], f"Technician card: customer, year, make, model, unit are editable ({k})")
        rid = await pg.evaluate(f"document.querySelector('{TP} .tch-band .rif').dataset.rifRo")
        m0 = await pg.evaluate(f"__tg.getRO('{rid}').model || ''")
        await pg.click(f"{TP} .tch-band .rif[data-rif-k=customerName]"); await pg.wait_for_timeout(200)
        await type_in(pg, None, "Summit Freightways Inc")
        await pg.click(f"{TP} .tch-band .rif[data-rif-k=unitNumber]"); await pg.wait_for_timeout(200)
        await type_in(pg, None, "T-999")
        await pg.click(f"{TP} .tch-band .rif[data-rif-k=model]"); await pg.wait_for_timeout(200)
        await type_in(pg, None, "VNL 860")
        v = await pg.evaluate(f"(()=>{{ const r=__tg.getRO('{rid}'); return [r.customerName, r.unitNumber, r.model, document.querySelector('{TP} .tch-band h2').textContent, document.querySelector('{TP} .tch-band .tch-sub').textContent]; }})()")
        ok(v[0] == "Summit Freightways Inc" and v[1] == "T-999" and v[2] == "VNL 860" and "Summit Freightways Inc" in v[3] and "VNL 860" in v[4] and "T-999" in v[4], f"…and they save and show ({v})")
        await pg.screenshot(path=os.path.join(OUT, "a1_tech_card.png"), clip={"x": 1140, "y": 60, "width": 300, "height": 480})
        await pg.keyboard.press("Control+z"); await pg.wait_for_timeout(400)
        m1 = await pg.evaluate(f"__tg.getRO('{rid}').model || ''")
        ok(m1 == m0, f"Ctrl Z takes the last change back ({m0!r} → {m1!r})")
        # 2 · quoted hours on the Technician clock card
        q0 = await pg.evaluate(f"(()=>{{ const c=document.querySelector('{TP} .ock'); return c ? [c.dataset.ro, c.dataset.op] : null; }})()")
        await pg.click(f"{TP} .ock [data-ock=q]"); await pg.wait_for_timeout(250)
        has = await pg.evaluate(f"!!document.querySelector('{TP} .ock [data-ock=q] input')")
        if has: await type_in(pg, None, "7.5")
        qv = await pg.evaluate(f"(()=>{{ const r=__tg.getRO('{q0[0]}'); const o=r.operations.find(o=>o.id==='{q0[1]}'); return o.quoted; }})()")
        ok(has and float(qv) == 7.5, f"Technician clock card: Quoted changes in place ({has}, {qv})")
        # 3 · the Parts tab's actions
        await pg.evaluate(f"(()=>{{ const b=[...document.querySelectorAll('{TP} .tch-tabs button')].find(b=>b.dataset.v==='parts'); if(b) b.click(); }})()"); await pg.wait_for_timeout(400)
        acts = await pg.evaluate(f"[...document.querySelectorAll('{TP} .tch-o.open .tch-icb')].map(b=>b.getAttribute('aria-label'))")
        ok(all(x in acts for x in ["Add part", "From inventory…", "Extract from a quote…"]), f"Technician Parts tab: Add part, From inventory, Extract ({acts})")
        n0 = await pg.evaluate(f"__tg.getRO('{q0[0]}').operations.find(o=>o.id==='{q0[1]}').parts.length")
        await pg.click(f"{TP} .tch-o.open .tch-icb[aria-label='Add part']"); await pg.wait_for_timeout(250)
        await pg.keyboard.type("4988201 x2 brake chamber $45.99"); await pg.keyboard.press("Enter"); await pg.wait_for_timeout(400)
        await pg.screenshot(path=os.path.join(OUT, "a2_add_part.png"))
        await pg.keyboard.press("Escape"); await pg.wait_for_timeout(200)
        np_ = await pg.evaluate(f"(()=>{{ const L=__tg.getRO('{q0[0]}').operations.find(o=>o.id==='{q0[1]}').parts; return [L.length, L[L.length-1].partNumber, L[L.length-1].qty, L[L.length-1].description]; }})()")
        ok(np_[0] == n0 + 1 and np_[1] == "4988201" and np_[2] == "2", f"Add part: a quick line adds it ({np_})")
        await pg.click(f"{TP} .tch-o.open .tch-icb[aria-label='From inventory…']"); await pg.wait_for_timeout(300)
        rows = await pg.evaluate("document.querySelectorAll('.pq-pop .pq-r').length")
        if rows: await pg.click(".pq-pop .pq-a"); await pg.wait_for_timeout(300)
        await pg.screenshot(path=os.path.join(OUT, "a3_inventory.png"))
        n2 = await pg.evaluate(f"__tg.getRO('{q0[0]}').operations.find(o=>o.id==='{q0[1]}').parts.length")
        ok(rows > 0 and n2 > np_[0], f"From inventory: the list shows and Add puts it on ({rows} rows, {np_[0]}→{n2})")
        await pg.keyboard.press("Escape"); await pg.wait_for_timeout(200)
        await pg.click(f"{TP} .tch-o.open .tch-icb[aria-label='Extract from a quote…']"); await pg.wait_for_timeout(300)
        await pg.fill(".pq-pop .pq-ta", "21899123  Release bearing  2  96.00\n20518417  Pilot bearing  1  38.50"); await pg.wait_for_timeout(300)
        fx = await pg.evaluate("[document.querySelectorAll('.pq-pop .pq-r').length, document.querySelector('.pq-pop .pq-go').textContent]")
        await pg.click(".pq-pop .pq-go"); await pg.wait_for_timeout(400)
        n3 = await pg.evaluate(f"__tg.getRO('{q0[0]}').operations.find(o=>o.id==='{q0[1]}').parts.length")
        ok(fx[0] == 2 and n3 == n2 + 2, f"Extract: two lines read and added ({fx}, {n2}→{n3})")
        # 4 · RO list: the pane's card and an operation's quote; the Time column
        await pg.evaluate(f"(()=>{{ const U=__tg.UI(); U.view='rolist'; __tg.render(); }})()"); await pg.wait_for_timeout(700)
        await pg.click("[data-pg=rolist] .rq-rows .rq-row"); await pg.wait_for_timeout(700)
        pk = await pg.evaluate("[...document.querySelectorAll('[data-pg=rolist] .rq-peek .rif')].map(x=>x.dataset.rifK)")
        ok("customerName" in pk and "model" in pk and "unitNumber" in pk, f"RO list pane: customer, truck and unit editable ({pk})")
        q1 = await pg.evaluate("(()=>{ const s=document.querySelector('[data-pg=rolist] .rq-peek .rq-pops .qte'); return s ? [s.dataset.qtRo, s.dataset.qtOp] : null; })()")
        await pg.click("[data-pg=rolist] .rq-peek .rq-pops .qte"); await pg.wait_for_timeout(250); await type_in(pg, None, "3.25")
        v1 = await pg.evaluate(f"__tg.getRO('{q1[0]}').operations.find(o=>o.id==='{q1[1]}').quoted")
        ok(float(v1) == 3.25, f"RO list pane: an operation's quote changes in place ({v1})")
        await pg.screenshot(path=os.path.join(OUT, "a4_rolist_pane.png"))
        # 5 · the RO page: title and an operation row's quote
        await pg.evaluate(f"(()=>{{ const U=__tg.UI(); U.view='ros'; U.selectedRo='{q1[0]}'; __tg.render(); }})()"); await pg.wait_for_timeout(1100)
        rp = await pg.evaluate(J("return [[...R.querySelectorAll('.px-ro__title .rif, .px-ro__sub .rif')].map(x=>x.dataset.rifK), R.querySelectorAll('.px-row__time .qte').length]"))
        ok("customerName" in rp[0] and "year" in rp[0] and rp[1] > 0, f"RO page: the title and each operation row's quote are editable ({rp})")
        await pg.evaluate(J("R.querySelector('.px-row__time .qte').click()")); await pg.wait_for_timeout(300)
        hasin = await pg.evaluate(J("return !!R.querySelector('.px-row__time .qte input')"))
        if hasin: await type_in(pg, None, "4.4")
        v2 = await pg.evaluate(J("const s=R.querySelector('.px-row__time .qte'); return s ? s.textContent : ''"))
        ok(hasin and "4.40" in v2, f"RO page: a row's quote changes in place, the card stays shut ({hasin}, {v2})")
        await pg.evaluate(J("R.querySelector('.px-ro__title .rif').click()")); await pg.wait_for_timeout(250)
        await type_in(pg, None, "Highplains Grain Co")
        v3 = await pg.evaluate(f"__tg.getRO('{q1[0]}').customerName")
        ok(v3 == "Highplains Grain Co", f"RO page: the customer changes in the title ({v3})")
        await pg.screenshot(path=os.path.join(OUT, "a5_ro_page.png"))
        # 6 · the sidebar order
        nav = await pg.evaluate("[...document.querySelectorAll('nav [data-view], .sidebar [data-view]')].map(x=>x.dataset.view)")
        ok(nav.index("assets") == nav.index("fixes") + 1 and nav.index("inventory") == nav.index("assets") + 1, f"sidebar: Assets and Inventory below Fixes ({nav})")
        # 7 · the Time Log opens on your own times
        me = await pg.evaluate("(()=>{ const T=__tg.staffList().filter(s=>s.role==='Technician'); localStorage.setItem('tec_viewas', T[1].id); __tg.pxSignedIn(); __tg.render(); return T[1].name; })()"); await pg.wait_for_timeout(600)
        await pg.evaluate("(()=>{ const b=document.querySelector('nav [data-view=timelog], .sidebar [data-view=timelog]'); if(b) b.click(); })()"); await pg.wait_for_timeout(900)
        who = await pg.evaluate("(document.querySelector('[data-pg=timelog]')||{}).innerText.slice(0,160)")
        ok(me.split()[0] in who, f"Time Log opens on the signed-in person's times ({me} · {who[:80]})")
        fm = await pg.evaluate("(()=>{ const F=__tg.staffList().find(s=>s.role==='Foreman'); if(!F) return null; localStorage.setItem('tec_viewas', F.id); __tg.pxSignedIn(); __tg.UI().view='rolist'; __tg.render(); return F.name; })()"); await pg.wait_for_timeout(500)
        await pg.evaluate("(()=>{ const b=document.querySelector('nav [data-view=timelog], .sidebar [data-view=timelog]'); if(b) b.click(); })()"); await pg.wait_for_timeout(900)
        await pg.screenshot(path=os.path.join(OUT, "a6_timelog_foreman.png"))
        fw = await pg.evaluate("(document.querySelector('[data-pg=timelog]')||{}).innerText.slice(0,160)")
        ok(fm.split()[0] in fw and "Whole shop" not in fw, f"…a foreman too, not the whole shop ({fm} · {fw[:90]!r})")
        # phone + dark
        await pg.set_viewport_size({"width": 390, "height": 844}); await pg.evaluate("document.documentElement.setAttribute('data-theme','ivd'); __tg.UI().view='tech'; __tg.render()"); await pg.wait_for_timeout(800)
        await pg.screenshot(path=os.path.join(OUT, "a7_phone_dark.png"))
        ok(not errs, f"no console errors: {errs[:3]}")
        print("FAILS:", len(FAILS), FAILS)
        await b.close()
asyncio.run(main())
