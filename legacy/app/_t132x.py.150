# Parsec 14 (fork X) — the import reads every cost and the engine serial; Extract operations and the Parts list import too
import asyncio, os, sys, json, base64, time
from playwright.async_api import async_playwright
H = os.path.dirname(os.path.abspath(__file__)); X = os.path.join(H, "x132"); OUT = os.path.join(H, "shots132x"); os.makedirs(OUT, exist_ok=True)
PAGE = sys.argv[1] if len(sys.argv) > 1 else "t12_ix.html"
FONTS = (sys.argv[2] if len(sys.argv) > 2 else "Arial@13px,DejaVu Sans@12px").split(",")
SR = "document.querySelector('.jc-host:not(.jc-band-host)').shadowRoot"
PASTE = """(t => { const dt = new DataTransfer(); dt.setData('text/plain', t); const z = document.querySelector('#imp-dlg .ix-drop') || document.body; z.dispatchEvent(new ClipboardEvent('paste', { clipboardData: dt, bubbles: true, cancelable: true })); })"""
FILES = """(L => { const fs = L.map((b, i) => { const s = atob(b), a = new Uint8Array(s.length); for(let k = 0; k < s.length; k++) a[k] = s.charCodeAt(k); return new File([a], 'shot' + (i + 1) + '.png', { type: 'image/png' }); }); __tg.IMPX.read(fs); })"""
FAILS = []
def ok(c, m):
    print(("ok   " if c else "FAIL ") + m)
    if not c: FAILS.append(m)
def T(f): return open(os.path.join(X, f), encoding="utf-8").read()
async def shots(b, font):
    fam, _, size = font.partition("@")
    pg = await (await b.new_context(viewport={"width": 1100, "height": 1400}, device_scale_factor=1)).new_page()
    await pg.goto("file://" + X + "/case_shot.html"); await pg.evaluate(f"document.body.style.setProperty('--f', '{fam}'); document.body.style.setProperty('--fs', '{size}')"); await pg.wait_for_timeout(200)
    out = {}
    for cid in ["c1", "c2", "c3", "c4", "q1"]:
        p = os.path.join(OUT, f"in_{fam.replace(' ', '')}{size}_{cid}.png"); await (await pg.query_selector("#" + cid)).screenshot(path=p)
        out[cid] = base64.b64encode(open(p, "rb").read()).decode()
    await pg.close(); return out
async def wait_read(pg):
    for _ in range(240):
        await pg.wait_for_timeout(500)
        if not await pg.evaluate("(() => { const D = __tg.IMPX.state(); return D ? D.busy : ''; })()"): return
async def main():
    async with async_playwright() as p:
        b = await p.chromium.launch()
        ctx = await b.new_context(viewport={"width": 1440, "height": 900}); pg = await ctx.new_page(); pg.set_default_timeout(8000); errs = []
        pg.on("pageerror", lambda e: errs.append(str(e)[:300]))
        pg.on("console", lambda m: errs.append("console: " + m.text[:200]) if m.type == "error" and "ERR_" not in m.text and "Failed to load resource" not in m.text else None)
        await pg.route("**/fonts.g*/**", lambda r: r.abort())
        await pg.goto("file://" + H + "/" + PAGE); await pg.wait_for_timeout(1200)
        await pg.evaluate("__tg.loadSample25()"); await pg.evaluate("__tg.ensureDemoTeam()"); await pg.evaluate("(()=>{ localStorage.removeItem('tec_viewas'); localStorage.removeItem('tec_out'); try{ __tg.pxSignedIn(); }catch(e){} __tg.render(); })()"); await pg.wait_for_timeout(300)
        # ---------- 1 · New RO from the pasted case page ----------
        await pg.evaluate("__tg.IMPX.open({})"); await pg.wait_for_timeout(300)
        await pg.evaluate(PASTE + "(" + json.dumps(T("s1_case.txt")) + ")"); await pg.wait_for_timeout(600)
        oc = await pg.evaluate("[...document.querySelectorAll('#imp-dlg .ix-oc')].map(x=>x.innerText.replace(/\\s+/g,' '))")
        ok(len(oc) == 3 and all("adds up" in x for x in oc), f"each operation shows its money and it adds up ({oc[:1]})")
        ok("165.00/h" in (oc[1] if len(oc) > 1 else "") and "its own rate" in (oc[1] if len(oc) > 1 else ""), "op 2 shows its own labor rate")
        th = await pg.evaluate("[...document.querySelectorAll('#imp-dlg .ix-pt')][0] ? [...document.querySelectorAll('#imp-dlg .ix-pt')][0].querySelector('thead').innerText.replace(/\\s+/g,' ') : ''")
        ok(all(k in th for k in ["List", "Disc", "Net", "Core", "Ext"]), f"the parts table shows List, Disc, Net, Core, Ext ({th})")
        tot = await pg.evaluate("[...document.querySelectorAll('#imp-dlg .ix-tot > div')].map(x=>x.innerText.replace(/\\s+/g,' '))")
        ok(len(tot) >= 6 and all(("matches" in x or "Tax" in x) for x in tot), f"totals: every line matches ASIST, tax shown ({tot})")
        sup = await pg.evaluate("(()=>{ const i=document.querySelector('#imp-dlg [data-ixf=shopSupplies]'); return i ? i.value : null; })()")
        ok(sup == "12.5", f"shop supplies & fees the operations don't carry go on the RO ({sup})")
        esn = await pg.evaluate("(()=>{ const i=document.querySelector('#imp-dlg [data-ixf=engineSerial]'); return i ? i.value : null; })()")
        ok(esn == "21987654", f"engine serial read from ESN: ({esn})")
        await pg.screenshot(path=os.path.join(OUT, "x1_import.png"))
        await pg.evaluate("(()=>{ const s=document.querySelector('#imp-dlg .ix-b'); const g=[...document.querySelectorAll('#imp-dlg .ix-grp h4')].find(h=>/Operations/.test(h.textContent)); if(g) g.scrollIntoView(); })()"); await pg.wait_for_timeout(200)
        await pg.screenshot(path=os.path.join(OUT, "x2_import_ops.png"))
        await pg.evaluate("(()=>{ const g=[...document.querySelectorAll('#imp-dlg .ix-grp h4')].find(h=>/Totals/.test(h.textContent)); if(g) g.scrollIntoView(); })()"); await pg.wait_for_timeout(200)
        await pg.screenshot(path=os.path.join(OUT, "x3_import_totals.png"))
        await pg.click('#imp-dlg [data-ix="apply"]'); await pg.wait_for_timeout(1200)
        r = await pg.evaluate("""(()=>{ const r=__tg.STATE().ros.find(x=>x.roNumber==='RA0001241190'); if(!r) return null; const M=__tg.roMoney(r);
          return { id: r.id, esn: r.engineSerial, sup: r.shopSupplies, at: r.asistTotals && r.asistTotals.total, ops: r.operations.map(o=>[o.quoted, o.estCost, o.laborRate||null, o.otherCost||null, o.asist && o.asist.total, (o.parts||[]).map(p=>[p.partNumber, p.price, p.list||null, p.disc||'', p.core||null])]),
            M: M, inv: (__tg.STATE().inventory||[]).filter(x=>x.pn==='VOL-23125678').map(x=>x.price) }; })()""")
        print("RO:", json.dumps(r)[:900])
        ok(r and r["esn"] == "21987654", "the RO has the engine serial")
        ok(r and r["ops"][0][:4] == [6.2, 1302, None, "35"] and r["ops"][1][2] == 165 and r["ops"][2][3] == "185", "operations keep labor, their own rate, shop supplies and sublet as Other")
        ok(r and r["ops"][0][5][0] == ["VOL-23125678", "1782", "1980", "10%", "250"], "parts keep net, list, disc and core")
        ok(r and r["sup"] == "12.5" and abs(r["at"] - 4598.82) < .01, "the RO keeps shop supplies & fees and ASIST's totals")
        ok(r and abs(r["M"]["total"] - 4502.40) < .01 and abs(r["M"]["labor"] - 1621.5) < .01 and abs(r["M"]["core"] - 250) < .01, f"the RO's money is ASIST's total less tax ({r and r['M']})")
        ok(r and r["inv"] and r["inv"][0] in ("1782", 1782), f"the Parts list learns the price ({r and r['inv']})")
        rid = r["id"] if r else ""
        await pg.evaluate(f"(()=>{{ const U=__tg.UI(); U.view='ros'; U.selectedRo='{rid}'; __tg.render(); }})()"); await pg.wait_for_timeout(1500)
        txt = await pg.evaluate(f"(()=>{{ const R={SR}; return R ? R.textContent : ''; }})()")
        ok("21987654" in txt, "the RO page shows the engine serial")
        ok("$4,502.40" in txt, "the RO page's money adds up to it")
        await pg.screenshot(path=os.path.join(OUT, "x4_ro.png"))
        # import the same case again: nothing new; ASIST changes op 2's rate → updated
        await pg.evaluate(f"__tg.IMPX.open({{ ro: '{rid}' }})"); await pg.wait_for_timeout(300)
        await pg.evaluate(PASTE + "(" + json.dumps(T("s1_case.txt")) + ")"); await pg.wait_for_timeout(500)
        c = await pg.evaluate("__tg.IMPX.counts()"); ok(c and c["changes"] == 0, f"the same case again: nothing to change ({c})")
        await pg.evaluate("__tg.IMPX.close()")
        await pg.evaluate(f"__tg.IMPX.open({{ ro: '{rid}' }})"); await pg.wait_for_timeout(300)
        t2 = T("s1_case.txt").replace("1.3\t$165.00\t$214.50\t$548.00\t$0.00\t$0.00\t$762.50", "1.3\t$150.00\t$195.00\t$548.00\t$0.00\t$0.00\t$743.00")
        await pg.evaluate(PASTE + "(" + json.dumps(t2) + ")"); await pg.wait_for_timeout(500)
        c = await pg.evaluate("__tg.IMPX.counts()"); ok(c and c["upd"] >= 1, f"ASIST changed op 2's rate: updated ({c})")
        await pg.click('#imp-dlg [data-ix="apply"]'); await pg.wait_for_timeout(900)
        lr = await pg.evaluate(f"(()=>{{ const r=__tg.getRO('{rid}'); return [r.operations[1].laborRate, r.operations[1].estCost]; }})()")
        ok(lr == [150, 195], f"…and applied ({lr})")
        # ---------- 2 · screenshots of the case, read here ----------
        for font in FONTS:
            S = await shots(b, font)
            await pg.evaluate("__tg.IMPX.open({})"); await pg.wait_for_timeout(300); t0 = time.time()
            await pg.evaluate(FILES + "(" + json.dumps([S["c1"], S["c2"], S["c3"], S["c4"]]) + ")"); await wait_read(pg)
            st = await pg.evaluate("""(()=>{ const D=__tg.IMPX.state(), A=D.acc; return { f: { esn: A.f.engineSerial, ro: A.f.roNumber, vin: A.f.vin, engine: A.f.engine }, ops: A.ops.map(o=>[o.no, o.hours, o.rate, o.price, o.partsAmt, o.misc, o.sublet, o.total]),
              parts: A.parts.concat(...A.ops.map(o=>o.parts)).map(p=>[p.pn, p.qty, p.list, p.disc, p.price, p.core, p.ext]), T: A.totals, sup: A.f.supplies }; })()""")
            print(font, "read in %.0fs" % (time.time() - t0), json.dumps(st)[:1200])
            ok(st["f"]["esn"] == "21987654", f"[{font}] screenshot: engine serial ({st['f']})")
            want = [[1, 6.2, 210, 1302, 2100.4, 35, None, 3437.4], [2, 1.3, 165, 214.5, 548, 0, 0, 762.5], [3, .5, 210, 105, 0, 0, 185, 290]]
            ok(st["ops"] == want, f"[{font}] screenshot: every operation's money ({st['ops']})")
            wp = [["VOL-23125678", "1", 1980, "10%", 1782, 250, 2032], ["VOL-21412345", "2", 38, "10%", 34.2, 0, 68.4], ["VOL-22827993", "1", None, "0%", 548, 0, 548]]
            ok(st["parts"] == wp, f"[{font}] screenshot: parts list, disc, net, core, ext ({st['parts']})")
            Tt = st["T"] or {}
            ok(Tt.get("labor") == 1621.5 and Tt.get("parts") == 2398.4 and Tt.get("tax") == 96.42 and Tt.get("total") == 4598.82 and st["sup"] == "12.5", f"[{font}] screenshot: the totals line ({Tt})")
            tot = await pg.evaluate("[...document.querySelectorAll('#imp-dlg .ix-tot > div')].map(x=>x.innerText.replace(/\\s+/g,' '))")
            ok(all(("matches" in x or "Tax" in x) for x in tot), f"[{font}] screenshot: totals match ({tot})")
            await pg.screenshot(path=os.path.join(OUT, f"x5_ocr_{font.split('@')[0].replace(' ', '')}.png"))
            await pg.evaluate("__tg.IMPX.close()")
        # ---------- 2b · the case as a browser copies it (tabs between cells): "Parts" ends the operations; ASIST's approval becomes Parsec's ----------
        CASE = T("s5_revcase.txt")
        await pg.evaluate("__tg.IMPX.open({})"); await pg.wait_for_timeout(300)
        await pg.evaluate("t=>__tg.IMPX.addText(t)", CASE); await pg.wait_for_timeout(600)
        nm = await pg.evaluate("[...document.querySelectorAll('#imp-dlg .ix-op .ix-on b')].map(x=>x.textContent)")
        ok(nm == ["Clutch slipping - replace clutch", "Check engine light - NOx sensor fault SPN 3226", "PM service - level A"], f"the Parts heading isn't glued onto the last operation ({nm})")
        lp = await pg.evaluate("(document.querySelector('#imp-dlg .ix-lp')||{}).innerText||''")
        ok("Clutch kit" in lp and "Op 1" in lp and "by its name" in lp, f"the case's parts go to the clutch op by name, not the last op ({lp.strip()[:160]})")
        pa = await pg.evaluate("[...document.querySelectorAll('#imp-dlg .ix-op')].map(o=>(o.querySelector('.ix-pa')||{}).textContent||'')")
        ok(pa == ["→ approved in Parsec", "needs approval", "needs approval"], f"the approval each op gets in Parsec ({pa})")
        pp = await pg.evaluate("[...document.querySelectorAll('#imp-dlg .ix-op')].map(o=>o.querySelectorAll('.ix-pt tbody tr').length)")
        ok(pp == [3, 0, 0], f"all three parts under Op 1 ({pp})")
        await pg.evaluate("(()=>{ const g=[...document.querySelectorAll('#imp-dlg .ix-grp h4')].find(h=>/Operations/.test(h.textContent)); if(g) g.scrollIntoView(); })()"); await pg.wait_for_timeout(200)
        await pg.screenshot(path=os.path.join(OUT, "x10_review_case.png"))
        await pg.click('#imp-dlg [data-ix="apply"]'); await pg.wait_for_timeout(1200)
        rv = await pg.evaluate("""(()=>{ const r=__tg.STATE().ros.find(x=>/1238877/.test(x.roNumber)); return r ? { id: r.id, esn: r.engineSerial, ops: r.operations.map(o=>[o.complaint, o.appr ? [o.appr.s, o.appr.how, o.appr.who] : null, !!o.declined, (o.parts||[]).length]) } : null; })()""")
        print("review RO:", json.dumps(rv))
        ok(rv and rv["ops"][0][1] == ["ok", "ASIST", "Jenna Cho"] and rv["ops"][1][1] is None and rv["ops"][2][1] is None, "Create RO: ASIST Approved → approved in Parsec (who: the case's Created By, how: ASIST); Pending → needs approval")
        ok(rv and [o[3] for o in rv["ops"]] == [3, 0, 0] and rv["ops"][2][0] == "PM service - level A", "the parts are on the clutch op and the PM op keeps its own name")
        ok(rv and rv["esn"] == "100254871", "Engine Serial # read from the tab-separated paste")
        rvid = rv["id"] if rv else ""
        aud = await pg.evaluate("(__tg.STATE().audit||[]).filter(a=>/approved in ASIST/.test(a.text||a.t||a.msg||JSON.stringify(a))).length")
        ok(aud >= 1, f"the approval is in the Activity log ({aud})")
        # Parts lists Op 1's parts under To order; Triage's Needs action has the RO
        await pg.evaluate("(()=>{ __tg.UI().view='parts'; __tg.render(); })()"); await pg.wait_for_timeout(900)
        pl = await pg.evaluate("(document.querySelector('[data-pg=parts] .tg-list')||{}).innerText||''")
        i0 = pl.find("To order"); i1 = pl.find("8877")
        nxt = min([x for x in [pl.find(h, i0 + 1) for h in ["Late", "Arrived", "On the way", "With the tech"]] if x > -1] or [len(pl)])
        ok(i0 > -1 and i0 < i1 < nxt, f"Parts: the RO's parts are under To order ({pl[i0:i0+120] if i0 > -1 else pl[:120]!r})")
        await pg.evaluate("(()=>{ __tg.UI().view='triage'; __tg.render(); })()"); await pg.wait_for_timeout(900)
        tl = await pg.evaluate("(document.querySelector('.tg-list')||{}).innerText||''")
        ok("8877" in tl, "Triage: the RO is in Needs action (ops 2 and 3 wait on the customer)")
        await pg.evaluate("(()=>{ __tg.UI().view='rolist'; __tg.render(); })()"); await pg.wait_for_timeout(900)
        nx = await pg.evaluate("(()=>{ const r=[...document.querySelectorAll('[data-pg=rolist] .rq-row, [data-pg=rolist] .rl-row')].find(x=>/8877/.test(x.innerText)); return r ? ((r.querySelector('.rq-nx, .rl-nx')||{}).innerText||'').replace(/\\s+/g,' ') : ''; })()")
        print("RO list next step:", nx)
        # re-import: same → nothing; Pending → Approved on op 2 applies; a hand decline on op 1 is kept; ASIST going back to Pending keeps the approval
        await pg.evaluate(f"__tg.IMPX.open({{ ro: '{rvid}' }})"); await pg.wait_for_timeout(300)
        await pg.evaluate("t=>__tg.IMPX.addText(t)", CASE); await pg.wait_for_timeout(500)
        c = await pg.evaluate("__tg.IMPX.counts()"); ok(c and c["changes"] == 0, f"the same case again: nothing to change ({c})"); await pg.evaluate("__tg.IMPX.close()")
        await pg.evaluate(f"(()=>{{ const r=__tg.getRO('{rvid}'); r.operations[0].appr={{ s:'no', by:'Admin', at:new Date().toISOString(), who:'Dave (fleet)', role:'', how:'Call', po:'', amt:0, reason:'Too much' }}; r.operations[0].declined=true; }})()")
        c2 = CASE.replace("1.5\t$315.00\tPending", "1.5\t$315.00\tApproved").replace("2.0\t$420.00\tPending", "2.0\t$420.00\tDeclined")
        await pg.evaluate(f"__tg.IMPX.open({{ ro: '{rvid}' }})"); await pg.wait_for_timeout(300)
        await pg.evaluate("t=>__tg.IMPX.addText(t)", c2); await pg.wait_for_timeout(500)
        pa = await pg.evaluate("[...document.querySelectorAll('#imp-dlg .ix-op')].map(o=>(o.querySelector('.ix-pa')||{}).textContent||'')")
        ok(pa[0].startswith("Kept yours") and "declined" in pa[0] and pa[1] == "→ approved in Parsec" and pa[2] == "→ declined in Parsec", f"re-import: hand decline kept, Pending→Approved, →Declined ({pa})")
        await pg.evaluate("(()=>{ const g=[...document.querySelectorAll('#imp-dlg .ix-grp h4')].find(h=>/Operations/.test(h.textContent)); if(g) g.scrollIntoView(); })()"); await pg.wait_for_timeout(200)
        await pg.screenshot(path=os.path.join(OUT, "x11_reimport_appr.png"))
        await pg.click('#imp-dlg [data-ix="apply"]'); await pg.wait_for_timeout(900)
        st = await pg.evaluate(f"__tg.getRO('{rvid}').operations.map(o=>[o.appr && o.appr.s, o.appr && o.appr.how, !!o.declined])")
        ok(st == [["no", "Call", True], ["ok", "ASIST", False], ["no", "ASIST", True]], f"…applied: op 1 stays declined by hand, op 2 approved, op 3 declined ({st})")
        await pg.evaluate(f"__tg.IMPX.open({{ ro: '{rvid}' }})"); await pg.wait_for_timeout(300)
        await pg.evaluate("t=>__tg.IMPX.addText(t)", CASE); await pg.wait_for_timeout(500)
        pa = await pg.evaluate("[...document.querySelectorAll('#imp-dlg .ix-op')].map(o=>(o.querySelector('.ix-pa')||{}).textContent||'')")
        ok(pa[1].startswith("Kept — already approved") and pa[2].startswith("Kept — already declined"), f"ASIST back to Pending doesn't undo Parsec's approval ({pa})")
        await pg.evaluate("__tg.IMPX.close()")
        # a name the 13.x import glued "Parts" onto comes back — on load, and on re-import
        g = await pg.evaluate(f"""(()=>{{ const r=__tg.getRO('{rvid}'), o=r.operations[2], k=Object.keys(r.imp.ops).find(k=>r.imp.ops[k].id===o.id); o.complaint='PM service - level A Parts'; r.imp.ops[k].name='PM service - level A Parts'; __tg.x132Unglue(r); return [o.complaint, r.imp.ops[k].name]; }})()""")
        ok(g == ["PM service - level A", "PM service - level A"], f"a glued name is put back when the file loads ({g})")
        await pg.evaluate(f"(()=>{{ const r=__tg.getRO('{rvid}'); r.operations[2].complaint='PM service - level A Parts'; }})()")
        await pg.evaluate(f"__tg.IMPX.open({{ ro: '{rvid}' }})"); await pg.wait_for_timeout(300)
        await pg.evaluate("t=>__tg.IMPX.addText(t)", CASE); await pg.wait_for_timeout(500)
        await pg.click('#imp-dlg [data-ix="apply"]'); await pg.wait_for_timeout(900)
        ok(await pg.evaluate(f"__tg.getRO('{rvid}').operations[2].complaint") == "PM service - level A", "…and on re-import")
        # ---------- 3 · Extract operations on an RO ----------
        rid2 = await pg.evaluate("(()=>{ const r=__tg.STATE().ros.find(x=>!x.shop && !x.dateClosed && x.operations.length); return r.id; })()")
        n0 = await pg.evaluate(f"__tg.getRO('{rid2}').operations.length")
        await pg.evaluate(f"(()=>{{ __tg.UI().modal={{ type:'extract-ops', roId:'{rid2}', rows:[], text:'', status:'' }}; __tg.render(); }})()"); await pg.wait_for_timeout(400)
        await pg.evaluate("(t=>{ const a=document.getElementById('ops-x-text'); a.value=t; a.dispatchEvent(new Event('input',{bubbles:true})); })(" + json.dumps(T("s3_noheader.txt")) + ")"); await pg.wait_for_timeout(500)
        rows = await pg.evaluate("[...document.querySelectorAll('.ops-x-row')].map(r=>[r.querySelector('.ops-x-n').value, r.querySelector('[data-opsh]').value, r.querySelector('[data-opsc]').value, (r.querySelector('.ops-x-more')||{}).textContent||''])")
        print("extract rows:", rows)
        ok(len(rows) == 3 and rows[0][2] == "420.00" and "parts $612.00" in rows[0][3] and "total $1,032.00" in rows[0][3], f"Extract operations: labor in the $ box, parts and total under the row ({rows[:1]})")
        await pg.screenshot(path=os.path.join(OUT, "x6_extract.png"))
        await pg.click("#ops-x-go"); await pg.wait_for_timeout(600)
        added = await pg.evaluate(f"__tg.getRO('{rid2}').operations.slice({n0}).map(o=>[o.complaint, o.quoted, o.estCost||null, o.laborRate||null, o.asist && o.asist.total || null])")
        ok(len(added) == 3 and added[0][2] == 420 and added[0][4] == 1032, f"…added with their money ({added})")
        # the case page through Extract operations brings each operation's own rate, Other and its parts
        await pg.evaluate(f"(()=>{{ __tg.UI().modal={{ type:'extract-ops', roId:'{rid2}', rows:[], text:'', status:'' }}; __tg.render(); }})()"); await pg.wait_for_timeout(400)
        await pg.evaluate("(t=>{ const a=document.getElementById('ops-x-text'); a.value=t; a.dispatchEvent(new Event('input',{bubbles:true})); })(" + json.dumps(T("s1_case.txt")) + ")"); await pg.wait_for_timeout(500)
        n1 = await pg.evaluate(f"__tg.getRO('{rid2}').operations.length")
        await pg.click("#ops-x-go"); await pg.wait_for_timeout(600)
        a2 = await pg.evaluate(f"__tg.getRO('{rid2}').operations.slice({n1}).map(o=>[o.complaint, o.laborRate||null, o.otherCost||null, (o.parts||[]).map(p=>[p.partNumber,p.price,p.core||null])])")
        ok(len(a2) == 3 and a2[1][1] == 165 and a2[0][2] == "35" and a2[2][2] == "185" and a2[0][3][0] == ["VOL-23125678", "1782", "250"], f"Extract operations from the case page: own rate, Other, parts ({json.dumps(a2)[:300]})")
        # ---------- 4 · the Parts list import: a quote, pasted and as a screenshot ----------
        await pg.evaluate("(()=>{ __tg.UI().modal={ type:'inv-extract', text:'', pick:{} }; __tg.render(); })()"); await pg.wait_for_timeout(400)
        await pg.evaluate("(t=>{ const a=document.getElementById('inv-x-text'); a.value=t; a.dispatchEvent(new Event('input',{bubbles:true})); })(" + json.dumps(T("s4_quote.txt")) + ")"); await pg.wait_for_timeout(500)
        ir = await pg.evaluate("[...document.querySelectorAll('.inv-x-row')].map(r=>r.innerText.replace(/\\s+/g,' '))")
        print("inventory rows:", ir)
        ok(len(ir) == 4 and "net $36.38 → cost" in ir[0] and "core $250.00" in ir[1], f"Parts list import: list → price, net → cost, core ({ir[:2]})")
        await pg.screenshot(path=os.path.join(OUT, "x7_inv.png"))
        await pg.click("#inv-x-go"); await pg.wait_for_timeout(500)
        inv = await pg.evaluate("(__tg.STATE().inventory||[]).filter(x=>['21707134','85013702'].includes(x.pn)).map(x=>[x.pn, x.price, x.cost||null, x.core||null])")
        ok(sorted(inv) == [["21707134", "48.5", "36.38", None], ["85013702", "1980", "1485", "250"]], f"…saved with price, cost and core ({inv})")
        await pg.evaluate("(()=>{ __tg.UI().modal={ type:'inv-extract', text:'', pick:{} }; __tg.render(); })()"); await pg.wait_for_timeout(400)
        S = await shots(b, FONTS[0]); qp = os.path.join(OUT, f"in_{FONTS[0].split('@')[0].replace(' ', '')}{FONTS[0].split('@')[1]}_q1.png")
        await pg.set_input_files("#inv-x-file", qp)
        for _ in range(120):
            await pg.wait_for_timeout(500)
            st = await pg.evaluate("(document.getElementById('inv-x-status')||{}).textContent||''")
            if "found" in st or "Couldn" in st or "no part" in st: break
        ir2 = await pg.evaluate("[...document.querySelectorAll('.inv-x-row')].map(r=>r.innerText.replace(/\\s+/g,' '))")
        print("inventory from the screenshot:", st, ir2)
        ok(len(ir2) >= 3 and "net $36.38 → cost" in ir2[0] and "net $1,485.00 → cost" in ir2[1] and "core $250.00" in ir2[1], f"Parts list import from a screenshot ({ir2[:2]})")
        await pg.screenshot(path=os.path.join(OUT, "x8_inv_ocr.png"))
        print("ERRORS", errs[:6]); ok(not errs, "no console errors")
        print("FAILS:", len(FAILS), FAILS)
        await b.close()
asyncio.run(main())
