  /* ============================== Technician page (Parsec 11) ==============================
     A technician's repair orders: Working, Assigned in the foreman's order, Waiting, and Done today — the list on
     the left, the RO on the right. Every operation opens to its notes, its time (each punch) and its parts.
     It replaces Console for technicians and runs on Console's own pieces: the same shop read out of STATE (build),
     the same punches, holds, asks, popovers, past fixes, photos and your day. */
  const TU = { ro: null, open: {}, q: '', dr: {}, kb: false };
  TK.runh = () => { const o = S && S.rp && opBy(S.rp.opId); return o ? h1(burnt(o)) + ' / ' + h1(o.q) + ' h' : null; };
  const TSTG = ['Check-in', 'Diag', 'Approval', 'Parts', 'Repair', 'Road test', 'Close-out'];
  const nxIx = o => { const L = nextOps(); const i = L.indexOf(o); return i < 0 ? 999 : i; };
  /* the ROs: Console's operations grouped by RO; the RO sits where its most urgent operation is */
  function tcRos(){
    const by = {}, order = [];
    S.ops.forEach(o => { if(!by[o.roId]){ by[o.roId] = []; order.push(o.roId); } by[o.roId].push(o); });
    return order.map(id => {
      const ops = by[id].slice().sort((a, b) => a.opn - b.opn), ro = ops[0].ro;
      const run = ops.find(isRun), nx = ops.filter(o => !isRun(o) && o.st === 'next').sort((a, b) => nxIx(a) - nxIx(b)), wt = ops.filter(o => !isRun(o) && o.st === 'wait'), dn = ops.filter(o => o.st === 'done');
      const lane = run ? 'run' : nx.length ? 'next' : wt.length ? 'wait' : 'done';
      const focus = run || nx[0] || wt[0] || dn[dn.length - 1];
      const left = ops.filter(o => o.st !== 'done'), q = sum(left, o => o.q), b = sum(left, o => burnt(o));
      const dq = sum(dn, o => o.q), db = sum(dn, o => o.b0);
      return { id, ro, ops, lane, focus, no: ops[0].no, cust: ops[0].cust, truck: ops[0].truck, unit: ops[0].unit, spot: ops[0].spot, q, b, eff: db >= .05 ? Math.round(dq / db * 100) : null, ix: nxIx(focus) };
    });
  }
  function tcMatch(r){
    const q = TU.q.trim().toLowerCase(); if(!q) return true;
    let tl = ''; try{ tl = trkLabel(r.ro); }catch(e){}
    const t = [r.no, r.cust, r.truck, tl, r.unit, r.spot, r.ro.vin || '', r.ro.year || ''].concat(r.ops.map(o => o.cmp)).join(' ').toLowerCase();
    return q.split(/\s+/).every(w => t.indexOf(w) > -1);
  }
  function tcGroups(all){
    const R = all.filter(tcMatch), fm = PG.person('Foreman'), fmw = fm ? PG.first(fm) + '’s order' : 'the foreman’s order';
    return [[S.shop ? 'On shop time' : 'Working', R.filter(r => r.lane === 'run'), 'run'],
      ['Assigned · ' + fmw, R.filter(r => r.lane === 'next').sort((a, b) => a.ix - b.ix), 'next'],
      ['Waiting', R.filter(r => r.lane === 'wait'), 'wait'],
      ['Done today', R.filter(r => r.lane === 'done'), 'done']].filter(g => g[1].length || g[2] === 'run');
  }
  const tcFlat = () => tcGroups(tcRos()).flatMap(g => g[1]);
  /* how long it has waited on someone else — Parsec 10's blocker aging, on every waiting RO */
  function tcAge(r){
    const o = r.focus; let h = null; try{ h = tgHold(r.ro); }catch(e){}
    if(h && h.held){ const x = h.goal ? h.held / h.goal : 0; return `<span class="tch-age${x >= 1 ? ' b' : x >= .75 ? ' w' : ''}" title="With ${esc(h.who || (o.hold && o.hold.who) || '')} · follow up after ${esc(tgShortDur(h.goal))}">${esc(tgShortDur(h.held))}</span>`; }
    return o.hold && o.hold.left ? `<span class="tch-age">${esc(o.hold.left)}</span>` : '';
  }
  function tcItem(r){
    const o = r.focus, on = r.id === TU.ro, more = r.ops.filter(x => x.st !== 'done').length - 1;
    const ord = r.lane === 'next' ? (o.paused ? `<span class="cx-n pz" title="Paused">${ic('pause', 10)}</span>` : o.ord ? `<span class="cx-n">${o.ord}</span>` : '<span></span>') : '';
    const sub = r.lane === 'wait' ? tcAge(r) + esc(o.hold.k + (o.hold.txt ? ' · ' + o.hold.txt : ''))
      : r.lane === 'done' ? 'Done at ' + esc(o.at) + (r.ops.length > 1 ? ' · ' + r.ops.length + ' operations' : '')
      : (o.back ? '<span class="ib-k auto">back</span>' : '') + esc(o.cmp) + (more > 0 ? ` <em>+${more}</em>` : '');
    const m = r.lane === 'run' ? `<b class="run" data-tk="runm">${dur(burnt(o) * 60)}</b>`
      : r.lane === 'done' ? `<b>${r.eff == null ? '—' : r.eff + '%'}</b>`
      : r.lane === 'wait' ? `<b class="wt">${esc(o.hold.k)}</b>`
      : o.paused ? `<b>${dur(o.b0 * 60)}</b>` : `<b>${h1(r.q)} h</b>`;
    const sm = r.lane === 'next' && o.paused ? 'paused ' + o.paused : r.lane === 'wait' ? (o.hold.left || '') : r.lane === 'done' ? h1(sum(r.ops.filter(x => x.st === 'done'), x => x.q)) + ' h sold' : (o.ro.cxBring && !bayLike(o.spot) ? 'coming in' : o.spot || 'no spot');
    return `<div class="tg-it tch-it ${r.lane}${on ? ' on' : ''}${on && TU.kb ? ' kb' : ''}${ord ? ' has-o' : ''}" data-a="tsel" data-id="${r.id}">${ord}<span class="tch-pic">${trkThumb(r.ro)}</span><span class="tch-t"><b><span class="tg-no">${esc(r.no)}</span>${esc(r.cust)}</b><small>${sub}</small></span><span class="tch-m">${m}<small>${esc(sm)}</small></span></div>`;
  }
  function tcList(G, all){
    const n = all.length, shown = G.reduce((s, g) => s + g[1].length, 0);
    const SH = shopRo().operations;
    const fn = STATE.fmNote && STATE.fmNote.d === todayStr() && STATE.fmNote.text && U.noteX !== (STATE.fmNote.at || todayStr()) ? STATE.fmNote : null;
    const empty = n ? (shown ? '' : `<div class="cx-empty">${ic('search', 18)}<b>Nothing matches “${esc(TU.q)}”</b><small>Search finds the RO, customer, truck, year, unit or complaint.</small></div>`)
      : `<div class="cx-empty">${ic('tech', 18)}<b>No repair orders yet</b><small>${esc(PG.person('Foreman') ? PG.first(PG.person('Foreman')) : 'The foreman')} assigns work on the Foreman page — it shows here.</small></div>`;
    return `<section class="tg-list tch-list"><div class="tg-lh">My repair orders<span class="n">${n}</span></div><div class="tg-scroll">${fn ? `<div class="cx-why cx-fmn" style="margin:8px 12px 4px">${ic('chat', 13)}<span><b>From ${esc(PG.first(fn.by || PG.person('Foreman') || 'the foreman'))}:</b> ${esc(fn.text)}</span><button class="btn btn-sm ib tg-gh" data-a="notex" title="Hide for today" style="margin-left:auto;flex:none">${ic('x', 13)}</button></div>` : ''}${G.map(([g, L, k]) => `<div class="tg-grp tch-grp ${k}"><i></i>${esc(g)}<span>${L.length || ''}</span></div>` + (k === 'run' && !L.length ? runEmpty() : L.map(tcItem).join(''))).join('')}${empty}</div>
     <div class="cx-shop"><span>${ic('gear2', 13)}Shop</span>${SH.map(op => { const on = S.rp && S.rp.opId === op.id; const nm = op.complaint.replace(/^Shop /, ''); return `<button class="${on ? 'on' : ''}" data-a="shopt" data-id="${op.id}"${S.out ? ' disabled' : ''} title="${esc(op.complaint)}">${on ? `<i></i>${esc(nm)} <b data-tk="shop">${TK.shop()}</b>` : esc(nm)}</button>`; }).join('')}</div>
     <div class="tg-keys"><span>${kbd('J')}${kbd('K')}move</span><span>${kbd('↵')}start</span><span>${kbd('S')}stop</span><span>${kbd('Ctrl')}${kbd('↵')}done</span><span>${kbd('/')}search</span></div></section>`;
  }
  /* ---------- the RO on the right ---------- */
  function tcStatus(o){
    const s = stOf(o), fm = PG.person('Foreman'), fmF = fm ? PG.first(fm) : 'the foreman';
    return { run: ['wk', 'Working · ' + (o.sr || 'Repairing')], next: ['nx', o.paused ? 'Paused · stays on top of Assigned' : o.back ? 'Back from Waiting' + (o.ord ? ' · #' + o.ord : '') : o.ord ? 'Assigned · #' + o.ord + ' in ' + (fm ? fmF + '’s' : 'the foreman’s') + ' order' : 'Assigned · not started'], wait: ['wt', 'Waiting – ' + (o.hold ? o.hold.k : '')], done: ['dn', 'Complete · ' + o.at] }[s] || ['nx', o.stn || ''];
  }
  function tcBand(r){
    const ro = r.ro, o = r.focus, st = tcStatus(o), nN = (typeof trkNotesOf === 'function' ? trkNotesOf(ro) : []).length;
    let tl = r.truck; try{ const t = trkLabel(ro); if(t && t !== 'this truck') tl = t; }catch(e){}
    const eb = [`<span class="tg-no">${esc(r.no)}</span>`, o.spot ? esc(o.spot) : '', ro.promisedAt ? 'promised ' + esc(PG.whenL(ro.promisedAt)) : ''].filter(Boolean).join('<i>·</i>');
    const who = r.lane === 'wait' && o.hold ? tcAge(r) + (o.hold.who ? `<span class="k">with ${esc(PG.first(o.hold.who))}</span>` : `<span class="k">${esc(o.hold.k)}</span>`) : '';
    return `<div class="tch-band"><div class="tch-bt"><div class="tch-eb">${eb}</div><h2>${esc(r.cust)}</h2><div class="tch-sub">${esc(tl)}${r.unit && r.unit !== '—' ? ' · Unit ' + esc(r.unit) : ''}</div><div class="tch-srow"><span class="cx-st ${st[0]}"><i></i>${esc(st[1])}</span>${who}${stOf(o) === 'run' ? `<span class="tch-clk"><b data-tk="run">${TK.run()}</b><small>Op ${o.opn} · since ${clk(S.rp.start)}</small></span>` : ''}</div></div>
      <div class="tch-bp"><button class="tch-bpic" data-a="ttruck" data-id="${r.id}" title="Truck &amp; photos">${trkThumb(ro)}</button><button class="tch-cam" data-a="ttruck" data-id="${r.id}" title="Truck &amp; photos" aria-label="Truck and photos">${ic('camera', 14)}</button>${nN ? `<button class="tch-nb" data-a="tnotes" data-id="${r.id}">${nN} note${nN === 1 ? '' : 's'} on the truck</button>` : ''}</div></div>`;
  }
  function tcActs(r){
    const o = r.focus, s = stOf(o), fm = PG.person('Foreman'), fmF = fm ? PG.first(fm) : 'the foreman', on = p => U.pop && U.pop.type === p ? ' on' : '';
    let a = '';
    if(s === 'run') a = `<button class="btn btn-primary" data-a="done" title="Done (Ctrl ↵)">${ic('check', 15)}Done</button><button class="btn" data-a="stop" title="Stop (S)">${ic('stop', 15)}Stop</button><button class="btn${on('hold')}" data-a="tdo" data-v="pop" data-p="hold" data-id="${o.id}" title="Put it on hold (H)">${ic('clock', 15)}Hold${ic('chevD', 13)}</button><button class="btn${on('sw')}" data-a="tdo" data-v="pop" data-p="sw" data-id="${o.id}">${ic('swap', 15)}Switch${ic('chevD', 13)}</button><button class="btn${on('ask')}" data-a="tdo" data-v="pop" data-p="ask" data-id="${o.id}" title="Ask ${esc(fmF)} — your clock keeps running">${ic('chat', 15)}Ask ${esc(fmF)}</button>`;
    else if(s === 'next'){ const yard = !bayLike(o.spot) && !o.ro.cxBring; a = `<button class="btn btn-primary" data-a="startid" data-id="${o.id}"${S.out ? ' disabled' : ''} title="Start (Enter)">${ic('play', 15)}${o.paused ? 'Resume' : S.rp ? 'Switch to this' : 'Start'}${r.ops.length > 1 ? ' Op ' + o.opn : ''}</button>${yard ? `<button class="btn${U.hl === 'bring' ? ' hl' : ''}" data-a="tdo" data-v="bring" data-id="${o.id}" title="Ask Triage to bring it to a bay">${ic('triage', 15)}Bring it in</button>` : ''}<button class="btn${on('hold')}" data-a="tdo" data-v="pop" data-p="hold" data-id="${o.id}">${ic('clock', 15)}Hold${ic('chevD', 13)}</button><button class="btn${on('part')}" data-a="tdo" data-v="pop" data-p="part" data-id="${o.id}">${ic('parts', 15)}Ask Parts</button>`; }
    else if(s === 'wait') a = `${o.hold.who ? `<button class="btn" data-a="tdo" data-v="askholder" data-id="${o.id}" title="It goes to ${esc(PG.first(o.hold.who))}’s Inbox">${ic('chat', 15)}Ask ${esc(PG.first(o.hold.who))}</button>` : ''}<button class="btn" data-a="startid" data-id="${o.id}"${S.out ? ' disabled' : ''}>${ic('play', 15)}Start anyway</button><button class="btn${on('part')}" data-a="tdo" data-v="pop" data-p="part" data-id="${o.id}">${ic('parts', 15)}Ask Parts</button>`;
    else a = `<button class="btn" data-a="tdo" data-v="reopen" data-id="${o.id}">${ic('undo', 15)}Reopen</button>`;
    return `<div class="tch-acts">${a}<span class="sp"></span><button class="btn tg-gh" data-a="openro" data-ro="${r.id}">${ic('ros', 14)}Open RO</button></div>`;
  }
  function tcStages(ro){
    let M = null; try{ M = roStages(ro); }catch(e){}
    const L = M && M.list ? M.list : TSTG.map(n => ({ name: n, state: 't' }));
    return `<div class="tch-stg">${L.map(x => { const c = x.state === 'd' ? 'd' : x.state === 'x' ? 'x' : x.state === 'w' ? 'n w' : x.state === 'c' || x.state === 'n' ? 'n' : ''; return `<span class="${c}" title="${esc((x.name || '') + (x.sub ? ' — ' + x.sub : x.state === 'x' ? ' — not needed' : ''))}"><i></i>${esc(x.name || '')}</span>`; }).join('')}</div>`;
  }
  /* an operation that isn't on your list any more (finished before today, declined, another tech's): shown, not worked */
  function tcOther(ro, op, i){
    const st0 = opStatus(op), stn = typeof st0 === 'string' ? st0 : st0.status;
    return { id: op.id, roId: ro.id, ro, op, opn: i + 1, no: tgNum(ro), cust: ro.customerName || '—', t: opJobType(op), cmp: op.complaint || 'Operation', q: +op.quoted || 0, b0: opCalc(op).burntHrs, st: 'other', stn: op.declined ? 'Declined' : stn, parts: opRealParts(op), notes: notesOf(op), other: true };
  }
  const PSs = p => { const k = p.status || 'Not Ordered'; return { 'Not Ordered': ['wt', 'Not ordered'], 'Ordered': ['wt', 'Ordered' + (p.eta ? ' · due ' + PG.day(p.eta + 'T12:00:00') : '')], 'Backordered': ['bo', 'Backordered' + (p.eta ? ' · ' + PG.day(p.eta + 'T12:00:00') : '')], 'Received': ['in', 'Received'], 'Staged': ['st', 'Staged at the counter'], 'Picked up': ['ok', 'Picked up'], 'Installed': ['ok', 'Installed'], 'Returned': ['in', 'Returned'] }[k] || ['in', k]; };
  function tcPunches(o){
    const ps = opPunches(o.id);
    if(!ps.length) return '<div class="mg-none tch-none">No time on it yet.</div>';
    return ps.map(p => { const st = new Date(p.start).getTime(), live = !p.stop, ms = (p.stop ? new Date(p.stop).getTime() : Date.now()) - st, who = punchWho(p);
      const why = [p.startReason, live ? 'on the clock' : p.stopReason].filter(Boolean).join(' → ');
      return `<div class="tch-pu${live ? ' live' : ''}"><span class="t"><span class="d">${PG.isToday(st) ? 'Today' : esc(PG.day(st))}</span>${clk(st)} – ${live ? 'now' : clk(p.stop)}</span><b class="mono"${live ? ` data-tk="tm" data-since="${st}"` : ''}>${dur(ms / 60000)}</b><span class="w">${who && !PG.isMe(who) ? esc(PG.first(who)) + ' · ' : ''}${esc(why)}</span></div>`; }).join('');
  }
  function tcOp(o, r){
    const s = o.other ? 'other' : stOf(o), open = TU.open[o.id] !== undefined ? TU.open[o.id] : o.id === r.focus.id, b = burnt(o), ov = b > o.q + .005, mine = !o.other, foc = o.id === r.focus.id;
    const pill = s === 'run' ? ['wk', 'Working'] : s === 'next' ? ['nx', o.paused ? 'Paused ' + o.paused : 'Up next'] : s === 'wait' ? ['wt', o.hold.k] : s === 'done' ? ['dn', 'Done ' + o.at] : [/^Complete/.test(o.stn) ? 'dn' : 'nx', o.stn || '—'];
    const clkB = !mine || s === 'done' ? (s === 'done' || /^Complete/.test(o.stn) ? `<span class="tch-okc">${ic('check', 13)}</span>` : '<span></span>')
      : s === 'run' ? `<button class="tch-ib on" data-a="stop" title="Stop the clock (S)">${ic('stop', 14)}</button>` : `<button class="tch-ib" data-a="startid" data-id="${o.id}"${S.out ? ' disabled' : ''} title="${o.paused ? 'Resume' : 'Start the clock on this operation'}">${ic('play', 14)}</button>`;
    const head = `<div class="tch-oh"><button class="tch-ot" data-a="topen" data-id="${o.id}" aria-expanded="${open}"><span class="tch-chev">${ic('chevR', 13)}</span><span class="cr-ty ${ty(o)[1]}">${ty(o)[0]}</span><span class="tch-oc"><b>${esc(o.cmp)}</b><small>Op ${o.opn} · <span class="tch-op ${pill[0]}">${esc(pill[1])}</span>${o.parts.length ? ' · ' + o.parts.length + ' part' + (o.parts.length === 1 ? '' : 's') : ''}${o.notes.length ? ' · ' + o.notes.length + ' note' + (o.notes.length === 1 ? '' : 's') : ''}</small></span><span class="tch-hb${ov ? ' over' : ''}"><span class="bar"><i style="width:${Math.min(100, o.q ? b / o.q * 100 : 0).toFixed(0)}%"></i></span><span class="mono"${s === 'run' ? ' data-tk="runh"' : ''}>${h1(b)} / ${h1(o.q)} h</span></span></button>${clkB}</div>`;
    if(!open) return `<div class="tch-o ${s}${foc ? ' foc' : ''}">${head}</div>`;
    const fx = mine && o.fix && s !== 'done' ? `<div class="tch-fix${o.fixUsed ? ' used' : ''}"><span class="gi">${ic('fixes', 14)}</span><span class="n"><b>${o.fixUsed ? 'Past fix in use' : 'A past fix matches'} — ${esc(o.fix.t)}</b><small>Fixed ${o.fix.n}× before${o.fix.by && o.fix.by !== '—' ? ' · last by ' + esc(o.fix.by) : ''}${o.fix.avg ? ' · about ' + h1(o.fix.avg) + ' h' : ''}</small></span>${o.fixUsed ? `<span class="ib-k auto">${ic('check', 11)}In your notes</span>` : `<button class="btn btn-sm" data-a="tdo" data-v="viewfix" data-id="${o.id}">View</button><button class="btn btn-sm btn-primary" data-a="tdo" data-v="usefix" data-id="${o.id}">Use fix</button>`}</div>` : '';
    const acts = !mine ? '' : s === 'run' ? `<button class="btn btn-sm" data-a="stop">${ic('stop', 13)}Stop</button><button class="btn btn-sm" data-a="tdo" data-v="pop" data-p="hold" data-id="${o.id}">${ic('clock', 13)}Hold${ic('chevD', 12)}</button><button class="btn btn-sm btn-primary" data-a="done">${ic('check', 13)}Done</button>`
      : s === 'done' ? `<button class="btn btn-sm" data-a="tdo" data-v="reopen" data-id="${o.id}">${ic('undo', 13)}Reopen</button>`
      : `<button class="btn btn-sm btn-primary" data-a="startid" data-id="${o.id}"${S.out ? ' disabled' : ''}>${ic('play', 13)}${o.paused ? 'Resume' : s === 'wait' ? 'Start anyway' : 'Start'}</button>${s === 'next' ? `<button class="btn btn-sm" data-a="tdo" data-v="pop" data-p="hold" data-id="${o.id}">${ic('clock', 13)}Hold${ic('chevD', 12)}</button>` : ''}`;
    const notes = `<div class="tch-sec"><div class="tch-sh"><b>Notes</b><small>${mine && s !== 'done' ? 'Enter adds the time' : o.notes.length ? o.notes.length + '' : ''}</small></div>${o.notes.map(n => `<div class="tch-nl"><small>${esc(n[0])}</small><span>${esc(n[1])}</span></div>`).join('') || '<div class="mg-none tch-none">Nothing written yet.</div>'}${mine && s !== 'done' ? `<label class="tch-box tch-in">${ic('pencil', 13)}<input data-in="tnote" data-id="${o.id}" value="${esc(TU.dr[o.id] || '')}" placeholder="What you found, what you did…"></label>` : ''}</div>`;
    const time = `<div class="tch-sec"><div class="tch-sh"><b>Time</b><small>${opPunches(o.id).length} punch${opPunches(o.id).length === 1 ? '' : 'es'}</small></div>${effBar(o)}<div class="tch-pus">${tcPunches(o)}</div></div>`;
    const parts = `<div class="tch-sec"><div class="tch-sh"><b>Parts</b><small>${o.parts.length || 'none yet'}</small></div>${o.parts.map(p => { const k = PSs(p); return `<div class="cx-pr"><span class="n"><b>${esc(p.description || p.partNumber)}</b><small>${p.partNumber ? esc(p.partNumber) + ' · ' : ''}qty ${esc(p.qty || 1)}</small></span><span class="cx-ps ${k[0]}"><i></i>${esc(k[1])}</span>${mine && p.status === 'Staged' ? `<button class="btn btn-sm" data-a="tpick" data-id="${o.id}" data-pt="${p.id}">Picked up</button>` : ''}</div>`; }).join('') || '<div class="mg-none tch-none">No parts on this one.</div>'}${mine && s !== 'done' ? `<button class="cr-add" data-a="tdo" data-v="pop" data-p="part" data-id="${o.id}">${ic('plus', 13)}Ask Parts for a part</button>` : ''}</div>`;
    return `<div class="tch-o ${s} open${foc ? ' foc' : ''}">${head}<div class="tch-ob">${fx}${notes}<div class="tch-two">${time}${parts}</div>${acts ? `<div class="tch-oa">${acts}</div>` : ''}</div></div>`;
  }
  function tcOps(r){
    const live = (r.ro.operations || []).map((op, i) => r.ops.find(x => x.id === op.id) || (op && op.id ? tcOther(r.ro, op, i) : null)).filter(Boolean);
    const q = sum(live, o => o.q), b = sum(live, o => burnt(o)), allOpen = live.every(o => TU.open[o.id] !== undefined ? TU.open[o.id] : o.id === r.focus.id);
    return `<div class="mg-card tch-ops"><div class="mg-ch"><b>Operations</b><small>${live.length} · ${h1(b)} of ${h1(q)} h</small><span class="sp"></span><button class="btn btn-sm tg-gh" data-a="tall" data-v="${allOpen ? 0 : 1}">${allOpen ? 'Fold all' : 'Open all'}</button></div><div class="tch-ol">${live.map(o => tcOp(o, r)).join('')}</div></div>`;
  }
  function tcPane(r){
    if(!r) return `<div class="tg-blank"><div class="tg-empty"><span class="tg-ring0">${ic('tech', 22)}</span><h3>No repair orders yet</h3><p>${esc(PG.person('Foreman') ? PG.first(PG.person('Foreman')) + '’s' : 'The foreman’s')} order for today shows here.</p></div></div>`;
    const o = r.focus, s = stOf(o), fm = PG.person('Foreman'), fmF = fm ? PG.first(fm) : 'the foreman';
    const nextUp = U.justDone && r.ops.some(x => x.id === U.justDone) ? (() => { const n = nextOps()[0]; return n ? `<div class="cx-nextup">${ic('spark', 14)}<span>Next${n.paused ? ' — paused' : ' in ' + (fm ? fmF + '’s' : 'the foreman’s') + ' order'}: <span class="tg-no">${esc(n.no)}</span> <b>${esc(n.cmp)}</b> · ${h1(n.q)} h</span><button class="btn btn-sm btn-primary" data-a="startid" data-id="${n.id}">${ic('play', 13)}Start it</button></div>` : ''; })() : '';
    const wbox = s === 'wait' && o.hold ? `<div class="tch-wbox"><b>Waiting – ${esc(o.hold.k)}</b><span>${esc(o.hold.txt || '')}${o.hold.left ? ' · ' + esc(o.hold.left) : ''}</span></div>` : '';
    const why = o.why && s === 'next' ? `<div class="cx-why">${ic('info', 13)}<span>${esc(o.why)}</span></div>` : '';
    return `<div class="mg-pane tch-pane" data-ro="${r.id}"><div class="tch-pin">${tcBand(r)}${tcActs(r)}${nudge()}${nextUp}${wbox}${why}${tcStages(r.ro)}${tcOps(r)}${photoCard(o, s === 'other' ? 'done' : s)}${dayCard(dayStats())}</div></div>`;
  }
  function tcHead(){
    const D = dayStats(), n = nChk(), M = S.M, w = M.name;
    const f = `<span class="tg-hf" style="cursor:default">${PG.av(w)}${esc(w)}</span><i>·</i>${S.morning ? `<span class="tg-hf" style="cursor:default"><span class="cx-dot off"></span>Not clocked in yet</span>` : S.out ? `<span class="tg-hf" style="cursor:default"><span class="cx-dot off"></span>Clocked out${S.out.at ? ' · ' + esc(String(S.out.why).toLowerCase()) + ' since ' + clk(S.out.at) : ''}</span>` : `<span class="tg-hf" style="cursor:default"><span class="cx-dot"></span><b data-tk="cl">${dur(D.cl)}</b>on the clock</span>`}${S.morning ? '' : `<i>·</i><span class="tg-hf" style="cursor:default"><b>${D.eff == null ? '—' : Math.round(D.eff) + '%'}</b>efficiency today</span>`}${n ? `<i>·</i><button class="tg-hf w${U.pop && U.pop.type === 'chk' ? ' on' : ''}" data-a="pop" data-p="chk"><b>${n}</b>to fix in the Time Log</button>` : ''}`;
    const find = S.morning ? '' : `<label class="tch-find tch-box">${ic('search', 14)}<input data-in="tq" value="${esc(TU.q)}" placeholder="RO, customer, truck, year…" autocomplete="off" aria-label="Search my repair orders"></label>`;
    const scan = S.morning || S.out ? '' : `<button class="btn btn-sm${U.pop && U.pop.type === 'scan' ? ' on' : ''}" data-a="pop" data-p="scan" style="height:30px" title="Scan a job jacket to switch">${ic('qr', 14)}Scan</button>`;
    const ck = S.morning ? `<button class="btn btn-sm btn-primary" data-a="morning" style="height:30px">${ic('play', 14)}Start my day</button>` : S.out ? `<button class="btn btn-sm btn-primary" data-a="cin" style="height:30px">${ic('play', 14)}Clock in</button>` : `<button class="btn btn-sm${U.pop && U.pop.type === 'out' ? ' on' : ''}" data-a="pop" data-p="out" style="height:30px">${ic('clock', 14)}Clock out${ic('chevD', 13)}</button>`;
    return `<header class="tg-head"><h1 class="tg-h1">Technician</h1><span class="tg-facts">${f}</span>${find}${scan}${ck}</header>`;
  }
  function viewTech(){
    const me0 = PG.me().name; if(U._me !== me0){ U._me = me0; U.view = 'today'; U.sel = null; U.pop = null; U.eod = false; U.tv = false; TU.ro = null; TU.open = {}; TU.q = ''; }
    build();
    if(S.lead) return `<div class="tg mg cr cx tch" data-pg="tech"><header class="tg-head"><h1 class="tg-h1">Technician</h1></header><div class="tg-body"><div class="tg-main"><div class="tg-blank"><div class="tg-empty"><span class="tg-ring0">${ic('tech', 22)}</span><h3>For technicians</h3><p>This page shows a technician’s own repair orders. Sign in as a technician to see theirs.</p></div></div></div></div></div>`;
    const all = tcRos(), G = tcGroups(all), L = G.flatMap(g => g[1]);
    if(!TU.ro || !all.some(r => r.id === TU.ro)){ const run = all.find(r => r.lane === 'run'); TU.ro = (run || L[0] || all[0] || {}).id || null; }
    const r = all.find(x => x.id === TU.ro) || null;
    /* Console's handlers work on U.sel — it follows the RO's operation that's up now, unless you picked another one in it */
    if(r && (U.selRo !== r.id || !U.pop || !r.ops.some(o => o.id === U.sel))){ U.selRo = r.id; U.sel = r.focus.id; }
    const body = S.morning ? `<div class="tg-main">${morningCard()}</div>` : tcList(G, all) + `<div class="tg-main">${tcPane(r)}</div>`;
    return `<div class="tg mg cr cx tch" data-pg="tech">${tcHead()}<div class="tg-body">${body}${pop()}${U.eod ? eodSheet() : ''}</div>${filePick()}</div>`;
  }
  /* ---------- doing things on the Technician page: Console's handlers, aimed at the operation you clicked ---------- */
  const tcSelOp = id => { if(id && opBy(id)){ U.sel = id; const o = opBy(id); U.selRo = o.roId; } };
  const HT = {
    tsel: t => { TU.ro = t.dataset.id; TU.kb = false; U.pop = null; U.selRo = null; PG.keepScroll(render); const p = document.querySelector('[data-pg="tech"] .mq-pane'); if(p) p.scrollTop = 0; },
    topen: t => { const id = t.dataset.id, r = tcRos().find(x => x.id === TU.ro), cur = TU.open[id] !== undefined ? TU.open[id] : !!(r && r.focus.id === id); TU.open[id] = !cur; PG.keepScroll(render); },
    tall: t => { const r = tcRos().find(x => x.id === TU.ro); if(!r) return; const v = t.dataset.v === '1'; (r.ro.operations || []).forEach(op => { if(op && op.id) TU.open[op.id] = v; }); PG.keepScroll(render); },
    tdo: (t, ev) => { tcSelOp(t.dataset.id); const f = H[t.dataset.v]; if(f) f(t, ev); },
    tpick: t => { const o = opBy(t.dataset.id), p = o && o.parts.find(x => x.id === t.dataset.pt); if(!p) return; PG.act('picked up', `Picked up — ${p.description || p.partNumber}.`, () => { p.status = 'Picked up'; p.statusChangedAt = nowIso(); p.pickedBy = S.me; }); note(PG.person('Parts'), 'fyi', o, `${PG.first(S.me)} picked up the parts for ${o.no}`, `${p.description || p.partNumber}${p.partNumber ? ' · ' + p.partNumber : ''}`); },
    ttruck: t => { const ro = getRO(t.dataset.id); if(ro && typeof trkDlgOpen === 'function') trkDlgOpen(ro, t); },
    tnotes: t => { const ro = getRO(t.dataset.id); if(ro && typeof trkInspOpen === 'function') trkInspOpen(ro); }
  };
  function tcInput(t){ if(t.dataset.in === 'tq'){ TU.q = t.value; PG.keepScroll(render); return true; } if(t.dataset.in === 'tnote'){ TU.dr[t.dataset.id] = t.value; return true; } return false; }
  function tcField(t, ev){
    if(t.dataset.in === 'tnote' && ev.key === 'Enter' && t.value.trim()){ ev.preventDefault(); const id = t.dataset.id, o = opBy(id); if(!o) return true; pushUndo('note'); addNote(o, t.value); TU.dr[id] = ''; scheduleSave(true); PG.keepScroll(render); const i = document.querySelector('[data-pg="tech"] [data-in="tnote"][data-id="' + id + '"]'); if(i){ i.value = ''; i.focus(); } return true; }
    if(t.dataset.in === 'tq' && (ev.key === 'Escape' || ev.key === 'Enter')){ ev.preventDefault(); if(ev.key === 'Escape'){ TU.q = ''; t.value = ''; PG.keepScroll(render); } t.blur(); return true; }
    return false;
  }
  function tcKeydown(ev){
    const k = ev.key; if(!S) return;
    const stop = () => { ev.preventDefault(); ev.stopPropagation(); ev.stopImmediatePropagation(); };
    if((ev.ctrlKey || ev.metaKey) && k === 'Enter' && !PG.typing(ev) && S.rp && !S.shop){ H.done(); return stop(); }
    if(ev.ctrlKey || ev.metaKey || ev.altKey || PG.typing(ev)) return;
    if(U.pop){ if(k === 'Escape'){ U.pop = null; camStop(); PG.keepScroll(render); return stop(); } return; }
    if(k === 'Escape' && U.eod){ U.eod = false; PG.keepScroll(render); return stop(); }
    if(U.eod || S.morning || S.lead) return;
    if(k === '/'){ const f = document.querySelector('[data-pg="tech"] [data-in="tq"]'); if(f){ f.focus(); f.select(); } return stop(); }
    if(k === 'j' || k === 'k' || k === 'ArrowDown' || k === 'ArrowUp'){ const L = tcFlat(), i = L.findIndex(x => x.id === TU.ro); const n = L[Math.max(0, Math.min(L.length - 1, i + (k === 'j' || k === 'ArrowDown' ? 1 : -1)))]; if(n){ TU.ro = n.id; TU.kb = true; U.selRo = null; PG.keepScroll(render); PG.kbScroll(); } return stop(); }
    const o = opBy(U.sel);
    if(k === 'Enter'){ if(o && !isRun(o) && o.st !== 'done' && !S.out){ startOp(o); return stop(); } }
    if(k === 's' && S.rp){ H.stop(); return stop(); }
    if(k === 'h' && S.rp && !S.shop){ U.sel = S.rp.opId; U.pop = { type: 'hold' }; PG.keepScroll(render); return stop(); }
    if(k === ' '){ if(S.rp){ H.stop(); return stop(); } if(o && o.st !== 'done' && !S.out){ startOp(o); return stop(); } }
  }
