  /* ---------- popovers ---------- */
  const openBy = id => build().O.find(o => o.opId === id) || null;
  function pop(){
    const p = U.pop; if(!p) return '';
    const hd = (t, sub) => `<div class="tg-ph"><b>${t}</b>${sub ? `<span class="cu">${sub}</span>` : ''}<button class="btn btn-sm ib" data-a="popx">${ic('x', 14)}</button></div>`;
    if(p.type === 'use'){ const o = openBy(p.op); if(!o) return ''; const g = grp(o.k), s = stats(o.k), same = s.E.filter(e => e.eng === o.eng && e.h > 0), avgS = same.length ? same.reduce((a, e) => a + e.h, 0) / same.length : s.hrs;
      const Q = [[Math.round(s.q * 10) / 10, 'The usual quote', `the usual on ${s.n} job${s.n === 1 ? '' : 's'}`], [Math.round(avgS * 10) / 10, `What it took on a ${o.eng}`, `average clocked, ${same.length} job${same.length === 1 ? '' : 's'}`], [null, 'Type it', 'your own number']];
      const sel = p.parts || (p.parts = Object.fromEntries(s.parts.filter(x => x.n / s.n >= 0.5).map(x => [x.p[0] || x.p[1], true])));
      const qv = p.o === 2 ? parseFloat(p.qt) || 0 : p.o != null ? Q[p.o][0] : 0, pc = s.parts.filter(x => sel[x.p[0] || x.p[1]]).reduce((a, x) => a + x.p[2] * x.p[3], 0);
      return `<div class="tg-pop xf fx-pop-w">${hd('Use this fix', `${esc(o.no)} · ${esc(o.cust)}`)}<div class="fx-ctx"><b>${esc(g.t)}</b><br>${esc(o.truck)} · ${esc(o.eng)}${o.miles ? ' · ' + o.miles.toLocaleString() + ' mi' : ''}${o.tech ? ' · ' + esc(F(o.tech)) + ' has it' : ''}${o.q ? `<br>Now: ${h1(o.q)} h quoted · ${o.parts.length} part${o.parts.length === 1 ? '' : 's'}` : ''}</div>
        <span class="tg-lbl top">Quote</span>${Q.map((q, i) => `<button class="tg-chip${p.o === i ? ' on' : ''}" data-a="oset" data-o="${i}" style="margin:0 4px 4px 0"${q[0] === 0 ? ' disabled' : ''}>${kbd(i + 1)}${q[0] != null ? h1(q[0]) + ' h · ' : ''}${q[1]}</button>`).join('')}
        ${p.o === 2 ? `<label class="fx-f" style="margin-top:4px"><span>Hours</span><input data-in="qt" value="${esc(p.qt || '')}" placeholder="1.2"></label>` : ''}
        <span class="tg-lbl top" style="margin-top:8px">Parts</span>${s.parts.length ? s.parts.slice(0, 8).map(x => { const key = x.p[0] || x.p[1], oh = onHand(x.p[0]); return `<label class="fx-ln" data-a="pck" data-pn="${esc(key)}"><input type="checkbox" ${sel[key] ? 'checked' : ''} tabindex="-1"><span class="d"><b>${esc(x.p[1])}${x.p[0] ? ` · <span style="font-family:var(--tg-mono);font-weight:500">${esc(x.p[0])}</span>` : ''}</b><small>used on ${x.n} of ${s.n} · ${oh ? oh + ' on hand' : 'none on hand'}</small></span><span class="r"><b>${usd(x.p[3])}</b>× ${x.p[2]}</span></label>`; }).join('') : '<div class="fx-none" style="padding:4px 0">Labor only.</div>'}
        ${tipOf(o.k) ? `<div class="fx-src">${ic('bulb', 14)}<span>${esc(tipOf(o.k))}</span></div>` : ''}
        <label class="fx-ck"><input type="checkbox" data-in="tel" data-ch="1" ${p.tell !== false ? 'checked' : ''}>Show the usual cause and fix on ${esc(F(o.tech))}’s Console</label>
        <label class="fx-ck"><input type="checkbox" data-in="tpa" data-ch="1" ${p.toParts !== false ? 'checked' : ''}>${techSame(ME().name, o.wr) || !o.wr ? 'Send the parts to Parts' : 'Send the parts to Parts — it asks ' + esc(F(o.wr)) + ' first'}</label>
        <div class="fx-nb">${ic('info', 12)}Nothing on ${esc(o.no)} changes until you press Use fix.</div><div class="tg-acts"><span class="hint">${qv ? h1(qv) + ' h · ' + usd0(qv * RATE()) + ' labor' : 'pick a quote'}${pc ? ' · ' + usd(pc) + ' parts' : ''}</span><button class="btn btn-sm btn-primary" data-a="ugo"${p.o == null || (p.o === 2 && !(parseFloat(p.qt) > 0)) ? ' disabled' : ''}>Use fix${kbd('↵')}</button></div></div>`; }
    if(p.type === 'write'){ const r = revItems().find(x => x.id === p.id); if(!r) return ''; const s = stats(r.k);
      return `<div class="tg-pop xf fx-pop-x">${hd(r.gap === 'code' ? 'Add the fault code' : 'Write it up', `${esc(r.ro)} · ${esc(r.cust)}`)}<div class="fx-ctx"><b>${esc(r.cmp)}</b> · ${esc(r.tech || '—')}</div>
        ${r.note ? `<div class="fx-src">${PG.av(r.tech || '?')}<span><i>From ${esc(F(r.tech))}’s punch notes</i><br>“${esc(r.note)}”</span><button class="btn btn-sm" data-a="usenote">Use it</button></div>` : ''}
        <label class="fx-f"><span>Cause</span><textarea data-in="c" rows="2" placeholder="What was found">${esc(p.c != null ? p.c : r.cause)}</textarea></label>
        <label class="fx-f"><span>Correction</span><textarea data-in="x" rows="2" placeholder="What fixed it">${esc(p.x != null ? p.x : r.fix)}</textarea></label>
        <label class="fx-f"><span>Fault code</span><input data-in="cd" value="${esc(p.cd != null ? p.cd : '')}" placeholder="${s.codes.length ? esc(s.codes[0][0]) + ' — the usual one' : 'none'}"></label>
        <div class="tg-acts"><span class="hint">It saves on the RO · “${esc(grp(r.k).t)}” · ${ents(r.k).length}×</span><button class="btn btn-sm btn-primary" data-a="wgo">Save${kbd('↵')}</button></div></div>`; }
    if(p.type === 'merge'){ const r = revItems().find(x => x.id === p.id); if(!r) return ''; const Cs = [r.dup].concat(build().G.filter(g => g.k !== r.k && g.k !== r.dup && g.sys === (grp(r.k) || {}).sys).map(g => g.k)).filter(Boolean).slice(0, 3);
      return `<div class="tg-pop xf fx-pop-w">${hd('Merge into…', esc(r.ro))}<div class="fx-ctx">“<b>${esc(r.cmp)}</b>” — the same job, worded differently. Merged, it counts with the others and shows up when someone searches either way.</div>
        ${Cs.map((k, i) => `<button class="tg-mi${(p.k || Cs[0]) === k ? ' on' : ''}" data-a="mset" data-k="${esc(k)}" style="height:auto;min-height:38px;padding:6px 10px !important">${kbd(i + 1)}<span style="flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(grp(k).t)}</span><span class="meta">${ents(k).length}×</span></button>`).join('')}
        <div class="tg-acts"><button class="btn btn-sm btn-primary" data-a="mgo">Merge${kbd('↵')}</button></div></div>`; }
    if(p.type === 'add'){ const d = p.d || (p.d = { cmp: p.k ? grp(p.k).t : '', c: '', x: '', eng: '', cd: '', pn: '' }); const q = d.cmp.trim().toLowerCase(); const m = q && !build().G.some(g => g.t.toLowerCase() === q) ? build().G.filter(g => q.split(/\s+/).filter(w => w.length > 3).some(w => g.t.toLowerCase().includes(w))).slice(0, 2) : [];
      return `<div class="tg-pop xf fx-pop-x">${hd('Add a fix by hand', 'work done before Parsec')}
        <label class="fx-f" style="margin-top:0"><span>Complaint</span><input data-in="acmp" value="${esc(d.cmp)}" placeholder="e.g. Coolant leak at water pump" autocomplete="off"></label>
        ${m.length ? `<div class="fx-hint">${ic('merge', 13)}Same as ${m.map(g => `<button class="tg-chip" data-a="apick" data-k="${esc(g.k)}" style="height:22px">${esc(g.t)} · ${ents(g.k).length}×</button>`).join(' ')}?</div>` : ''}
        <div class="fx-two"><label class="fx-f"><span>Cause</span><textarea data-in="ac" rows="3" placeholder="What was found">${esc(d.c)}</textarea></label><label class="fx-f"><span>Correction</span><textarea data-in="ax" rows="3" placeholder="What fixed it">${esc(d.x)}</textarea></label></div>
        <div class="fx-three"><label class="fx-f"><span>Engine</span><input data-in="aeng" value="${esc(d.eng)}" placeholder="D13"></label><label class="fx-f"><span>Fault code</span><input data-in="acd" value="${esc(d.cd)}" placeholder="SPN 641 FMI 7"></label><label class="fx-f"><span>Truck · year model</span><input data-in="apn" value="${esc(d.pn)}" placeholder="2019 VNL 760"></label></div>
        <div class="tg-acts"><span class="hint">${role() === 'tech' ? 'It goes to Review first' : 'Finished operations land here by themselves'}</span><button class="btn btn-sm btn-primary" data-a="ago">Save fix${kbd('↵')}</button></div></div>`; }
    if(p.type === 'cons'){ const k = p.k, g = grp(k), s = stats(k), O = opensOf(k), o = O.find(pend) || O[0], tab = p.tab || 'start', std = STD()[k], S_ = stepsOf(k);
      return `<div class="tg-pop xf fx-pop-w">${hd('What the tech sees', `${o ? esc(o.tech || '—') + ' · RO ' + esc(o.no) : 'on the Console and the phone app'}`)}<div class="fx-tabs tg-seg3"><button class="${tab === 'start' ? 'on' : ''}" data-a="ctab" data-v="start">When the clock starts</button><button class="${tab === 'stop' ? 'on' : ''}" data-a="ctab" data-v="stop">When it stops</button></div>
        <div class="fx-con"><div class="bar"><span class="dot"></span>Console${o ? ' · ' + esc(F(o.tech)) : ''}<span class="sp"></span>${o ? 'RO ' + esc(o.no) : ''}</div>${tab === 'start' ? `<div class="t">${esc(g.t)}</div><div class="chips"><span>Fixed ${s.n}× before</span>${s.hrs ? `<span>usually ${h1(s.hrs)} h</span>` : ''}${std ? '<span class="std">shop standard</span>' : ''}</div>
          ${S_ ? `<div class="sec">Check first</div>${S_.map((x, i) => `<div class="st"><span>${i + 1}</span>${esc(x[0])}</div>`).join('')}` : ''}
          <div class="sec">The usual fix</div><p>${esc((s.causes[0] || ['—'])[0])} → ${esc(std ? std.fix : (s.fixes[0] || ['—'])[0])}</p>${std && std.note ? `<p class="nt">${esc(std.note)}</p>` : ''}
          ${s.parts.length ? `<div class="sec">Parts</div>${s.parts.slice(0, 3).map(x => `<p>${esc(x.p[1])}${x.p[0] ? ' · ' + esc(x.p[0]) : ''}</p>`).join('')}` : ''}<div class="go"><span class="b">Got it</span></div>`
        : `<div class="t">Did the usual fix work?</div><p>${esc(std ? std.fix : (s.fixes[0] || ['—'])[0])}</p><div class="ans"><button data-a="cans" data-v="Yes — fixed">Yes — fixed</button><button data-a="cans" data-v="Not sure yet">Not sure yet</button><button data-a="cans" data-v="No — something else">No — something else</button></div><p class="nt">The answer counts toward Held. “Something else” asks for the cause.</p>`}</div>
        <div class="fx-nb">${ic('info', 12)}Shows when ${o ? esc(F(o.tech)) : 'the tech'} opens this job on the Console.</div></div>`; }
    if(p.type === 'std'){ const k = p.k, s = stats(k), cur = STD()[k]; if(!s.fixes.length) return '';
      return `<div class="tg-pop xf fx-pop-w">${hd('Make it the shop standard', esc(grp(k).t))}<div class="fx-ctx">The standard shows first — here, on the Console, and when someone presses Use fix. Foreman, lead tech or manager.</div>
        <span class="tg-lbl top">Correction</span>${s.fixes.slice(0, 5).map((x, i) => `<button class="tg-mi${(p.f != null ? p.f : (cur ? Math.max(0, s.fixes.findIndex(y => y[0] === cur.fix)) : 0)) === i ? ' on' : ''}" data-a="sfix" data-i="${i}" style="height:auto;min-height:40px;padding:6px 10px !important;white-space:normal;line-height:18px">${kbd(i + 1)}<span style="flex:1">${esc(x[0])}</span><span class="meta">${x[1]} of ${s.n}</span></button>`).join('')}
        <label class="fx-f"><span>Note for the tech</span><input data-in="sn" value="${esc(p.n != null ? p.n : (cur && cur.note) || '')}" placeholder="e.g. Check the connector before you test the actuator"></label>
        <div class="tg-acts">${cur ? '<button class="btn btn-sm tg-gh" data-a="sclr">Remove standard</button>' : ''}<span class="hint">Set by ${esc(F(ME().name))} · ${ROLEL[role()]}</span><button class="btn btn-sm btn-primary" data-a="stdgo">Make standard${kbd('↵')}</button></div></div>`; }
    if(p.type === 'kit'){ const k = p.k, s = stats(k), sel = p.sel || (p.sel = Object.fromEntries(s.parts.filter(x => x.n / s.n >= 0.5).map(x => [x.p[0] || x.p[1], true]))), tot = s.parts.filter(x => sel[x.p[0] || x.p[1]]).reduce((a, x) => a + x.p[2] * x.p[3], 0);
      return `<div class="tg-pop xf fx-pop-w">${hd('Make a kit', esc(grp(k).t))}<label class="fx-f" style="margin-top:0"><span>Kit name</span><input data-in="kn" value="${esc(p.n != null ? p.n : grp(k).t.split(' — ')[0] + ' job')}"></label>
        <span class="tg-lbl top" style="margin-top:8px">Parts</span>${s.parts.slice(0, 10).map(x => { const key = x.p[0] || x.p[1], oh = onHand(x.p[0]); return `<label class="fx-ln" data-a="kpk" data-pn="${esc(key)}"><input type="checkbox" ${sel[key] ? 'checked' : ''} tabindex="-1"><span class="d"><b>${esc(x.p[1])}${x.p[0] ? ` · <span style="font-family:var(--tg-mono);font-weight:500">${esc(x.p[0])}</span>` : ''}</b><small>used on ${x.n} of ${s.n} · ${oh != null ? oh + ' on hand' : '—'}</small></span><span class="r"><b>${usd(x.p[3])}</b>× ${x.p[2]}</span></label>`; }).join('')}
        <div class="tg-acts"><span class="hint">Goes to Parts → Catalog · ${usd(tot)}</span><button class="btn btn-sm btn-primary" data-a="kgo">Make kit${kbd('↵')}</button></div></div>`; }
    if(p.type === 'flt2'){ const all = [].concat(...Object.values(build().E)), engs = [...new Set(all.map(e => e.eng).filter(x => x && x !== '—'))].slice(0, 5), mdl = [...new Set(all.map(e => (String(e.truck).match(/\b(VNL|VNR|VHD|VAH|Anthem|Granite|Pinnacle)\b/) || [])[1]).filter(Boolean))];
      const row = (lbl, f, opts) => opts.length ? `<span class="tg-lbl top">${lbl}</span><div class="tg-r" style="margin-bottom:6px">${opts.map(o => `<button class="tg-chip${U[f] === o[0] ? ' on' : ''}" data-a="fset2" data-f="${f}" data-v="${esc(o[0])}">${esc(o[1])}</button>`).join('')}</div>` : '';
      return `<div class="tg-pop xf fx-pop-w">${hd('Filter the fixes', 'only the jobs that match')}${row('Engine', 'fe', engs.map(x => [x, x]))}${row('Model', 'fmdl', mdl.map(x => [x, x]))}${row('Miles', 'fmi', [['lo', 'Under 300k'], ['mid', '300k–500k'], ['hi', 'Over 500k']])}
        <div class="tg-acts"><button class="btn btn-sm tg-gh" data-a="fclr" data-f="all">Clear</button><span class="hint">${build().G.reduce((s, g) => s + ents(g.k).length, 0)} fixes match</span><button class="btn btn-sm btn-primary" data-a="popx">Done${kbd('↵')}</button></div></div>`; }
    if(p.type === 'srch'){ const q = (p.q || '').trim().toLowerCase(), R = [];
      if(q){ const W = q.split(/\s+/); build().G.forEach(g => { const E = build().E[g.k] || []; const hit = [];
        const look = (lbl, s) => { if(s && W.every(w => String(s).toLowerCase().includes(w))) hit.push([lbl, String(s)]); };
        look('Complaint', g.t); E.forEach(e => { look('Cause', e.cause); look('Correction', e.fix); e.codes.forEach(c => look('Code', c)); e.parts.forEach(pp => look('Part', pp[0] + ' ' + pp[1])); look('VIN', e.vinF); look('RO', e.ro); });
        if(hit.length) R.push({ g, h: hit[0], n: hit.length }); }); }
      const mk = (s, q) => { const w = q.split(/\s+/)[0], i = s.toLowerCase().indexOf(w); return i < 0 ? esc(s) : esc(s.slice(0, i)) + '<mark>' + esc(s.slice(i, i + w.length)) + '</mark>' + esc(s.slice(i + w.length)); };
      return `<div class="tg-pop menu fx-pop-w"><div class="fx-srin">${ic('search', 15)}<input data-in="sq" placeholder="Complaint, cause, SPN code, part # or VIN" value="${esc(p.q || '')}" autocomplete="off"></div>${q ? (R.length ? R.slice(0, 7).map((x, i) => `<button class="fx-srr${i === 0 ? ' k' : ''}" data-a="sel" data-k="${esc(x.g.k)}" data-go="1"><span class="gi">${ic(SYS[x.g.sys][1], 14)}</span><b>${esc(x.g.t)}</b><span class="m">${(build().E[x.g.k] || []).length}×</span><small>${x.h[0]}: ${mk(x.h[1], q)}</small></button>`).join('') : `<div class="fx-none">Nothing matches “${esc(p.q)}”. Try a part number, a code, or fewer words.</div>`) : '<div class="fx-none">Try an SPN code, a part number, a word like “connector”, or a VIN.</div>'}</div>`; }
    return '';
  }
  /* ---------- doing things ---------- */
  const rd = () => { flush(); PG.keepScroll(render); };
  const save = l => pushUndo(l || 'fixes');
  const fin = msg => { scheduleSave(true); flush(); if(msg) pushToast(msg, true); rd(); };
  function openPop(type, ex, el){ U.pop = Object.assign({ type }, ex || {}); if(el) PG.anchor(U, el); rd(); }
  function revMark(id, o){ REV()[id] = Object.assign(REV()[id] || {}, o, { by: ME().name, byRole: ROLEL[role()], at: nowIso() }); }
  function copyTxt(t){ try{ navigator.clipboard.writeText(t); pushToast('Copied.'); }catch(e){ pushToast('Couldn’t copy here.'); } }
  const H = {
    sel: t => { U.sel = t.dataset.k; U.kb = false; U.pop = null; if(t.dataset.go){ U.view = 'lib'; if(U.flt && !opensOf(U.sel).length) U.flt = false; } rd(); },
    view: t => { U.view = t.dataset.v; U.pop = null; rd(); },
    sort: t => { U.sort = t.dataset.v; rd(); },
    grp: t => { U.grp = t.dataset.v; rd(); },
    flt: () => { U.flt = !U.flt; if(U.flt && !opensOf(U.sel).length){ const g = groupsList()[0]; if(g) U.sel = g.k; } rd(); },
    pop: t => { const p = U.pop; if(p && p.type === t.dataset.p && !t.dataset.op && !t.dataset.id){ U.pop = null; return rd(); } const ex = {}; ['op', 'id', 'k', 'i'].forEach(k => { if(t.dataset[k] != null) ex[k] = t.dataset[k]; }); if(t.dataset.p === 'use') ex.tell = true; openPop(t.dataset.p, ex, t);
      if(t.dataset.p === 'srch') setTimeout(() => { const i = document.querySelector('[data-pg="fixes"] [data-in="sq"]'); if(i) i.focus(); }, 20); },
    popx: () => { U.pop = null; rd(); },
    oset: t => { U.pop.o = +t.dataset.o; rd(); if(U.pop.o === 2) setTimeout(() => { const i = document.querySelector('[data-pg="fixes"] [data-in="qt"]'); if(i) i.focus(); }, 20); },
    pck: (t, ev) => { ev.preventDefault(); const p = U.pop; p.parts[t.dataset.pn] = !p.parts[t.dataset.pn]; rd(); },
    ugo: () => { const p = U.pop, o = openBy(p.op); if(!o || p.o == null) return; const s = stats(o.k), same = s.E.filter(e => e.eng === o.eng && e.h > 0);
      const qv = p.o === 2 ? parseFloat(p.qt) : p.o === 0 ? Math.round(s.q * 10) / 10 : Math.round((same.length ? same.reduce((a, e) => a + e.h, 0) / same.length : s.hrs) * 10) / 10; if(!(qv > 0)) return;
      save('use fix'); const op = o.op; op.quoted = qv; op.parts = op.parts || [];
      const have = new Set(opRealParts(op).map(x => invPnKey(x.partNumber) || invDescKey(x.description))), add = s.parts.filter(x => p.parts[x.p[0] || x.p[1]] && !have.has(invPnKey(x.p[0]) || invDescKey(x.p[1])));
      add.forEach(x => op.parts.push({ id: uid('pt'), description: x.p[1], partNumber: x.p[0], qty: String(x.p[2]), price: x.p[3] ? String(x.p[3]) : '', status: 'Not Ordered', statusChangedAt: nowIso() }));
      const src = s.E.find(e => e.fix === ((STD()[o.k] || {}).fix || (s.fixes[0] || [''])[0])) || s.E[0];
      op.fxUse = { ro: src ? src.ro : '', by: ME().name, at: nowIso(), key: o.k }; op.fxQ = op.fxQ || { ro: src ? src.ro : '', at: nowIso() }; op.fxP = op.fxP || { ro: src ? src.ro : '', at: nowIso() };
      if(p.tell !== false) op.fxShow = true;
      let partsMsg = '';
      if(add.length && p.toParts !== false){ if(techSame(ME().name, o.wr) || !o.wr){ try{ rtSend(o.ro, 'parts', '', 'Parts from a past fix', null, {}); }catch(e){} partsMsg = ' (sent to Parts)'; }
        else if(typeof IB !== 'undefined'){ IB.send({ to: o.wr, k: 'ask', src: 'fixes', ro: o.roId, op: o.opId, t: `Send the parts on ${o.no} to Parts?`, b: `${F(ME().name)} used a past fix — ${add.length} part${add.length > 1 ? 's' : ''} added: ${add.map(x => x.p[1]).join(', ')}.`, acts: [['Open in Triage', 'page'], ['Open RO', 'open']] }); partsMsg = ` (${F(o.wr)} is asked)`; } }
      U.pop = null; fin(`Used on ${o.no} — ${h1(qv)} h quoted${add.length ? `, ${add.length} part${add.length > 1 ? 's' : ''} on the RO${partsMsg}` : ''}${p.tell !== false && o.tech ? `. ${F(o.tech)} sees the usual fix on the Console.` : '.'}`); },
    usenote: () => { const r = revItems().find(x => x.id === U.pop.id); if(!r || !r.note) return; if(!r.fix || r.gap === 'short') U.pop.x = r.note; else if(!r.cause) U.pop.c = r.note; rd(); },
    wgo: () => { const p = U.pop, r = revItems().find(x => x.id === p.id); if(!r || !r.e || !r.e.op) return; const op = r.e.op, c = String(p.c != null ? p.c : r.cause).trim(), x = String(p.x != null ? p.x : r.fix).trim(), cd = String(p.cd || '').trim();
      save('write up a fix'); op.log = op.log || [];
      if(c && c !== r.cause){ op.cause = c; op.log = op.log.filter(l => l.kind !== 'cause'); }
      if(x && x !== r.fix){ op.correction = x; op.log = op.log.filter(l => l.kind !== 'fix'); }
      if(cd){ op.faults = op.faults || []; if(!opFaultCodes(op).includes(cd)) op.faults.push({ id: 'fc_' + uid(), code: cd }); }
      revMark(r.id, { done: true }); U.pop = null; fin(`Written up — saved on ${r.ro}.`); },
    mset: t => { U.pop.k = t.dataset.k; rd(); },
    mgo: () => { const p = U.pop, r = revItems().find(x => x.id === p.id); if(!r) return; const k = p.k || r.dup; if(!k) return; save('merge fixes'); ALIAS()[fixKeyOf(r.cmp)] = k; revMark(r.id, { done: true, merged: k }); U.pop = null; fin(`Merged into “${grp(k).t}”.`); },
    rvok: t => { const r = revItems().find(x => x.id === t.dataset.id); if(!r) return; save('review'); revMark(r.id, { ok: true, kept: true }); fin(`${r.ro} kept as written — by ${F(ME().name)}.`); },
    rvhand: t => { const m = fixManual().find(x => x.id === t.dataset.id); if(!m) return; save('review'); m.reviewed = true; m.review = false; m.revBy = ME().name; fin(`Added — “${m.complaint}” now counts.`); },
    rvdrop: t => { const l = fixManual(), i = l.findIndex(x => x.id === t.dataset.id); if(i < 0) return; save('review'); l.splice(i, 1); fin('Dropped.'); },
    apick: t => { U.pop.d.cmp = grp(t.dataset.k).t; U.pop.k = t.dataset.k; rd(); },
    ago: () => { const d = U.pop.d; d.cmp = String(d.cmp || '').trim(); if(!d.cmp || !(String(d.c).trim() || String(d.x).trim())){ pushToast(!d.cmp ? 'Add the complaint.' : 'Add the cause, the correction, or both.'); return; }
      save('add a fix'); const tm = String(d.pn || '').trim(), ym = /^(\d{4})\s+(.*)$/.exec(tm);
      fixManual().push({ id: uid('fx'), complaint: d.cmp, cause: String(d.c).trim(), correction: String(d.x).trim(), year: ym ? ym[1] : '', model: ym ? ym[2] : tm, engine: String(d.eng || '').trim(), code: String(d.cd || '').trim(), vin: '', date: nowIso(), by: ME().name, at: nowIso(), review: role() === 'tech' });
      U.pop = null; flush(); if(role() !== 'tech'){ U.view = 'lib'; U.sel = keyOf(d.cmp); }
      fin(role() === 'tech' ? 'Sent to Review — a foreman, lead tech, Triage or the manager checks it before it counts.' : `Fix added to “${d.cmp}”.`); },
    askuse: t => { const ro = getRO(t.dataset.ro), op = ro && ro.operations.find(o => o.id === t.dataset.op), wr = PG.person('Service writer'); if(!ro || !wr || typeof IB === 'undefined') return;
      IB.send({ to: wr, k: 'ask', src: 'fixes', ro: ro.id, op: op ? op.id : null, t: `${F(ME().name)} asks: use the past fix on ${tgNum(ro)}?`, b: op ? op.complaint : '', acts: [['Open RO', 'open']] }); scheduleSave(true); pushToast(`Asked ${F(wr)} to use this fix on ${tgNum(ro)} — it’s in their Inbox.`); },
    suggest: () => { const g = grp(U.sel); if(!g) return; const s = stats(g.k); save('suggest an edit'); fixManual().push({ id: uid('fx'), complaint: g.t, cause: (s.causes[0] || [''])[0], correction: (STD()[g.k] || {}).fix || (s.fixes[0] || [''])[0], by: ME().name, at: nowIso(), date: nowIso(), review: true, sug: true }); fin('Sent to Review — the foreman, a lead tech or the manager looks at it.'); },
    gocb: () => { const o = build().O.find(x => x.cb); if(!o) return; U.view = 'lib'; U.sel = o.k; U.pop = null; rd(); },
    tofix: t => { U.hl = t.dataset.ro; rd(); setTimeout(() => { const el = document.querySelector(`[data-pg="fixes"] .fx-er[data-ro="${U.hl}"]`); if(el) el.scrollIntoView({ block: 'center' }); }, 30); },
    cbsend: t => { const ro = getRO(t.dataset.ro); if(!ro) return; save('comeback'); try{ rtSend(ro, 'foreman', '', 'Comeback — same complaint, same truck', null, { reason: 'Comeback' }); }catch(e){} fin(`Sent to ${F(PG.person('Foreman') || 'Foreman')} — flagged as a comeback.`); },
    stp: (t, ev) => { ev.preventDefault(); const d = U.steps[t.dataset.k] = U.steps[t.dataset.k] || {}; d[t.dataset.i] = !d[t.dataset.i]; rd(); },
    qset: t => { const k = t.dataset.k, s = stats(k); save('usual quote'); QO()[k] = Math.round(s.hrs * 10) / 10; fin(`The usual quote is now ${h1(QO()[k])} h — Use fix starts from it.`); },
    qkeep: t => { save('keep quote'); QK()[t.dataset.k] = nowIso(); fin('Kept — it asks again if the gap grows.'); },
    ctab: t => { U.pop.tab = t.dataset.v; rd(); },
    cans: () => { U.pop = null; pushToast('That’s what the tech answers when the clock stops.'); rd(); },
    sfix: t => { U.pop.f = +t.dataset.i; rd(); },
    stdgo: () => { const p = U.pop, s = stats(p.k), cur = STD()[p.k], i = p.f != null ? p.f : (cur ? Math.max(0, s.fixes.findIndex(y => y[0] === cur.fix)) : 0); if(!s.fixes[i]) return; save('shop standard'); STD()[p.k] = { fix: s.fixes[i][0], note: String(p.n != null ? p.n : (cur && cur.note) || '').trim(), by: ME().name, at: nowIso() }; U.pop = null; fin(`Shop standard set by ${F(ME().name)} — it shows first, here and on the Console.`); },
    sclr: () => { save('remove standard'); delete STD()[U.pop.k]; U.pop = null; fin('Standard removed.'); },
    kpk: (t, ev) => { ev.preventDefault(); const p = U.pop; p.sel[t.dataset.pn] = !p.sel[t.dataset.pn]; rd(); },
    kgo: () => { const p = U.pop, s = stats(p.k), sel = s.parts.filter(x => p.sel[x.p[0] || x.p[1]]); if(!sel.length){ pushToast('Pick at least one part.'); return; } save('make a kit');
      const kit = invBlank(true); kit.desc = String(p.n != null ? p.n : grp(p.k).t.split(' — ')[0] + ' job').trim(); kit.engine = (s.engs || [])[0] || ''; kit.children = sel.map(x => { const c = invChild(); c.desc = x.p[1]; c.pn = x.p[0]; c.qty = String(x.p[2]); c.price = x.p[3] ? String(x.p[3]) : ''; return c; }); kit.autoFrom = { fix: p.k, at: nowIso() };
      invList().unshift(kit); KITS()[p.k] = kit.id; U.pop = null; fin(`“${kit.desc}” is in Parts → Catalog.`); },
    fset2: t => { const f = t.dataset.f; U[f] = U[f] === t.dataset.v ? null : t.dataset.v; rd(); },
    fclr: t => { const f = t.dataset.f; if(f === 'all'){ U.fe = U.fmdl = U.fmi = null; } else U[f] = null; rd(); },
    openro: t => PG.openRo(t.dataset.ro, t.dataset.op),
    copy: t => { const s = stats(t.dataset.k); copyTxt(`Cause: ${(s.causes[0] || [''])[0]}\nCorrection: ${(STD()[t.dataset.k] || {}).fix || (s.fixes[0] || [''])[0]}${s.parts.length ? '\nParts: ' + s.parts.slice(0, 6).map(x => x.p[1] + (x.p[0] ? ' ' + x.p[0] : '')).join(', ') : ''}`); },
    copyw: t => { const k = t.dataset.k, g = grp(k), s = stats(k); copyTxt(`Complaint: ${g.t}\nCause: ${(s.causes[0] || [''])[0]}\nCorrection: ${(STD()[k] || {}).fix || (s.fixes[0] || [''])[0]}${s.parts.length ? '\nCausal part: ' + s.parts[0].p[1] + (s.parts[0].p[0] ? ' ' + s.parts[0].p[0] : '') : ''}`); },
    print: () => { const el = document.querySelector('[data-pg="fixes"] .fx-printme'); if(!el) return; el.classList.add('pg-printme'); document.documentElement.classList.add('pg-print2'); setTimeout(() => { try{ window.print(); } finally { el.classList.remove('pg-printme'); document.documentElement.classList.remove('pg-print2'); } }, 30); }
  };
  /* ---------- typing and keys ---------- */
  function input(t){ const d = t.dataset.in, p = U.pop; if(!p) return;
    if(d === 'qt'){ p.qt = t.value; const b = document.querySelector('[data-pg="fixes"] .tg-pop [data-a="ugo"]'); if(b) b.disabled = !(parseFloat(p.qt) > 0); return; }
    if(d === 'sn' || d === 'kn') p.n = t.value; if(d === 'c') p.c = t.value; if(d === 'x') p.x = t.value; if(d === 'cd') p.cd = t.value;
    if(d === 'sq' || d === 'acmp'){ if(d === 'sq') p.q = t.value; else p.d.cmp = t.value; const pos = t.selectionStart; rd(); const f = document.querySelector(`[data-pg="fixes"] [data-in="${d}"]`); if(f){ f.focus(); try{ f.setSelectionRange(pos, pos); }catch(e){} } return; }
    if(d === 'ac') p.d.c = t.value; if(d === 'ax') p.d.x = t.value; if(d === 'aeng') p.d.eng = t.value; if(d === 'acd') p.d.cd = t.value; if(d === 'apn') p.d.pn = t.value; }
  function change(t){ const d = t.dataset.in, p = U.pop; if(!p) return; if(d === 'tel') p.tell = t.checked; if(d === 'tpa') p.toParts = t.checked; }
  function fieldKey(t, ev){ const d = t.dataset.in, k = ev.key;
    if(k === 'Escape'){ t.blur(); if(U.pop){ U.pop = null; rd(); } ev.preventDefault(); return true; }
    if(k === 'Enter' && d === 'sq'){ ev.preventDefault(); const b = document.querySelector('[data-pg="fixes"] .tg-pop .fx-srr'); if(b) b.click(); return true; }
    if(k === 'Enter' && t.tagName !== 'TEXTAREA'){ ev.preventDefault(); const b = document.querySelector('[data-pg="fixes"] .tg-pop .btn-primary:not([disabled])'); if(b) b.click(); return true; }
    return false; }
  function move(d){ const L = flat(); if(!L.length) return; U.kb = true; U.view = 'lib'; const i = L.indexOf(U.sel); U.sel = i < 0 ? L[0] : L[Math.max(0, Math.min(L.length - 1, i + d))]; U.pop = null; rd(); PG.kbScroll(); }
  function keydown(ev){
    const k = ev.key; if(ev.ctrlKey || ev.metaKey || ev.altKey || PG.typing(ev)) return;
    const stop = () => { ev.preventDefault(); ev.stopPropagation(); ev.stopImmediatePropagation(); };
    const p = U.pop;
    if(p){ if(k === 'Escape'){ U.pop = null; rd(); return stop(); }
      if(k === 'Enter'){ const b = document.querySelector('[data-pg="fixes"] .tg-pop .btn-primary:not([disabled])'); if(b){ b.click(); return stop(); } }
      const n = +k; if(n >= 1 && n <= 5){ const b = document.querySelector(`[data-pg="fixes"] .tg-pop [data-a="oset"][data-o="${n - 1}"]`) || [...document.querySelectorAll('[data-pg="fixes"] .tg-pop [data-a="mset"], [data-pg="fixes"] .tg-pop [data-a="sfix"]')][n - 1]; if(b){ b.click(); return stop(); } } return; }
    if(k === 'j'){ move(1); return stop(); } if(k === 'k'){ move(-1); return stop(); }
    if(k === 'u'){ const b = document.querySelector('[data-pg="fixes"] .tg-next [data-p="use"]'); if(b){ H.pop(b); return stop(); } }
    if(k === 'a'){ const b = document.querySelector('[data-pg="fixes"] [data-a="pop"][data-p="add"]'); if(b){ H.pop(b); return stop(); } }
    if(k === '/'){ const b = document.querySelector('[data-pg="fixes"] [data-a="pop"][data-p="srch"]'); if(b){ H.pop(b); return stop(); } }
    if(k >= '1' && k <= '4'){ const v = ['lib', 'open', 'rev', 'trend'][+k - 1]; if((v === 'rev' && !isRev()) || (v === 'trend' && !['mg', 'fm'].includes(role()))) return stop(); U.view = v; U.pop = null; rd(); return stop(); }
  }
  function after(){ PG.placePop(U); if(U.kb) PG.kbScroll(); }
  /* the Inbox: a comeback is in the shop */
  if(typeof IB !== 'undefined') IB.DERIVE.push((me, r) => { if(!['Foreman', 'Manager', 'Admin'].includes(r)) return []; flush(); return build().O.filter(o => o.cb).map(o => ({ key: 'cb:' + o.opId, from: 'Parsec', k: 'ask', src: 'fixes', at: o.ro.dateOpened || nowIso(), ro: o.roId, op: o.opId, t: `Comeback — ${o.no} is back with the same complaint`, b: `${o.cust} · ${o.cb.days} days after RO ${o.cb.ro}. ${o.op.complaint || ''}`, acts: [['Open RO', 'open'], ['See the fix', 'page']] })); });
  PG.reg('fixes', { H, U: () => U, input, change, fieldKey, keydown, after });
  return { view, U: () => U, flush, build, stats, keyOf };
})();
function viewFixes(){ return FX.view(); }
