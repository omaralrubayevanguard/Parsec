/* ===== Parsec 9.7: the truck — the small picture in lists, and Your data › Truck pictures ===== */
.trk-th{position:relative;display:grid;place-items:center;width:56px;height:32px;line-height:0;flex:none;overflow:visible}
.trk-th img{display:block;max-width:56px;max-height:32px;object-fit:contain}
.trk-th.fr img,.trk-th.ph img{width:100%;height:100%;object-fit:cover;border-radius:6px;box-shadow:0 0 0 1px var(--px-hair,rgba(0,0,0,.08))}
.trk-th.ph{background:var(--px-fill,#eee);border-radius:6px}
.trk-th.no{color:var(--px-ink4,#aaa);opacity:.55}
.trk-th.no svg{width:44px;height:auto}
.rq-row > .rq-trk,.rq-head > .rq-trk{overflow:visible;display:flex;align-items:center}
@media (max-width:1440px){:root:not([data-device="phone"]) .rq:not(.is-peek) .rq-row > .rq-trk .trk-th{width:48px;height:28px}:root:not([data-device="phone"]) .rq:not(.is-peek) .rq-row > .rq-trk .trk-th img{max-width:48px;max-height:28px}:root:not([data-device="phone"]) .rq:not(.is-peek) .rq-row > .rq-trk .trk-th.no svg{width:40px}}
/* Parsec 9.8 — Needs action rows on Foreman and Triage: the truck where the row's icon was */
.tg-it:has(> .tg-gi.trk){grid-template-columns:56px minmax(0,1fr) auto auto}
.tg-gi.trk{width:56px;height:34px;border-radius:0;background:none !important;overflow:visible}
.tg-gi.trk .trk-th{width:56px;height:34px}
.tg-gi.trk .trk-th img{max-width:56px;max-height:34px}
.tg-gi.trk .trk-th.no svg{width:44px}
:root[data-device="phone"] .tg-it:has(> .tg-gi.trk){grid-template-columns:44px minmax(0,1fr) auto auto}
:root[data-device="phone"] .tg-gi.trk,:root[data-device="phone"] .tg-gi.trk .trk-th{width:44px;height:28px}
:root[data-device="phone"] .tg-gi.trk .trk-th img{max-width:44px;max-height:28px}
:root[data-device="phone"] .tg-gi.trk .trk-th.no svg{width:36px}
/* the Foreman floor (9.9): the bay keeps its look; the truck sits small at its right — from above, cab up, when the model has that view */
.fm-bay > .fm-ti{position:absolute;right:10px;top:50%;transform:translateY(-46%);z-index:1;pointer-events:none;line-height:0}
.fm-bay > .fm-ti.top{width:46px;height:24px;border-radius:5px;overflow:hidden;background:#121211;box-shadow:0 0 0 1px rgba(0,0,0,.12)}
.fm-bay > .fm-ti.top img{display:block;width:46px;height:24px;object-fit:cover}
.fm-bay > .fm-ti .trk-th{width:44px;height:28px}
.fm-bay > .fm-ti .trk-th img{max-width:44px;max-height:28px}
.fm-bay.has-top > .t{padding-right:52px}
/* the selected RO's header on Foreman and Triage: the truck at the right */
.tg-top:has(> .tg-hpic){position:relative;padding-right:176px}
.tg-top > .tg-hpic{position:absolute;right:28px;top:50%;transform:translateY(-50%)}
.tg-hpic{display:grid;place-items:center;width:136px;height:84px;line-height:0;pointer-events:none}
.tg-hpic .trk-th{width:136px;height:84px}
.tg-hpic .trk-th img{max-width:136px;max-height:84px;filter:drop-shadow(0 6px 8px rgba(0,0,0,.14))}
.tg-hpic .trk-th.ph img,.tg-hpic .trk-th.fr img{width:136px;height:84px;object-fit:cover;border-radius:10px;filter:none}
.tg-dkh > .tg-hpic{order:3;flex:none;width:100px;height:60px;margin:-4px 0 -2px 0}
.tg-dkh > .tg-hpic .trk-th{width:100px;height:60px}
.tg-dkh > .tg-hpic .trk-th img{max-width:100px;max-height:60px}
.tg-dkh > .tg-hpic .trk-th.ph img,.tg-dkh > .tg-hpic .trk-th.fr img{width:100px;height:60px}
:root[data-device="phone"] .tg-hpic{display:none !important}
/* Search (Ctrl K): the truck in each result */
.pal-row:has(> .pal-trk){height:54px !important;min-height:54px !important;gap:12px}
.pal-trk{flex:none;display:grid;place-items:center;width:56px;height:34px;line-height:0}
.pal-trk .trk-th{width:56px;height:34px}
.pal-trk .trk-th img{max-width:56px;max-height:34px}
.pal-sub{font:400 12px/16px var(--px-sans,inherit);color:var(--px-ink3,var(--ink-faint));overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pal-sub .mono{font-family:var(--px-mono,var(--font-code));}
.pal-row:has(> .pal-trk) .pal-cust{font-weight:500}
/* the list of model pictures */
.px-trkl{display:flex;flex-direction:column;margin:2px 0 8px}
.px-trkl.is-long{max-height:520px;overflow:auto;padding-right:4px;scrollbar-width:thin;box-shadow:inset 0 1px 0 var(--px-hair),inset 0 -1px 0 var(--px-hair)}
.px-trkr[hidden]{display:none}
.px-trkq{box-sizing:border-box;width:280px;max-width:100%;height:32px;padding:0 10px;border:0;border-radius:8px;background:var(--px-raised);box-shadow:inset 0 0 0 1px var(--px-border);font:400 13px/1 var(--px-sans);color:var(--px-ink);outline:none}
.px-trkq:focus{box-shadow:inset 0 0 0 1.5px var(--px-focus,var(--px-primary))}
.px-trkr{display:grid;grid-template-columns:96px 76px minmax(0,1fr) auto;align-items:center;gap:12px;padding:8px 0;box-shadow:inset 0 -1px 0 var(--px-hair)}
.px-trkr:last-child{box-shadow:none}
.px-trkr__pic{display:grid;place-items:center;width:96px;height:52px;line-height:0}
.px-trkr__pic img{display:block;max-width:96px;max-height:52px;object-fit:contain}
.px-trkr__pic.fr img{width:100%;height:100%;object-fit:cover;border-radius:8px}
.px-trkr__top{all:unset;box-sizing:border-box;display:grid;place-items:center;width:76px;height:40px;border-radius:8px;background:#121211;overflow:hidden;cursor:pointer;box-shadow:inset 0 0 0 1px var(--px-hair)}
.px-trkr__top img{width:100%;height:100%;object-fit:cover}
.px-trkr__top.no{background:transparent;box-shadow:inset 0 0 0 1px var(--px-border);color:var(--px-ink3);font-size:11.5px;text-align:center;line-height:14px}
.px-trkr__top:hover{box-shadow:inset 0 0 0 1.5px var(--px-ink3)}
.px-trkr__top:focus-visible{box-shadow:0 0 0 2px var(--px-focus,var(--px-primary))}
.px-trkr__f{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr) minmax(0,1fr);gap:4px 6px;min-width:0}
.px-trkr__f input{box-sizing:border-box;width:100%;min-width:0;height:30px;padding:0 8px;border:0;border-radius:7px;background:var(--px-raised);box-shadow:inset 0 0 0 1px var(--px-border);font:400 13px/1 var(--px-sans);color:var(--px-ink);outline:none}
.px-trkr__f input:focus{box-shadow:inset 0 0 0 1.5px var(--px-focus,var(--px-primary))}
.px-trkr__f input::placeholder{color:var(--px-ink3)}
.px-trkr__n{grid-column:1 / -1;font-size:12px;line-height:16px;color:var(--px-ink3);white-space:nowrap}
.px-trkr__b{display:flex;gap:4px}
.px-hint{font-size:12.5px;color:var(--px-ink3)}
p.px-hint{margin:6px 0 8px}
:root[data-device="phone"] .px-trkr{grid-template-columns:84px minmax(0,1fr);grid-template-areas:"pic f" "top b";row-gap:6px}
:root[data-device="phone"] .px-trkr__top{grid-area:top;width:84px;height:40px}
:root[data-device="phone"] .px-trkr__pic{grid-area:pic;width:84px;height:46px}
:root[data-device="phone"] .px-trkr__pic img{max-width:84px;max-height:46px}
:root[data-device="phone"] .px-trkr__f{grid-area:f;grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
:root[data-device="phone"] .px-trkr__f input[data-f="years"]{grid-column:1 / -1}
:root[data-device="phone"] .px-trkr__f input{height:40px;font-size:16px}
:root[data-device="phone"] .px-trkr__b{grid-area:b;justify-self:end}

/* ===== Parsec 9.9 — Notes on the truck: put the note where the issue is ===== */
.ti-wrap{position:fixed;inset:0;z-index:88;display:flex;align-items:center;justify-content:center;padding:24px;background:color-mix(in srgb,#000 46%,transparent);backdrop-filter:blur(6px);animation:ti-in .16s ease-out}
@keyframes ti-in{from{opacity:0}to{opacity:1}}
.ti{outline:none;width:min(1020px,100%);max-height:calc(100vh - 48px);display:flex;flex-direction:column;border-radius:18px;background:var(--px-panel,#fbfaf7);color:var(--px-ink);box-shadow:0 30px 80px -30px rgba(0,0,0,.5),0 0 0 1px var(--px-hair);overflow:hidden;font-family:var(--px-sans)}
.ti-h{display:flex;align-items:flex-start;gap:16px;padding:20px 24px 16px;box-shadow:inset 0 -1px 0 var(--px-hair)}
.ti-ht{flex:1;min-width:0}
.ti-eb0{font-size:12px;color:var(--px-ink3)} .ti-eb0 .mono{font-family:var(--px-mono);font-weight:500;color:var(--px-ink2)}
.ti h2{margin:4px 0 0;font:500 26px/32px var(--px-serif);letter-spacing:-.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ti-sub{margin-top:2px;font-size:13px;color:var(--px-ink2)}
.ti-x{all:unset;flex:none;display:grid;place-items:center;width:32px;height:32px;border-radius:8px;color:var(--px-ink2);cursor:pointer}
.ti-x:hover{background:var(--px-fill)} .ti-x:focus-visible{box-shadow:0 0 0 2px var(--px-focus,var(--px-primary))}
.ti-b{flex:1;min-height:0;display:grid;grid-template-columns:minmax(0,1fr) 320px;overflow:hidden}
.ti-st{display:flex;flex-direction:column;min-width:0;padding:16px 20px 14px;overflow:auto}
.ti-bar{display:flex;align-items:center;gap:10px;min-height:32px}
.ti-hint{flex:1;font-size:12.5px;color:var(--px-ink3)}
.ti-stage{flex:1;display:grid;place-items:center;margin-top:10px;padding:18px;border-radius:14px;background:linear-gradient(180deg,var(--px-panel) 0%,var(--px-fill) 100%);box-shadow:inset 0 0 0 1px var(--px-hair);min-height:300px}
.ti-stage.placing{box-shadow:inset 0 0 0 1.5px var(--px-primary)}
.ti-stage.placing .ti-pic{cursor:crosshair}
.ti-pic{position:relative;display:inline-block;line-height:0;max-width:100%;outline:none}
.ti-pic img{display:block;width:540px;max-width:100%;height:auto;user-select:none;-webkit-user-drag:none}
.ti-pic img[data-ti-ph]{width:auto;max-height:min(52vh,440px)}
.ti-pic img[data-ti-ph]{border-radius:10px}
.ti-sil{display:block;width:min(520px,70vw);color:var(--px-ink4)} .ti-sil svg{display:block;width:100%;height:auto}
.ti-m{all:unset;box-sizing:border-box;position:absolute;width:26px;height:26px;margin:-13px 0 0 -13px;border-radius:50%;display:grid;place-items:center;background:var(--px-ink,#1d1d1b);color:var(--px-panel,#fff);font:600 12px/1 var(--px-sans);box-shadow:0 0 0 2.5px var(--px-panel,#fff),0 4px 10px -2px rgba(0,0,0,.45);cursor:pointer;transition:transform .12s}
.ti-m:hover{transform:scale(1.08)}
.ti-m.sel{background:var(--px-primary,#8a6a45);color:var(--px-onprimary,#fff)}
.ti-m.other{opacity:.45}
.ti-m.draft{animation:ti-pop .22s cubic-bezier(.2,.8,.2,1)}
@keyframes ti-pop{from{transform:scale(.4)}to{transform:none}}
.ti-m:focus-visible{box-shadow:0 0 0 2.5px var(--px-panel,#fff),0 0 0 5px var(--px-focus,var(--px-primary))}
.ti-fine{margin:10px 2px 0;font-size:12px;color:var(--px-ink3)}
.ti-side{display:flex;flex-direction:column;gap:14px;padding:16px 20px 18px;box-shadow:inset 1px 0 0 var(--px-hair);overflow:auto}
.ti-ed{display:flex;flex-direction:column;gap:12px;padding:14px;border-radius:14px;background:var(--px-raised);box-shadow:0 0 0 1px var(--px-hair),0 6px 16px -12px rgba(0,0,0,.3)}
.ti-eh{display:flex;align-items:center;gap:10px} .ti-eh b{font:500 18px/22px var(--px-serif)} .ti-eh small{margin-left:auto;font-size:11.5px;color:var(--px-ink3);text-align:right}
.ti-n{flex:none;display:inline-grid;place-items:center;width:22px;height:22px;border-radius:50%;background:var(--px-ink);color:var(--px-panel);font:600 11px/1 var(--px-sans)}
.ti-l{display:flex;flex-direction:column;gap:6px;font-size:12px;font-weight:500;color:var(--px-ink3)}
.ti-l select,.ti-l textarea{box-sizing:border-box;width:100%;border:0;border-radius:9px;background:var(--px-panel);box-shadow:inset 0 0 0 1px var(--px-border);font:400 13.5px/1.4 var(--px-sans);color:var(--px-ink);outline:none}
.ti-l select{height:36px;padding:0 10px}
.ti-l textarea{min-height:92px;padding:9px 10px;resize:vertical}
.ti-l select:focus,.ti-l textarea:focus{box-shadow:inset 0 0 0 1.5px var(--px-focus,var(--px-primary))}
.ti-eb{display:flex;gap:6px;flex-wrap:wrap} .ti-eb .pri{flex:1;justify-content:center}
.ti-del{color:var(--px-bad,#b3402f) !important}
.ti-list{display:flex;flex-direction:column;gap:2px}
.ti-li{all:unset;box-sizing:border-box;display:flex;align-items:flex-start;gap:10px;padding:8px 10px;border-radius:10px;cursor:pointer}
.ti-li:hover{background:var(--px-fill)} .ti-li.sel{background:var(--px-sel,var(--px-fill))} .ti-li:focus-visible{box-shadow:inset 0 0 0 1.5px var(--px-focus,var(--px-primary))}
.ti-lt{display:flex;flex-direction:column;gap:1px;min-width:0} .ti-lt b{font-size:13px;font-weight:500} .ti-lt small{font-size:12px;color:var(--px-ink3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:230px}
.ti-empty{margin:4px 0;font-size:13px;line-height:19px;color:var(--px-ink3)}
:root[data-device="phone"] .ti-wrap{padding:0;align-items:stretch}
:root[data-device="phone"] .ti{max-height:none;height:100%;border-radius:0}
:root[data-device="phone"] .ti-b{grid-template-columns:1fr;overflow:auto;display:block}
:root[data-device="phone"] .ti-st{overflow:visible;padding:12px 16px}
:root[data-device="phone"] .ti-stage{min-height:0;padding:10px}
:root[data-device="phone"] .ti-side{box-shadow:inset 0 1px 0 var(--px-hair);padding:14px 16px 28px;overflow:visible}
:root[data-device="phone"] .ti-l select,:root[data-device="phone"] .ti-l textarea{font-size:16px}
:root[data-device="phone"] .ti-m{width:30px;height:30px;margin:-15px 0 0 -15px}
