/* ============================== RO list (RO list mock-up, layout C: the list and a peek pane) ==============================
   Open is one flat list, oldest first, the status at the start of the complaint; Mine · Working · Waiting · Hold · Done
   group by status (or stage, or tech). Click a row and the RO opens in a pane beside the list — Enter or Open RO goes to
   the RO page. Select rows for Set status · Transfer · Print. Display picks List or Board, grouping and sort. */
var RL = (function(){
  const esc = PG.e, ic = PG.ic, kbd = PG.kbd;
  const R0 = () => document.querySelector('[data-pg="rolist"]') || document;
  const $ = s => R0().querySelector(s);
  let U = null, DIRTY = false;
  function reset(){ U = { view: 'list', groupBy: 'status', sort: 'days', sel: {}, cur: null, closed: {}, pop: null, peek: true, print: false }; }
  reset();
  const STG = ['checkin', 'diag', 'approval', 'parts', 'repair', 'roadtest', 'closeout'];
  const STGN = { checkin: 'Check-in', diag: 'Diag', approval: 'Approval', parts: 'Parts', repair: 'Repair', roadtest: 'Road test', closeout: 'Close-out' };
  const STK = { 'Hold Tech': 'hold', 'Working': 'working', 'Waiting – Parts': 'parts', 'Waiting – Foreman': 'foreman', 'Waiting – Tech Support': 'support', 'Waiting – Customer': 'customer', 'Complete – Road test': 'roadtest', 'Complete – Released': 'released', 'Declined': 'declined' };
  const GORDER = ['working', 'roadtest', 'parts', 'customer', 'support', 'foreman', 'hold', 'released', 'declined'];
  const GNAME = { working: 'Working', roadtest: 'Complete – Road test', parts: 'Waiting – Parts', customer: 'Waiting – Customer', support: 'Waiting – Tech support', foreman: 'Waiting – Foreman', hold: 'Hold tech', released: 'Complete – Released', declined: 'Declined' };
  const SHORT = { working: 'Working', roadtest: 'Road test', parts: 'Parts', customer: 'Customer', support: 'Tech support', foreman: 'Foreman', hold: 'Hold tech', released: 'Released', declined: 'Declined' };
  const si = k => TG_SI[k] || TG_SI.hold;
  const RLG = 'r' + 'l-group';   /* the app's own action — kept out of the class renaming */
  const fstN = n => String(n || '').split(' ')[0];
  const DAYN = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const hm = d => d.getHours() + ':' + String(d.getMinutes()).padStart(2, '0');
  /* ---------- one RO, as the list draws it ---------- */
  function info(ro){
    const s = roStatus(ro), k = STK[s.status] || (/^Complete/.test(s.status) ? 'released' : 'hold'), done = roIsDone(ro);
    let f = null; try{ f = roForecast(ro); }catch(e){}
    let M = null; try{ M = roStages(ro, f); }catch(e){}
    const ops = (ro.operations || []).filter(o => o && o.id && !o.declined);
    let b = 0, q = 0; ops.forEach(o => { q += +o.quoted || 0; try{ b += opCalc(o).burntHrs || 0; }catch(e){} });
    const live = STATE.punches.some(p => !p.stop && p.roId === ro.id);
    const T = M ? M.list.map(x => x.state === 'd' ? 'done' : x.state === 'x' ? 'skip' : x.state === 'w' ? 'wait' : (x.state === 'n' || x.state === 'c') ? 'now' : '') : STG.map(() => '');
    const stage = M && M.cur ? M.cur.name : (done ? 'Close-out' : 'Check-in');
    let ready = '—', readyT = '9';
    if(done){ const at = ro.dateClosed || (ro.status && ro.status.setAt); if(at){ const d = new Date(at); ready = 'Released ' + DAYN[d.getDay()]; readyT = '0' + at; } }
    else if(f && f.likely){ const d = f.likely, t0 = new Date(); t0.setHours(0, 0, 0, 0); const dd0 = Math.round((new Date(d).setHours(0, 0, 0, 0) - t0) / 86400000); ready = (dd0 <= 0 ? 'Today' : dd0 === 1 ? 'Tomorrow' : dd0 < 7 ? DAYN[d.getDay()] : PG.day ? PG.day(localDay(d.toISOString())) : localDay(d.toISOString())) + ' ' + hm(d); readyT = d.toISOString(); }
    const warr = !!ro.warranty || ops.some(o => { const t = opJobType(o); return t === 'WARR' || t === 'RECALL'; });
    let tm = null; try{ tm = truckYM(ro); }catch(e){}
    return { ro, id: ro.id, no: tgNum(ro), cust: ro.customerName || '—', unit: ro.unitNumber || '', veh: (tm && tm.line) || [ro.year, ro.make, ro.model].filter(Boolean).join(' ') || '—',
      st: s.status, sub: s.sub || '', k, grp: roGroupOf(ro), done, tech: ro.assignedTech || '', spot: (typeof spotOf === 'function' && spotOf(ro.location)) || ro.location || '—',
      days: daysOpen(ro), b, q, ops, cmp: ops[0] ? String(ops[0].complaint || '').trim() : '', live, T, stage, M, f, ready, readyT, warr };
  }
  let CACHE = null;
  function rows(){
    const key = [STATE.savedAt || '', STATE.ros.length, STATE.punches.length, UI.rlGroup || 'all', UI.roFilter || '', U.sort, todayStr()].join('|');
    if(CACHE && CACHE.key === key) return CACHE.L;
    const L = rlList().map(info).sort((a, b) => U.sort === 'no' ? String(a.no).localeCompare(String(b.no), undefined, { numeric: true }) : U.sort === 'ready' ? (a.readyT < b.readyT ? -1 : a.readyT > b.readyT ? 1 : 0) : (b.days || 0) - (a.days || 0));
    CACHE = { key, L }; return L;
  }
  function counts(){
    const me = rlMe(), c = { all: 0, mine: 0, working: 0, waiting: 0, hold: 0, done: 0, late: 0, live: 0 };
    STATE.ros.forEach(ro => { if(ro.id === SHOP_RO_ID || ro.shop || !roMatchesFilter(ro, UI.roFilter)) return; const g = roGroupOf(ro); c[g]++;
      if(g !== 'done'){ c.all++; if(me && techSame(ro.assignedTech, me)) c.mine++; const d = daysOpen(ro); if(d != null && d >= 7) c.late++; if(STATE.punches.some(p => !p.stop && p.roId === ro.id)) c.live++; } });
    return c;
  }
  /* ---------- drawing ---------- */
  const ticks = r => `<span class="rl-ticks" title="${esc(r.stage)}">${r.T.map(t => `<i class="${t}"></i>`).join('')}</span>`;
  const mini = (b, q) => `<span class="rl-mini"><i${b > q ? ' class="over"' : ''} style="width:${q ? Math.min(100, b / q * 100) : (b ? 100 : 0)}%"></i></span>`;
  const av = n => n ? `<span class="tg-av" title="${esc(n)}">${esc(PG.ini(n))}</span>` : '<span class="tg-av" title="Unassigned">—</span>';
  function row(r){
    const late = r.days != null && r.days >= 7 && !r.done, flat = (UI.rlGroup || 'all') === 'all', why = UI.roFilter ? roMatch(r.ro, UI.roFilter) : '';
    const sub = flat ? `<span class="sub">${esc(r.sub || SHORT[r.k])} · </span>` : (r.sub && U.groupBy !== 'none' ? `<span class="sub">${esc(r.sub)} · </span>` : '');
    return `<div class="rl-row${U.sel[r.id] ? ' is-sel' : ''}${U.peek && U.cur === r.id ? ' is-cur' : ''}" data-a="sel" data-id="${r.id}">
      <span class="rl-cb" data-a="cb" data-id="${r.id}"></span><span class="rl-no">${r.live ? '<i class="rl-live" title="On the clock"></i>' : ''}${esc(r.no)}</span>${si(r.k)}<span class="rl-trk">${trkThumb(r.ro)}</span>
      <span class="rl-cu"><b>${esc(r.cust)}</b>${why ? `<small class="rl-why">${esc(why)}</small>` : r.unit ? `<small>Unit ${esc(r.unit)}</small>` : ''}${r.warr ? `<span class="rl-tag">${ic('warranty', 12)}WARR</span>` : ''}</span>
      <span class="rl-cmp">${sub}${esc(r.cmp || 'No operations yet')}${r.ops.length > 1 ? `<em>+${r.ops.length - 1}</em>` : ''}</span>
      ${ticks(r)}<span class="rl-time c-time">${mini(r.b, r.q)}<span>${r.b.toFixed(2)} <em>/ ${r.q.toFixed(2)}</em></span></span>
      ${av(r.tech)}<span class="rl-sub c-spot">${esc(r.spot)}</span><span class="rl-sub c-ready">${esc(r.ready)}</span>
      <span class="rl-days r${late ? ' late' : ''}">${r.days == null ? '—' : r.days === 0 ? 'today' : r.days + 'd'}</span>
      <span class="rl-optw" data-keep-pop>${rlOptHtml(r.ro)}</span></div>`;
  }
  function gkey(r){ return U.groupBy === 'status' ? r.k : U.groupBy === 'stage' ? r.stage : U.groupBy === 'tech' ? (r.tech || '') : 'all'; }
  function glabel(k){ if(U.groupBy === 'status') return si(k) + `<span>${GNAME[k] || k}</span>`; if(U.groupBy === 'stage') return `<span>${esc(k)}</span>`; if(U.groupBy === 'tech') return av(k) + `<span>${esc(k || 'Unassigned')}</span>`; return '<span>All</span>'; }
  function list(){
    const L = rows(), g = UI.rlGroup || 'all', flat = g === 'all' || U.groupBy === 'none';
    let h = `<div class="rl-head"><span></span><span>RO</span><span></span><span class="rl-trk"></span><span>Customer</span><span>Complaint</span><span>Stage</span><span class="c-time">Time</span><span>Tech</span><span class="c-spot">Spot</span><span class="c-ready">Ready by</span><span class="r">Open</span><span></span></div>`;
    if(g !== 'done' && !UI.roFilter){ const l0 = STATE.punches.some(p => !p.stop && isShopPunch(p));
      h += `<div class="rl-row rl-shop" data-a="shop"><span></span><span class="rl-no">${l0 ? '<i class="rl-live"></i>' : ''}${ic('kit', 14)}</span><span></span><span class="rl-trk"></span><span class="rl-cu"><b>Shop time</b><small>clock non-RO work</small></span><span class="rl-cmp">Cleaning, training, shop truck…</span><span></span><span class="c-time"></span><span></span><span class="c-spot"></span><span class="c-ready"></span><span></span><span></span></div>`; }
    if(flat) h += `<div class="rl-rows" style="margin-top:6px">${L.map(row).join('')}</div>`;
    else {
      const keys = U.groupBy === 'status' ? GORDER : U.groupBy === 'stage' ? Object.values(STGN) : [...new Set(L.map(r => r.tech || ''))].sort((a, b) => !a ? 1 : !b ? -1 : a.localeCompare(b));
      keys.forEach(k => { const G = L.filter(r => gkey(r) === k); if(!G.length) return; const ck = U.groupBy + ':' + k;
        h += `<div class="rl-grp${U.closed[ck] ? ' is-closed' : ''}" data-a="grp" data-g="${esc(ck)}"><span class="rl-chev">${ic('chevD', 14)}</span>${glabel(k)}<span class="n">${G.length}</span></div><div class="rl-rows">${G.map(row).join('')}</div>`; });
    }
    if(!L.length) h += `<div class="rl-none">${UI.roFilter ? 'Nothing matches that — check the spelling, or clear the search.' : 'Nothing here right now.'}</div>`;
    return `<div class="rl-scroll" data-scroll="rl">${h}</div>`;
  }
  function board(){
    const L = rows();
    return `<div class="rl-board">${STG.map(k => { const G = L.filter(r => r.stage === STGN[k]);
      return `<div class="rl-col"><div class="rl-colh"><i class="${k === 'repair' ? 'now' : ''}"></i>${STGN[k]}<span class="n">${G.length}</span></div><div class="rl-cards">${G.map(r => `<div class="rl-card" data-a="open" data-id="${r.id}">
        <div class="rl-card__top">${r.live ? '<i class="rl-live"></i>' : ''}${esc(r.no)}<span class="d${r.days >= 7 && !r.done ? ' late' : ''}">${r.days == null ? '—' : r.days === 0 ? 'today' : r.days + 'd'}</span></div>
        <h4>${esc(r.cust)}</h4><p>${esc(r.cmp || 'No operations yet')}${r.ops.length > 1 ? ` · +${r.ops.length - 1}` : ''}</p>
        <div class="rl-card__ft">${si(r.k)}<span class="s">${esc(r.sub || SHORT[r.k])}</span>${mini(r.b, r.q)}${av(r.tech)}</div></div>`).join('') || '<div class="rl-empty">Nothing here</div>'}</div></div>`; }).join('')}</div>`;
  }
  function peek(r){
    const ro = r.ro; let nx = null; try{ nx = raNext(ro); }catch(e){}
    const parts = []; r.ops.forEach(o => { try{ opRealParts(o).forEach(p => parts.push(p)); }catch(e){} });
    const pin = parts.filter(p => p.status === 'Received' || p.status === 'Installed' || p.sup === 'stock').length;
    const files = (ro.attachments || []).length + (ro.bulletins || []).reduce((s, b) => s + ((b.files || []).length), 0);
    const run = STATE.punches.filter(p => !p.stop && p.roId === ro.id);
    return `<aside class="rl-peek"><div class="rl-peek__top"><span class="id">RO-${esc(r.no)}</span><span>·</span><span>${r.done ? 'closed' : r.days == null ? '' : r.days === 0 ? 'opened today' : r.days + ' days open'}</span><button class="btn btn-sm ib tg-gh" data-a="peekx" title="Close (Esc)">${ic('x', 15)}</button></div>
      <h2>${esc(r.cust)}</h2><div class="sub">${esc(r.veh)}${r.unit ? ' · Unit ' + esc(r.unit) : ''}${r.spot && r.spot !== '—' ? ' · ' + esc(r.spot) : ''}</div>
      <div class="rl-strow"><button class="rl-stbtn" data-a="status" data-id="${r.id}" title="Set status (S)">${si(r.k)}<span>${esc(r.st)}</span>${r.sub ? `<span class="s2">· ${esc(r.sub)}</span>` : ''}${ic('chevD', 13)}</button>${r.tech ? `<span class="rl-with">with ${av(r.tech)} ${esc(r.tech)}</span>` : '<span class="rl-with">no tech yet</span>'}</div>
      ${nx ? `<div class="rl-next ${nx.tone === 'bad' ? 'bad' : nx.tone === 'warn' ? 'warn' : nx.tone === 'good' ? 'good' : ''}"><div class="rl-next__head"><b>Next</b><span>${esc(r.stage)}${r.ready && r.ready !== '—' ? ' · ' + (r.done ? '' : 'ready ') + esc(r.ready) : ''}</span></div><p>${esc(nx.txt)}</p></div>` : ''}
      <div class="rl-tots"><div><span>${ic('clock', 13)}Time</span><b>${r.b.toFixed(2)}<em> / ${r.q.toFixed(2)} h</em></b></div><div><span>${ic('parts', 13)}Parts</span><b>${pin}<em> / ${parts.length}</em></b></div><div><span>${ic('clip', 13)}Files</span><b>${files}</b></div></div>
      <div class="rl-pk-h">Operations</div><div class="rl-pops">${r.ops.length ? r.ops.map((o, i) => { let bb = 0; try{ bb = opCalc(o).burntHrs || 0; }catch(e){} const k = opDoneNow(o) ? 'released' : run.some(p => p.opId === o.id) ? 'working' : 'hold';
        return `<div class="rl-pop">${si(k)}<span class="n">${i + 1}</span><span class="t">${esc(o.complaint || 'Operation')}</span><span class="h">${bb.toFixed(2)} / ${(+o.quoted || 0).toFixed(2)} h</span></div>`; }).join('') : '<div class="rl-pop"><span class="t" style="color:var(--tg-ink3)">No operations yet</span></div>'}</div>
      <div class="rl-open"><button class="btn btn-primary" data-a="open" data-id="${r.id}">Open RO${kbd('↵')}</button><button class="btn" data-a="pop" data-p="xfer" data-id="${r.id}">${ic('swap', 14)}Transfer…</button></div></aside>`;
  }
  function pop(){
    const p = U.pop; if(!p) return '';
    if(p.type === 'disp') return `<div class="tg-pop rl-disp" style="width:280px"><h5>View</h5><div class="rl-seg"><button class="${U.view === 'list' ? 'on' : ''}" data-a="dv" data-v="list">${ic('list', 14)}List</button><button class="${U.view === 'board' ? 'on' : ''}" data-a="dv" data-v="board">${ic('board', 14)}Board</button></div>
      <h5>Group by</h5><div class="rl-chips">${[['status', 'Status'], ['stage', 'Stage'], ['tech', 'Tech'], ['none', 'None']].map(([k, l]) => `<button class="${U.groupBy === k ? 'on' : ''}" data-a="dgb" data-v="${k}">${l}</button>`).join('')}</div>
      <h5>Sort</h5><div class="rl-chips">${[['days', 'Days open'], ['no', 'RO number'], ['ready', 'Ready by']].map(([k, l]) => `<button class="${U.sort === k ? 'on' : ''}" data-a="dso" data-v="${k}">${l}</button>`).join('')}</div>
      <h5>Pane</h5><div class="rl-chips"><button class="${U.peek ? 'on' : ''}" data-a="dpk" data-v="1">Open in a pane</button><button class="${U.peek ? '' : 'on'}" data-a="dpk" data-v="0">Go straight to the RO</button></div>
      <div class="tg-pft">${ic('info', 12)}Open is one list, oldest first. The other groups follow Group by.</div></div>`;
    const ids = p.ids || [];
    if(p.type === 'bst') return `<div class="tg-pop menu" style="width:260px"><div class="tg-ph"><b>Set status</b><span class="cu">${ids.length} RO${ids.length === 1 ? '' : 's'}</span></div>${RO_STATUS_OPTIONS.map(o => `<button class="rl-mrow" data-a="bset" data-v="${esc(o.status)}">${si(STK[o.status] || 'hold')}${esc(o.status)}</button>`).join('')}</div>`;
    if(p.type === 'xfer'){ const techs = (typeof rtTechs === 'function' ? rtTechs() : []) || [];
      return `<div class="tg-pop menu" style="width:280px"><div class="tg-ph"><b>Transfer</b><span class="cu">${ids.length} RO${ids.length === 1 ? '' : 's'} — they accept it in their Inbox</span></div>
        ${techs.map(n => `<button class="rl-mrow" data-a="xto" data-k="tech" data-w="${esc(n)}">${av(n)}${esc(n)}<small>Technician</small></button>`).join('')}
        ${['writer', 'parts', 'foreman', 'manager', 'warranty'].map(k => `<button class="rl-mrow" data-a="xto" data-k="${k}">${ic(k === 'writer' ? 'user' : k === 'parts' ? 'parts' : k === 'warranty' ? 'warranty' : 'users', 14)}${esc(RT_DEPT[k] || k)}<small>${esc((typeof rtPerson === 'function' && rtPerson(k)) || '')}</small></button>`).join('')}</div>`; }
    return '';
  }
  function printSheet(){
    const L = rows().filter(r => U.sel[r.id]);
    return `<div class="rl-print pg-printme"><h3>Repair orders · ${L.length}</h3><table><thead><tr><th>RO</th><th>Customer</th><th>Unit</th><th>Complaint</th><th>Status</th><th>Tech</th><th>Spot</th><th>Open</th></tr></thead><tbody>${L.map(r => `<tr><td>${esc(r.no)}</td><td>${esc(r.cust)}</td><td>${esc(r.unit)}</td><td>${esc(r.cmp)}${r.ops.length > 1 ? ' +' + (r.ops.length - 1) : ''}</td><td>${esc(r.st)}${r.sub ? ' · ' + esc(r.sub) : ''}</td><td>${esc(r.tech || '—')}</td><td>${esc(r.spot)}</td><td>${r.days == null ? '—' : r.days + 'd'}</td></tr>`).join('')}</tbody></table></div>`;
  }
  function view(){
    if(U._me !== PG.me().name){ reset(); U._me = PG.me().name; }
    if(!STATE.ros.filter(ro => ro.id !== SHOP_RO_ID && !ro.shop).length) return `<div class="tg rl" data-pg="rolist"><div class="tg-body"><div class="rl-main"><div class="rl-top"><div class="rl-titlerow"><div><h1 class="rl-title">Repair orders</h1><p class="rl-facts">No repair orders yet.</p></div><button class="btn btn-primary" data-action="open-add-ro">${ic('plus', 15)}New RO</button></div></div><div class="rl-none">Add the first RO, or load the samples from Settings to look around.</div></div></div></div>`;
    const c = counts(), g = UI.rlGroup || 'all', me = rlMe(), L = rows();
    Object.keys(U.sel).forEach(id => { if(!L.some(r => r.id === id)) delete U.sel[id]; });
    if(U.cur && !L.some(r => r.id === U.cur)) U.cur = null;
    const cur = U.peek && U.view === 'list' && U.cur ? L.find(r => r.id === U.cur) : null, nSel = Object.keys(U.sel).length;
    const waiting = c.waiting;
    return `<div class="tg rl${cur ? ' is-peek' : ''}${nSel ? ' has-sel' : ''}" data-pg="rolist"><div class="tg-body"><div class="rl-main">
      <div class="rl-top"><div class="rl-titlerow"><div><h1 class="rl-title">Repair orders</h1><p class="rl-facts"><span><b>${c.all}</b> open</span><span>·</span><span><b>${waiting}</b> waiting</span><span>·</span><span><b>${c.live}</b> on the clock</span>${c.late ? `<span>·</span><span class="warn"><b>${c.late}</b> open 7+ days</span>` : ''}</p></div>
        <button class="btn btn-primary" data-action="open-add-ro">${ic('plus', 15)}New RO${kbd('N')}</button></div>
        <div class="rl-tools"><div class="rl-seg" role="group" aria-label="Show">${RL_GROUPS.filter(x => x[0] !== 'mine' || me).map(x => `<button class="${g === x[0] ? 'on' : ''}" data-action="${RLG}" data-g="${x[0]}" aria-pressed="${g === x[0]}">${x[1]}<span>${c[x[0]]}</span></button>`).join('')}</div>
          <label class="rl-find">${ic('search', 16)}<input data-bind="ro-filter" data-in="q" data-no-draft placeholder="Search RO, customer, VIN, part #, DTC…" value="${esc(UI.roFilter || '')}" aria-label="Search repair orders">${kbd('/')}</label>
          <button class="btn" data-a="pop" data-p="disp">${ic('sliders', 15)}Display</button></div></div>
      ${U.view === 'board' ? board() : list()}</div>
      ${cur ? peek(cur) : ''}${pop()}
      ${nSel ? `<div class="rl-bulkwrap"><div class="rl-bulk"><b>${nSel} selected</b><button class="btn btn-sm tg-gh" data-a="pop" data-p="xfer">${ic('swap', 14)}Transfer…</button><button class="btn btn-sm tg-gh" data-a="pop" data-p="bst">${si('hold')}Set status…</button><button class="btn btn-sm tg-gh" data-a="bprint">${ic('print', 14)}Print</button><button class="btn btn-sm ib tg-gh" data-a="bclr" title="Clear (Esc)">${ic('x', 14)}</button></div></div>` : ''}
      ${U.print ? printSheet() : ''}</div></div>`;
  }
  const rd = () => PG.keepScroll(render);
  function open(id){ U.pop = null; PG.openRo(id); }
  const H = {
    sel: (t, ev) => { const id = t.dataset.id; if(ev && (ev.shiftKey || ev.metaKey || ev.ctrlKey)){ if(U.sel[id]) delete U.sel[id]; else U.sel[id] = 1; rd(); return; }
      if(!U.peek || U.view !== 'list' || U.cur === id || (typeof pmOn === 'function' && pmOn())){ open(id); return; } U.cur = id; rd(); },
    cb: (t, ev) => { if(ev) ev.stopPropagation(); const id = t.dataset.id; if(U.sel[id]) delete U.sel[id]; else U.sel[id] = 1; rd(); },
    shop: () => { UI.view = 'ros'; UI.selectedRo = SHOP_RO_ID; UI.modal = null; render(); },
    grp: t => { const k = t.dataset.g; U.closed[k] = !U.closed[k]; rd(); },
    open: t => open(t.dataset.id),
    peekx: () => { U.cur = null; rd(); },
    status: t => { UI.modal = { type: 'ro-status', roId: t.dataset.id }; render(); },
    pop: (t) => { const p = t.dataset.p; if(U.pop && U.pop.type === p){ U.pop = null; rd(); return; } const ids = t.dataset.id ? [t.dataset.id] : Object.keys(U.sel); U.pop = { type: p, ids }; PG.anchor(U, t); rd(); },
    dv: t => { U.view = t.dataset.v; U.pop = null; rd(); },
    dgb: t => { U.groupBy = t.dataset.v; rd(); },
    dso: t => { U.sort = t.dataset.v; CACHE = null; rd(); },
    dpk: t => { U.peek = t.dataset.v === '1'; if(!U.peek) U.cur = null; rd(); },
    bclr: () => { U.sel = {}; rd(); },
    bset: t => { const v = t.dataset.v, ids = (U.pop && U.pop.ids) || []; let ok = 0; ids.forEach(id => { if(setRoStatus(id, v, null) !== false) ok++; }); U.pop = null; if(ok){ pushToast(`${ok} RO${ok === 1 ? '' : 's'} set to ${v}.`, true); U.sel = {}; } CACHE = null; render(); },
    xto: t => { const k = t.dataset.k, w = t.dataset.w || '', ids = (U.pop && U.pop.ids) || []; let n = 0; ids.forEach(id => { const ro = getRO(id); if(!ro) return; try{ rtSend(ro, k, k === 'tech' ? w : '', 'From the RO list', null, {}); n++; }catch(e){ console.error(e); } });
      U.pop = null; if(n){ pushToast(`${n} RO${n === 1 ? '' : 's'} sent to ${k === 'tech' ? fstN(w) : (RT_DEPT[k] || k)} — they accept it in their Inbox.`, true); U.sel = {}; } CACHE = null; scheduleSave(true); render(); },
    bprint: () => { U.print = true; rd(); setTimeout(() => { const el = $('.rq-print'); document.documentElement.classList.add('pg-print2'); try{ window.print(); } finally { document.documentElement.classList.remove('pg-print2'); U.print = false; rd(); } }, 60); }
  };
  function keydown(e){
    const k = e.key; if(e.ctrlKey || e.metaKey || e.altKey) return;
    const stop = () => { e.preventDefault(); e.stopPropagation(); e.stopImmediatePropagation(); };
    if(PG.typing(e)) return;
    if(k === '/'){ const f = $('.rq-find input'); if(f){ f.focus(); f.select(); } return stop(); }
    if(k === 'Escape'){ if(U.pop){ U.pop = null; rd(); return stop(); } if(Object.keys(U.sel).length){ U.sel = {}; rd(); return stop(); } if(U.cur){ U.cur = null; rd(); return stop(); } return; }
    if((k === 'j' || k === 'k') && U.view === 'list'){ const L = rows(), i = L.findIndex(r => r.id === U.cur); const n = L[Math.max(0, Math.min(L.length - 1, i < 0 ? 0 : i + (k === 'j' ? 1 : -1)))]; if(n){ U.cur = n.id; rd(); const el = $(`.rq-row[data-id="${n.id}"]`); if(el) el.scrollIntoView({ block: 'nearest' }); } return stop(); }
    if(k === 'Enter' && U.cur){ open(U.cur); return stop(); }
    if(k === 'x' && U.cur){ if(U.sel[U.cur]) delete U.sel[U.cur]; else U.sel[U.cur] = 1; rd(); return stop(); }
    if((k === 's' || k === 'S') && U.cur){ UI.modal = { type: 'ro-status', roId: U.cur }; render(); return stop(); }
  }
  function after(){ PG.placePop(U); }
  function fieldKey(t, ev){ if(ev.key === 'Escape'){ t.blur(); return true; } if(ev.key === 'ArrowDown' && t.closest('.rq-find')){ t.blur(); const L = rows(); if(L[0]){ U.cur = L[0].id; rd(); } ev.preventDefault(); return true; } return false; }
  PG.reg('rolist', { H, U: () => U, input: () => {}, change: () => {}, fieldKey, keydown, after });
  return { view, U: () => U, rows };
})();
function viewRoList(){ return RL.view(); }
