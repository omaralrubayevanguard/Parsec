/* ============================== Parsec 14.2 ==============================
   · The truck card's customer, year, make, model and unit change in place (rifHtml / rifVeh) — the Technician page,
     the RO list pane and the RO page — through the same field table and setter as the RO details (ROFLD, roFldSet).
   · Quoted hours change in place wherever an operation's quote shows (qtHtml): click, type, Enter.
   · The Technician page's Parts tab: Add part, From inventory…, Extract from a quote… — the RO page's three (pqAdd / pqInv / pqXtr). */
function v142E(t){ return String(t == null ? "" : t).replace(/[&<>"]/g, function(c){ return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); }
function v142Op(ro, id){ return ro ? (ro.operations || []).filter(function(o){ return o && o.id === id; })[0] || null : null; }
function v142N(ro, op){ return ro ? (ro.operations || []).indexOf(op) + 1 : 0; }
function v142Ok(ro){ try{ return typeof roFldCanEdit === "function" ? roFldCanEdit(ro) : !!ro; }catch(e){ return false; } }
/* ---------- the truck card's words ---------- */
var RIF_PH = { customerName: "Add customer", year: "Year", make: "Make", model: "Model", unitNumber: "Add unit", location: "Add spot" };
function rifHtml(ro, k, shown, ph){
  var v = shown == null ? "" : String(shown);
  if(!ro || !v142Ok(ro)) return v142E(v || ph || "");
  return '<span class="rif' + (v ? "" : " rif-e") + '" role="button" tabindex="0" data-rif-ro="' + v142E(ro.id) + '" data-rif-k="' + k + '" title="Click to change">' + v142E(v || ph || RIF_PH[k] || "Add") + "</span>";
}
/* "2020 Volvo VNL 300 · 6x4 · Mid-roof · Unit T-876" — year, make, model and unit change; what the body catalog adds stays as it is */
function rifVeh(ro, line, o){
  o = o || {}; line = String(line || "").replace(/^\s*[—-]\s*$/, ""); var segs = line.split(" · ").filter(Boolean), first = segs.shift() || "", t = first.split(/\s+/).filter(Boolean), y = "", mk = "";
  if(/^(19|20)\d{2}$/.test(t[0] || "")) y = t.shift();
  if(t.length > 1 && /^(volvo|mack|freightliner|kenworth|peterbilt|international|western star|cummins|detroit)$/i.test(t[0])) mk = t.shift();
  var yr = ro.year ? String(ro.year) : y, make = ro.make || mk, model = ro.model || t.join(" ");
  segs = segs.filter(function(s){ return !/^Unit\s/i.test(s) && !(o.dropSpot && ro.location && s === ro.location); });
  var h = [rifHtml(ro, "year", yr), rifHtml(ro, "make", make), rifHtml(ro, "model", model)].join(" ");
  if(segs.length) h += " · " + segs.map(v142E).join(" · ");
  if(!o.noUnit) h += " · Unit " + rifHtml(ro, "unitNumber", ro.unitNumber || "", "—");
  if(o.spot) h += " · " + rifHtml(ro, "location", ro.location || "", "Add spot");
  return h;
}
function rifEdit(sp){
  if(!sp || sp.querySelector("input")) return;
  var ro = getRO(sp.getAttribute("data-rif-ro")), k = sp.getAttribute("data-rif-k"), f = ro && typeof roFld === "function" ? roFld(k) : null; if(!ro || !f) return;
  var cur = roFldGet(ro, f) || (sp.classList.contains("rif-e") ? "" : sp.textContent), inp = document.createElement("input");
  inp.className = "rif-in"; inp.value = cur; inp.setAttribute("data-no-draft", ""); inp.autocomplete = "off"; inp.setAttribute("aria-label", f.l);
  var fit = function(){ inp.style.width = Math.max(4, Math.min(48, (inp.value || "").length + 2)) + "ch"; }; fit();
  sp.textContent = ""; sp.appendChild(inp); sp.classList.add("on"); inp.focus(); try{ inp.select(); }catch(e){}
  var done = false;
  function commit(keep, next){
    if(done) return; done = true; var v = inp.value.trim();
    if(keep && v !== String(cur || "").trim()){ var w = f.o.warn ? f.o.warn(v) : ""; roFldSet(ro, k, v); if(w) pushToast(w + " — saved anyway.", false); else pushToast(f.l + (v ? " · " + v : " cleared"), true); }
    v141Render();
    if(next) setTimeout(function(){ var root = sp.getRootNode ? sp.getRootNode() : document, L = Array.prototype.slice.call(root.querySelectorAll('.rif[data-rif-ro="' + ro.id + '"]')), i = L.map(function(x){ return x.getAttribute("data-rif-k"); }).indexOf(k), nx = L[i + next]; if(nx) rifEdit(nx); }, 30);
  }
  inp.addEventListener("input", fit);
  inp.addEventListener("keydown", function(ev){ ev.stopPropagation(); if(ev.key === "Enter"){ ev.preventDefault(); commit(true); } else if(ev.key === "Escape"){ ev.preventDefault(); commit(false); } else if(ev.key === "Tab"){ ev.preventDefault(); commit(true, ev.shiftKey ? -1 : 1); } });
  inp.addEventListener("blur", function(){ setTimeout(function(){ commit(true); }, 0); });
}
/* ---------- quoted hours ---------- */
function qtHtml(ro, op, q, d){
  var v = (+q || 0).toFixed(d == null ? 2 : d);
  if(!ro || !op || op.declined || !v142Ok(ro)) return v;
  return '<span class="qte" role="button" tabindex="0" data-qt-ro="' + v142E(ro.id) + '" data-qt-op="' + v142E(op.id) + '" title="Quoted hours — click to change">' + v + "</span>";
}
/* an RO's total: it changes only when one operation carries the quote */
function qtRoHtml(ro, q, d){
  var L = (ro && ro.operations || []).filter(function(o){ return o && !o.declined && (o.complaint || +o.quoted); });
  return L.length === 1 ? qtHtml(ro, L[0], q, d) : (+q || 0).toFixed(d == null ? 2 : d);
}
function qtSet(ro, op, v){
  var was = +op.quoted || 0; if(Math.abs(was - v) < .001) return false;
  pushUndo("quoted hours"); op.quoted = v ? String(v) : "";
  try{ audit("ro", roLabel(ro) + ": Op " + v142N(ro, op) + " quoted " + was.toFixed(2) + " → " + v.toFixed(2) + " h", ro); }catch(e){}
  scheduleSave(true); pushToast("Op " + v142N(ro, op) + " quoted " + v.toFixed(2) + " h.", true); return true;
}
function qtEditIn(host, ro, op){
  if(!host || !ro || !op || host.querySelector("input")) return;
  var q = +op.quoted || 0, inp = document.createElement("input");
  inp.className = "qte-in"; inp.value = q > 0 ? q.toFixed(2) : ""; inp.inputMode = "decimal"; inp.setAttribute("aria-label", "Quoted hours"); inp.setAttribute("data-no-draft", ""); inp.autocomplete = "off";
  host.textContent = ""; host.appendChild(inp); host.classList.add("on"); inp.focus(); try{ inp.select(); }catch(e){}
  var done = false;
  function commit(keep){ if(done) return; done = true; var s = String(inp.value).replace(/[^\d.]/g, ""), v = s ? Math.round(parseFloat(s) * 100) / 100 : 0;
    if(keep && isFinite(v) && v >= 0 && v < 1000) qtSet(ro, op, v); v141Render(); }
  inp.addEventListener("keydown", function(ev){ ev.stopPropagation(); if(ev.key === "Enter" || ev.key === "Tab"){ ev.preventDefault(); commit(true); } else if(ev.key === "Escape"){ ev.preventDefault(); commit(false); } });
  inp.addEventListener("blur", function(){ setTimeout(function(){ commit(true); }, 0); });
}
function qtEdit(sp){ var ro = getRO(sp.getAttribute("data-qt-ro")); qtEditIn(sp, ro, v142Op(ro, sp.getAttribute("data-qt-op"))); }
/* the clock card's Quoted on the Technician page (the RO page has its own) */
function qtEditCell(cell, roId, opId){ var ro = getRO(roId), op = v142Op(ro, opId), b = cell && cell.querySelector("b"); if(b && v142Ok(ro)) qtEditIn(b, ro, op); }
(function(){ var n = 0, f = function(){ try{ if(typeof OCK_CB !== "undefined" && OCK_CB.tc){ if(!OCK_CB.tc.editQ) OCK_CB.tc.editQ = qtEditCell; return; } }catch(e){} if(++n < 40) setTimeout(f, 250); }; setTimeout(f, 0); })();
/* one listener for both, in the page and inside the RO page (its own root) */
function v142Tgt(e){ var t = (e.composedPath && e.composedPath()[0]) || e.target; if(t && t.nodeType !== 1) t = t.parentElement; return t && t.closest ? t : null; }
document.addEventListener("click", function(e){
  var t = v142Tgt(e); if(!t) return;
  var q = t.closest(".qte"), r = q ? null : t.closest(".rif");
  if(!q && !r) return;
  e.stopPropagation(); if(t.closest("input")) return; e.preventDefault();
  if(q) qtEdit(q); else rifEdit(r);
}, true);
["mousedown", "dblclick"].forEach(function(ev){ document.addEventListener(ev, function(e){ var t = v142Tgt(e); if(t && (t.closest(".qte") || t.closest(".rif"))) e.stopPropagation(); }, true); });
document.addEventListener("keydown", function(e){
  if(e.key !== "Enter" && e.key !== " ") return; var t = v142Tgt(e); if(!t || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;
  var q = t.closest(".qte"), r = q ? null : t.closest(".rif"); if(!q && !r) return;
  e.preventDefault(); e.stopPropagation(); if(q) qtEdit(q); else rifEdit(r);
}, true);
/* ---------- the Technician page's Parts tab: add a part three ways ---------- */
var PQ = { el: null };
function pqClose(){ if(PQ.el){ PQ.el.remove(); PQ.el = null; } document.removeEventListener("keydown", pqKey, true); document.removeEventListener("mousedown", pqOut, true); }
function pqKey(e){ if(e.key === "Escape"){ e.preventDefault(); e.stopPropagation(); pqClose(); } }
function pqOut(e){ if(PQ.el && !PQ.el.contains(e.target)) pqClose(); }
function pqOpen(anchor, title, sub, body, wide){
  pqClose(); var d = document.createElement("div"); d.className = "pq-pop" + (wide ? " w" : ""); d.setAttribute("role", "dialog"); d.setAttribute("aria-label", title);
  d.innerHTML = '<div class="pq-h"><b>' + v142E(title) + "</b>" + (sub ? "<small>" + v142E(sub) + "</small>" : "") + '<button type="button" class="pq-x" aria-label="Close">×</button></div><div class="pq-b">' + body + "</div>";
  document.body.appendChild(d); PQ.el = d;
  var r = anchor.getBoundingClientRect(), w = d.offsetWidth, h = d.offsetHeight, x = Math.max(12, Math.min(window.innerWidth - w - 12, r.right - w)), y = r.bottom + 6;
  if(y + h > window.innerHeight - 12) y = Math.max(12, r.top - h - 6);
  d.style.left = x + "px"; d.style.top = y + "px";
  d.querySelector(".pq-x").addEventListener("click", pqClose);
  setTimeout(function(){ document.addEventListener("keydown", pqKey, true); document.addEventListener("mousedown", pqOut, true); }, 0);
  return d;
}
function pqMoney(v){ var n = Number(v); return isFinite(n) && n > 0 ? "$" + n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ""; }
function pqPart(desc, pn, qty, price, eta){ var p = { id: "pt_" + uid(), description: desc || "", partNumber: pn || "", eta: eta || "", qty: String(qty || "1"), status: "Not Ordered", statusChangedAt: new Date().toISOString() }; if(Number(price) > 0) p.price = String(price); return p; }
function pqAddParts(ro, op, L, how){
  if(!L.length) return 0; var nInv = 0; op.parts = Array.isArray(op.parts) ? op.parts : [];
  L.forEach(function(p){ op.parts.push(p); try{ if(invAddFromPart(p, ro.roNumber)) nInv++; }catch(e){} });
  try{ audit("ro", roLabel(ro) + ": Op " + v142N(ro, op) + " — " + L.length + " part" + (L.length === 1 ? "" : "s") + " added " + how, ro); }catch(e){}
  scheduleSave(true); return nInv;
}
function pqCtx(roId, opId){ var ro = getRO(roId), op = v142Op(ro, opId); return ro && op ? { ro: ro, op: op } : null; }
function pqAdd(anchor, roId, opId){
  var C = pqCtx(roId, opId); if(!C) return;
  var d = pqOpen(anchor, "Add a part", "Op " + v142N(C.ro, C.op) + " · " + (C.op.complaint || ""), '<input class="pq-in" placeholder="e.g. 4988201 x2 brake chamber $45.99" autocomplete="off" data-no-draft><small class="pq-n">Enter adds it and keeps this open for the next · Esc closes</small>');
  var inp = d.querySelector(".pq-in"), note = d.querySelector(".pq-n"); inp.focus();
  inp.addEventListener("keydown", function(ev){ ev.stopPropagation(); if(ev.key === "Escape"){ pqClose(); return; } if(ev.key !== "Enter") return; ev.preventDefault();
    var qp = parseQuickPart(inp.value); if(!qp.desc && !qp.pn) return;
    pushUndo("add part"); pqAddParts(C.ro, C.op, [pqPart(qp.desc, qp.pn, qp.qty, qp.price)], "by hand");
    note.textContent = "Added " + (qp.desc || qp.pn) + " — type the next one, or Esc."; inp.value = ""; render(); pushToast("Added " + (qp.desc || qp.pn) + " to Op " + v142N(C.ro, C.op) + ".", true); setTimeout(function(){ if(PQ.el) inp.focus(); }, 30); });
}
function pqInv(anchor, roId, opId){
  var C = pqCtx(roId, opId); if(!C) return; try{ invSyncAll(); }catch(e){}
  var d = pqOpen(anchor, "From inventory", "Op " + v142N(C.ro, C.op) + " · " + (C.op.complaint || ""), '<input class="pq-in" type="search" placeholder="Search description, part #, engine, model…" autocomplete="off" data-no-draft><div class="pq-list"></div><small class="pq-n"></small>', true);
  var inp = d.querySelector(".pq-in"), list = d.querySelector(".pq-list"), note = d.querySelector(".pq-n"), added = 0, L = [];
  var hay = function(it){ return [it.desc, it.pn, it.engine, it.year, it.model].concat((it.children || []).map(function(c){ return c.desc + " " + c.pn; })).join(" ").toLowerCase(); };
  function paint(){
    var q = inp.value.toLowerCase().trim(); L = invList().filter(function(it){ return !q || hay(it).indexOf(q) > -1; }).slice(0, 60);
    list.innerHTML = L.length ? L.map(function(it, i){ var meta = [it.pn || "no part #", it.engine, it.model].filter(Boolean).join(" · ");
      return '<div class="pq-r"><span class="pq-d"><b>' + (it.kit ? '<em class="pq-kit">KIT · ' + (it.children || []).length + "</em> " : "") + v142E(it.desc || "(no description)") + "</b><small>" + v142E(meta) + (pqMoney(it.price) ? " · " + pqMoney(it.price) : "") + '</small></span><input class="pq-q" type="number" min="1" step="1" value="' + (parseFloat(it.qty) > 0 && !it.kit ? 1 : 1) + '" aria-label="Quantity"><button type="button" class="btn btn-sm pq-a" data-i="' + i + '">' + (it.kit ? "Add kit" : "Add") + "</button></div>"; }).join("")
      : '<div class="pq-e">' + (invList().length ? "Nothing on the Parts page matches “" + v142E(inp.value) + "”." : "The Parts page is empty — parts you add to ROs show up here.") + "</div>";
  }
  list.addEventListener("click", function(e){ var b = e.target.closest(".pq-a"); if(!b) return; e.stopPropagation(); var it = L[+b.getAttribute("data-i")]; if(!it) return;
    var n = Math.max(1, parseFloat(b.previousElementSibling.value) || 1), P = [];
    if(it.kit) (it.children || []).forEach(function(c){ P.push(pqPart(c.desc, c.pn, (parseFloat(c.qty) || 1) * n, c.price)); }); else P.push(pqPart(it.desc, it.pn, n, it.price));
    pushUndo("add part from inventory"); pqAddParts(C.ro, C.op, P, "from inventory"); added += P.length;
    b.textContent = "Added ✓"; b.disabled = true; note.textContent = added + " part line" + (added === 1 ? "" : "s") + " added to Op " + v142N(C.ro, C.op) + "."; render(); });
  inp.addEventListener("input", paint); inp.addEventListener("keydown", function(ev){ ev.stopPropagation(); if(ev.key === "Escape") pqClose(); });
  paint(); inp.focus();
}
function pqXtr(anchor, roId, opId){
  var C = pqCtx(roId, opId); if(!C) return;
  var d = pqOpen(anchor, "Extract from a quote", "Op " + v142N(C.ro, C.op) + " · " + (C.op.complaint || ""), '<textarea class="pq-ta" rows="6" placeholder="Paste a parts list, quote or invoice — one part per line." data-no-draft></textarea><div class="pq-tools"><button type="button" class="btn btn-sm pq-file">Screenshot or PDF…</button><input type="file" accept="image/*,.pdf,application/pdf" multiple style="display:none"><small class="pq-st"></small></div><div class="pq-list"></div><div class="pq-f"><button type="button" class="btn btn-sm pq-cancel">Cancel</button><button type="button" class="btn btn-sm btn-primary pq-go" disabled>Add parts</button></div>', true);
  var ta = d.querySelector(".pq-ta"), list = d.querySelector(".pq-list"), st = d.querySelector(".pq-st"), go = d.querySelector(".pq-go"), fi = d.querySelector('input[type="file"]'), found = [], pick = {};
  function count(){ var n = found.filter(function(p, i){ return pick[i]; }).length; go.textContent = n ? "Add " + n + " part" + (n === 1 ? "" : "s") : "Add parts"; go.disabled = !n; }
  function paint(){
    found = []; try{ found = parsePartsText(ta.value) || []; }catch(e){}
    list.innerHTML = found.length ? found.map(function(p, i){ if(pick[i] === undefined) pick[i] = true;
      return '<label class="pq-r x"><input type="checkbox" data-i="' + i + '"' + (pick[i] ? " checked" : "") + '><span class="pq-d"><b>' + v142E(p.desc || "—") + "</b><small>" + v142E(p.pn || "no part #") + " · ×" + v142E(p.qty || 1) + (pqMoney(p.price) ? " · " + pqMoney(p.price) : "") + (p.eta ? " · ETA " + v142E(String(p.eta).slice(5)) : "") + "</small></span></label>"; }).join("")
      : '<div class="pq-e">' + (ta.value.trim() ? "No parts found in that text yet." : "Parts show up here as you paste.") + "</div>";
    count();
  }
  list.addEventListener("change", function(e){ var c = e.target.closest("input[data-i]"); if(c){ pick[+c.getAttribute("data-i")] = c.checked; count(); } });
  ta.addEventListener("input", function(){ pick = {}; paint(); }); ta.addEventListener("keydown", function(ev){ ev.stopPropagation(); if(ev.key === "Escape") pqClose(); });
  d.querySelector(".pq-file").addEventListener("click", function(){ fi.click(); });
  fi.addEventListener("change", function(){ var fs = Array.prototype.slice.call(fi.files || []); if(!fs.length) return;
    var pdf = fs.filter(function(f){ return /pdf$/i.test(f.type) || /\.pdf$/i.test(f.name); })[0], imgs = fs.filter(function(f){ return /^image\//.test(f.type); });
    st.textContent = pdf ? "Reading the PDF…" : "Reading the screenshot" + (imgs.length > 1 ? "s" : "") + "…";
    (pdf ? pdfToText(pdf) : ocrImages(imgs).then(cleanOcrText)).then(function(text){ ta.value = (ta.value.trim() ? ta.value.trim() + "\n" : "") + String(text || "").trim(); pick = {}; paint();
      st.textContent = found.length ? found.length + " part line" + (found.length === 1 ? "" : "s") + " found — untick any you don’t want." : "Read it, but found no part lines — you can edit the text."; },
      function(){ st.textContent = "Couldn’t read that file here — paste the text instead."; });
    fi.value = ""; });
  d.querySelector(".pq-cancel").addEventListener("click", pqClose);
  go.addEventListener("click", function(){ var add = found.filter(function(p, i){ return pick[i]; }); if(!add.length) return;
    pushUndo("extract parts"); var nInv = pqAddParts(C.ro, C.op, add.map(function(q){ return pqPart(q.desc, q.pn, q.qty, q.price, q.eta); }), "from a quote");
    pqClose(); render(); pushToast(add.length + " part" + (add.length === 1 ? "" : "s") + " added to Op " + v142N(C.ro, C.op) + (nInv ? " · " + nInv + " new on the Parts page" : "") + ".", true); });
  paint(); ta.focus();
}
