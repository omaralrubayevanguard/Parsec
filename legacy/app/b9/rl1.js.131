/* ============================== RO list (RO list mock-up, layout C: the list and a peek pane) ==============================
   Open is one flat list, oldest first, the status at the start of the complaint; Mine · Working · Waiting · Hold · Done
   group by status (or stage, or tech). Click a row and the RO opens in a pane beside the list — Enter or Open RO goes to
   the RO page. Select rows for Set status · Transfer · Print. Display picks List or Board, grouping and sort. */
var RL = (function(){
  const esc = PG.e, ic = PG.ic, kbd = PG.kbd;
  const R0 = () => document.querySelector('[data-pg="rolist"]') || document;
  const $ = s => R0().querySelector(s);
  let U = null, DIRTY = false;
  function reset(){ U = { view: 'list', groupBy: 'status', sort: 'days', sel: {}, cur: null, closed: {}, pop: null, peek: true, print: false, cs: null, cfEdit: null, cfNew: '' }; }
  reset();
  const STG = ['checkin', 'diag', 'approval', 'parts', 'repair', 'roadtest', 'closeout'];
  const STGN = { checkin: 'Check-in', diag: 'Diag', approval: 'Approval', parts: 'Parts', repair: 'Repair', roadtest: 'Road test', closeout: 'Close-out' };
  const STK = { 'Hold Tech': 'hold', 'Working': 'working', 'Waiting – Parts': 'parts', 'Waiting – Foreman': 'foreman', 'Waiting – Tech Support': 'support', 'Waiting – Customer': 'customer', 'Complete – Road test': 'roadtest', 'Complete – Released': 'released', 'Declined': 'declined' };
  const GORDER = ['working', 'roadtest', 'parts', 'customer', 'support', 'foreman', 'hold', 'released', 'declined'];
  const GNAME = { working: 'Working', roadtest: 'Complete – Road test', parts: 'Waiting – Parts', customer: 'Waiting – Customer', support: 'Waiting – Tech support', foreman: 'Waiting – Foreman', hold: 'Hold tech', released: 'Complete – Released', declined: 'Declined' };
  const SHORT = { working: 'Working', roadtest: 'Road test', parts: 'Parts', customer: 'Customer', support: 'Tech support', foreman: 'Foreman', hold: 'Hold tech', released: 'Released', declined: 'Declined' };
  const si = k => TG_SI[k] || TG_SI.hold;
  const RLG = 'r' + 'l-group';   /* the app's own action — kept out of the class renaming */
  const fstN = n => String(n || '').split(' ')[0];
  const DAYN = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const hm = d => d.getHours() + ':' + String(d.getMinutes()).padStart(2, '0');
  /* ---------- one RO, as the list draws it ---------- */
  function info(ro){
    const s = roStatus(ro), k = STK[s.status] || (/^Complete/.test(s.status) ? 'released' : 'hold'), done = roIsDone(ro);
    let f = null; try{ f = roForecast(ro); }catch(e){}
    let M = null; try{ M = roStages(ro, f); }catch(e){}
    const ops = (ro.operations || []).filter(o => o && o.id && !o.declined);
    let b = 0, q = 0; ops.forEach(o => { q += +o.quoted || 0; try{ b += opCalc(o).burntHrs || 0; }catch(e){} });
    const live = STATE.punches.some(p => !p.stop && p.roId === ro.id);
    const T = M ? M.list.map(x => x.state === 'd' ? 'done' : x.state === 'x' ? 'skip' : x.state === 'w' ? 'wait' : (x.state === 'n' || x.state === 'c') ? 'now' : '') : STG.map(() => '');
    const stage = M && M.cur ? M.cur.name : (done ? 'Close-out' : 'Check-in');
    let ready = '—', readyT = '9';
    if(done){ const at = ro.dateClosed || (ro.status && ro.status.setAt); if(at){ const d = new Date(at); ready = 'Released ' + DAYN[d.getDay()]; readyT = '0' + at; } }
    else if(f && f.likely){ const d = f.likely, t0 = new Date(); t0.setHours(0, 0, 0, 0); const dd0 = Math.round((new Date(d).setHours(0, 0, 0, 0) - t0) / 86400000); ready = (dd0 <= 0 ? 'Today' : dd0 === 1 ? 'Tomorrow' : dd0 < 7 ? DAYN[d.getDay()] : PG.day ? PG.day(localDay(d.toISOString())) : localDay(d.toISOString())) + ' ' + hm(d); readyT = d.toISOString(); }
    const warr = !!ro.warranty || ops.some(o => { const t = opJobType(o); return t === 'WARR' || t === 'RECALL'; });
    let tm = null; try{ tm = truckYM(ro); }catch(e){}
    return { ro, id: ro.id, no: tgNum(ro), cust: ro.customerName || '—', unit: ro.unitNumber || '', veh: (tm && tm.line) || [ro.year, ro.make, ro.model].filter(Boolean).join(' ') || '—',
      st: s.status, sub: s.sub || '', k, grp: roGroupOf(ro), done, tech: ro.assignedTech || '', spot: (typeof spotOf === 'function' && spotOf(ro.location)) || ro.location || '—',
      days: daysOpen(ro), b, q, ops, cmp: ops[0] ? String(ops[0].complaint || '').trim() : '', live, T, stage, M, f, ready, readyT, warr, nx: nextStep(ro, s.status, ops, live), si: ['checkin', 'diag', 'approval', 'parts', 'repair', 'roadtest', 'closeout'].indexOf(Object.keys(STGN).find(x => STGN[x] === stage) || '') };
  }
  /* Parsec 13.1: the next step — what has to happen next, and who has it */
  function nextStep(ro, st, live, running){
    const who = k => { try{ return k === 'tech' ? (ro.assignedTech || '') : (rtPerson(k) || ''); }catch(e){ return ''; } };
    const N = (t, w, tone) => ({ t, w: w || '', tone: tone || 'info' });
    const parts = []; live.forEach(o => { try{ opRealParts(o).forEach(p => parts.push({ o, p })); }catch(e){} });
    const nm = x => String(x.p.description || x.p.partNumber || 'part').replace(/\s+-\s+.*$/, '');
    if(!live.length) return N('Add the first operation', who('writer'), 'hold');
    if(st === 'Complete – Released') return N('Nothing left — released', '', 'good');
    if(st === 'Declined') return N('Declined — nothing to do', '', 'hold');
    if(st === 'Complete – Road test') return N('Release the truck', who('writer'), 'good');
    if(running){ const p = STATE.punches.filter(x => !x.stop && x.roId === ro.id)[0], op = p && live.find(o => o.id === p.opId); return N('Working' + (op ? ' · Op ' + raN(ro, op) + ' — ' + String(op.complaint || '').replace(/\s+-\s+.*$/, '') : ''), (p && (p.by || ro.assignedTech)) || who('tech'), 'run'); }
    const bo = parts.filter(x => x.p.status === 'Backordered');
    if(bo.length) return N('Chase the backorder · ' + nm(bo[0]) + (bo[0].p.eta ? ' (ETA ' + bo[0].p.eta + ')' : ''), who('parts'), 'bad');
    const no = parts.filter(x => !x.p.status || x.p.status === 'Not Ordered');
    if(no.length) return N(no.length === 1 ? 'Order the ' + nm(no[0]).toLowerCase() : 'Order ' + no.length + ' parts', who('parts'), 'warn');
    if(st === 'Waiting – Customer'){ let ag = 0; try{ ag = ageSince(ro.status && ro.status.setAt); }catch(e){} return N('Customer approval' + (ag ? ' · ' + ageText(ag) : ''), who('writer'), ag > 86400000 ? 'bad' : 'teal'); }
    const unap = live.filter(o => !o.appr && +o.quoted > 0 && !opDoneNow(o) && ['WARR', 'RECALL'].indexOf(opJobType(o)) < 0);
    if(unap.length && st !== 'Working') return N('Send the estimate', who('writer'), 'teal');
    const out = parts.filter(x => x.p.status === 'Ordered');
    if(out.length && live.every(o => opDoneNow(o) || opRealParts(o).some(p => p.status === 'Ordered'))){ const eta = out.map(x => x.p.eta).filter(Boolean).sort()[0]; return N(eta ? 'Parts due ' + eta : 'Waiting on ' + (out.length === 1 ? 'a part' : out.length + ' parts'), who('parts'), 'warn'); }
    const gap = live.filter(o => { const c = raCcc(o); return opDoneNow(o) && (!c.ca || !c.co); })[0];
    if(gap) return N('Write the story · Op ' + raN(ro, gap), who('tech'), 'warn');
    if(live.every(opDoneNow)) return N(ro.roadTest && ro.roadTest.result === 'Pass' ? 'Release the truck' : 'Road test', ro.roadTest && ro.roadTest.result === 'Pass' ? who('writer') : who('foreman'), 'good');
    const nx = live.filter(o => !opDoneNow(o))[0];
    return N('Op ' + raN(ro, nx) + ' — ' + String(nx.complaint || 'operation').replace(/\s+-\s+.*$/, ''), who('tech'), 'info');
  }
  let CACHE = null;
  function rows(){
    const key = [STATE.savedAt || '', STATE.ros.length, STATE.punches.length, UI.rlGroup || 'all', UI.roFilter || '', U.sort, todayStr()].join('|');
    if(CACHE && CACHE.key === key) return CACHE.L;
    const L = rlList().map(info).sort((a, b) => U.sort === 'no' ? String(a.ro.roNumber || a.no).localeCompare(String(b.ro.roNumber || b.no), undefined, { numeric: true }) : U.sort === 'ready' ? (a.readyT < b.readyT ? -1 : a.readyT > b.readyT ? 1 : 0) : (b.days || 0) - (a.days || 0));
    CACHE = { key, L }; return L;
  }
  function counts(){
    const me = rlMe(), c = { all: 0, mine: 0, working: 0, waiting: 0, hold: 0, done: 0, late: 0, live: 0 };
    STATE.ros.forEach(ro => { if(ro.id === SHOP_RO_ID || ro.shop || !roMatchesFilter(ro, UI.roFilter)) return; const g = roGroupOf(ro); c[g]++;
      if(g !== 'done'){ c.all++; if(me && techSame(ro.assignedTech, me)) c.mine++; const d = daysOpen(ro); if(d != null && d >= 7) c.late++; if(STATE.punches.some(p => !p.stop && p.roId === ro.id)) c.live++; } });
    return c;
  }
  /* ---------- drawing ---------- */
  const ticks = r => `<span class="rl-ticks" title="${esc(r.stage)}">${r.T.map(t => `<i class="${t}"></i>`).join('')}</span>`;
  const mini = (b, q) => `<span class="rl-mini"><i${b > q ? ' class="over"' : ''} style="width:${q ? Math.min(100, b / q * 100) : (b ? 100 : 0)}%"></i></span>`;
  const av = n => n ? `<span class="tg-av" title="${esc(n)}">${esc(PG.ini(n))}</span>` : '<span class="tg-av" title="Unassigned">—</span>';
  /* ---------- Parsec 13.1: the columns — drag them into any order, add fields or your own, sort by any of them ---------- */
  const NUM = x => { const n = parseFloat(String(x == null ? '' : x).replace(/[^0-9.]/g, '')); return isNaN(n) ? null : n; };
  const TONE = { bad: 0, warn: 1, teal: 2, run: 3, info: 4, hold: 5, good: 6 };
  const dShort = iso => { if(!iso) return '—'; const d = new Date(iso); return isNaN(d) ? '—' : DAYN[d.getDay()] + ' ' + (d.getMonth() + 1) + '/' + d.getDate(); };
  const partsOf = r => { const L = []; r.ops.forEach(o => { try{ opRealParts(o).forEach(p => L.push(p)); }catch(e){} }); return L; };
  const inHand = p => p.status === 'Received' || p.status === 'Installed' || p.sup === 'stock';
  const nxHtml = r => `<span class="rl-nx t-${r.nx.tone}" title="${esc(r.nx.t + (r.nx.w ? ' — ' + r.nx.w : ''))}"><i></i><span class="t">${esc(r.nx.t)}</span>${r.nx.w ? `<span class="w">${esc(fstN(r.nx.w))}</span>` : ''}</span>`;
  const FIELD = {
    ro:      { l: 'RO', w: '108px', min: 108, fixed: 1, cell: r => `<span class="rl-no">${r.live ? '<i class="rl-live" title="On the clock"></i>' : ''}${esc(r.no)}</span><span class="rl-trk">${trkThumb(r.ro)}</span>`, sort: r => NUM(r.no) },
    cust:    { l: 'Customer', w: 'minmax(130px,1.2fr)', min: 130, cell: r => `<span class="rl-cu"><b>${esc(r.cust)}</b>${r.why ? `<small class="rl-why">${esc(r.why)}</small>` : r.unit ? `<small>Unit ${esc(r.unit)}</small>` : ''}${r.warr ? `<span class="rl-tag">${ic('warranty', 12)}WARR</span>` : ''}</span>`, sort: r => r.cust.toLowerCase() },
    status:  { l: 'Status', w: 'minmax(110px,.8fr)', min: 110, cell: r => `<span class="rl-st">${si(r.k)}<span>${esc(SHORT[r.k] === r.st ? r.st : r.st)}${r.sub ? `<em> · ${esc(r.sub)}</em>` : ''}</span></span>`, sort: r => GORDER.indexOf(r.k) * 100 + (r.sub ? 1 : 0) },
    next:    { l: 'Next step', w: 'minmax(170px,1.8fr)', min: 170, cell: nxHtml, sort: r => TONE[r.nx.tone] * 1000 + (r.nx.w ? 0 : 500), sort2: r => r.nx.t.toLowerCase() },
    stage:   { l: 'Stage', w: '70px', min: 70, peek: 1, cell: r => ticks(r), sort: r => r.si },
    time:    { l: 'Time', w: '112px', min: 112, peek: 1, cell: r => `<span class="rl-time">${mini(r.b, r.q)}<span>${r.b.toFixed(2)} <em>/ ${r.q.toFixed(2)}</em></span></span>`, sort: r => r.b },
    tech:    { l: 'Tech', w: '40px', min: 40, cell: r => av(r.tech), sort: r => r.tech ? r.tech.toLowerCase() : null },
    spot:    { l: 'Spot', w: '52px', min: 52, peek: 1, cell: r => `<span class="rl-sub">${esc(r.spot)}</span>`, sort: r => r.spot === '—' ? null : r.spot },
    ready:   { l: 'Ready by', w: '100px', min: 100, peek: 1, cell: r => `<span class="rl-sub">${esc(r.ready)}</span>`, sort: r => r.readyT && r.readyT !== '9' ? r.readyT : null },
    days:    { l: 'Open', w: '48px', min: 48, r: 1, cell: r => `<span class="rl-days${r.days != null && r.days >= 7 && !r.done ? ' late' : ''}">${r.days == null ? '—' : r.days === 0 ? 'today' : r.days + 'd'}</span>`, sort: r => r.days == null ? -1 : r.days },
    /* more fields — off until you add them from Display */
    cmp:     { l: 'Complaint', w: 'minmax(150px,1.3fr)', min: 150, cell: r => `<span class="rl-cmp">${esc(r.cmp || 'No operations yet')}${r.ops.length > 1 ? `<em>+${r.ops.length - 1}</em>` : ''}</span>`, sort: r => r.cmp.toLowerCase() },
    unit:    { l: 'Unit #', w: '72px', min: 72, cell: r => esc(r.unit || '—'), sort: r => r.unit || null },
    truck:   { l: 'Truck', w: 'minmax(130px,1fr)', min: 130, cell: r => esc(r.veh), sort: r => r.veh.toLowerCase() },
    vin:     { l: 'VIN', w: '156px', min: 156, cell: r => `<span class="rl-mono">${esc(r.ro.vin || '—')}</span>`, sort: r => r.ro.vin || null },
    mileage: { l: 'Mileage', w: '84px', min: 84, r: 1, cell: r => { const n = NUM(r.ro.mileage); return n == null ? '—' : n.toLocaleString('en-US'); }, sort: r => NUM(r.ro.mileage) },
    hours:   { l: 'Engine hrs', w: '84px', min: 84, r: 1, cell: r => { const n = NUM(r.ro.engineHours); return n == null ? '—' : n.toLocaleString('en-US'); }, sort: r => NUM(r.ro.engineHours) },
    engine:  { l: 'Engine', w: '124px', min: 124, cell: r => esc(r.ro.engineType || '—'), sort: r => r.ro.engineType || null },
    keytag:  { l: 'Key tag', w: '64px', min: 64, cell: r => esc(r.ro.keyTag || '—'), sort: r => NUM(r.ro.keyTag) },
    opened:  { l: 'Opened', w: '84px', min: 84, cell: r => esc(dShort(r.ro.dateOpened)), sort: r => r.ro.dateOpened || null },
    case:    { l: 'Case #', w: '96px', min: 96, cell: r => esc(r.ro.caseNumber || r.ro.techSupportCase || '—'), sort: r => r.ro.caseNumber || r.ro.techSupportCase || null },
    ops:     { l: 'Operations', w: '84px', min: 84, cell: r => { const d = r.ops.filter(o => { try{ return opDoneNow(o); }catch(e){ return false; } }).length; return r.ops.length ? `${d} of ${r.ops.length} done` : '—'; }, sort: r => r.ops.length },
    parts:   { l: 'Parts', w: '84px', min: 84, cell: r => { const L = partsOf(r); return L.length ? `${L.filter(inHand).length} of ${L.length} in` : '—'; }, sort: r => { const L = partsOf(r); return L.length ? L.filter(inHand).length / L.length : 2; } },
    warranty:{ l: 'Warranty', w: '84px', min: 84, cell: r => { const R0 = r.ops.some(o => opJobType(o) === 'RECALL'); return r.warr ? (R0 ? 'Recall' : 'Warranty') : '—'; }, sort: r => r.warr ? 0 : 1 }
  };
  const DEF_COLS = ['ro', 'cust', 'status', 'next', 'stage', 'time', 'tech', 'spot', 'ready', 'days'];
  const MORE = ['cmp', 'unit', 'truck', 'vin', 'mileage', 'hours', 'engine', 'keytag', 'opened', 'case', 'ops', 'parts', 'warranty'];
  function customs(){ return Array.isArray(STATE.rlCustom) ? STATE.rlCustom : []; }
  function colDef(k){
    if(String(k).indexOf('c:') === 0){ const c = customs().find(x => 'c:' + x.id === k); if(!c) return null;
      return { l: c.name, w: 'minmax(110px,.8fr)', min: 110, custom: c, cell: r => cfCell(r, c), sort: r => { const v = String((r.ro.cf || {})[c.id] || '').trim(); const n = NUM(v); return v === '' ? null : n != null && /^[\s$#\d.,\-]+$/.test(v) ? n : v.toLowerCase(); } }; }
    return FIELD[k] || null;
  }
  const layKey = () => (PG.me() || {}).name || 'Admin';
  function cols(){ const M = STATE.rlLayout && STATE.rlLayout[layKey()]; const L = (M && Array.isArray(M.cols) ? M.cols : DEF_COLS).filter(k => colDef(k)); if(L.indexOf('ro') < 0) L.unshift('ro'); return L; }
  function colsSet(L){ if(!STATE.rlLayout || typeof STATE.rlLayout !== 'object') STATE.rlLayout = {}; STATE.rlLayout[layKey()] = { cols: L.slice(), at: nowIso() }; CACHE = null; scheduleSave(true); }
  function shown(){ const peekOn = U.peek && U.view === 'list' && U.cur; return cols().filter(k => !(peekOn && (colDef(k) || {}).peek)); }
  function gridVars(){ const L = shown(); const tr = ['18px'].concat(L.map(k => colDef(k).w), ['24px']); const min = 18 + 24 + L.reduce((a, k) => a + (colDef(k).min || 80), 0) + 12 * (L.length + 1) + 12;
    return `--cols:${tr.join(' ')};--rl-minw:${min}px`; }
  /* your own columns: type straight into the cell */
  function cfCell(r, c){
    const v = String((r.ro.cf || {})[c.id] || '');
    if(U.cfEdit && U.cfEdit.id === r.id && U.cfEdit.c === c.id) return `<input class="rl-cfin" data-in="cf" data-id="${r.id}" data-c="${esc(c.id)}" value="${esc(v)}" placeholder="${esc(c.name)}" autocomplete="off" data-no-draft>`;
    return `<span class="rl-cf" data-a="cfed" data-id="${r.id}" data-c="${esc(c.id)}" title="Click to type — ${esc(c.name)}">${v ? esc(v) : '<i>—</i>'}</span>`;
  }
  function cfSave(id, cid, v){ const ro = getRO(id); if(!ro) return; v = String(v == null ? '' : v).trim().slice(0, 120); const was = String((ro.cf || {})[cid] || ''); U.cfEdit = null; if(v === was){ rd(); return; }
    pushUndo('RO list column'); ro.cf = ro.cf || {}; if(v) ro.cf[cid] = v; else delete ro.cf[cid]; CACHE = null; scheduleSave(true); rd(); }
  /* sorting by a column header — the whole list, the groups fold while it's on */
  function cmpBy(k, dir){ const d = colDef(k); if(!d) return () => 0;
    return (a, b) => { let x = d.sort(a), y = d.sort(b); if(x == null && y == null) x = y = 0; else if(x == null) return 1; else if(y == null) return -1;
      let c = typeof x === 'number' && typeof y === 'number' ? x - y : typeof x === 'number' ? -1 : typeof y === 'number' ? 1 : String(x).localeCompare(String(y), undefined, { numeric: true, sensitivity: 'base' });
      if(!c && d.sort2) c = String(d.sort2(a)).localeCompare(String(d.sort2(b)));
      return c * dir; }; }
  function ordered(L){ if(!U.cs || !colDef(U.cs.k)) return L; return L.slice().sort(cmpBy(U.cs.k, U.cs.dir)); }
  function headHtml(){
    const L = shown();
    return `<div class="rl-head"><span></span>${L.map(k => { const d = colDef(k), on = U.cs && U.cs.k === k;
      return `<span class="rl-hc${d.r ? ' r' : ''}${on ? ' on' : ''}" data-a="hsort" data-col="${esc(k)}" draggable="true" title="Sort by ${esc(d.l)} — drag to move the column" aria-sort="${on ? (U.cs.dir > 0 ? 'ascending' : 'descending') : 'none'}"><span class="l">${esc(d.l)}</span><i class="rl-sa">${on ? (U.cs.dir > 0 ? '↑' : '↓') : ''}</i></span>`; }).join('')}<span></span></div>`;
  }
  function row(r){
    if(document.documentElement.getAttribute('data-device') === 'phone') return rowPhone(r);
    r.why = UI.roFilter ? roMatch(r.ro, UI.roFilter) : '';
    return `<div class="rl-row${U.sel[r.id] ? ' is-sel' : ''}${U.peek && U.cur === r.id ? ' is-cur' : ''}" data-a="sel" data-id="${r.id}">
      <span class="rl-cb" data-a="cb" data-id="${r.id}"></span>${shown().map(k => { const d = colDef(k); return `<span class="rl-c rl-k-${k.indexOf('c:') === 0 ? 'cf' : k}${d.r ? ' r' : ''}">${d.cell(r)}</span>`; }).join('')}
      <span class="rl-optw" data-keep-pop>${rlOptHtml(r.ro)}</span></div>`;
  }
  /* the phone keeps its card: truck, status, RO, days · customer, tech · the next step */
  function rowPhone(r){
    const late = r.days != null && r.days >= 7 && !r.done, why = UI.roFilter ? roMatch(r.ro, UI.roFilter) : '';
    return `<div class="rl-row${U.sel[r.id] ? ' is-sel' : ''}${U.peek && U.cur === r.id ? ' is-cur' : ''}" data-a="sel" data-id="${r.id}">
      <span class="rl-cb" data-a="cb" data-id="${r.id}"></span><span class="rl-no">${r.live ? '<i class="rl-live" title="On the clock"></i>' : ''}${esc(r.no)}</span>${si(r.k)}<span class="rl-trk">${trkThumb(r.ro)}</span>
      <span class="rl-cu"><b>${esc(r.cust)}</b>${why ? `<small class="rl-why">${esc(why)}</small>` : r.unit ? `<small>Unit ${esc(r.unit)}</small>` : ''}</span>
      <span class="rl-cmp">${nxHtml(r)}</span>${av(r.tech)}
      <span class="rl-days r${late ? ' late' : ''}">${r.days == null ? '—' : r.days === 0 ? 'today' : r.days + 'd'}</span>
      <span class="rl-optw" data-keep-pop>${rlOptHtml(r.ro)}</span></div>`;
  }
  function gkey(r){ return U.groupBy === 'status' ? r.k : U.groupBy === 'stage' ? r.stage : U.groupBy === 'tech' ? (r.tech || '') : 'all'; }
  function glabel(k){ if(U.groupBy === 'status') return si(k) + `<span>${GNAME[k] || k}</span>`; if(U.groupBy === 'stage') return `<span>${esc(k)}</span>`; if(U.groupBy === 'tech') return av(k) + `<span>${esc(k || 'Unassigned')}</span>`; return '<span>All</span>'; }
  function list(){
    const L = ordered(rows()), g = UI.rlGroup || 'all', flat = g === 'all' || U.groupBy === 'none' || !!U.cs;
    let h = headHtml();
    if(g !== 'done' && !UI.roFilter){ const l0 = STATE.punches.some(p => !p.stop && isShopPunch(p));
      h += `<div class="rl-row rl-shop" data-a="shop"><span></span>${shown().map(k => k === 'ro' ? `<span class="rl-c rl-k-ro"><span class="rl-no">${l0 ? '<i class="rl-live"></i>' : ''}${ic('kit', 14)}</span></span>` : k === 'cust' ? '<span class="rl-c rl-k-cust"><span class="rl-cu"><b>Shop time</b><small>clock non-RO work</small></span></span>' : k === 'next' ? '<span class="rl-c rl-k-next rl-sub">Cleaning, training, shop truck…</span>' : '<span></span>').join('')}<span></span></div>`; }
    if(U.cs && colDef(U.cs.k)) h += `<div class="rl-sortbar">${ic('sort', 13)}<span>Sorted by <b>${esc(colDef(U.cs.k).l)}</b> ${U.cs.dir > 0 ? 'A → Z, low → high' : 'Z → A, high → low'}${g !== 'all' && U.groupBy !== 'none' ? ' — the groups fold while it’s on' : ''}</span><button class="btn btn-sm tg-gh" data-a="hsclr">${ic('x', 12)}${g !== 'all' && U.groupBy !== 'none' ? 'Show the groups' : 'Clear the sort'}</button></div>`;
    if(flat) h += `<div class="rl-rows" style="margin-top:6px">${L.map(row).join('')}</div>`;
    else {
      const keys = U.groupBy === 'status' ? GORDER : U.groupBy === 'stage' ? Object.values(STGN) : [...new Set(L.map(r => r.tech || ''))].sort((a, b) => !a ? 1 : !b ? -1 : a.localeCompare(b));
      keys.forEach(k => { const G = L.filter(r => gkey(r) === k); if(!G.length) return; const ck = U.groupBy + ':' + k;
        h += `<div class="rl-grp${U.closed[ck] ? ' is-closed' : ''}" data-a="grp" data-g="${esc(ck)}"><span class="rl-chev">${ic('chevD', 14)}</span>${glabel(k)}<span class="n">${G.length}</span></div><div class="rl-rows">${G.map(row).join('')}</div>`; });
    }
    if(!L.length) h += `<div class="rl-none">${UI.roFilter ? 'Nothing matches that — check the spelling, or clear the search.' : 'Nothing here right now.'}</div>`;
    return `<div class="rl-scroll" data-scroll="rl" style="${gridVars()}">${h}</div>`;
  }
  function board(){
    const L = rows();
    return `<div class="rl-board">${STG.map(k => { const G = L.filter(r => r.stage === STGN[k]);
      return `<div class="rl-col"><div class="rl-colh"><i class="${k === 'repair' ? 'now' : ''}"></i>${STGN[k]}<span class="n">${G.length}</span></div><div class="rl-cards">${G.map(r => `<div class="rl-card" data-a="open" data-id="${r.id}">
        <div class="rl-card__top">${r.live ? '<i class="rl-live"></i>' : ''}${esc(r.no)}<span class="d${r.days >= 7 && !r.done ? ' late' : ''}">${r.days == null ? '—' : r.days === 0 ? 'today' : r.days + 'd'}</span></div>
        <h4>${esc(r.cust)}</h4><p>${esc(r.cmp || 'No operations yet')}${r.ops.length > 1 ? ` · +${r.ops.length - 1}` : ''}</p>
        <div class="rl-card__ft">${si(r.k)}<span class="s">${esc(r.sub || SHORT[r.k])}</span>${mini(r.b, r.q)}${av(r.tech)}</div></div>`).join('') || '<div class="rl-empty">Nothing here</div>'}</div></div>`; }).join('')}</div>`;
  }
  function peek(r){
    const ro = r.ro; let nx = null; try{ nx = raNext(ro); }catch(e){}
    const parts = []; r.ops.forEach(o => { try{ opRealParts(o).forEach(p => parts.push(p)); }catch(e){} });
    const pin = parts.filter(p => p.status === 'Received' || p.status === 'Installed' || p.sup === 'stock').length;
    const files = (ro.attachments || []).length + (ro.bulletins || []).reduce((s, b) => s + ((b.files || []).length), 0);
    const run = STATE.punches.filter(p => !p.stop && p.roId === ro.id);
    return `<aside class="rl-peek"><div class="rl-peek__top"><span class="id">${esc(roLabelFull(ro))}</span><span>·</span><span>${r.done ? 'closed' : r.days == null ? '' : r.days === 0 ? 'opened today' : r.days + ' days open'}</span><button class="btn btn-sm ib tg-gh" data-a="peekx" title="Close (Esc)">${ic('x', 15)}</button></div>
      <h2>${esc(r.cust)}</h2><div class="sub">${esc(r.veh)}${r.unit ? ' · Unit ' + esc(r.unit) : ''}${r.spot && r.spot !== '—' ? ' · ' + esc(r.spot) : ''}</div>
      <div class="rl-strow"><button class="rl-stbtn" data-a="status" data-id="${r.id}" title="Set status (S)">${si(r.k)}<span>${esc(r.st)}</span>${r.sub ? `<span class="s2">· ${esc(r.sub)}</span>` : ''}${ic('chevD', 13)}</button>${r.tech ? `<span class="rl-with">with ${av(r.tech)} ${esc(r.tech)}</span>` : '<span class="rl-with">no tech yet</span>'}</div>
      ${nx ? `<div class="rl-next ${nx.tone === 'bad' ? 'bad' : nx.tone === 'warn' ? 'warn' : nx.tone === 'good' ? 'good' : ''}"><div class="rl-next__head"><b>Next</b><span>${esc(r.stage)}${r.ready && r.ready !== '—' ? ' · ' + (r.done ? '' : 'ready ') + esc(r.ready) : ''}</span></div><p>${esc(nx.txt)}</p></div>` : ''}
      <div class="rl-tots"><div><span>${ic('clock', 13)}Time</span><b>${r.b.toFixed(2)}<em> / ${r.q.toFixed(2)} h</em></b></div><div><span>${ic('parts', 13)}Parts</span><b>${pin}<em> / ${parts.length}</em></b></div><div><span>${ic('clip', 13)}Files</span><b>${files}</b></div></div>
      <div class="rl-pk-h">Operations</div><div class="rl-pops">${r.ops.length ? r.ops.map((o, i) => { let bb = 0; try{ bb = opCalc(o).burntHrs || 0; }catch(e){} const k = opDoneNow(o) ? 'released' : run.some(p => p.opId === o.id) ? 'working' : 'hold';
        return `<div class="rl-pop">${si(k)}<span class="n">${i + 1}</span><span class="t">${esc(o.complaint || 'Operation')}</span><span class="h">${bb.toFixed(2)} / ${(+o.quoted || 0).toFixed(2)} h</span></div>`; }).join('') : '<div class="rl-pop"><span class="t" style="color:var(--tg-ink3)">No operations yet</span></div>'}</div>
      <div class="rl-open"><button class="btn btn-primary" data-a="open" data-id="${r.id}">Open RO${kbd('↵')}</button><button class="btn" data-a="pop" data-p="xfer" data-id="${r.id}">${ic('swap', 14)}Transfer…</button></div>${trxBtnsOk(ro) ? `<div class="rl-open rl-open2">${trxBtns(ro, 'btn')}</div>` : ''}</aside>`;
  }
  function pop(){
    const p = U.pop; if(!p) return '';
    if(p.type === 'disp') return `<div class="tg-pop rl-disp" style="width:320px"><h5>View</h5><div class="rl-seg"><button class="${U.view === 'list' ? 'on' : ''}" data-a="dv" data-v="list">${ic('list', 14)}List</button><button class="${U.view === 'board' ? 'on' : ''}" data-a="dv" data-v="board">${ic('board', 14)}Board</button></div>
      <h5>Group by</h5><div class="rl-chips">${[['status', 'Status'], ['stage', 'Stage'], ['tech', 'Tech'], ['none', 'None']].map(([k, l]) => `<button class="${U.groupBy === k ? 'on' : ''}" data-a="dgb" data-v="${k}">${l}</button>`).join('')}</div>
      <h5>Sort</h5><div class="rl-chips">${[['days', 'Days open'], ['no', 'RO number'], ['ready', 'Ready by']].map(([k, l]) => `<button class="${U.sort === k ? 'on' : ''}" data-a="dso" data-v="${k}">${l}</button>`).join('')}</div>
      <h5>Columns<small>drag to reorder</small></h5><div class="rl-colist">${cols().map(k => { const d = colDef(k); return `<div class="rl-coli" draggable="true" data-colk="${esc(k)}"><span class="h" aria-hidden="true">${ic('grip', 13)}</span><span class="n">${esc(d.l)}${d.custom ? '<em>yours</em>' : ''}</span>${d.fixed ? '<span class="fx">always</span>' : `<button class="x" data-a="colx" data-k="${esc(k)}" title="Hide this column" aria-label="Hide ${esc(d.l)}">${ic('x', 12)}</button>`}</div>`; }).join('')}</div>
      <h5>Add a column</h5><div class="rl-chips rl-addc">${DEF_COLS.concat(MORE).filter(k => cols().indexOf(k) < 0).map(k => `<button data-a="coladd" data-k="${k}">${ic('plus', 11)}${esc(FIELD[k].l)}</button>`).join('') || '<span class="rl-none2">Every field is on.</span>'}${customs().filter(c => cols().indexOf('c:' + c.id) < 0).map(c => `<button data-a="coladd" data-k="c:${esc(c.id)}">${ic('plus', 11)}${esc(c.name)}<em>yours</em></button>`).join('')}</div>
      <h5>Your own columns<small>you type into them</small></h5>${customs().length ? `<div class="rl-cflist">${customs().map(c => `<div class="rl-cfi"><span>${esc(c.name)}</span><small>${STATE.ros.filter(ro => ro.cf && ro.cf[c.id]).length} filled</small><button class="x" data-a="cfdel" data-id="${esc(c.id)}" title="Delete this column for everyone" aria-label="Delete ${esc(c.name)}">${ic('trash', 12)}</button></div>`).join('')}</div>` : ''}
      <div class="rl-cfnew"><input data-in="cfnew" placeholder="New column — e.g. PO #" value="${esc(U.cfNew || '')}" maxlength="24" autocomplete="off" data-no-draft><button class="btn btn-sm" data-a="cfnew">${ic('plus', 12)}Add</button></div>
      <div class="rl-colft"><button class="btn btn-sm tg-gh" data-a="colreset">${ic('undo', 12)}Back to the standard columns</button></div>
      <h5>Pane</h5><div class="rl-chips"><button class="${U.peek ? 'on' : ''}" data-a="dpk" data-v="1">Open in a pane</button><button class="${U.peek ? '' : 'on'}" data-a="dpk" data-v="0">Go straight to the RO</button></div>
      <div class="tg-pft">${ic('info', 12)}Open is one list, oldest first. The other groups follow Group by.</div></div>`;
    const ids = p.ids || [];
    if(p.type === 'bst') return `<div class="tg-pop menu" style="width:260px"><div class="tg-ph"><b>Set status</b><span class="cu">${ids.length} RO${ids.length === 1 ? '' : 's'}</span></div>${RO_STATUS_OPTIONS.map(o => `<button class="rl-mrow" data-a="bset" data-v="${esc(o.status)}">${si(STK[o.status] || 'hold')}${esc(o.status)}</button>`).join('')}</div>`;
    if(p.type === 'bdel'){ const R = ids.map(getRO).filter(x => x && !x.shop && x.id !== SHOP_RO_ID), np = STATE.punches.filter(x => ids.indexOf(x.roId) > -1).length, run = STATE.punches.some(x => !x.stop && ids.indexOf(x.roId) > -1);
      return `<div class="tg-pop xf" style="width:330px"><div class="tg-ph"><b>Delete ${R.length} RO${R.length === 1 ? '' : 's'}?</b><span class="cu">the whole repair order${R.length === 1 ? '' : 's'}</span></div><p class="rl-delp">${esc(R.slice(0, 6).map(x => tgNum(x) + (x.customerName ? ' · ' + x.customerName : '')).join('\n') + (R.length > 6 ? '\n+ ' + (R.length - 6) + ' more' : ''))}</p><div class="tg-pft">${ic('info', 12)}Their operations, parts and ${np} time punch${np === 1 ? '' : 'es'}${run ? ' (a clock is running on one)' : ''} go too. Undo brings them back.</div><div class="tg-acts"><button class="btn btn-sm" data-a="popx">Cancel</button><button class="btn btn-sm rl-danger" data-a="bdelgo">${ic('trash', 13)}Delete ${R.length}</button></div></div>`; }
    if(p.type === 'xfer'){ const techs = (typeof rtTechs === 'function' ? rtTechs() : []) || [];
      return `<div class="tg-pop menu" style="width:280px"><div class="tg-ph"><b>Transfer</b><span class="cu">${ids.length} RO${ids.length === 1 ? '' : 's'}</span></div>
        ${techs.map(n => `<button class="rl-mrow" data-a="xto" data-k="tech" data-w="${esc(n)}">${av(n)}${esc(n)}<small>Technician</small></button>`).join('')}
        ${['writer', 'parts', 'foreman', 'manager', 'warranty'].map(k => `<button class="rl-mrow" data-a="xto" data-k="${k}">${ic(k === 'writer' ? 'user' : k === 'parts' ? 'parts' : k === 'warranty' ? 'warranty' : 'users', 14)}${esc(RT_DEPT[k] || k)}<small>${esc((typeof rtPerson === 'function' && rtPerson(k)) || '')}</small></button>`).join('')}</div>`; }
    return '';
  }
  function printSheet(){
    const L = rows().filter(r => U.sel[r.id]);
    return `<div class="rl-print pg-printme"><h3>Repair orders · ${L.length}</h3><table><thead><tr><th>RO</th><th>Customer</th><th>Unit</th><th>Complaint</th><th>Status</th><th>Tech</th><th>Spot</th><th>Open</th></tr></thead><tbody>${L.map(r => `<tr><td>${esc(r.ro.roNumber || r.no)}</td><td>${esc(r.cust)}</td><td>${esc(r.unit)}</td><td>${esc(r.cmp)}${r.ops.length > 1 ? ' +' + (r.ops.length - 1) : ''}</td><td>${esc(r.st)}${r.sub ? ' · ' + esc(r.sub) : ''}</td><td>${esc(r.tech || '—')}</td><td>${esc(r.spot)}</td><td>${r.days == null ? '—' : r.days + 'd'}</td></tr>`).join('')}</tbody></table></div>`;
  }
  /* Parsec 10: saved views — the filter, the search, the grouping and the sort kept under a name, one click away */
  const VKEYS = () => ({ g: UI.rlGroup || 'all', q: UI.roFilter || '', groupBy: U.groupBy, sort: U.sort, view: U.view });
  function myViews(){ const me = PG.me().name || ''; return (Array.isArray(STATE.rlViews) ? STATE.rlViews : []).filter(v => !v.by || v.by === me); }
  function sameView(v){ const c = VKEYS(); return v.g === c.g && (v.q || '') === c.q && v.groupBy === c.groupBy && v.sort === c.sort && v.view === c.view; }
  function savedViews(){
    const V = myViews(), cur = V.find(sameView), c = VKEYS(), dirty = !cur && (c.q || c.g !== 'all' || c.groupBy !== 'status' || c.sort !== 'days' || c.view !== 'list');
    if(!V.length && !dirty && !U.vname) return '';
    return `<div class="rl-views"><span class="rl-vl">${ic('bookmark', 13)}Saved views</span>${V.map(v => `<span class="rl-vc${cur === v ? ' on' : ''}"><button data-a="vgo" data-id="${v.id}" aria-pressed="${cur === v}" title="${esc([v.q ? '“' + v.q + '”' : '', v.g !== 'all' ? v.g : '', v.groupBy !== 'status' ? 'by ' + v.groupBy : '', v.view === 'board' ? 'board' : ''].filter(Boolean).join(' · ') || 'All open')}">${esc(v.name)}</button><button class="x" data-a="vdel" data-id="${v.id}" title="Remove this view" aria-label="Remove ${esc(v.name)}">${ic('x', 11)}</button></span>`).join('')}${U.vname ? `<span class="rl-vn"><input data-in="vn" data-no-draft placeholder="Name this view" maxlength="30" value="${esc(U.vtxt || '')}" aria-label="Name this view"><button class="btn btn-sm btn-primary" data-a="vsave">Save</button><button class="btn btn-sm tg-gh" data-a="vcancel">Cancel</button></span>` : dirty ? `<button class="btn btn-sm tg-gh rl-vadd" data-a="vname">${ic('plus', 13)}Save this view</button>` : ''}</div>`;
  }
  function view(){
    if(U._me !== PG.me().name){ reset(); U._me = PG.me().name; }
    if(!STATE.ros.filter(ro => ro.id !== SHOP_RO_ID && !ro.shop).length) return `<div class="tg rl" data-pg="rolist"><div class="tg-body"><div class="rl-main"><div class="rl-top"><div class="rl-titlerow"><div><h1 class="rl-title">Repair orders</h1><p class="rl-facts">No repair orders yet.</p></div><button class="btn btn-primary" data-action="open-add-ro">${ic('plus', 15)}New RO</button></div></div><div class="rl-none">Add the first RO, or load the samples from Settings to look around.</div></div></div></div>`;
    const c = counts(), g = UI.rlGroup || 'all', me = rlMe(), L = rows();
    Object.keys(U.sel).forEach(id => { if(!L.some(r => r.id === id)) delete U.sel[id]; });
    if(U.cur && !L.some(r => r.id === U.cur)) U.cur = null;
    const cur = U.peek && U.view === 'list' && U.cur ? L.find(r => r.id === U.cur) : null, nSel = Object.keys(U.sel).length;
    const waiting = c.waiting;
    return `<div class="tg rl${cur ? ' is-peek' : ''}${nSel ? ' has-sel' : ''}" data-pg="rolist"><div class="tg-body"><div class="rl-main">
      <div class="rl-top"><div class="rl-titlerow"><div><h1 class="rl-title">Repair orders</h1><p class="rl-facts"><span><b>${c.all}</b> open</span><span>·</span><span><b>${waiting}</b> waiting</span><span>·</span><span><b>${c.live}</b> on the clock</span>${c.late ? `<span>·</span><span class="warn"><b>${c.late}</b> open 7+ days</span>` : ''}</p></div>
        <button class="btn btn-primary" data-action="open-add-ro">${ic('plus', 15)}New RO${kbd('N')}</button></div>
        <div class="rl-tools"><div class="rl-seg" role="group" aria-label="Show">${RL_GROUPS.filter(x => x[0] !== 'mine' || me).map(x => `<button class="${g === x[0] ? 'on' : ''}" data-a="tab" data-g="${x[0]}" aria-pressed="${g === x[0]}">${x[1]}<span>${c[x[0]]}</span></button>`).join('')}</div>
          <span class="rl-findw">${typeof psmBtn === 'function' ? psmBtn('rolist', 'Search repair orders') : ''}</span>
          <button class="btn" data-a="pop" data-p="disp">${ic('sliders', 15)}Display</button></div>${savedViews()}</div>
      ${U.view === 'board' ? board() : list()}</div>
      ${cur ? peek(cur) : ''}${pop()}
      ${nSel ? `<div class="rl-bulkwrap"><div class="rl-bulk"><b>${nSel} selected</b><button class="btn btn-sm tg-gh" data-a="pop" data-p="xfer">${ic('swap', 14)}Transfer…</button><button class="btn btn-sm tg-gh" data-a="pop" data-p="bst">${si('hold')}Set status…</button><button class="btn btn-sm tg-gh" data-a="bprint">${ic('print', 14)}Print</button><button class="btn btn-sm tg-gh rl-danger" data-a="pop" data-p="bdel">${ic('trash', 14)}Delete…</button><button class="btn btn-sm ib tg-gh" data-a="bclr" title="Clear (Esc)">${ic('x', 14)}</button></div></div>` : ''}
      ${U.print ? printSheet() : ''}</div></div>`;
  }
  const rd = () => PG.keepScroll(render);
  function open(id){ U.pop = null; PG.openRo(id); }
  const H = {
    sel: (t, ev) => { const id = t.dataset.id; if(ev && (ev.shiftKey || ev.metaKey || ev.ctrlKey)){ if(U.sel[id]) delete U.sel[id]; else U.sel[id] = 1; rd(); return; }
      if(!U.peek || U.view !== 'list' || U.cur === id || (typeof pmOn === 'function' && pmOn())){ open(id); return; } U.cur = id; rd(); },
    cb: (t, ev) => { if(ev) ev.stopPropagation(); const id = t.dataset.id; if(U.sel[id]) delete U.sel[id]; else U.sel[id] = 1; rd(); },
    shop: () => { UI.view = 'ros'; UI.selectedRo = SHOP_RO_ID; UI.modal = null; render(); },
    grp: t => { const k = t.dataset.g; U.closed[k] = !U.closed[k]; rd(); },
    open: t => open(t.dataset.id),
    peekx: () => { U.cur = null; rd(); },
    status: t => { UI.modal = { type: 'ro-status', roId: t.dataset.id }; render(); },
    pop: (t) => { const p = t.dataset.p; if(U.pop && U.pop.type === p){ U.pop = null; rd(); return; } const ids = t.dataset.id ? [t.dataset.id] : Object.keys(U.sel); U.pop = { type: p, ids }; PG.anchor(U, t); rd(); },
    vname: () => { U.vname = 1; U.vtxt = ''; rd(); setTimeout(() => { const i = $('.rq-vn input'); if(i) i.focus(); }, 30); },
    vcancel: () => { U.vname = 0; rd(); },
    vsave: () => { const n = String(U.vtxt || '').trim().slice(0, 30) || 'My view'; pushUndo('saved view'); if(!Array.isArray(STATE.rlViews)) STATE.rlViews = []; STATE.rlViews.push(Object.assign({ id: uid('vw'), name: n, by: PG.me().name || '', at: nowIso() }, VKEYS())); U.vname = 0; scheduleSave(true); rd(); pushToast(`View “${n}” saved — one click brings this list back.`, true);
      setTimeout(() => { const b = $('.rq-vc.on'); if(b && typeof pmAnimate === 'function') pmAnimate(b, [{ transform: 'scale(.9)', opacity: 0 }, { transform: 'none', opacity: 1 }], 180); }, 20); },
    vgo: t => { const v = myViews().find(x => x.id === t.dataset.id); if(!v) return; UI.rlGroup = v.g; UI.roFilter = v.q || ''; U.groupBy = v.groupBy || 'status'; U.sort = v.sort || 'days'; U.view = v.view || 'list'; CACHE = null; U.cur = null; rd(); },
    vdel: t => { const v = myViews().find(x => x.id === t.dataset.id); if(!v) return; pushUndo('saved view'); STATE.rlViews = STATE.rlViews.filter(x => x.id !== v.id); scheduleSave(true); rd(); pushToast(`View “${v.name}” removed.`, true); },
    dv: t => { U.view = t.dataset.v; U.pop = null; rd(); },
    tab: t => { UI.rlGroup = t.dataset.g; CACHE = null; U.cur = null; U.sel = {}; try{ persistUI(); }catch(e){} rd(); },
    hsort: (t, ev) => { const k = t.dataset.col; if(!colDef(k)) return; if(U.cs && U.cs.k === k){ if(U.cs.dir > 0) U.cs.dir = -1; else U.cs = null; } else U.cs = { k, dir: 1 }; rd(); },
    hsclr: () => { U.cs = null; rd(); },
    colx: t => { const k = t.dataset.k, L = cols().filter(x => x !== k); if(k === 'ro') return; colsSet(L); if(U.cs && U.cs.k === k) U.cs = null; rd(); },
    coladd: t => { const k = t.dataset.k; if(!colDef(k)) return; const L = cols(); if(L.indexOf(k) < 0) L.push(k); colsSet(L); rd(); },
    colreset: () => { colsSet(DEF_COLS); U.cs = null; rd(); pushToast('The RO list is back to its standard columns.'); },
    cfnew: () => { const n = String(U.cfNew || '').trim().slice(0, 24); if(!n){ const i = $('.rq-cfnew input'); if(i) i.focus(); return; }
      if(customs().some(c => c.name.toLowerCase() === n.toLowerCase())){ pushToast(`There’s already a column called “${n}”.`); return; }
      pushUndo('RO list column'); if(!Array.isArray(STATE.rlCustom)) STATE.rlCustom = []; const c = { id: uid('cf'), name: n, by: (PG.me() || {}).name || '', at: nowIso() }; STATE.rlCustom.push(c);
      const L = cols(); L.push('c:' + c.id); colsSet(L); U.cfNew = ''; scheduleSave(true); rd(); pushToast(`“${n}” is a column now — click a cell to type in it.`, true); },
    cfdel: t => { const id = t.dataset.id, c = customs().find(x => x.id === id); if(!c) return; pushUndo('RO list column');
      STATE.rlCustom = customs().filter(x => x.id !== id); STATE.ros.forEach(ro => { if(ro.cf) delete ro.cf[id]; });
      if(STATE.rlLayout) Object.keys(STATE.rlLayout).forEach(k => { const M = STATE.rlLayout[k]; if(M && Array.isArray(M.cols)) M.cols = M.cols.filter(x => x !== 'c:' + id); });
      if(U.cs && U.cs.k === 'c:' + id) U.cs = null; CACHE = null; scheduleSave(true); rd(); pushToast(`“${c.name}” deleted, with what was typed in it.`, true); },
    cfed: (t, ev) => { if(ev) ev.stopPropagation(); U.cfEdit = { id: t.dataset.id, c: t.dataset.c }; rd(); setTimeout(() => { const i = $(`.rq-cfin[data-id="${t.dataset.id}"][data-c="${t.dataset.c}"]`); if(i){ i.focus(); i.select(); } }, 20); },
    dgb: t => { U.groupBy = t.dataset.v; rd(); },
    dso: t => { U.sort = t.dataset.v; CACHE = null; rd(); },
    dpk: t => { U.peek = t.dataset.v === '1'; if(!U.peek) U.cur = null; rd(); },
    bclr: () => { U.sel = {}; rd(); },
    popx: () => { U.pop = null; rd(); },
    bdelgo: () => { const ids = (U.pop && U.pop.ids) || [], R = ids.map(getRO).filter(x => x && !x.shop && x.id !== SHOP_RO_ID); U.pop = null; if(!R.length){ rd(); return; }   /* Parsec 12.2 */
      pushUndo('delete ' + R.length + ' RO' + (R.length === 1 ? '' : 's')); const gone = {};
      R.forEach(x => { gone[x.id] = 1; try{ audit('ro-del', 'Deleted ' + roLabel(x) + (x.customerName ? ' (' + x.customerName + ')' : ''), x); }catch(e){} });
      STATE.punches = STATE.punches.filter(q => !gone[q.roId]); STATE.ros = STATE.ros.filter(x => !gone[x.id]);
      if(gone[UI.selectedRo]) UI.selectedRo = null; if(gone[U.cur]) U.cur = null; U.sel = {}; CACHE = null; scheduleSave(true); render();
      pushToast(`Deleted ${R.length} RO${R.length === 1 ? '' : 's'}.`, true); },
    bset: t => { const v = t.dataset.v, ids = (U.pop && U.pop.ids) || []; let ok = 0; ids.forEach(id => { if(setRoStatus(id, v, null) !== false) ok++; }); U.pop = null; if(ok){ pushToast(`${ok} RO${ok === 1 ? '' : 's'} set to ${v}.`, true); U.sel = {}; } CACHE = null; render(); },
    xto: t => { const k = t.dataset.k, w = t.dataset.w || '', ids = (U.pop && U.pop.ids) || []; let n = 0; ids.forEach(id => { const ro = getRO(id); if(!ro) return; try{ rtSend(ro, k, k === 'tech' ? w : '', 'From the RO list', null, {}); n++; }catch(e){ console.error(e); } });
      U.pop = null; if(n){ pushToast(`${n} RO${n === 1 ? '' : 's'} sent to ${k === 'tech' ? fstN(w) : (RT_DEPT[k] || k)}.`, true); U.sel = {}; } CACHE = null; scheduleSave(true); render(); },
    bprint: () => { U.print = true; rd(); setTimeout(() => { const el = $('.rq-print'); document.documentElement.classList.add('pg-print2'); try{ window.print(); } finally { document.documentElement.classList.remove('pg-print2'); U.print = false; rd(); } }, 60); }
  };
  function keydown(e){
    const k = e.key; if(e.ctrlKey || e.metaKey || e.altKey) return;
    const stop = () => { e.preventDefault(); e.stopPropagation(); e.stopImmediatePropagation(); };
    if(PG.typing(e)) return;
    if(k === '/'){ if(typeof psmOpen === 'function') psmOpen('rolist'); return stop(); }
    if(k === 'Escape'){ if(U.pop){ U.pop = null; rd(); return stop(); } if(Object.keys(U.sel).length){ U.sel = {}; rd(); return stop(); } if(U.cur){ U.cur = null; rd(); return stop(); } return; }
    if((k === 'j' || k === 'k') && U.view === 'list'){ const L = ordered(rows()), i = L.findIndex(r => r.id === U.cur); const n = L[Math.max(0, Math.min(L.length - 1, i < 0 ? 0 : i + (k === 'j' ? 1 : -1)))]; if(n){ U.cur = n.id; rd(); const el = $(`.rq-row[data-id="${n.id}"]`); if(el) el.scrollIntoView({ block: 'nearest' }); } return stop(); }
    if(k === 'Enter' && U.cur){ open(U.cur); return stop(); }
    if(k === 'x' && U.cur){ if(U.sel[U.cur]) delete U.sel[U.cur]; else U.sel[U.cur] = 1; rd(); return stop(); }
    if((k === 's' || k === 'S') && U.cur){ UI.modal = { type: 'ro-status', roId: U.cur }; render(); return stop(); }
  }
  function after(){ PG.placePop(U); }
  function fieldKey(t, ev){
    if(t.dataset.in === 'cf'){ if(ev.key === 'Enter'){ ev.preventDefault(); cfSave(t.dataset.id, t.dataset.c, t.value); return true; } if(ev.key === 'Escape'){ ev.preventDefault(); U.cfEdit = null; rd(); return true; }
      if(ev.key === 'Tab'){ ev.preventDefault(); const cs = cols().filter(k => k.indexOf('c:') === 0), L = ordered(rows()), i = L.findIndex(r => r.id === t.dataset.id); cfSave(t.dataset.id, t.dataset.c, t.value); const n = L[i + (ev.shiftKey ? -1 : 1)]; if(n){ U.cfEdit = { id: n.id, c: t.dataset.c }; rd(); setTimeout(() => { const j = $(`.rq-cfin[data-id="${n.id}"]`); if(j){ j.focus(); j.select(); } }, 20); } return true; } return false; }
    if(t.dataset.in === 'cfnew'){ if(ev.key === 'Enter'){ ev.preventDefault(); U.cfNew = t.value; H.cfnew(); return true; } return false; }
    if(t.dataset.in === 'vn'){ if(ev.key === 'Enter'){ ev.preventDefault(); U.vtxt = t.value; H.vsave(); return true; } if(ev.key === 'Escape'){ U.vname = 0; rd(); return true; } return false; }
    if(ev.key === 'Escape'){ t.blur(); return true; } if(ev.key === 'ArrowDown' && t.closest('.rq-find')){ t.blur(); const L = rows(); if(L[0]){ U.cur = L[0].id; rd(); } ev.preventDefault(); return true; } return false; }
  PG.reg('rolist', { H, U: () => U, input: (t) => { if(t.dataset.in === 'vn') U.vtxt = t.value; if(t.dataset.in === 'cfnew') U.cfNew = t.value; },
    change: (t) => { if(t.dataset.in === 'cf' && U.cfEdit) cfSave(t.dataset.id, t.dataset.c, t.value); }, fieldKey, keydown, after });
  /* the search window: it filters this list */
  if(typeof psmReg === 'function') psmReg('rolist', () => ({ title: 'Search repair orders', page: 'RO list', placeholder: 'RO, customer, VIN, unit, part #, DTC…',
    get: () => UI.roFilter || '', set: q => { UI.roFilter = q; CACHE = null; U.cur = null; try{ persistUI(); }catch(e){} rd(); },
    count: () => { const q0 = UI.roFilter; UI.roFilter = ''; let of = 0; try{ of = rlList().length; }catch(e){} UI.roFilter = q0; return { n: rows().length, of }; },
    items: q => ordered(rows()).slice(0, 8).map(r => ({ id: r.id, title: r.no + ' · ' + r.cust, sub: (q ? roMatch(r.ro, q) : '') || (r.nx.t + (r.nx.w ? ' · ' + fstN(r.nx.w) : '')) })),
    pick: it => { U.cur = it.id; if(U.peek && U.view === 'list') rd(); else open(it.id); } }));
  /* dragging a column: by its header, or in Display */
  let DRAG = null;
  const dragEl = e => e.target && e.target.closest ? e.target.closest('[data-pg="rolist"] .rq-hc[data-col], [data-pg="rolist"] .rq-coli[data-colk]') : null;
  const dragK = el => el.getAttribute('data-col') || el.getAttribute('data-colk');
  const clearMarks = () => document.querySelectorAll('[data-pg="rolist"] .drop-b, [data-pg="rolist"] .drop-a, [data-pg="rolist"] .dragging').forEach(x => x.classList.remove('drop-b', 'drop-a', 'dragging'));
  document.addEventListener('dragstart', e => { const el = dragEl(e); if(!el) return; DRAG = { k: dragK(el), list: el.classList.contains('rq-coli') }; el.classList.add('dragging'); try{ e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('text/plain', DRAG.k); }catch(er){} });
  document.addEventListener('dragover', e => { if(!DRAG) return; const el = dragEl(e); if(!el || dragK(el) === DRAG.k) return; e.preventDefault(); try{ e.dataTransfer.dropEffect = 'move'; }catch(er){}
    const r = el.getBoundingClientRect(), after = el.classList.contains('rq-coli') ? e.clientY > r.top + r.height / 2 : e.clientX > r.left + r.width / 2;
    if(!el.classList.contains(after ? 'drop-a' : 'drop-b')){ clearMarks(); el.classList.add(after ? 'drop-a' : 'drop-b'); const d = document.querySelector(`[data-pg="rolist"] [data-col="${DRAG.k}"], [data-pg="rolist"] [data-colk="${DRAG.k}"]`); if(d) d.classList.add('dragging'); } });
  document.addEventListener('drop', e => { if(!DRAG) return; const el = dragEl(e); if(!el){ return; } e.preventDefault(); const to = dragK(el), after = el.classList.contains('drop-a'), k = DRAG.k; DRAG = null; clearMarks(); if(!to || to === k) return;
    const L = cols().filter(x => x !== k); let i = L.indexOf(to); if(i < 0) return; if(after) i++; L.splice(i, 0, k); colsSet(L); rd(); });
  document.addEventListener('dragend', () => { DRAG = null; clearMarks(); });
  return { view, U: () => U, rows };
})();
function viewRoList(){ return RL.view(); }
