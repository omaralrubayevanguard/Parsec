/* ===== Parsec 9.7: the truck in the RO's header — a band, the title on the left, the truck on the right ===== */
.px-trk { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 280px; align-items: end; column-gap: 24px; margin: -16px -24px 0; padding: 22px 24px 0; min-height: 176px; border-radius: 16px; background: linear-gradient(180deg, var(--panel) 0%, var(--fill) 100%); box-shadow: inset 0 0 0 1px var(--hairline); }
.px-trk > .px-titleblock { padding-bottom: 20px; min-width: 0; }
.px-trk .px-ro__status { flex-wrap: wrap; row-gap: 8px; }
.px-trk .px-ro__status > .px-status--button, .px-trk .px-ro__status > .px-with { flex: none; white-space: nowrap; }
.px-trk__pic { position: relative; align-self: end; justify-self: end; width: 280px; line-height: 0; }
.px-trk__pic img { display: block; width: 100%; height: auto; position: relative; z-index: 1; }
.px-trk__pic.is-model { margin-bottom: -4px; }
.px-trk__pic.is-model::after { content: ""; position: absolute; left: 8%; right: 8%; bottom: 2px; height: 12px; border-radius: 50%; background: radial-gradient(closest-side, rgba(0,0,0,.26), rgba(0,0,0,0)); z-index: 0; }
.px-trk__pic.is-model.is-framed { margin-bottom: 18px; border-radius: 12px; overflow: hidden; box-shadow: inset 0 0 0 1px var(--hairline); }
.px-trk__pic.is-model.is-framed::after { display: none; }
.px-trk__pic.is-photo { width: 256px; height: 150px; margin-bottom: 18px; border-radius: 12px; overflow: hidden; background: var(--fill); box-shadow: 0 0 0 1px var(--hairline), 0 10px 24px -14px rgba(0,0,0,.4); }
.px-trk__pic.is-photo img { width: 100%; height: 100%; object-fit: cover; }
.px-trk__cap { position: absolute; left: 8px; bottom: 8px; z-index: 3; padding: 3px 7px; border-radius: 6px; background: rgba(0,0,0,.58); color: #fff; font: 500 11px/14px var(--font-sans); }
.px-trk__pic.is-none { width: 240px; margin-bottom: 14px; color: var(--ink-4); display: flex; flex-direction: column; align-items: center; gap: 8px; }
.px-trk__pic.is-none > svg { width: 200px; height: auto; display: block; }
.px-trk__none { font: 400 12px/16px var(--font-sans); color: var(--ink-3); text-align: center; }
.px-trk__act { all: unset; box-sizing: border-box; position: absolute; top: 6px; right: 6px; z-index: 4; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--raised); color: var(--ink-2); box-shadow: inset 0 0 0 1px var(--border), 0 2px 6px -2px rgba(0,0,0,.25); cursor: pointer; opacity: .0; transition: opacity .15s ease-out; }
.px-trk__pic.is-model:not(.is-framed) .px-trk__act { top: -8px; right: -8px; }
.px-trk__pic.is-none .px-trk__act { top: -6px; right: -6px; }
.px-trk:hover .px-trk__act, .px-trk__act:focus-visible, .px-trk.has-menu .px-trk__act { opacity: 1; }
.px-trk__act:hover { color: var(--ink); background: var(--panel); }
.px-trk__act:focus-visible { box-shadow: 0 0 0 2px var(--focus, var(--accent)); }
@media (hover: none) { .px-trk__act { opacity: 1; } }
.px-trk__menu { position: absolute; z-index: 30; top: 30px; right: 14px; width: 300px; padding: 6px; border-radius: var(--radius-lg); background: var(--raised); box-shadow: var(--shadow-raised); font: 400 13.5px/1.3 var(--font-sans); color: var(--ink); animation: px-up .18s cubic-bezier(.2,.8,.2,1) both; }
.px-trk__menu button { all: unset; box-sizing: border-box; display: block; width: 100%; padding: 7px 10px; border-radius: var(--radius-md); cursor: pointer; }
.px-trk__menu button:hover, .px-trk__menu button:focus-visible { background: var(--fill); }
.px-trk__menu b { display: block; font-weight: 500; }
.px-trk__menu small { display: block; margin-top: 1px; font-size: 12px; color: var(--ink-3); }
.px-trk__menu button + button.is-sep { margin-top: 6px; box-shadow: 0 -1px 0 var(--hairline); border-radius: 0 0 var(--radius-md) var(--radius-md); }
/* a narrower page: the truck gets smaller before the title gets crowded */
.px-ro__col { container-type: inline-size; }
@container (max-width: 700px) { .px-trk { grid-template-columns: minmax(0, 1fr) 220px; } .px-trk__pic { width: 220px; } .px-trk__pic.is-photo { width: 210px; height: 124px; } .px-trk__pic.is-none { width: 200px; } .px-trk__pic.is-none > svg { width: 160px; } }
/* the phone: the truck on top, the title under it */
:host([data-device=phone]) .px-trk { grid-template-columns: minmax(0, 1fr) !important; margin: -16px -16px 0 !important; padding: 14px 16px 0 !important; border-radius: 0 !important; box-shadow: inset 0 -1px 0 var(--hairline) !important; min-height: 0 !important; }
:host([data-device=phone]) .px-trk__pic { order: -1; justify-self: center; width: min(300px, 82%) !important; height: auto !important; margin: 0 0 10px !important; }
:host([data-device=phone]) .px-trk__pic.is-model { margin-bottom: 4px !important; }
:host([data-device=phone]) .px-trk__pic.is-photo { width: 100% !important; aspect-ratio: 16 / 9; height: auto !important; }
:host([data-device=phone]) .px-trk__pic.is-none > svg { width: 150px; }
:host([data-device=phone]) .px-trk__act { opacity: 1; top: 0; right: 0; }
:host([data-device=phone]) .px-trk__pic.is-model:not(.is-framed) .px-trk__act { top: 0; right: -12%; }
:host([data-device=phone]) .px-trk > .px-titleblock { padding-bottom: 14px; }
:host([data-device=phone]) .px-trk__menu { left: 12px; right: 12px; width: auto; top: 40px; }

/* 9.9: notes on the truck — its marks on the model picture, and the way in */
.px-trk__mk { position: absolute; z-index: 3; width: 18px; height: 18px; margin: -9px 0 0 -9px; border-radius: 50%; display: grid; place-items: center; background: var(--ink); color: var(--panel); font: 600 10px/1 var(--font-sans); box-shadow: 0 0 0 2px var(--panel), 0 3px 8px -2px rgba(0,0,0,.4); pointer-events: none; }
.px-trk__nb { all: unset; box-sizing: border-box; position: absolute; z-index: 4; right: 6px; bottom: 6px; padding: 3px 8px; border-radius: 7px; background: color-mix(in srgb, var(--raised) 88%, transparent); backdrop-filter: blur(4px); box-shadow: inset 0 0 0 1px var(--border); color: var(--ink); font: 500 11.5px/16px var(--font-sans); cursor: pointer; line-height: 16px; }
.px-trk__nb:hover { background: var(--raised); }
.px-trk__nb:focus-visible { box-shadow: 0 0 0 2px var(--accent); }
.px-trk__pic.is-model .px-trk__nb { bottom: 12px; }
