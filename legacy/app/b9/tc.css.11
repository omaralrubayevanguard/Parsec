/* ---------- Technician page (Parsec 11): the list of your ROs, the RO beside it, every operation opens ---------- */
.tch-box{position:relative;display:inline-flex;align-items:center;flex:none;}
.tch-box > .tg-ic{position:absolute;left:10px;top:50%;margin-top:-7px;color:var(--tg-ink3);pointer-events:none;}
.tch-box input{box-sizing:border-box;height:30px;padding:0 10px 0 31px;font:400 13px/1 var(--tg-sans);color:var(--tg-ink);}
.tch-box input:focus{outline:1.5px solid var(--tg-acc);outline-offset:-1px;}
.tch-box input::placeholder{color:var(--tg-ink4);}
.tch-find{margin-left:auto;} .tch-find input{width:220px;}
.tch-in{display:flex;margin-top:8px;} .tch-in input{width:100%;height:34px;}
.tch .tg-head .tg-facts{min-width:0;overflow:hidden;}
/* the list */
.tch-grp{display:flex;align-items:center;gap:8px;}
.tch-grp i{width:7px;height:7px;border-radius:50%;background:var(--tg-ink4);flex:none;}
.tch-grp.run i{background:var(--tg-st-working);} .tch-grp.wait i{background:var(--tg-st-waiting);} .tch-grp.next i{background:var(--tg-acc);} .tch-grp.done i{background:var(--tg-ink3);}
.tch-grp span{margin-left:2px;}
.tg-it.tch-it{grid-template-columns:62px minmax(0,1fr) auto;gap:0 12px;padding:9px 16px 9px 14px;}
.tg-it.tch-it.has-o{grid-template-columns:18px 62px minmax(0,1fr) auto;gap:0 10px;}
.tg-it.tch-it.on{box-shadow:inset 2px 0 0 var(--tg-acc);}
.tch-pic{width:62px;height:36px;display:grid;place-items:center;line-height:0;}
.tch-pic .trk-th{width:60px;height:36px;} .tch-pic .trk-th img{max-width:60px;max-height:36px;filter:drop-shadow(0 3px 3px rgba(0,0,0,.13));}
.tch-t{min-width:0;display:flex;flex-direction:column;gap:1px;}
.tch-t b{display:flex;align-items:center;gap:7px;min-width:0;font-size:13.5px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--tg-ink);}
.tch-t b .tg-no{flex:none;}
.tch-t small{display:block;font-size:12.5px;color:var(--tg-ink3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.tch-t small em{font-style:normal;font-size:11.5px;color:var(--tg-ink4);}
.tch-t small .ib-k{margin-right:6px;}
.tch-m{text-align:right;display:flex;flex-direction:column;align-items:flex-end;gap:1px;}
.tch-m b{font:500 13px/18px var(--tg-mono);font-family:var(--tg-mono) !important;color:var(--tg-ink2);font-variant-numeric:tabular-nums;}
.tch-m b.run{color:var(--tg-good);} .tch-m b.wt{font-family:var(--tg-sans) !important;font-size:12px;color:var(--tg-warn);}
.tch-m small{font-size:11.5px;color:var(--tg-ink3);white-space:nowrap;}
.tch-age{display:inline-flex;align-items:center;height:17px;padding:0 5px;margin-right:6px;border-radius:5px;background:var(--tg-fill);color:var(--tg-ink2);font:600 10.5px/1 var(--tg-mono);font-family:var(--tg-mono) !important;vertical-align:1px;}
.tch-age.w{background:var(--tg-warn-t);color:var(--tg-warn);} .tch-age.b{background:var(--tg-bad-t);color:var(--tg-bad);}
/* the RO */
.tch-pin{padding:18px 26px 32px;display:flex;flex-direction:column;gap:14px;}
.tch-band{position:relative;display:grid;grid-template-columns:minmax(0,1fr) 230px;align-items:end;gap:16px;padding:18px 20px 0;border-radius:16px;background:linear-gradient(180deg,var(--tg-panel),var(--tg-fill));box-shadow:inset 0 0 0 1px var(--tg-hair);}
.tch-bt{padding-bottom:16px;min-width:0;}
.tch-eb{display:flex;align-items:center;gap:6px;flex-wrap:wrap;font-size:12.5px;color:var(--tg-ink3);} .tch-eb i{font-style:normal;color:var(--tg-ink4);}
.tch-band h2{margin:4px 0 2px;font:500 27px/32px var(--tg-serif);font-family:var(--tg-serif) !important;letter-spacing:-.015em;color:var(--tg-ink);}
.tch-sub{font-size:13px;color:var(--tg-ink2);}
.tch-srow{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:10px;} .tch-srow .k{font-size:12px;color:var(--tg-ink3);}
.tch-bp{position:relative;align-self:end;display:grid;place-items:end center;min-height:110px;}
.tch-bpic{all:unset;cursor:pointer;display:grid;place-items:end center;width:100%;line-height:0;}
.tch-bpic .trk-th{width:220px;height:118px;} .tch-bpic .trk-th img{max-width:220px;max-height:118px;filter:drop-shadow(0 8px 8px rgba(0,0,0,.18));}
.tch-bpic .trk-th.no svg{width:150px;}
.tch-bpic:focus-visible{outline:2px solid var(--tg-acc);outline-offset:2px;border-radius:10px;}
.tch-cam{all:unset;cursor:pointer;position:absolute;right:-6px;bottom:12px;width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:var(--tg-raised);color:var(--tg-ink2);box-shadow:inset 0 0 0 1px var(--tg-border),0 2px 8px -2px rgba(0,0,0,.3);}
.tch-cam:hover{color:var(--tg-ink);}
.tch-nb{all:unset;cursor:pointer;position:absolute;left:4px;bottom:10px;padding:3px 8px;border-radius:7px;background:color-mix(in srgb,var(--tg-raised) 88%,transparent);box-shadow:inset 0 0 0 1px var(--tg-border);font:500 11.5px/16px var(--tg-sans);color:var(--tg-ink);}
.tch-acts{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
.tch-acts .btn{height:32px;}
.tch-clk{display:inline-flex;align-items:baseline;gap:7px;margin-left:4px;}
.tch-clk b{font:600 15px/1 var(--tg-mono);font-family:var(--tg-mono) !important;font-variant-numeric:tabular-nums;color:var(--tg-good);}
.tch-clk small{font-size:11.5px;color:var(--tg-ink3);}
.tch-wbox{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:10px 12px;border-radius:12px;background:var(--tg-warn-t);color:var(--tg-warn);font-size:13px;} .tch-wbox b{font-weight:600;} .tch-wbox span{flex:1;min-width:180px;color:var(--tg-ink2);}
.tch-stg{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px;}
.tch-stg span{display:flex;flex-direction:column;gap:5px;font-size:11.5px;color:var(--tg-ink3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.tch-stg i{height:4px;border-radius:2px;background:var(--tg-hair);}
.tch-stg .d i{background:var(--tg-ink2);} .tch-stg .n i{background:var(--tg-acc);} .tch-stg .n{color:var(--tg-ink);font-weight:600;}
.tch-stg .n.w i{background:var(--tg-st-waiting);} .tch-stg .x{opacity:.45;} .tch-stg .x i{background:repeating-linear-gradient(90deg,var(--tg-hair) 0 4px,transparent 4px 7px);}
/* the operations: a row each, opening to notes, time and parts */
.tch-ops .mg-ch{gap:8px;} .tch-ops .mg-ch small{color:var(--tg-ink3);font-size:12px;}
.tch-ol{display:flex;flex-direction:column;}
.tch-o{box-shadow:inset 0 -1px 0 var(--tg-hair);} .tch-o:last-child{box-shadow:none;}
.tch-o.run > .tch-oh{background:linear-gradient(90deg,var(--tg-good-t),transparent 70%);}
.tch-oh{display:flex;align-items:center;gap:8px;padding:0 14px 0 6px;}
.tch-ot{all:unset;box-sizing:border-box;cursor:pointer;flex:1;min-width:0;display:grid;grid-template-columns:20px minmax(40px,auto) minmax(0,1fr) 150px;align-items:center;gap:10px;padding:10px 4px;border-radius:10px;}
.tch-ot:focus-visible{box-shadow:inset 0 0 0 1.5px var(--tg-acc);}
.tch-chev{display:grid;place-items:center;color:var(--tg-ink3);transition:transform .16s cubic-bezier(.2,.75,.25,1);}
.tch-o.open .tch-chev{transform:rotate(90deg);}
.tch-ot .cr-ty{justify-self:start;}
.tch-oc{min-width:0;display:flex;flex-direction:column;gap:1px;}
.tch-oc b{font-size:13.5px;font-weight:500;color:var(--tg-ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.tch-o.done .tch-oc b,.tch-o.other .tch-oc b{color:var(--tg-ink3);}
.tch-oc small{font-size:12px;color:var(--tg-ink3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.tch-op{font-weight:500;color:var(--tg-ink2);} .tch-op.wk{color:var(--tg-good);} .tch-op.wt{color:var(--tg-warn);} .tch-op.dn{color:var(--tg-ink3);}
.tch-hb{display:inline-flex;align-items:center;gap:8px;white-space:nowrap;font-size:11.5px;color:var(--tg-ink3);}
.tch-hb .bar{flex:1;height:5px;border-radius:3px;background:var(--tg-hair);overflow:hidden;min-width:40px;} .tch-hb .bar i{display:block;height:100%;border-radius:3px;background:var(--tg-ink3);}
.tch-o.run .tch-hb .bar i{background:var(--tg-st-working);} .tch-hb.over .bar i{background:var(--tg-bad);} .tch-hb.over .mono{color:var(--tg-bad);}
.tch-hb .mono{font-family:var(--tg-mono) !important;font-variant-numeric:tabular-nums;}
.tch-ib{all:unset;cursor:pointer;width:30px;height:30px;border-radius:8px;display:grid;place-items:center;background:var(--tg-fill);color:var(--tg-ink2);flex:none;}
.tch-ib:hover{background:var(--tg-sel);color:var(--tg-ink);} .tch-ib.on{background:var(--tg-st-working);color:#fff;} .tch-ib:disabled{opacity:.4;cursor:default;}
.tch-okc{width:30px;height:30px;display:grid;place-items:center;color:var(--tg-good);flex:none;}
.tch-oh > span:empty{width:30px;flex:none;}
.tch-ob{padding:2px 16px 14px 40px;display:flex;flex-direction:column;gap:10px;animation:tcopen .18s cubic-bezier(.2,.75,.25,1);}
@keyframes tcopen{from{opacity:0;transform:translateY(-3px)}to{opacity:1;transform:none}}
.tch-two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px;}
.tch-pane{container:tchp / inline-size;}
.tch-sec{min-width:0;padding:10px 12px 12px;border-radius:12px;background:var(--tg-panel);box-shadow:inset 0 0 0 1px var(--tg-hair);}
.tch-sh{display:flex;align-items:baseline;gap:8px;margin-bottom:4px;font-size:13px;} .tch-sh b{font-weight:600;color:var(--tg-ink);} .tch-sh small{font-size:11.5px;color:var(--tg-ink3);}
.tch-nl{display:grid;grid-template-columns:118px minmax(0,1fr);gap:8px;padding:6px 0;box-shadow:inset 0 -1px 0 var(--tg-hair);font-size:12.5px;line-height:18px;color:var(--tg-ink2);}
.tch-nl small{font:500 11px/18px var(--tg-mono);font-family:var(--tg-mono) !important;color:var(--tg-ink4);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.tch-none{padding:4px 0 !important;font-size:12.5px;}
.tch-sec .cr-bar{margin:4px 0 6px;}
.tch-sec .cr-bar .nums{flex-wrap:wrap;row-gap:4px;}
.tch-pus{display:flex;flex-direction:column;}
.tch-pu{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1px 10px;padding:6px 0;box-shadow:inset 0 -1px 0 var(--tg-hair);font-size:12.5px;color:var(--tg-ink2);}
.tch-pu:last-child{box-shadow:none;}
.tch-pu .t{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;} .tch-pu .d{color:var(--tg-ink3);margin-right:6px;}
.tch-pu b{font:600 12.5px/18px var(--tg-mono);font-family:var(--tg-mono) !important;color:var(--tg-ink);text-align:right;}
.tch-pu .w{grid-column:1 / -1;font-size:11.5px;color:var(--tg-ink3);}
.tch-pu.live b{color:var(--tg-good);}
.tch-sec .cx-pr{padding:6px 0;}
.tch-sec .cr-add{margin-top:6px;}
.tch-fix{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:12px;background:var(--tg-acct);box-shadow:inset 0 0 0 1px var(--tg-accl);}
.tch-fix .gi{width:28px;height:28px;border-radius:8px;display:grid;place-items:center;background:var(--tg-raised);color:var(--tg-acctx);flex:none;}
.tch-fix .n{flex:1;min-width:0;display:flex;flex-direction:column;} .tch-fix b{font-size:13px;font-weight:600;color:var(--tg-ink);} .tch-fix small{font-size:12px;color:var(--tg-ink3);}
.tch-fix.used{background:var(--tg-good-t);box-shadow:none;}
.tch-oa{display:flex;gap:8px;flex-wrap:wrap;}
@container tchp (max-width:560px){.tch-two{grid-template-columns:1fr;}}
@media (max-width:1380px){.tch-find input{width:170px;}}
@media (max-width:1180px){.tch-band{grid-template-columns:minmax(0,1fr) 170px;} .tch-bpic .trk-th{width:168px;height:92px;} .tch-bpic .trk-th img{max-width:168px;max-height:92px;} .tch-ot{grid-template-columns:20px minmax(40px,auto) minmax(0,1fr) 120px;}}
:root[data-device="phone"] .tch-pin{padding:12px 12px 90px;}
:root[data-device="phone"] .tch-band{grid-template-columns:1fr;padding:12px 14px 0;}
:root[data-device="phone"] .tch-bp{order:-1;min-height:0;}
:root[data-device="phone"] .tch-bpic .trk-th{width:240px;height:120px;} :root[data-device="phone"] .tch-bpic .trk-th img{max-width:240px;max-height:120px;}
:root[data-device="phone"] .tch-band h2{font-size:23px;line-height:28px;}
:root[data-device="phone"] .tch-two{grid-template-columns:1fr;}
:root[data-device="phone"] .tch-ot{grid-template-columns:16px minmax(36px,auto) minmax(0,1fr);row-gap:6px;}
:root[data-device="phone"] .tch-fix{flex-wrap:wrap;} :root[data-device="phone"] .tch-fix .n{flex-basis:calc(100% - 40px);}
:root[data-device="phone"] .tch-pane .cx-tiles{grid-template-columns:1fr !important;}
:root[data-device="phone"] .tch-acts .tg-gh{margin-left:auto;}
:root[data-device="phone"] .tch-ot .tch-hb{grid-column:3;}
:root[data-device="phone"] .tch-ob{padding:2px 10px 12px 12px;}
:root[data-device="phone"] .tch-stg span{font-size:9.5px;}
:root[data-device="phone"] .tch-find{display:none;}
@media (prefers-reduced-motion:reduce){.tch-ob,.tch-chev{animation:none !important;transition:none !important;}}
