/* ============================== Phone view (Parsec 9.6) ============================== */
:root[data-device="phone"]{--pnav-w:0px;--pm-tab-h:58px;}
:root[data-device="phone"] body{padding:0 0 calc(var(--pm-tab-h) + env(safe-area-inset-bottom) + 8px) 0 !important;min-width:0 !important;overflow-x:hidden;background:var(--px-panel)}
:root[data-device="phone"] #app{padding-left:0 !important;min-width:0 !important;max-width:100vw;overflow-x:clip}
:root[data-device="phone"] .px-rail,:root[data-device="phone"] .pz-hdr,:root[data-device="phone"] .day-ribbon,:root[data-device="phone"] .assist-fab,:root[data-device="phone"] .pxr-pop{display:none !important}
/* the bottom bar */
.pm-tabs{position:fixed;left:0;right:0;bottom:0;z-index:900;display:flex;padding:5px 4px calc(env(safe-area-inset-bottom) + 5px);background:var(--px-panel);box-shadow:inset 0 1px 0 var(--px-hair);transition:transform .22s cubic-bezier(.2,.8,.2,1);font-family:var(--px-sans)}
.pm-tabs.hide{transform:translateY(calc(100% + 2px))}
.pm-tab{all:unset;cursor:pointer;flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;gap:3px;padding:4px 0 2px;font:500 11px/1.1 var(--px-sans);color:var(--px-ink3);-webkit-tap-highlight-color:transparent}
.pm-tab .w{position:relative;display:grid;place-items:center;height:26px}
.pm-tab .w svg{width:23px;height:23px}
.pm-tab .l{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pm-tab.on{color:var(--px-ink)}
.pm-tab em{position:absolute;top:-3px;left:calc(50% + 6px);min-width:17px;height:17px;padding:0 4px;box-sizing:border-box;border-radius:9px;background:var(--px-warn-dot);color:#fff;font:700 10.5px/17px var(--px-sans);font-style:normal;text-align:center;box-shadow:0 0 0 2px var(--px-panel)}
/* Back, above an opened row */
.pm-dbar{position:sticky;top:0;z-index:60;display:flex;align-items:center;height:46px;padding:0 6px;background:var(--px-panel);box-shadow:inset 0 -1px 0 var(--px-hair)}
.pm-back{all:unset;cursor:pointer;display:flex;align-items:center;gap:2px;height:40px;padding:0 10px 0 4px;border-radius:10px;font:500 15px/1 var(--px-sans);color:var(--px-ink2)}
.pm-back svg{width:22px;height:22px}
/* More */
.pm-scrim{position:fixed;inset:0;z-index:950;background:rgba(20,19,17,.38);animation:pm-fade .18s both}
.pm-sheet{position:fixed;left:0;right:0;bottom:0;z-index:951;max-height:88vh;overflow-y:auto;overscroll-behavior:contain;padding:8px 16px calc(env(safe-area-inset-bottom) + 18px);border-radius:24px 24px 0 0;background:var(--px-panel);color:var(--px-ink);box-shadow:0 -10px 40px -10px rgba(0,0,0,.35);font-family:var(--px-sans);animation:pm-up .24s cubic-bezier(.2,.8,.2,1) both}
@keyframes pm-fade{from{opacity:0}} @keyframes pm-up{from{transform:translateY(30%);opacity:.5}}
.pm-grab{width:38px;height:5px;border-radius:3px;background:var(--px-border);margin:0 auto 10px}
.pm-me{all:unset;cursor:pointer;box-sizing:border-box;display:flex;align-items:center;gap:12px;width:100%;padding:8px 4px 12px;box-shadow:inset 0 -1px 0 var(--px-hair)}
.pm-me > span{flex:1;min-width:0}
.pm-me b{display:block;font:600 16px/21px var(--px-sans)} .pm-me small{display:block;font-size:13px;color:var(--px-ink3)}
.pm-me .pm-av,.pm-me [class*="av"]{width:40px;height:40px;flex:none}
.pm-clk{display:flex;align-items:center;gap:10px;margin-top:12px;padding:10px 12px;border-radius:16px;background:var(--px-fill)}
.pm-clk > i{width:9px;height:9px;border-radius:50%;background:var(--px-ink4);flex:none}
.pm-clk > i.on{background:var(--px-st-working);box-shadow:0 0 0 4px var(--px-good-t)}
.pm-clk span{flex:1;min-width:0} .pm-clk b{display:block;font:600 14.5px/19px var(--px-sans)} .pm-clk small{display:block;font-size:12.5px;color:var(--px-ink3)}
.pm-btn{all:unset;cursor:pointer;box-sizing:border-box;display:inline-flex;align-items:center;height:36px;padding:0 14px;border-radius:11px;background:var(--px-raised);box-shadow:inset 0 0 0 1px var(--px-border);font:500 14px/1 var(--px-sans);color:var(--px-ink);white-space:nowrap}
.pm-btn.pri{background:var(--px-primary);color:var(--px-onprimary);box-shadow:none}
.pm-gh{margin:16px 4px 6px;font:600 11.5px/1 var(--px-sans);letter-spacing:.06em;text-transform:uppercase;color:var(--px-ink3)}
.pm-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.pm-pg{all:unset;cursor:pointer;box-sizing:border-box;position:relative;display:flex;flex-direction:column;align-items:center;gap:7px;padding:14px 4px 12px;border-radius:16px;background:var(--px-fill);font:500 12.5px/1.15 var(--px-sans);color:var(--px-ink);text-align:center}
.pm-pg svg{width:24px;height:24px}
.pm-pg.on{box-shadow:inset 0 0 0 1.5px var(--px-ink)}
.pm-pg em{position:absolute;top:7px;right:9px;min-width:17px;height:17px;padding:0 4px;box-sizing:border-box;border-radius:9px;background:var(--px-warn-dot);color:#fff;font:700 10.5px/17px var(--px-sans);font-style:normal}
.pm-rows{display:flex;flex-direction:column}
.pm-rows button{all:unset;cursor:pointer;box-sizing:border-box;display:grid;grid-template-columns:22px 1fr;gap:1px 12px;align-items:center;padding:11px 6px;border-radius:12px}
.pm-rows button svg{grid-row:1 / span 2;color:var(--px-ink2)}
.pm-rows button span{font:500 15px/20px var(--px-sans)} .pm-rows button small{grid-column:2;font-size:12.5px;color:var(--px-ink3)}
.pm-rows button:active,.pm-pg:active,.pm-tab:active{opacity:.7}
:root.pm-more[data-device="phone"] body{overflow:hidden}
/* ---------- pages: one column, the page scrolls (not boxes inside it) ---------- */
:root[data-device="phone"] .main{padding:0 !important;margin:0 !important;width:auto !important;max-width:100vw !important;height:auto !important;min-height:0 !important;overflow:visible !important;flex:none !important;display:block !important}
:root[data-device="phone"] .main > .tg,:root[data-device="phone"] .main > .px{height:auto !important;min-height:calc(100vh - var(--pm-tab-h));overflow:visible !important;border-radius:0 !important;box-shadow:none !important;display:block !important;max-width:100vw}
:root[data-device="phone"] .tg-body,:root[data-device="phone"] .px-body{display:block !important;height:auto !important;overflow:visible !important;grid-template-columns:none !important}
:root[data-device="phone"] .tg-list,:root[data-device="phone"] .px-list{width:auto !important;max-width:none !important;height:auto !important;border:0 !important;box-shadow:none !important;overflow:visible !important;display:block !important}
:root[data-device="phone"] .tg-main,:root[data-device="phone"] .px-main{width:auto !important;height:auto !important;overflow:visible !important;border:0 !important;display:block !important}
:root[data-device="phone"] .tg-scroll,:root[data-device="phone"] .px-scroll,:root[data-device="phone"] .pg-scroll,:root[data-device="phone"] .tg-main > *{height:auto !important;max-height:none !important;overflow:visible !important}
:root[data-device="phone"] .tg-keys,:root[data-device="phone"] .px-keys,:root[data-device="phone"] kbd,:root[data-device="phone"] .px-kbd,:root[data-device="phone"] .pxr-kbd{display:none !important}
/* the list, or the opened row — not both */
:root[data-device="phone"] .tg-body:has(> .tg-list) > .tg-main,:root[data-device="phone"] .px-body:has(> .px-list) > .px-main{display:none !important}
:root.pm-det[data-device="phone"] .tg-body:has(> .tg-list) > .tg-main,:root.pm-det[data-device="phone"] .px-body:has(> .px-list) > .px-main{display:block !important}
:root.pm-det[data-device="phone"] .tg-body > .tg-list,:root.pm-det[data-device="phone"] .px-body > .px-list{display:none !important}
:root.pm-det[data-device="phone"] .main > .tg > .tg-head,:root.pm-det[data-device="phone"] .main > .px > .px-head{display:none !important}
/* page heads: the title, then the facts, then the views as chips that scroll sideways */
:root[data-device="phone"] .tg-head,:root[data-device="phone"] .px-head{position:static !important;display:flex !important;flex-wrap:wrap !important;align-items:center;gap:8px 10px !important;height:auto !important;min-height:0 !important;padding:14px 16px 10px !important}
:root[data-device="phone"] .tg-head > :first-child,:root[data-device="phone"] .px-head > :first-child{font-size:26px !important;line-height:32px !important}
:root[data-device="phone"] .tg-facts,:root[data-device="phone"] .px-facts{order:3;flex:1 1 100% !important;display:flex !important;flex-wrap:wrap;gap:6px !important;margin:0 !important;white-space:normal !important}
:root[data-device="phone"] .tg-head .sp,:root[data-device="phone"] .px-head .sp{display:none !important}
:root[data-device="phone"] .tg-views{order:4;flex:1 1 100% !important;display:flex !important;overflow-x:auto;scrollbar-width:none;margin:0 -16px !important;padding:0 16px 2px !important;max-width:none !important;width:auto !important}
:root[data-device="phone"] .tg-views::-webkit-scrollbar{display:none}
:root[data-device="phone"] .tg-views > *{flex:none !important}
/* popovers become sheets from the bottom; dialogs fit the screen */
:root[data-device="phone"] .tg-pop{position:fixed !important;left:0 !important;right:0 !important;top:auto !important;bottom:0 !important;width:auto !important;max-width:none !important;max-height:82vh !important;overflow-y:auto !important;border-radius:20px 20px 0 0 !important;padding-bottom:calc(env(safe-area-inset-bottom) + 14px) !important;z-index:960 !important}
:root[data-device="phone"] .modal,:root[data-device="phone"] .modal-card,:root[data-device="phone"] .px-modal{max-width:calc(100vw - 16px) !important;width:calc(100vw - 16px) !important;max-height:calc(100vh - 24px) !important;overflow-y:auto !important}
:root[data-device="phone"] .toast-wrap{bottom:calc(var(--pm-tab-h) + env(safe-area-inset-bottom) + 14px) !important;left:12px !important;right:12px !important;transform:none !important;width:auto !important}
:root[data-device="phone"] .toast{max-width:none !important;width:100% !important}
/* ---------- the opened row: its top line wraps ---------- */
:root[data-device="phone"] .tg-top{padding-left:16px !important;padding-right:16px !important}
:root[data-device="phone"] .tg-top .r1,:root[data-device="phone"] .mq-ch,:root[data-device="phone"] .fq-ch,:root[data-device="phone"] .wa-oph,:root[data-device="phone"] .tk-dh,:root[data-device="phone"] .mq-sec,:root[data-device="phone"] .pq-opf,:root[data-device="phone"] .mq-more,:root[data-device="phone"] .tg-next,:root[data-device="phone"] .fm-bh,:root[data-device="phone"] .wa-pk-h,:root[data-device="phone"] .tg-sec,:root[data-device="phone"] .r1{flex-wrap:wrap !important;row-gap:6px !important}
:root[data-device="phone"] .mq-ch .sp,:root[data-device="phone"] .tg-top .r1 .sp{flex-basis:0 !important}
:root[data-device="phone"] .mq-leg{flex-wrap:wrap !important;row-gap:4px}
/* ---------- dashboards: cards in one column, tiles two across ---------- */
:root[data-device="phone"] .mq-full{padding:4px 12px 20px !important;max-width:100vw;box-sizing:border-box}
:root[data-device="phone"] .mq-full > *,:root[data-device="phone"] .mq-grid,:root[data-device="phone"] .mq-row2,:root[data-device="phone"] .mq-cols{grid-column:1 / -1 !important}
:root[data-device="phone"] .mq-tiles,:root[data-device="phone"] .mq-needs,:root[data-device="phone"] .cq-kps,:root[data-device="phone"] .cr-tot,:root[data-device="phone"] .pq-facts,:root[data-device="phone"] .fq-facts,:root[data-device="phone"] .fq-phg,:root[data-device="phone"] .dy-tot{grid-template-columns:repeat(2,minmax(0,1fr)) !important}
:root[data-device="phone"] .mq-pace{grid-template-columns:minmax(0,1fr) !important}
:root[data-device="phone"] .mq-tile .r{flex-wrap:wrap !important}
/* wide table rows keep their columns and slide sideways inside their card */
:root[data-device="phone"] .mq-cb,:root[data-device="phone"] .pq-op,:root[data-device="phone"] .fq-card,:root[data-device="phone"] .tk-wg,:root[data-device="phone"] .wa-pts{overflow-x:auto !important;-webkit-overflow-scrolling:touch}
:root[data-device="phone"] .cq-bh,:root[data-device="phone"] .cq-br{min-width:920px}
:root[data-device="phone"] .pq-pr{min-width:640px}
:root[data-device="phone"] .fq-er{min-width:600px}
:root[data-device="phone"] .cr-wy{min-width:520px}
:root[data-device="phone"] .mq-age{min-width:560px}
:root[data-device="phone"] .mq-capg{min-width:640px}
:root[data-device="phone"] .wa-pt{min-width:560px}
/* the Console's team: tech cards slide sideways */
:root[data-device="phone"] .cq-team{display:flex !important;overflow-x:auto;gap:8px !important;scrollbar-width:none;margin:0 -12px;padding:0 12px 4px}
:root[data-device="phone"] .cq-team > *{flex:0 0 150px !important;min-width:150px}
/* Warranty: the claim's steps — only the dots and the current step's name */
:root[data-device="phone"] .wa-sum{flex-wrap:wrap !important;row-gap:10px !important}
:root[data-device="phone"] .wa-sum .wa-trk{flex:1 1 100% !important}
:root[data-device="phone"] .wa-stp{font-size:11px !important;text-align:center;line-height:1.2}
/* ---------- the RO list: a row is RO, customer, what's wrong, tech and age ---------- */
:root[data-device="phone"] .rq-top{padding:12px 16px 8px !important;height:auto !important;position:static !important}
:root[data-device="phone"] .rq-titlerow{flex-wrap:wrap !important;row-gap:8px}
:root[data-device="phone"] .rq-tools{flex-wrap:wrap !important;gap:8px !important}
:root[data-device="phone"] .rq-seg{order:-1;flex:1 1 100% !important;max-width:none !important;overflow-x:auto;scrollbar-width:none;display:flex !important}
:root[data-device="phone"] .rq-seg > *{flex:none !important}
:root[data-device="phone"] .rq-find{flex:1 1 100% !important;max-width:none !important;width:auto !important}
:root[data-device="phone"] .rq-head{display:none !important}
:root[data-device="phone"] .rq-scroll{height:auto !important;overflow:visible !important;padding:0 8px !important}
:root[data-device="phone"] .rq-row{grid-template-columns:18px minmax(0,1fr) auto !important;grid-template-areas:"st no days" "st cu av" "st cmp cmp" !important;row-gap:2px !important;column-gap:8px !important;height:auto !important;min-height:0 !important;padding:10px 8px !important;align-items:center}
:root[data-device="phone"] .rq-row > *{min-width:0}
:root[data-device="phone"] .rq-row > .rq-cb,:root[data-device="phone"] .rq-row > .rq-ticks,:root[data-device="phone"] .rq-row > .c-time,:root[data-device="phone"] .rq-row > .c-spot,:root[data-device="phone"] .rq-row > .c-ready,:root[data-device="phone"] .rq-row > .rq-optw{display:none !important}
:root[data-device="phone"] .rq-row > svg{grid-area:st;align-self:start;margin-top:2px}
:root[data-device="phone"] .rq-row > .rq-no{grid-area:no}
:root[data-device="phone"] .rq-row > .rq-days{grid-area:days;justify-self:end}
:root[data-device="phone"] .rq-row > .rq-cu{grid-area:cu;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
:root[data-device="phone"] .rq-row > .tg-av{grid-area:av;justify-self:end}
:root[data-device="phone"] .rq-row > .rq-cmp{grid-area:cmp;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
/* ---------- Day report: the sheet fills the phone, tables slide ---------- */
:root[data-device="phone"] .dy-cv{padding:8px !important}
:root[data-device="phone"] .dy-paper{width:auto !important;max-width:none !important;padding:16px 14px !important;box-sizing:border-box}
:root[data-device="phone"] .dy-paper table{display:block;overflow-x:auto;max-width:100%}
/* ---------- Profile: the sections as a list, then the one you open ---------- */
:root[data-device="phone"] .px-scroll{display:block !important}
:root[data-device="phone"] .px-it{width:auto !important;max-width:none !important}
:root[data-device="phone"] .px-doc{max-width:none !important;width:auto !important;padding:12px 16px 24px !important}
/* ---------- the RO page ---------- */
:root[data-device="phone"] .ro-page,:root[data-device="phone"] .ro-detail-pane,:root[data-device="phone"] .jc-host{height:auto !important;min-height:0 !important;max-height:none !important;overflow:visible !important;display:block !important;width:auto !important;padding:0 !important;margin:0 !important}
:root[data-device="phone"] .ro-page > .ro-list{display:none !important}
/* ---------- second round: the views inside each page ---------- */
:root[data-device="phone"] .tg-head{gap:8px 6px !important}
:root[data-device="phone"] .tg-next > p,:root[data-device="phone"] .tg-next > span:not(:first-child):not(.sp),:root[data-device="phone"] .tg-next > div:not(:first-child){flex:1 1 200px !important;min-width:0}
:root[data-device="phone"] .mq-two,:root[data-device="phone"] .mq-fcols,:root[data-device="phone"] .cr-two,:root[data-device="phone"] .tk-sig{grid-template-columns:minmax(0,1fr) !important}
:root[data-device="phone"] .mq-sc,:root[data-device="phone"] .mq-pages,:root[data-device="phone"] .mq-form,:root[data-device="phone"] .cr-bests{grid-template-columns:repeat(2,minmax(0,1fr)) !important}
:root[data-device="phone"] .mq-fcs{grid-template-columns:none !important;grid-auto-flow:column !important;grid-auto-columns:118px !important;overflow-x:auto;scrollbar-width:none;padding-bottom:4px}
:root[data-device="phone"] .mq-tbl{overflow-x:auto !important}
:root[data-device="phone"] .mq-tbl > .h,:root[data-device="phone"] .mq-tr{min-width:560px}
:root[data-device="phone"] .mq-gh,:root[data-device="phone"] .mq-gr{min-width:520px}
:root[data-device="phone"] .mq-al{min-width:600px}
:root[data-device="phone"] .tk-tsbar,:root[data-device="phone"] .cr-job .h,:root[data-device="phone"] .cr-bar .nums,:root[data-device="phone"] .cr-wy .n{flex-wrap:wrap !important;row-gap:6px}
/* Time Log, the shop: name and hours on one line, the day's bar under it */
:root[data-device="phone"] .tk-sr{grid-template-columns:minmax(0,1fr) auto auto auto !important;grid-template-areas:"nm v1 v2 v3" "wt wt wt wt" !important;row-gap:6px !important;column-gap:10px !important;min-width:0 !important}
:root[data-device="phone"] .tk-sr > :nth-child(1){grid-area:nm;min-width:0}
:root[data-device="phone"] .tk-sr > .tk-wt{grid-area:wt;min-height:16px}
:root[data-device="phone"] .tk-sr > :nth-child(3){grid-area:v1} :root[data-device="phone"] .tk-sr > :nth-child(4){grid-area:v2} :root[data-device="phone"] .tk-sr > :nth-child(5){grid-area:v3}
/* boards (the Desk, the Yard, Tomorrow, the claim Board, Money, failed Parts, Techs) open on the board, not the list */
:root[data-device="phone"] :is(.main.v-triage .tg-body.v-desk,.main.v-triage .tg-body.v-yard,.main.v-foreman .tg-body.v-yard,.main.v-foreman .tg-body.v-tmr,.main.v-foreman .tg-body.v-techs,.main.v-warranty .tg-body.v-board,.main.v-warranty .tg-body.v-money,.main.v-warranty .tg-body.v-parts) > .tg-list{display:none !important}
:root[data-device="phone"] :is(.main.v-triage .tg-body.v-desk,.main.v-triage .tg-body.v-yard,.main.v-foreman .tg-body.v-yard,.main.v-foreman .tg-body.v-tmr,.main.v-foreman .tg-body.v-techs,.main.v-warranty .tg-body.v-board,.main.v-warranty .tg-body.v-money,.main.v-warranty .tg-body.v-parts) > .tg-main{display:block !important}
/* boards with columns slide sideways; tables slide inside their card */
:root[data-device="phone"] .wa-bd,:root[data-device="phone"] .fm-tmcols{overflow-x:auto !important;-webkit-overflow-scrolling:touch}
:root[data-device="phone"] .wa-mf,:root[data-device="phone"] .fm-tmh,:root[data-device="phone"] .tg-main .r{flex-wrap:wrap !important;row-gap:6px}
:root[data-device="phone"] .wa-per,:root[data-device="phone"] .tg-seg3{max-width:100%;overflow-x:auto;scrollbar-width:none}
:root[data-device="phone"] .wa-bins{grid-template-columns:repeat(3,minmax(0,1fr)) !important}
:root[data-device="phone"] .main table{display:block;overflow-x:auto;max-width:100%;-webkit-overflow-scrolling:touch}
/* Parts and Fixes, the full-width views */
:root[data-device="phone"] .pq-fh,:root[data-device="phone"] .fq-fh,:root[data-device="phone"] .pq-cbar,:root[data-device="phone"] .pq-tg,:root[data-device="phone"] .pq-sum,:root[data-device="phone"] .fq-sum{flex-wrap:wrap !important;row-gap:6px !important}
:root[data-device="phone"] .pq-fh .tg-hf,:root[data-device="phone"] .fq-fh .tg-hf{flex:1 1 100% !important;white-space:normal !important;order:3}
:root[data-device="phone"] .pq-cgrid,:root[data-device="phone"] .pq-two2,:root[data-device="phone"] .fq-trend{grid-template-columns:minmax(0,1fr) !important}
:root[data-device="phone"] .pq-bins{grid-template-columns:repeat(2,minmax(0,1fr)) !important}
:root[data-device="phone"] .pq-up{grid-template-columns:none !important;grid-auto-flow:column !important;grid-auto-columns:200px !important;overflow-x:auto;scrollbar-width:none}
:root[data-device="phone"] .pq-tbl,:root[data-device="phone"] .fq-tbl{overflow-x:auto !important;-webkit-overflow-scrolling:touch}
:root[data-device="phone"] .pq-or,:root[data-device="phone"] .pq-rr,:root[data-device="phone"] .pq-cr,:root[data-device="phone"] .pq-wait,:root[data-device="phone"] .fq-or,:root[data-device="phone"] .fq-rv{min-width:680px}
:root[data-device="phone"] .ivHint,:root[data-device="phone"] .tg-kbd,:root[data-device="phone"] .mfoot .hint,:root[data-device="phone"] .modal .kbdHint{display:none !important}
:root[data-device="phone"] .modal-foot::before{content:"" !important;margin-right:auto}
:root[data-device="phone"] .px-it[data-s="keys"]{display:none !important}
:root[data-device="phone"] .pq-fh,:root[data-device="phone"] .fq-fh{height:auto !important;min-height:0 !important;align-items:center}
:root[data-device="phone"] .pq-fh h2,:root[data-device="phone"] .fq-fh h2{line-height:1.2 !important;height:auto !important}
:root[data-device="phone"] .fq-or{min-width:900px}
/* the phone view in a wide window (trying it on the computer): a phone-width column in the middle */
@media (min-width:600px){
  :root[data-device="phone"] body{background:var(--px-canvas)}
  :root[data-device="phone"] #app{max-width:480px;margin:0 auto !important;background:var(--px-panel);box-shadow:0 0 0 1px var(--px-hair);min-height:100vh}
  :root[data-device="phone"] .pm-tabs,:root[data-device="phone"] .pm-sheet,:root[data-device="phone"] .tg-pop,:root[data-device="phone"] .toast-wrap{left:max(0px,calc(50% - 240px)) !important;right:max(0px,calc(50% - 240px)) !important}
  :root[data-device="phone"] .main,:root[data-device="phone"] .main > .tg,:root[data-device="phone"] .main > .px{max-width:480px !important}
}
