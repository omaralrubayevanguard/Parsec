    else { x = W - pw - 16; y = 12; }
    p.style.left = Math.round(Math.max(12, Math.min(x, W - pw - 12))) + "px"; p.style.top = Math.round(Math.max(12, Math.min(y, Hh - ph - 12))) + "px";
  }
