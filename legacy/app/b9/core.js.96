    if(on.offsetTop < sc.scrollTop + 30) sc.scrollTop = on.offsetTop - 40; else if(on.offsetTop + on.offsetHeight > sc.scrollTop + sc.clientHeight - 20) sc.scrollTop = on.offsetTop + on.offsetHeight - sc.clientHeight + 40; }
