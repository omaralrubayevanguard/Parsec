  /* ---------- drawing ---------- */
  const stCls = { 'Not Ordered': 'no', 'Ordered': 'ord', 'Backordered': 'bo', 'Received': 'in', 'Staged': 'stg', 'Picked up': 'pk', 'Installed': 'inst' };
  const stTxt = { 'Not Ordered': 'Not ordered', 'Ordered': 'Ordered', 'Backordered': 'Backordered', 'Received': 'Received', 'Staged': 'Staged', 'Picked up': 'Picked up', 'Installed': 'Installed' };
  const stChip = (p, live) => { const l = late(p); return `<span class="pt-st ${l && l.k === 'late' ? 'late' : stCls[p.st] || 'no'}"${live ? ` data-a="pop" data-p="st" data-pid="${p.id}" title="Change status"` : ''}><i></i>${stTxt[p.st] || esc(p.st)}${live ? ic('chevD', 10) : ''}</span>`; };
  const fm = () => F(PG.person('Foreman') || 'Foreman');
  function view(){
    flush(); const me0 = PG.me().name; if(U._me !== me0){ U._me = me0; U.view = 'desk'; U.sel = null; U.pop = null; }
    if(UI.ptRo){ const r = get(UI.ptRo); if(r){ U.view = 'desk'; U.sel = r.id; const st = stateOf(r); if(st === 'way' || st === 'tech') U.open[st] = true; } UI.ptRo = null; }
    if(U.view === 'desk' && (!U.sel || !get(U.sel))){ const L = flat(); U.sel = L[0] || null; }
    bayLog();
    const v = U.view;
    const body = v === 'order' ? vOrder() : v === 'shelf' ? vShelf() : v === 'cat' ? vCat() : v === 'ret' ? vRet() : v === 'setup' ? vSetup() : vDesk();
    return `<div class="tg pt" data-pg="parts">${head()}<div class="tg-body v-${v}">${v === 'desk' ? list() : ''}<div class="tg-main">${body}</div>${pop()}</div>${askCard()}</div>`;
  }
  function head(){
    const G = grouped(), all = allLines().map(x => x.q), oo = all.filter(p => p.st === 'Ordered' || p.st === 'Backordered'), due = oo.filter(p => p.eta === TODAY()).length;
    const f = (k, n, t, w) => n ? `<button class="tg-hf${w ? ' w' : ''}" data-a="hf" data-k="${k}"><b>${n}</b>${t}</button><i>·</i>` : '';
    const vs = [['desk', 'inbox2', 'Desk'], ['order', 'truck', 'On order'], ['shelf', 'shelf', 'Shelf'], ['ret', 'undo', 'Returns'], ['cat', 'book', 'Catalog']];
    return `<header class="tg-head"><h1 class="tg-h1">Parts</h1><span class="tg-facts">${f('counter', G.counter.length, 'at the counter', true)}${f('sent', G.sent.length, 'sent to you')}${f('order', G.order.length, 'to order')}${f('late', G.late.length, 'late', true)}${f('due', due, 'due today')}${f('rets', retStore().filter(needs).length, 'returns')}</span>
    <div class="tg-views">${vs.map((x, i) => `<button class="${U.view === x[0] ? 'on' : ''}" data-a="view" data-v="${x[0]}" title="${x[2]} (${i + 1})">${ic(x[1], 14)}${x[2]}</button>`).join('')}</div><span class="tg-hsep"></span>
    <button class="btn ib tg-srch-b" data-a="pop" data-p="srch" title="Find a part, RO or customer (/)">${ic('search', 16)}</button><button class="btn ib tg-srch-b${U.view === 'setup' ? ' on' : ''}" data-a="view" data-v="setup" title="Parts setup — suppliers, bins, returns, rules">${ic('gear', 16)}</button><button class="btn btn-sm btn-primary pt-cb" data-a="pop" data-p="chk" title="Check in a delivery (C)">${ic('truck', 15)}Check in</button></header>`;
  }
  function list(){
    const G = grouped(), s = U.sel;
    const item = r => { const st = stateOf(r), w = why(r), on = r.id === s, g = GROUPS.find(x => x[0] === st);
      return `<div class="tg-it${on ? ' on' : ''}${on && U.kb ? ' kb' : ''}" data-a="sel" data-ro="${r.id}">${w.late ? '<i class="tg-dot"></i>' : ''}<span class="tg-gi${st === 'counter' ? ' now' : ''}">${ic(g ? g[2] : 'box', 15)}</span><span class="tg-t"><b class="tg-no">${esc(r.no)}</b><b class="tg-cu">${esc(r.cust)}</b>${r.spot !== '—' ? `<span class="tg-spot${r.bay ? ' bay' : ''}">${ic('pin', 11)}${esc(r.spot)}</span>` : ''}</span><span class="tg-w${w.late ? ' late' : ''}">${esc(w.t)}</span><button class="btn btn-sm${st === 'counter' ? ' btn-primary' : ''} tg-go" data-a="do" data-ro="${r.id}">${esc(BTN[st](r))}${on && U.kb ? kbd('↵') : ''}</button></div>`; };
    let body = GROUPS.filter(g => G[g[0]].length).map(g => `<div class="tg-grp">${g[1]}<span>${G[g[0]].length}</span></div>` + G[g[0]].map(item).join('')).join('');
    if(!body) body = `<div class="tg-empty"><span class="tg-ring0 ok">${ic('check', 22)}</span><h3>All caught up</h3><p>Nothing to order, chase or ship.</p></div>`;
    if(G.way.length) body += `<div class="tg-sec${U.open.way ? ' open' : ''}" data-a="open" data-k="way">${ic('chevR', 12)}<span>On the way</span><span class="n">${G.way.length}</span><span class="m">on time</span></div>` + (U.open.way ? G.way.map(item).join('') : '');
    if(G.tech.length) body += `<div class="tg-sec${U.open.tech ? ' open' : ''}" data-a="open" data-k="tech">${ic('chevR', 12)}<span>With the tech</span><span class="n">${G.tech.length}</span><span class="m">every part picked up</span></div>` + (U.open.tech ? G.tech.map(item).join('') : '');
    if(G.done.length) body += `<div class="tg-sec${U.open.done ? ' open' : ''}" data-a="open" data-k="done">${ic('chevR', 12)}<span>Cleared today</span><span class="n">${G.done.length}</span></div>` + (U.open.done ? `<div class="tg-rows">${G.done.map(r => { const d = doneStore()[r.id] || {}; return `<div class="tg-row done" data-a="sel" data-ro="${r.id}"><time>${esc(tm(d.at))}</time><b class="tg-no">${esc(r.no)}</b><b>${esc(r.cust)}</b><small>${ic('check', 12)}${esc(d.why || '')}</small></div>`; }).join('')}</div>` : '');
    const n = GROUPS.reduce((a, g) => a + G[g[0]].length, 0);
    return `<section class="tg-list"><div class="tg-lh">Needs action<span class="n">${n}</span></div><div class="tg-scroll">${body}</div><div class="tg-keys"><span>${kbd('J')}${kbd('K')}move</span><span>${kbd('↵')}do it</span><span>${kbd('C')}check in</span><span>${kbd('/')}find</span><span>${kbd('1')}–${kbd('5')}views</span></div></section>`;
  }
  function srcCell(p, r){
    const c = cat(p.pn) || {}, l = late(p);
    if(p.st === 'Not Ordered') return c.oh >= p.qty ? `<span class="src"><b>On the shelf${c.bin ? ' · ' + esc(c.bin) : ''}</b><small>${c.oh} on hand</small></span>` : `<span class="src"><b>To order</b><small>${c.oh ? c.oh + ' on hand · short' : 'none on hand'}</small></span>`;
    if(p.st === 'Received') return `<span class="src"><b>Receiving · no bin yet</b><small class="late">checked in ${esc(tm(p.rcv))}</small></span>`;
    if(p.st === 'Staged') return `<span class="src"><b>Bin ${esc(p.bin || '—')}</b><small>${p.sup === 'stock' ? 'from stock' : (p.sup ? esc(supName(p.sup)) + (p.po ? ' · PO ' + esc(p.po) : '') : '')}${p.rcv ? ' · ' + esc(tm(p.rcv)) : ''}</small></span>`;
    if(p.st === 'Picked up') return `<span class="src"><b>With ${esc(F(r.tech))}</b><small>picked up ${esc(tm(p.pk))}</small></span>`;
    if(p.st === 'Installed') return `<span class="src"><b>On the truck</b><small>installed${r.tech ? ' by ' + esc(F(r.tech)) : ''}</small></span>`;
    return `<span class="src"><b>${p.sup ? esc(supName(p.sup)) : 'Ordered'}${p.po ? ' · PO ' + esc(p.po) : ''}</b><small class="${l ? (l.k === 'bo' ? 'bad' : 'late') : ''}">${l ? l.t : p.eta ? (p.eta === TODAY() ? 'due today' : 'due ' + short(p.eta)) : 'no ETA'}</small></span>`; }
  function nextBar(r){
    const st = stateOf(r), L = lines(r);
    const bar = (t, btn, a, sec) => `<div class="tg-next"><span class="k">Next</span><p>${t}</p>${btn ? `<button class="btn btn-sm${a === 'do' ? ' btn-primary' : ''}" data-a="do" data-ro="${r.id}">${btn}${kbd('↵')}</button>` : ''}${sec || ''}</div>`;
    if(st === 'counter'){ const a = counterAsk(r); return bar(`${esc(F(a.from))} is waiting${r.spot !== '—' ? ' at ' + esc(r.spot) : ''} — ${esc(a.q || a.t)}${a.b ? ' <span class="pt-rule">' + esc(a.b) + '</span>' : ''}`, 'Handle it', 'do', `<button class="btn btn-sm" data-a="askdone" data-ro="${r.id}">${ic('check', 13)}Handed over</button>`); }
    if(st === 'sent') return bar(`${esc(F(r.route.by))} sent this ${esc(tm(r.route.at))}${r.route.reason ? ' · ' + esc(r.route.reason) : ''}${r.route.note ? ' — “' + esc(r.route.note) + '”' : ''}.<span class="pt-rule">${ic('swap', 11)}Approval done → Parts · ${rtCfg().rules.find(x => x.k === 'approval').mode === 'auto' ? 'automatic' : 'asks first'}</span>`, 'Accept', 'do', `<button class="btn btn-sm" data-a="pop" data-p="ret" data-ro="${r.id}">Send back…</button>`);
    if(st === 'order'){ const no = r.ops.filter(o => o.appr).flatMap(o => o.parts).filter(p => p.st === 'Not Ordered'), stk = no.filter(p => (cat(p.pn) || {}).oh >= p.qty).length; const c0 = cat(no[0].pn) || {};
      return bar(stk === no.length ? (no.length === 1 ? `1 part to get — it’s on the shelf${c0.bin ? ', bin ' + esc(c0.bin) : ''}.` : `${no.length} parts to get — all on the shelf.`) : `${no.length} part${no.length > 1 ? 's' : ''} to get${stk ? ` · ${stk} on the shelf` : ''}.`, stk === no.length ? 'Pull…' : 'Order…', 'do'); }
    if(st === 'late'){ const p = L.find(late), l = late(p); return bar(`The ${esc(lc(p.desc))} is ${l.k === 'late' ? l.n + ' day' + (l.n > 1 ? 's' : '') + ' late' : l.k === 'bo' ? 'backordered' + (p.eta ? '' : ' with no date') : 'out with no ETA'} — ${esc(supName(p.sup))}${p.po ? ', PO ' + esc(p.po) : ''}.${r.ro.ptTold ? ` ${esc(F(r.wr))} last told the customer ${esc(md(r.ro.ptTold))}.` : ''}`, 'Chase…', 'do'); }
    if(st === 'in'){ const rc = rcvd(r); if(rc.length){ const b = binOf(r) || nextBin(); return bar(`The ${esc(lc(rc[0].desc))} is checked in but has no bin — stage it${binOf(r) ? ' with the rest' : ''} in ${esc(b)}.`, 'Stage it', 'do'); }
      return bar(`Every part is in — bin ${esc(binOf(r) || '—')}. Send it to ${esc(fm())} to bring the truck in?<span class="pt-rule">${ic('swap', 11)}All parts received → Foreman · ${rtCfg().rules.find(x => x.k === 'parts').mode === 'auto' ? 'automatic' : 'asks first'}</span>`, 'Send to ' + esc(fm()), 'do', `<button class="btn btn-sm" data-a="notyet" data-ro="${r.id}">Not yet</button>`); }
    if(st === 'ret'){ const t = retsOf(r).find(needs); return t ? bar(esc(retNext(t)), retAct(t)[1], 'do') : ''; }
    if(st === 'way'){ const p = L.filter(x => !inHand(x) && x.st !== 'Not Ordered')[0]; return bar(p ? `Nothing to do — the ${esc(lc(p.desc))} is due ${p.eta === TODAY() ? 'today' : p.eta ? short(p.eta) : '— no date yet'}.` : 'Nothing to do yet.', '', ''); }
    if(st === 'tech') return bar(`Nothing for Parts — ${esc(F(r.tech))} has every part.`, '', '');
    if(st === 'quiet'){ const t = retsOf(r)[0], w = r.ops.some(o => !o.appr && o.parts.length); return t ? bar(`${t.id} · ${esc(rstTxt(t))}${t.st === 'hold' ? ' until ' + short(t.by) : ''} — nothing to do yet.`, '', '') : bar(w ? 'Waiting on the customer’s approval — the parts show under To order once it’s approved.' : 'Nothing for Parts on this RO.', '', ''); }
    const d = doneStore()[r.id] || {}; return `<div class="pt-ok">${ic('check', 16)}Cleared — ${esc(d.why || '')}</div>`;
  }
  function vDesk(){
    const r = get(U.sel); if(!r) return `<div class="tg-blank"><div class="tg-empty"><span class="tg-ring0">${ic('parts', 22)}</span><h3>Pick an RO</h3><p>Its parts, where they are and what’s next.</p></div></div>`;
    const st = stateOf(r), L = lines(r);
    const tot = L.reduce((s, p) => s + p.price * p.qty, 0);
    let h = `<div class="pt-pane pg-scroll" data-scroll="pane"><div class="tg-top"><div class="r1"><span class="tg-no">${esc(roLabelFull(r.ro))}</span>${r.jt ? `<span class="pt-jt">${r.jt}</span>` : ''}<span>·</span><span>${esc(r.veh)}${r.eng ? ' · ' + esc(r.eng) : ''} · Unit ${esc(r.unit)}</span><span class="sp"></span><button class="btn btn-sm" data-a="pop" data-p="send" data-ro="${r.id}">${ic('swap', 14)}Send to…</button><button class="btn btn-sm" data-a="openro" data-ro="${r.id}">Open RO</button></div><h2>${esc(r.cust)}</h2>
      <div class="pt-facts"><div><small>Truck</small><span class="${r.bay && st === 'late' ? 'warn' : ''}">${roIsDone(r.ro) ? 'Gone — RO closed' : r.spot === '—' ? 'No spot yet' : `${ic('pin', 12)}${r.bay ? 'Bay ' : 'Lot '}${esc(r.spot)}${r.bay && st === 'late' ? ' · tied up' : ''}`}</span></div><div><small>Technician</small><span>${esc(r.tech || '—')}</span></div><div><small>Writer</small><span>${esc(r.wr || '—')}</span></div><div><small>VIN</small><span class="m">${esc(r.vin)}</span></div><div><small>Parts on this RO</small><span class="m">${L.length ? usd(tot) : '—'}</span></div></div></div><div class="pt-pad">${nextBar(r)}${extraCards(r)}`;
    r.ops.forEach((o, i) => { if(!o.parts.length && r.ops.length > 1) return; const oin = o.parts.filter(inHand).length, ot = o.parts.reduce((s, p) => s + p.price * p.qty, 0);
      h += `<div class="pt-op"><div class="pt-oph"><span class="n">${i + 1}</span>${o.jt ? `<span class="pt-jt">${o.jt}</span>` : ''}<b>${esc(o.cmp)}</b>${o.appr ? '' : '<span class="pt-jt" style="background:var(--tg-warn-t);color:var(--tg-warn)">not approved yet</span>'}<span class="sp"></span><small>${oin} of ${o.parts.length} in hand</small><span class="pt-bar"><i style="width:${o.parts.length ? oin / o.parts.length * 100 : 0}%"></i></span></div>
        <div class="pt-pr h"><span>Status</span><span>Part</span><span>Part #</span><span style="text-align:right">Qty</span><span>Where</span><span style="text-align:right">Each</span><span></span></div>
        ${o.parts.map(p => { const c = cat(p.pn) || {}, l = late(p); return `<div class="pt-pr">${stChip(p, 1)}<span class="d"><b>${esc(p.desc)}</b>${p.st === 'Not Ordered' && c.oh >= p.qty ? `<small class="ok">In stock${c.bin ? ' · bin ' + esc(c.bin) : ''}</small>` : ''}</span><span class="pn">${esc(p.pn || '—')}</span><span class="q">${p.qty}</span>${srcCell(p, r)}<span class="pr">${p.price ? usd(p.price) : 'no charge'}</span><span class="ac">${st === 'sent' || !o.appr ? '' : p.st === 'Not Ordered' ? `<button class="btn btn-sm" data-a="do" data-ro="${r.id}">${c.oh >= p.qty ? 'Pull' : 'Order…'}</button>` : l ? `<button class="btn btn-sm" data-a="do" data-ro="${r.id}">Chase…</button>` : p.st === 'Ordered' ? `<button class="btn btn-sm" data-a="rcv1" data-pid="${p.id}">${ic('check', 13)}It’s in</button>` : p.st === 'Received' ? `<button class="btn btn-sm" data-a="stage1" data-pid="${p.id}">Stage</button>` : p.st === 'Staged' ? `<button class="btn btn-sm" data-a="pk1" data-pid="${p.id}" title="The tech took it">${ic('check', 13)}Picked up</button>` : ''}</span></div>`; }).join('') || '<div class="pt-none">No parts on this operation.</div>'}
        <div class="pt-opf"><span>Parts</span><b>${usd(ot)}</b><span class="sp"></span><button class="btn btn-sm tg-gh" data-a="addpart" data-ro="${r.id}" data-opid="${o.id}" title="Opens the operation on the RO page — add the part there">${ic('plus', 13)}Add a part</button></div></div>`; });
    const RT = retsOf(r); if(RT.length) h += `<div class="pt-op"><div class="pt-oph"><span class="n">${ic('undo', 13)}</span><b>Going back</b><span class="sp"></span><small>Parts runs every return</small></div>${RT.map(t => { const a = retAct(t); return `<div class="pt-ret"><span class="gi">${ic(t.kind === 'warranty' ? 'warranty' : t.kind === 'core' ? 'undo' : 'box', 16)}</span><b>${esc(t.id)} · ${esc(t.desc)}${t.qty > 1 ? ' × ' + t.qty : ''} · <span style="font-family:var(--tg-mono);font-weight:500">${esc(t.pn)}</span> <span class="pt-kind ${t.kind}">${KIND[t.kind]}</span></b><small>${esc(t.why)} · ${t.kind === 'warranty' ? `claim ${esc(t.claim || '—')}${t.ra ? ' · RA ' + esc(t.ra) : ''}` : `${esc(t.to)}${t.ra ? ' · RA ' + esc(t.ra) : ''} · ${usd(t.credit)} credit`} · shelf ${esc(t.shelf)}${t.by && t.st !== 'credited' ? ` · ${t.st === 'hold' ? 'hold until' : 'by'} ${short(t.by)}` : ''} · <span class="pt-st ${rstCls(t)}" style="height:18px;cursor:default"><i></i>${rstTxt(t)}</span></small>${a ? `<button class="btn btn-sm" data-a="rdo" data-tid="${t.id}">${a[1]}</button>` : ''}</div>`; }).join('')}</div>`;
    const LG = logOf(r);
    h += `<div class="pt-sec">History<span class="sp"></span><span>hand-offs, orders and check-ins</span></div><div class="pt-log">${LG.map(x => `<div><time>${esc(tm(x[0]))}</time><span>${x[1]}</span></div>`).join('') || '<div><span>Nothing yet.</span></div>'}</div>`;
    return h + '</div></div>';
  }
  function vOrder(){
    const rows0 = allLines().filter(x => x.q.st === 'Ordered' || x.q.st === 'Backordered').map(x => ({ r: x.r, p: x.q })), T = TODAY();
    const G = [['late', 'Late', x => !!late(x.p)], ['today', 'Due today', x => !late(x.p) && x.p.eta === T], ['tom', 'Tomorrow', x => x.p.eta === addD(T, 1)], ['later', 'Later', x => !late(x.p) && x.p.eta && x.p.eta > addD(T, 1)], ['none', 'No ETA yet', x => !late(x.p) && !x.p.eta]];
    const amt = rows0.reduce((s, x) => s + x.p.price * x.p.qty, 0), nl = rows0.filter(x => late(x.p)).length;
    const row = x => { const p = x.p, r = x.r, l = late(p);
      return `<div class="pt-or" data-a="open" data-ro="${r.id}" data-k="ro"><b>${esc(p.desc)}</b><span class="m">${esc(p.pn)}</span><span class="m q">${p.qty}</span><span class="ro"><b class="tg-no">${esc(r.no)}</b><span>${esc(r.cust)}</span></span><span class="wt"><span class="tg-spot${r.bay ? ' bay' : ''}">${ic('pin', 11)}${esc(r.spot)}</span>${esc(F(r.tech))}</span><span class="su">${esc(supName(p.sup))}<small>${p.po ? 'PO ' + esc(p.po) : ''}${p.ord ? ' · ' + md(p.ord) : ''}</small></span><span class="eta ${l ? (l.k === 'bo' ? 'bad' : 'late') : ''}">${l ? (l.k === 'late' ? `${l.n} d late` : l.k === 'bo' ? 'Backordered' : 'No ETA') : p.eta === T ? 'Today' : p.eta ? short(p.eta) : '—'}</span>${stChip(p, 0)}</div>`; };
    const tbl = G.map(g => { const L = rows0.filter(g[2]); if(!L.length) return ''; return `<div class="pt-tg${g[0] === 'late' ? ' late' : ''}">${g[1]}<span>${L.length}</span><span class="sp"></span>${g[0] === 'today' ? `<button class="btn btn-sm" data-a="pop" data-p="chk">${ic('truck', 13)}Check in</button>` : ''}</div>${L.map(row).join('')}`; }).join('') || '<div class="pt-none">Nothing on order.</div>';
    return `<div class="pt-full pg-scroll"><div class="pt-fh"><h2>On order</h2><span class="sp"></span><button class="btn btn-sm" data-a="ordcsv">${ic('download', 14)}Export</button><button class="btn btn-sm" data-a="ordprint">${ic('print', 14)}Print</button></div>
     ${orderCards()}<div class="pt-sum"><span><b>${rows0.length}</b>parts on order</span><span><b>${new Set(rows0.map(x => x.r.id)).size}</b>ROs</span><span><b>${usd0(amt)}</b>on order</span>${nl ? `<span class="warn"><b>${nl}</b>late</span>` : ''}</div>
     <div class="pt-tbl pt-print"><div class="pt-or h"><span>Part</span><span>Part #</span><span class="q">Qty</span><span>RO</span><span>Truck · tech</span><span>Supplier · PO</span><span>ETA</span><span>Status</span></div>${tbl}</div></div>`;
  }
  function vShelf(){
    const ALL = allLines();
    const bins = BINS().map(b => { const L = ALL.filter(x => x.q.st === 'Staged' && x.q.bin === b); return { b, r: L[0] && L[0].r, L }; });
    const card = x => { if(!x.r) return `<div class="pt-bin empty"><span class="k">${esc(x.b)}</span><span class="w">Empty</span></div>`;
      const r = x.r, L = lines(r), n = L.filter(inHand).length, all = n === L.length;
      return `<div class="pt-bin" data-a="open" data-ro="${r.id}" data-k="ro"><span class="k">${esc(x.b)}<span class="sp"></span><em class="${all ? 'ok' : 'part'}">${all ? 'All in' : n + ' of ' + L.length + ' in'}</em></span><span class="t"><b class="tg-no">${esc(r.no)}</b><b>${esc(r.cust)}</b></span><span class="w">${PG.av(r.tech || '?')}${esc(F(r.tech))} · ${x.L.length} part${x.L.length > 1 ? 's' : ''}<span class="sp"></span><button class="btn btn-sm ib pt-pk pt-lb" data-a="pop" data-p="label" data-bin="${esc(x.b)}" title="Bin label">${ic('scan', 13)}</button><button class="btn btn-sm pt-pk" data-a="pickup" data-bin="${esc(x.b)}" title="${esc(F(r.tech))} took these">${ic('check', 12)}Picked up</button></span></div>`; };
    const wait = ALL.filter(x => x.q.st === 'Received');
    const free = BINS().filter(b => !usedBins().has(b));
    const picked = ALL.filter(x => (x.q.st === 'Picked up' || x.q.st === 'Installed') && x.q.pk && localDay(x.q.pk) === TODAY()).sort((a, b) => new Date(b.q.pk) - new Date(a.q.pk));
    const SH = [['W', 'Warranty', 'bin_w', 6], ['K', 'Cores', 'bin_k', 4], ['R', 'Supplier returns', 'bin_r', 4]];
    const shelves = SH.map(s => `<div class="pt-shg"><small>${s[1]}</small><div>${binList(s[2], s[0], s[3]).map(id => { const t = retStore().find(x => x.shelf === id && !['shipped', 'credited', 'scrapped', 'back'].includes(x.st)); return t ? `<button class="pt-shv${needs(t) ? ' act' : ''}" data-a="rsel" data-tid="${t.id}" title="${esc(t.desc)} · ${esc(rstTxt(t))}"><b>${id}</b>${esc(t.id)}</button>` : `<span class="pt-shv off"><b>${id}</b>empty</span>`; }).join('')}</div></div>`).join('');
    return `<div class="pt-full pg-scroll"><div class="pt-fh"><h2>Shelf</h2><span class="sp"></span><button class="btn btn-sm" data-a="binsprint">${ic('print', 14)}Print bin labels</button></div>
      ${upNext()}${wait.length ? `<div class="pt-tg" style="color:var(--tg-warn)">Waiting for a bin<span>${wait.length}</span><span class="sp"></span><span style="font-weight:400;color:var(--tg-ink3)">checked in at receiving — Received, not yet Staged</span></div>
      <div class="pt-tbl" style="padding-top:8px">${wait.map(x => { const b = binOf(x.r); const opts = b ? [b] : free.slice(0, 3); return `<div class="pt-wait"><span class="d"><b>${esc(x.q.desc)}</b><small>${esc(x.q.pn)} · checked in ${esc(tm(x.q.rcv))}</small></span><span class="ro"><b class="tg-no">${esc(x.r.no)}</b> ${esc(x.r.cust)}</span><span class="tg-r">${opts.map((o, i) => `<button class="tg-chip${i === 0 ? ' on' : ''}" data-a="stageto" data-pid="${x.q.id}" data-bin="${esc(o)}">${b ? 'With the rest · ' : 'Bin '}${esc(o)}</button>`).join('')}</span></div>`; }).join('')}</div>` : ''}
      <div class="pt-tg"${wait.length ? '' : ' style="padding-top:0"'}>Staged for the shop<span>${bins.filter(x => x.r).length} of ${BINS().length} bins</span><span class="sp"></span><span style="font-weight:400;color:var(--tg-ink3)">Staged until the tech picks them up</span></div>
      <div class="pt-bins">${bins.map(card).join('')}</div>
      <div class="pt-two2"><div><div class="pt-tg">Return shelves<span>Parts runs every return</span><span class="sp"></span><button class="btn btn-sm tg-gh" data-a="view" data-v="ret">Open Returns</button></div><div class="pt-tbl pt-shs">${shelves}</div></div>
      <div><div class="pt-tg">Picked up today<span>${picked.length}</span></div><div class="pt-tbl">${picked.length ? picked.map(x => `<div class="pt-pkr"><time>${esc(tm(x.q.pk))}</time>${PG.av(x.r.tech || '?')}<span><b>${esc(x.q.desc)}</b> · <span class="tg-no">${esc(x.r.no)}</span></span>${stChip(x.q, 0)}</div>`).join('') : '<div class="pt-none">Nothing picked up yet today.</div>'}</div></div></div></div>`;
  }
  function upNext(){
    let Q = []; try{ rtTechs().forEach(t => fmUpNext(t).slice(0, 2).forEach(ro => Q.push([ro, t]))); }catch(e){}
    Q = Q.filter(x => !roIsDone(x[0])).slice(0, 3);
    if(!Q.length) return '';
    return `<div class="pt-tg" style="padding-top:0">Up next on the floor<span>from ${esc(fm())}’s queue</span><span class="sp"></span><span style="font-weight:400;color:var(--tg-ink3)">pull the parts before the bay frees up</span></div><div class="pt-up">${Q.map(([ro, t]) => { const r = get(ro.id); if(!r) return '';
      const L = r.ops.filter(o => o.appr).flatMap(o => o.parts), pull = L.filter(p => p.st === 'Not Ordered' && (cat(p.pn) || {}).oh >= p.qty), no = L.filter(p => p.st === 'Not Ordered' && !pull.includes(p)), oo = L.filter(p => p.st === 'Ordered' || p.st === 'Backordered');
      const s = pull.length ? ['warn', `${pull.length} on the shelf, not pulled`] : no.length ? ['warn', `${no.length} still to order`] : oo.length ? ['', `${oo[0].desc} due ${oo[0].eta === TODAY() ? 'today' : oo[0].eta ? short(oo[0].eta) : '—'}`] : ['ok', L.length ? `Ready · bin ${binOf(r) || '—'}` : 'No parts needed'];
      return `<div class="pt-upc"><div class="k"><span class="tg-spot${r.bay ? ' bay' : ''}">${ic('pin', 11)}${esc(r.spot)}</span><b>${esc(F(t))}</b><span class="sp"></span><em class="${s[0]}">${esc(s[1])}</em></div><div class="t"><b class="tg-no">${esc(r.no)}</b><b>${esc(r.cust)}</b></div><div class="w">${PG.av(t)}next for ${esc(F(t))}<span class="sp"></span>${pull.length ? `<button class="btn btn-sm btn-primary" data-a="pullahead" data-ro="${r.id}">Pull ${pull.length} to a bin</button>` : ''}</div></div>`; }).join('')}</div>`;
  }
