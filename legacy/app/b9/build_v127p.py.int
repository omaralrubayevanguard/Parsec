# Parsec 12.7 (fork P) — each person keeps their own job clock and day clock (the user's pick: "Each person keeps their own").
# Switching who's signed in never stops anyone else's clock; starting a job stops only your own running job.
# The helpers: b9/v127p.js (global) + b9/v127p.css. The card (b9/v124.js), the RO page's card hand-over (b9/ock_jc.js) and the
# Technician page's numbers (b9/cx1.js) follow "mine" in their own files. Runs inside build12.py after build_v126.py:
# uses js, rep, b9, EXTRA_CSS, HOOK_NAMES, LOG.

# ---- the helpers, and runningPunch() is yours now (runningPunches() is everyone's)
js = rep(js, "function runningPunch(){ return STATE.punches.find(function(p){return !p.stop;}); }",
         b9("v127p.js") + "\nfunction runningPunch(){ return runningPunchOfPerson(pcMe()); }   /* Parsec 12.7: your own running punch */")
EXTRA_CSS.append(b9("v127p.css"))

# ---- your day clock: open, the last clock out today, today's time on it
js = rep(js, "function openShift(){ return shiftList().filter(function(s){ return !s.out; })[0] || null; }",
         "function openShift(){ return openShiftOf(pcMe()); }   /* Parsec 12.7: your own day clock */")
js = rep(js, "  var t = shiftsForDate(todayStr()); var s = t[t.length - 1];\n  return s && s.out ? s : null;",
         "  var t = shiftsOfPerson(todayStr(), pcMe()); var s = t[t.length - 1];\n  return s && s.out ? s : null;")
js = rep(js, "function todayShiftMs(){ var t = todayStr(); return shiftList().reduce(function(a, x){ return localDay(x.in) === t ? a + shiftMs(x) : a; }, 0); }",
         "function todayShiftMs(){ var t = todayStr(), me = pcMe(); return shiftList().reduce(function(a, x){ return localDay(x.in) === t && sameOwner(shiftOwner(x), me) ? a + shiftMs(x) : a; }, 0); }")

# ---- a day clock typed in by hand is yours (or the person handed in), and only clashes with that person's
js = rep(js, "function shiftAddManual(day, tIn, tOut){\n", "function shiftAddManual(day, tIn, tOut, who){\n  if(who == null) who = pxMeName();   /* Parsec 12.7: whose day clock */\n")
js = rep(js, "    if(openShift()) return { ok:false, msg:\"You\\u2019re already on the clock",
             "    if(openShiftOf(who)) return { ok:false, msg:\"You\\u2019re already on the clock")
js = rep(js, "  var clash = shiftList().filter(function(x){ var xo = x.out ? new Date(x.out) : new Date(); return inD < xo && end > new Date(x.in); })[0];",
             "  var clash = shiftList().filter(function(x){ var xo = x.out ? new Date(x.out) : new Date(); return inD < xo && end > new Date(x.in) && sameOwner(shiftOwner(x), who); })[0];")
js = rep(js, "  shiftList().push({ id: uid(\"sh\"), in: inD.toISOString(), out: outD ? outD.toISOString() : null, manual: true });",
             "  shiftList().push({ id: uid(\"sh\"), in: inD.toISOString(), out: outD ? outD.toISOString() : null, manual: true, by: who });")
js = rep(js, "  var ps = punchesForDate(day), today = day === todayStr(), ss = shiftsForDate(day);",
             "  var me = pcMe(), ps = punchesForDate(day).filter(function(p){ return sameOwner(punchOwner(p), me); }), today = day === todayStr(), ss = shiftsOfPerson(day, me);")

# ---- lunch ends the day clock of the person who stopped for it, and only theirs
js = rep(js, "return a <= st && st < b - 1000; })[0];", "return a <= st && st < b - 1000 && sameOwner(shiftOwner(x), punchOwner(p)); })[0];")
js = rep(js, "return x.id !== p.id && localDay(x.start) === day && new Date(x.start).getTime() >= st; })",
             "return x.id !== p.id && localDay(x.start) === day && new Date(x.start).getTime() >= st && sameOwner(punchOwner(x), punchOwner(p)); })")
js = rep(js, "shiftList().push({ id: uid(\"sh\"), in: next.start, out: origOut || null, outReason: origOut ? origWhy : null });",
             "shiftList().push({ id: uid(\"sh\"), in: next.start, out: origOut || null, outReason: origOut ? origWhy : null, by: sh.by || shiftOwner(sh) });")
js = rep(js, "    else if(!origOut) msg = p.stopReason", "    else if(!origOut && sameOwner(punchOwner(p), pcMe())) msg = p.stopReason")

# ---- overlaps: you can only be on one operation at a time — two people can be on two (or the same one)
js = rep(js, "  var overlap = STATE.punches.some(function(p){\n    if(p.id===punch.id) return false;",
             "  var who = punchOwner(punch);   /* Parsec 12.7: only the same person's punches clash */\n  var overlap = STATE.punches.some(function(p){\n    if(p.id===punch.id || !sameOwner(punchOwner(p), who)) return false;")
js = rep(js, "  var overlap = STATE.punches.some(function(p){ return new Date(fields.start) < new Date(p.stop||Date.now())",
             "  var who = fields.by || pcMe();   /* Parsec 12.7: yours, or the person handed in */\n  var overlap = STATE.punches.some(function(p){ return sameOwner(punchOwner(p), who) && new Date(fields.start) < new Date(p.stop||Date.now())")
js = rep(js, "notes:fields.notes||\"\", manual:true, by: punchByName() });", "notes:fields.notes||\"\", manual:true, by: fields.by || punchByName() });")
js = rep(js, "function punchClash(ignoreId, startMs, stopMs){\n  var now = Date.now();\n  return STATE.punches.filter(function(p){\n    if(p.id === ignoreId) return false;",
             "function punchClash(ignoreId, startMs, stopMs, who){\n  var now = Date.now();\n"
             "  if(who == null){ var own = ignoreId ? STATE.punches.filter(function(x){ return x.id === ignoreId; })[0] : null; who = own ? punchOwner(own) : pcMe(); }   /* Parsec 12.7: that person's punches */\n"
             "  return STATE.punches.filter(function(p){\n    if(p.id === ignoreId || !sameOwner(punchOwner(p), who)) return false;")

# ---- your day's numbers (the day ribbon, your totals, the warnings, the assistant): a named person's own punches and day clocks
js = rep(js, "function dailyCalc(date){\n  var ps = punchesForDate(date);\n  var sh = shiftsForDate(date);",
             "function dailyCalc(date, who){\n  if(who == null) who = pcMe();\n  var ps = punchesForDate(date);\n  var sh = shiftsForDate(date);\n"
             "  if(who){ ps = ps.filter(function(p){ return sameOwner(punchOwner(p), who); }); sh = sh.filter(function(s){ return sameOwner(shiftOwner(s), who); }); }   /* Parsec 12.7 */")

# ---- the shop-wide ones: the page keeps ticking while anyone's clock runs; the forecast waits on the assigned tech's own clock
js = rep(js, "var period = runningPunch() ? 5000 : 60000;", "var period = runningPunches().length ? 5000 : 60000;")
js = rep(js, "techFreeAt = null, run = runningPunch();", "techFreeAt = null, run = ro.assignedTech ? runningPunchOfPerson(ro.assignedTech) : null;")

# ---- the sign-in screen: every running clock, whose it is; signing out or switching says yours keeps running
js = rep(js, "    if(rp && rp.by && techSame(rp.by, sf.name)) return 'on the clock · ' + esc(roTag(getRO(rp.roId)));",
             "    var rq = sf.name ? runningPunchOfPerson(sf.name) : null; if(rq) return 'on the clock · ' + esc(roTag(getRO(rq.roId)));   /* Parsec 12.7 */\n"
             "    if(sf.name && openShiftOf(sf.name)) return 'on the day clock';")
js = rep(js, "    + (rp || openShift() ? '<div class=\"pxs-clk\"><i class=\"pxr-dot ' + pxClockState() + '\"></i>' + (rp ? 'The clock is running on ' + esc(roTag(getRO(rp.roId))) + (rp.by ? ' · ' + esc(rp.by) : '') : 'The day clock is running') + '</div>' : '')",
             "    + pcSignInClocks()")
js = rep(js, "  var rp = runningPunch(), who = viewAsStaff();\n", "  var rp = runningPunch(), who = viewAsStaff(), os0 = openShift();\n")
js = rep(js, "(rp ? \" The clock keeps running on \" + roTag(getRO(rp.roId)) + \".\" : openShift() ? \" The day clock keeps running.\" : \"\")",
             "(rp ? \" Your clock keeps running on \" + roTag(getRO(rp.roId)) + \".\" : os0 ? \" Your day clock keeps running.\" : \"\")")
js = rep(js, "case \"px-switch\": { var rp = runningPunch(); UI.pxPop = null; pxLS(\"tec_out\", \"1\"); pxLS(\"tec_viewas\", null); pxLS(\"tec_signin_at\", null); UI.modal = null; UI.selectedRo = null; render(); return true; }",
             "case \"px-switch\": { var rp = runningPunch(), os0 = openShift(); UI.pxPop = null; pxLS(\"tec_out\", \"1\"); pxLS(\"tec_viewas\", null); pxLS(\"tec_signin_at\", null); UI.modal = null; UI.selectedRo = null;"
             " if(rp || os0) pushToast(rp ? \"Your clock keeps running on \" + roTag(getRO(rp.roId)) + \" \\u2014 switching never stops it.\" : \"Your day clock keeps running \\u2014 switching never stops it.\"); render(); return true; }")

# ---- the RO page (JC): Stop stops your clock; Start stops only yours; the keyboard's clock key works on yours
js = rep(js, "  var p = STATE.punches.filter(function (x) { return !x.stop; })[0];\n  if (!p) return null;\n  commitNoteDrafts();",
             "  var p = runningPunch();   /* Parsec 12.7: your own clock */\n  if (!p) return null;\n  commitNoteDrafts();")
js = rep(js, "  if (runStartOf(job)) {\n    pushUndo('stop punch');\n    var stopped = stopClock();",
             "  if (myRunOf(job)) {\n    pushUndo('stop punch');\n    var stopped = stopClock();")
js = rep(js, "|| S.jobs.filter(function (j) { return runStartOf(j); })[0] || S.jobs[0];\n    if (!job) return false;",
             "|| S.jobs.filter(function (j) { return myRunOf(j); })[0] || S.jobs[0];\n    if (!job) return false;")
js = rep(js, "    pushUndo('operation status');\n    var rp = runningPunchOf(job);\n    if (rp) { stopClock(); rp.stopReason = nm; }",
             "    pushUndo('operation status');\n    var rp = myRunOf(job);\n    if (rp) { stopClock(); rp.stopReason = nm; }")

HOOK_NAMES += ["sameOwner", "punchOwner", "shiftOwner", "runningPunches", "runningPunchOfPerson", "openShiftOf", "shiftsOfPerson", "myRunOf", "pcMe", "pcSignInClocks",
               "addManualPunch", "editPunchCommit", "punchClash", "shiftAddManual", "todayShiftMs", "dailyCalc", "lastShiftOut"]
LOG.append("Parsec 12.7 (P): each person keeps their own job clock and day clock")
