  /* ---------- popovers ---------- */
  function newCands(){ const L = [];
    allLines().forEach(x => { const p = x.q; if(p.st === 'Staged' || p.st === 'Received' || p.st === 'Picked up') L.push({ k: 'ro:' + p.id, pid: p.id, ro: x.r.id, no: x.r.no, cust: x.r.cust, desc: p.desc, pn: p.pn, qty: p.qty, price: p.price, st: p.st, to: p.sup === 'fp' ? supName('fp') : supName('pdc') }); });
    catAll().forEach(c => { if(c.min && c.oh >= c.min * 3) L.push({ k: 'cat:' + c.id, cid: c.id, desc: c.desc, pn: c.pn, qty: c.oh - c.min * 2, price: c.price, oh: c.oh, min: c.min, to: supName('pdc') }); });
    return L; }
  const ETA = k => k === 'vor' ? addD(TODAY(), 1) : k === 'fp' ? TODAY() : bizD(TODAY(), 2);
  const ETAW = k => k === 'vor' ? 'tomorrow, ' + short(addD(TODAY(), 1)) + ' · rush' : k === 'fp' ? 'today · local' : 'arrives ' + short(bizD(TODAY(), 2)) + ' · stock order';
  function pop(){
    const p = U.pop; if(!p) return '';
    const hd = (t, sub) => `<div class="tg-ph"><b>${t}</b>${sub ? `<span class="cu">${sub}</span>` : ''}<button class="btn btn-sm ib" data-a="popx">${ic('x', 14)}</button></div>`;
    const r = p.ro ? get(p.ro) : null;
    if(p.type === 'st'){ const f = findLine(p.pid); if(!f) return '';
      return `<div class="tg-pop menu"><div class="tg-ph"><b>${esc(f.q.desc)}</b><span class="cu">${esc(f.q.pn)}</span></div>${STS.map(k => `${k === 'Received' ? '<div class="pt-mis"></div>' : ''}<button class="tg-mi${f.q.st === k ? ' on' : ''}" data-a="setst" data-pid="${p.pid}" data-v="${k}"><span class="pt-dot" style="background:var(${stVar(k)})"></span>${stTxt[k]}<span class="meta">${STH[k]}</span></button>`).join('')}</div>`; }
    if(p.type === 'order' && r){ const no = r.ops.filter(o => o.appr).flatMap(o => o.parts).filter(x => x.st === 'Not Ordered'), stk = no.filter(x => (cat(x.pn) || {}).oh >= x.qty), buy = no.filter(x => !((cat(x.pn) || {}).oh >= x.qty));
      const amt = no.reduce((s, x) => s + x.price * x.qty, 0);
      return `<div class="tg-pop xf pt-pop-w">${hd('Order parts', `${esc(r.no)} · ${esc(r.cust)}`)}<div class="pt-lst">${no.map(x => { const c = cat(x.pn) || {}, s = c.oh >= x.qty; return `<label class="pt-ln"><input type="checkbox" checked disabled><span class="d"><b>${esc(x.desc)}</b><small>${esc(x.pn || 'no part #')} · × ${x.qty}</small></span><span class="r"><b>${usd(x.price * x.qty)}</b>${s ? `<span class="stk">from stock${c.bin ? ' · bin ' + esc(c.bin) : ''}</span>` : 'to order'}</span></label>`; }).join('')}</div>
        ${buy.length ? `<span class="tg-lbl top" style="margin-top:10px">Order ${buy.length} from</span>${SUPK.map((k, i) => `<button class="pt-opt${p.o === i ? ' on' : ''}" data-a="oset" data-o="${i}">${kbd(i + 1)}<b>${esc(supName(k))}</b><small>${esc(set()['sup_' + k] ? String(set()['sup_' + k]).split('·').slice(1).join('·').trim() || ETAW(k) : ETAW(k))}</small></button>`).join('')}
        <div class="pt-two"><label class="pt-f"><span>PO #</span><input data-in="po" value="${esc(p.po != null ? p.po : (set().poNext || 55831))}"></label><label class="pt-f"><span>ETA</span><input data-in="eta" value="${esc(p.eta != null ? p.eta : p.o == null ? '' : ETA(SUPK[p.o]))}" placeholder="pick a supplier"></label></div>
        ${r.wr ? `<label class="pt-ck"><input type="checkbox" data-in="tell" data-ch="1" ${p.tell !== false ? 'checked' : ''}>Send ${esc(F(r.wr))} the ETA — for the customer</label>` : ''}` : `<div class="pt-ctx" style="margin-top:10px">Everything is on the shelf — it goes to the RO’s bin, nothing to order.</div>`}
        <div class="tg-acts"><span class="hint">${stk.length ? stk.length + ' from stock · ' : ''}${buy.length ? buy.length + ' to order · ' : ''}${usd(amt)}</span><button class="btn btn-sm btn-primary" data-a="ogo"${buy.length && p.o == null ? ' disabled' : ''}>${buy.length && stk.length ? `Order ${buy.length} · pull ${stk.length}` : buy.length ? `Order ${buy.length === 1 ? 'it' : buy.length + ' parts'}` : `Pull ${stk.length === 1 ? 'it' : stk.length + ' parts'}`}${kbd('↵')}</button></div></div>`; }
    if(p.type === 'chase' && r){ const x = lines(r).find(late); if(!x) return ''; const l = late(x);
      const D = [addD(TODAY(), 1), bizD(TODAY(), 2), bizD(TODAY(), 4)];
      const O = [['New date from the supplier', 'pick it below'], ['Backordered — no date yet', 'checks again tomorrow'], ['Get it somewhere else', esc(supName('fp')) + ' · today · about ' + usd(x.price * 1.05)]];
      return `<div class="tg-pop xf pt-pop-w">${hd('Chase a late part', `${esc(r.no)} · ${esc(r.cust)}`)}<div class="pt-ctx"><b>${esc(x.desc)}</b> · ${esc(x.pn)} · ${esc(supName(x.sup))}${x.po ? ' · PO ' + esc(x.po) : ''}<br>${l.k === 'late' ? `Was due ${short(x.eta)} — ${l.n} day${l.n > 1 ? 's' : ''} late.` : l.k === 'bo' ? 'Backordered.' : `Ordered ${short(x.ord)} — no date yet.`}${r.bay ? ` The truck is holding <b>${esc(r.spot)}</b>.` : ''}</div>
        ${O.map((o, i) => `<button class="pt-opt${p.o === i ? ' on' : ''}" data-a="oset" data-o="${i}">${kbd(i + 1)}<b>${o[0]}</b><small>${o[1]}</small></button>`).join('')}
        ${p.o === 0 ? `<div class="tg-r" style="margin:8px 0 0 10px">${D.map(k => `<button class="tg-chip${p.d === k ? ' on' : ''}" data-a="dset" data-d="${k}">${short(k)}</button>`).join('')}</div>` : ''}
        ${r.wr ? `<label class="pt-ck"><input type="checkbox" data-in="tell" data-ch="1" ${p.tell !== false ? 'checked' : ''}>Tell ${esc(F(r.wr))} — for the “parts delayed” message to the customer</label>` : ''}
        <div class="tg-acts"><button class="btn btn-sm btn-primary" data-a="cgo"${p.o == null || (p.o === 0 && !p.d) ? ' disabled' : ''}>Save${kbd('↵')}</button></div></div>`; }
    if(p.type === 'hand' && r){ const b = binOf(r);
      return `<div class="tg-pop xf pt-pop-w">${hd('Send to ' + esc(fm()), `${esc(r.no)} · ${esc(r.cust)}`)}<div class="pt-ctx">All ${lines(r).length} parts are in${b ? ', <b>bin ' + esc(b) + '</b>' : ''}. The truck is on <b>${esc(r.spot)}</b>${r.tech ? '; <b>' + esc(F(r.tech)) + '</b> is the tech' : ''}.</div>
        <span class="tg-lbl top">Note</span><input data-in="hn" style="width:100%" value="${esc(p.n != null ? p.n : `All parts in${b ? ' — bin ' + b : ''}.`)}">
        <div class="tg-acts"><span class="hint">${esc(fm())} sees it in the Inbox, then brings it in</span><button class="btn btn-sm btn-primary" data-a="hgo">Send to ${esc(fm())}${kbd('↵')}</button></div></div>`; }
    if(p.type === 'ret' && r){ const R = ['Missing part number', 'Not approved yet', 'Missing information', 'Wrong department'];
      return `<div class="tg-pop xf pt-pop-w">${hd('Send it back', `to ${esc(F(r.route && r.route.by))} · ${esc(r.no)}`)}<div class="tg-r">${R.map(x => `<button class="tg-chip${p.why === x ? ' on' : ''}" data-a="rset" data-v="${esc(x)}">${esc(x)}</button>`).join('')}</div>
        <div class="tg-acts"><span class="hint">It goes back with the reason</span><button class="btn btn-sm btn-primary" data-a="rgo"${p.why ? '' : ' disabled'}>Send back${kbd('↵')}</button></div></div>`; }
    if(p.type === 'counter' && r){ const a = counterAsk(r); if(!a) return ''; const q = (p.q || '').trim().toLowerCase(), C = q ? catAll().filter(c => [c.pn, c.desc].join(' ').toLowerCase().includes(q)).slice(0, 6) : [];
      return `<div class="tg-pop xf pt-pop-w">${hd('At the counter', `${esc(F(a.from))} · ${esc(r.no)}`)}<div class="pt-ctx">“${esc(a.q || a.t)}”${a.b ? '<br>' + esc(a.b) : ''}</div>
        <div class="pt-srin">${ic('search', 15)}<input data-in="cpq" placeholder="Find the part — number or name" value="${esc(p.q || '')}" autocomplete="off"></div>
        ${C.map(c => `<button class="pt-srr${p.cid === c.id ? ' k' : ''}" data-a="cpick" data-id="${c.id}"><span class="gi">${ic('box', 14)}</span><b>${esc(c.desc)}</b><span class="m">${esc(c.pn)}</span><small>${c.oh} on hand${c.bin ? ' · bin ' + esc(c.bin) : ''} · ${usd(c.price)}</small></button>`).join('')}
        <div class="tg-acts"><button class="btn btn-sm tg-gh" data-a="askdone" data-ro="${r.id}">Handed over — nothing to add</button><span class="hint"></span><button class="btn btn-sm btn-primary" data-a="cgive"${p.cid ? '' : ' disabled'}>Give it · add to the RO${kbd('↵')}</button></div></div>`; }
    const T = p.tid ? getT(p.tid) : null;
    const tctx = t => { const ro = t.ro && getRO(t.ro); return `<div class="pt-ctx"><b>${esc(t.id)} · ${esc(t.desc)}${t.qty > 1 ? ' × ' + t.qty : ''}</b> · ${esc(t.pn)} · shelf ${esc(t.shelf)} <span class="pt-kind ${t.kind}">${KIND[t.kind]}</span><br>${ro ? `RO ${esc(tgNum(ro))} · ${esc(ro.customerName || '')} · ` : 'From stock · '}${esc(t.why)}</div>`; };
    if(p.type === 'ship' && T){ const t = T, C = t.kind === 'warranty' ? ['UPS', 'FedEx', supName('pdc') + ' truck'] : t.kind === 'core' ? [supName('pdc') + ' truck', supName('fp') + ' pickup'] : [supName('pdc') + ' truck', 'UPS', supName('fp') + ' pickup'];
      return `<div class="tg-pop xf pt-pop-w">${hd(t.kind === 'warranty' ? 'Ship a warranty return' : t.kind === 'core' ? 'Send a core back' : 'Ship a supplier return', `to ${esc(t.to)}`)}${tctx(t)}
        <div class="pt-kv">${t.kind === 'warranty' ? `<span>RA</span><b>${esc(t.ra || '—')}</b><span>Claim</span><b>${esc(t.claim || '—')}</b><span>Ship by</span><b>${short(t.by)}</b>` : t.kind === 'core' ? `<span>Core credit</span><b>${usd(t.credit)}</b><span>Back by</span><b>${short(t.by)}</b>` : `<span>RA</span><b>${esc(t.ra || '—')}</b><span>Credit</span><b>${usd(t.credit)}</b><span>Fee</span><b>${esc(set().ret_fee || '15%')} restocking</b>`}</div>
        <span class="tg-lbl top">How it goes</span><div class="tg-r">${C.map(c => `<button class="tg-chip${p.c === c ? ' on' : ''}" data-a="cset" data-v="${esc(c)}">${esc(c)}</button>`).join('')}</div>
        ${p.c === 'UPS' || p.c === 'FedEx' ? `<label class="pt-f"><span>Tracking #</span><input data-in="tr" value="${esc(p.tr || '')}" placeholder="1Z…"></label>` : ''}
        <div class="tg-acts"><span class="hint">${t.kind === 'warranty' ? 'Warranty sees the tracking on the claim' : 'Credit is due once it lands'}</span><button class="btn btn-sm btn-primary" data-a="sgo"${p.c ? '' : ' disabled'}>Mark shipped${kbd('↵')}</button></div></div>`; }
    if(p.type === 'ra' && T){ const t = T;
      return `<div class="tg-pop xf pt-pop-w">${hd('Ask for a return authorization', esc(t.to))}${tctx(t)}
        <div class="pt-kv"><span>Credit if they take it</span><b>${usd(t.credit)}</b><span>Fee</span><b>${esc(set().ret_fee || '15%')} restocking</b></div>
        <label class="pt-f"><span>RA # from ${esc(t.to)}</span><input data-in="ra" value="${esc(p.ra || '')}" placeholder="Type it when they send it"></label>
        <div class="tg-acts"><button class="btn btn-sm tg-gh" data-a="raask">Asked — waiting on them</button><span class="hint"></span><button class="btn btn-sm btn-primary" data-a="rago">Save RA${kbd('↵')}</button></div></div>`; }
    if(p.type === 'credit' && T){ const t = T;
      return `<div class="tg-pop xf pt-pop-w">${hd('Credit in', esc(t.to))}${tctx(t)}
        <div class="pt-two"><label class="pt-f"><span>Credit received</span><input data-in="cr" value="${esc(p.cr != null ? p.cr : (+t.credit || 0).toFixed(2))}"></label><label class="pt-f"><span>Credit memo #</span><input data-in="cm" value="${esc(p.cm || '')}" placeholder="CM-…"></label></div>
        <div class="tg-acts"><span class="hint">Expected ${usd(t.credit)}${t.shipped ? ' · shipped ' + esc(t.shipped) : ''}</span><button class="btn btn-sm btn-primary" data-a="crgo">Credit in${kbd('↵')}</button></div></div>`; }
    if(p.type === 'hold' && T){ const t = T, O = [['Scrap it', 'Holding is done · logged'], ['Keep 14 more days', 'Volvo may still ask for it'], ['Give it back to the customer', 'Logged on the RO']];
      return `<div class="tg-pop xf pt-pop-w">${hd('Done holding', esc(t.id))}${tctx(t)}${O.map((o, i) => `<button class="pt-opt${p.o === i ? ' on' : ''}" data-a="oset" data-o="${i}">${kbd(i + 1)}<b>${o[0]}</b><small>${o[1]}</small></button>`).join('')}
        <div class="tg-acts"><button class="btn btn-sm btn-primary" data-a="hogo"${p.o == null ? ' disabled' : ''}>Save${kbd('↵')}</button></div></div>`; }
    if(p.type === 'newret'){ const C = newCands(), R = ['Wrong part', 'Not needed — job declined', 'Damaged', 'Overstock', 'Core', 'Warranty — failed part'], c = C.find(x => x.k === p.k), fee = (parseFloat(set().ret_fee) || 15) / 100;
      const core = p.why === 'Core', war = p.why === 'Warranty — failed part';
      return `<div class="tg-pop xf pt-pop-x">${hd('Start a return', 'Parts runs it from here')}<span class="tg-lbl top">What’s going back</span><div class="pt-lst" style="max-height:220px">${C.map(x => `<label class="pt-ln${p.k === x.k ? ' hit' : ''}" data-a="nrk" data-k="${x.k}"><input type="radio" ${p.k === x.k ? 'checked' : ''} tabindex="-1"><span class="d"><b>${esc(x.desc)}${x.qty > 1 ? ' × ' + x.qty : ''} · <span style="font-family:var(--tg-mono);font-weight:500">${esc(x.pn)}</span></b><small>${x.ro ? `${esc(x.no)} · ${esc(x.cust)} · ${stTxt[x.st]}` : `Stock · ${x.oh} on hand, min ${x.min}`}</small></span><span class="r"><b>${usd(x.price * x.qty)}</b>${esc(x.to)}</span></label>`).join('') || '<div class="pt-none">Nothing in hand to send back.</div>'}</div>
        <span class="tg-lbl top" style="margin-top:10px">Why</span><div class="tg-r">${R.map(w => `<button class="tg-chip${p.why === w ? ' on' : ''}" data-a="nrw" data-v="${esc(w)}">${esc(w)}</button>`).join('')}</div>
        ${c && p.why ? `<div class="pt-kv" style="margin-top:10px"><span>Goes to</span><b>${war ? 'Volvo · warranty' : esc(c.to)}</b><span>Shelf</span><b>${war ? binList('bin_w', 'W', 6)[0] : core ? binList('bin_k', 'K', 4)[0] : binList('bin_r', 'R', 4)[0]}</b><span>Credit</span><b>${war ? 'on the claim' : usd(c.price * c.qty * (core ? 1 : 1 - fee)) + (core ? '' : ' after ' + Math.round(fee * 100) + '%')}</b></div>${c.ro && (p.why === 'Wrong part' || p.why === 'Damaged') ? `<div class="pt-ctx" style="margin:8px 0 0">The RO still needs one — the line goes back to <b>Not ordered</b> so it can be ordered again.</div>` : ''}` : ''}
        <div class="tg-acts"><span class="hint">${core ? 'Cores ship without an RA' : war ? 'Held for Volvo until they ask for it' : 'Next: ask for an RA'}</span><button class="btn btn-sm btn-primary" data-a="nrgo"${c && p.why ? '' : ' disabled'}>Start return${kbd('↵')}</button></div></div>`; }
    if(p.type === 'label'){ const X = allLines().filter(x => x.q.st === 'Staged' && x.q.bin === p.bin); if(!X.length) return ''; const rr = X[0].r;
      return `<div class="tg-pop xf pt-pop-w pt-label">${hd('Bin label', `${esc(p.bin)} · ${esc(rr.no)}`)}<div class="pt-lab pt-print1"><div class="t"><b>${esc(p.bin)}</b><span><b>${esc(rr.no)} · ${esc(rr.cust)}</b><small>${esc(rr.tech || '—')} · Unit ${esc(rr.unit)}</small></span></div>${barcode('BIN-' + p.bin + '-' + rr.no)}<div class="ls">${X.map(x => `<div><span>${x.q.qty} ×</span>${esc(x.q.desc)}<em>${esc(x.q.pn)}</em></div>`).join('')}</div><div class="f">Scan with the Parsec phone app to pick up</div></div>
        <div class="tg-acts"><button class="btn btn-sm tg-gh" data-a="pickup" data-bin="${esc(p.bin)}">${ic('check', 14)}Picked up</button><span class="hint"></span><button class="btn btn-sm btn-primary" data-a="labprint">${ic('print', 14)}Print${kbd('↵')}</button></div></div>`; }
    if(p.type === 'send' && r){ const D = [['writer', 'Service writer', PG.person('Service writer')], ['foreman', 'Foreman', PG.person('Foreman')], ['tech', 'Technician', r.tech], ['warranty', 'Warranty', PG.person('Warranty admin') || 'Warranty desk']];
      return `<div class="tg-pop menu"><div class="tg-ph"><b>Send ${esc(r.no)} to…</b></div>${D.map((d, i) => `<button class="tg-mi" data-a="sendto" data-k="${d[0]}"${d[0] === 'tech' && !r.tech ? ' disabled' : ''}>${kbd(i + 1)}${d[1]}<span class="meta">${esc(d[2] || '—')}</span></button>`).join('')}</div>`; }
    if(p.type === 'chk'){ const L = dueLines(), sel = p.sel || (p.sel = {}), n = Object.keys(sel).filter(k => sel[k]).length;
      const used = usedBins(), tmpB = {}; L.forEach(x => { let b = binOf(x.r) || tmpB[x.r.id]; if(!b && sel[x.p.id]){ b = BINS().find(z => !used.has(z)) || BINS()[BINS().length - 1]; used.add(b); tmpB[x.r.id] = b; } x.bin = b; });
      const ln = x => { const on = !!sel[x.p.id], l = late(x.p), stg = p.stage !== false; return `<label class="pt-ln${p.hit === x.p.id ? ' hit' : ''}" data-a="ckl" data-pid="${x.p.id}"><input type="checkbox" ${on ? 'checked' : ''} tabindex="-1"><span class="d"><b>${esc(x.p.desc)} · <span style="font-family:var(--tg-mono);font-weight:500">${esc(x.p.pn)}</span> × ${x.p.qty}</b><small>${esc(x.r.no)} · ${esc(x.r.cust)} · ${esc(supName(x.p.sup))}${x.p.po ? ' PO ' + esc(x.p.po) : ''}${l ? ' · ' + l.t : ''}</small></span><span class="r">${on ? `<span class="pt-cst" data-keep-pop><small>cost</small><input data-in="cst" data-pid="${x.p.id}" value="${esc(p.cost && p.cost[x.p.id] != null ? p.cost[x.p.id] : (costHint(x.p) || ''))}" placeholder="$ each" inputmode="decimal" onclick="event.stopPropagation()"></span><b>${stg ? '→ bin ' + esc(x.bin || '—') : '→ receiving'}</b>` : ''}${on && lines(x.r).filter(q => q.id !== x.p.id).every(q => inHand(q) || sel[q.id]) ? '<span class="stk">RO complete</span>' : ''}</span></label>`; };
      const today = L.filter(x => !late(x.p)), lt = L.filter(x => late(x.p));
      return `<div class="tg-pop xf pt-pop-x">${hd('Check in a delivery', 'what came on the truck')}${chkHead(p)}
        <div class="pt-lst">${today.length ? `<div class="pt-lh">${ic('calendar', 12)}Due · ${today.length}</div>${today.map(ln).join('')}` : ''}${lt.length ? `<div class="pt-lh late">${ic('clock', 12)}Late — may be on this truck · ${lt.length}</div>${lt.map(ln).join('')}` : ''}${L.length ? '' : '<div class="pt-none">Nothing due — every order is in.</div>'}</div>
        <label class="pt-ck"><input type="checkbox" data-in="stg" data-ch="1" ${p.stage !== false ? 'checked' : ''}><span>Put them on bins now — <b style="font-weight:500">Staged</b>. Off: they wait at receiving as <b style="font-weight:500">Received</b>.</span></label><div class="tg-acts"><span class="hint">${n ? n + ' ticked' : 'tick what came'}</span><button class="btn btn-sm btn-primary" data-a="kgo"${n ? '' : ' disabled'}>Check in ${n || ''} part${n === 1 ? '' : 's'}${kbd('↵')}</button></div></div>`; }
    if(p.type === 'newpart') return `<div class="tg-pop xf pt-pop-w">${hd('New part', 'on the Parts list')}<div class="pt-two"><label class="pt-f"><span>Part #</span><input data-in="np" data-f="pn" value="${esc(p.pn || '')}"></label><label class="pt-f"><span>Price each</span><input data-in="np" data-f="price" value="${esc(p.price || '')}" placeholder="0.00"></label><label class="pt-f"><span>Cost each</span><input data-in="np" data-f="cost" value="${esc(p.cost || '')}" placeholder="what we pay"></label></div><label class="pt-f"><span>Description</span><input data-in="np" data-f="desc" value="${esc(p.desc || '')}"></label><div class="pt-two"><label class="pt-f"><span>Bin</span><input data-in="np" data-f="bin" value="${esc(p.bin || '')}" placeholder="F1"></label><label class="pt-f"><span>On hand · min</span><input data-in="np" data-f="oh" value="${esc(p.oh || '')}" placeholder="0 · 0"></label></div><div class="tg-acts"><span class="hint">Kits build themselves from finished jobs</span><button class="btn btn-sm btn-primary" data-a="npgo">Add part${kbd('↵')}</button></div></div>`;
    if(p.type === 'srch'){ const q = (p.q || '').trim().toLowerCase(); const res = [];
      if(q){ retStore().forEach(t => { if([t.id, t.pn, t.desc, t.ro ? tgNum(getRO(t.ro) || {}) : ''].join(' ').toLowerCase().includes(q)) res.push({ k: 'ret', t }); });
        rows().forEach(r => { lines(r).forEach(x => { if([x.pn, x.desc, r.no, r.cust].join(' ').toLowerCase().includes(q)) res.push({ k: 'ro', r, x }); }); if(!lines(r).length && [r.no, r.cust].join(' ').toLowerCase().includes(q)) res.push({ k: 'ro', r, x: null }); });
        catAll().forEach(c => { if([c.pn, c.desc].join(' ').toLowerCase().includes(q)) res.push({ k: 'cat', c }); }); }
      const R = res.slice(0, 7);
      return `<div class="tg-pop menu pt-pop-w"><div class="pt-srin">${ic('search', 15)}<input data-in="sq" placeholder="Part #, part, RO or customer" value="${esc(p.q || '')}" autocomplete="off"></div>${q ? (R.length ? R.map((x, i) => x.k === 'ret' ? `<button class="pt-srr${i === 0 ? ' k' : ''}" data-a="rsel" data-tid="${x.t.id}"><span class="gi">${ic('undo', 14)}</span><b>${esc(x.t.id)} · ${esc(x.t.desc)}</b><span class="m">${esc(x.t.pn)}</span><small>Return · ${KIND[x.t.kind]} · ${rstTxt(x.t)} · shelf ${esc(x.t.shelf)}</small></button>` : x.k === 'ro' ? `<button class="pt-srr${i === 0 ? ' k' : ''}" data-a="open" data-ro="${x.r.id}" data-k="ro"><span class="gi">${ic('ros', 14)}</span><b>${x.x ? esc(x.x.desc) + ' · ' : ''}${esc(x.r.no)} ${esc(x.r.cust)}</b><span class="m">${x.x ? esc(x.x.pn) : ''}</span><small>${x.x ? `${stTxt[x.x.st] || ''}${x.x.bin && x.x.st === 'Staged' ? ' · bin ' + esc(x.x.bin) : ''}${x.x.eta && !inHand(x.x) ? ' · due ' + short(x.x.eta) : ''}` : 'No parts yet'}</small></button>` : `<button class="pt-srr${i === 0 ? ' k' : ''}" data-a="open" data-k="cat" data-pn="${esc(x.c.pn)}"><span class="gi">${ic('book', 14)}</span><b>${esc(x.c.desc)}</b><span class="m">${esc(x.c.pn)}</span><small>Catalog · ${x.c.oh} on hand${x.c.bin ? ' · bin ' + esc(x.c.bin) : ''} · ${usd(x.c.price)}</small></button>`).join('') : `<div class="pt-none">Nothing matches “${esc(p.q)}”.</div>`) : '<div class="pt-none">Where is it, who’s it for, is it in? Type a part #, a part or an RO.</div>'}</div>`; }
    return '';
  }
