/* ============================== Parsec 14 — one status look on every page ==============================
   The same icon, color and words for a status wherever it shows. Two forms:
   · to read (lists, headers, rows): icon + word, no box            pgSt('ro', 'Waiting – Parts')
   · to change (it opens a menu):    an outlined pill with ▾         pgSt('ro', 'Waiting – Parts', { menu: 1, attrs: 'data-a="st"' })
   kind: 'ro' (RO and operation statuses), 'part' (part statuses), 'claim' (warranty claims), or 'any' with o.tone / o.ic.
   pgStEl(...) gives the same as a DOM element (the RO page builds its own nodes). pgStLabel(kind, s) is just the words.
   Tones are the shop's status colors: hold (grey), run (green), wait (amber), cust (teal), tech (violet), bad (red), acc (bronze). */
var PGST_IC = {
  ring: '<circle cx="7" cy="7" r="5.25" fill="none" stroke="currentColor" stroke-width="1.5"/>',
  half: '<circle cx="7" cy="7" r="5.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M7 3.5a3.5 3.5 0 0 1 0 7z" fill="currentColor"/>',
  q: '<circle cx="7" cy="7" r="5.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M7 3.5a3.5 3.5 0 0 1 3.5 3.5H7z" fill="currentColor"/>',
  rt: '<circle cx="7" cy="7" r="5.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M7 3.5a3.5 3.5 0 1 1-3.5 3.5H7z" fill="currentColor"/>',
  wait: '<circle cx="7" cy="7" r="5.25" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.3 1.82"/><circle cx="7" cy="7" r="1.75" fill="currentColor"/>',
  done: '<circle cx="7" cy="7" r="5.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M4.6 7.1l1.6 1.6 3.2-3.4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
  rel: '<circle cx="7" cy="7" r="6" fill="currentColor"/><path d="M4.4 7.2l1.8 1.8 3.5-3.7" fill="none" stroke="var(--pgst-on, #fff)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  no: '<circle cx="7" cy="7" r="6" fill="currentColor"/><path d="M5 5l4 4M9 5l-4 4" fill="none" stroke="var(--pgst-on, #fff)" stroke-width="1.6" stroke-linecap="round"/>',
  bad: '<circle cx="7" cy="7" r="5.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M7 4.2v3.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="7" cy="9.75" r=".95" fill="currentColor"/>',
  ret: '<circle cx="7" cy="7" r="5.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8.9 8.8H5.4M6.9 7.2L5.3 8.8l1.6 1.6M5.3 5.6h3.4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>'
};
/* [tone, icon, words when they differ from the stored name] */
var PGST_RO = {
  "Hold Tech": ["hold", "ring", "Hold tech"], "Working": ["run", "half"],
  "Waiting – Parts": ["wait", "wait"], "Waiting – Foreman": ["wait", "wait"], "Waiting – New Job": ["wait", "wait", "Waiting – New job"],
  "Waiting – Tech Support": ["tech", "wait", "Waiting – Tech support"], "Waiting – Customer": ["cust", "wait"], "Waiting – Approval": ["cust", "wait"],
  "Complete": ["run", "done"], "Complete – Road test": ["run", "rt"], "Complete – Released": ["run", "rel"], "Declined": ["hold", "no"]
};
var PGST_PART = {
  "Not Ordered": ["hold", "ring", "Not ordered"], "Ordered": ["tech", "q"], "Backordered": ["bad", "bad"],
  "Received": ["run", "done"], "Staged": ["acc", "done"], "Picked up": ["cust", "done"], "Installed": ["run", "rel"], "Returned": ["hold", "ret"]
};
var PGST_CLAIM = {
  "Repair": ["hold", "ring"], "In repair": ["hold", "ring"], "Ready to file": ["wait", "wait"], "Draft": ["hold", "ring"], "Filed": ["tech", "q"], "Submitted": ["tech", "q"],
  "Returned": ["bad", "bad"], "Denied": ["bad", "no"], "Approved": ["run", "done"], "Paid": ["run", "rel"], "Closed": ["hold", "rel"]
};
function pgStMap(kind){ return kind === "part" ? PGST_PART : kind === "claim" ? PGST_CLAIM : PGST_RO; }
/* the stored name for a status written another way ("Not ordered", "hold tech", "Hold tech") */
function pgStKey(kind, s){
  s = String(s == null ? "" : s).trim(); var M = pgStMap(kind); if(M[s]) return s;
  var n = s.toLowerCase().replace(/\s*[-–—]\s*/g, " – ").replace(/\s+/g, " ");
  for(var k in M){ if(k.toLowerCase() === n || (M[k][2] && M[k][2].toLowerCase() === n)) return k; }
  if(kind === "part" && /^to order$/i.test(s)) return "Not Ordered";
  return s;
}
function pgStOf(kind, s, o){
  o = o || {}; var k = pgStKey(kind, s), d = pgStMap(kind)[k];
  if(!d && kind !== "part" && kind !== "claim" && /^complete/i.test(k)) d = PGST_RO["Complete"];
  if(!d && /^waiting/i.test(k)) d = ["wait", "wait"];
  d = d || ["hold", "ring"];
  return { key: k, tone: o.tone || d[0], ic: o.ic || d[1], label: o.label || d[2] || k };
}
function pgStLabel(kind, s){ return pgStOf(kind, s).label; }
function pgStIc(ic, size){ return '<svg class="pgst-i" viewBox="0 0 14 14" width="' + (size || 14) + '" height="' + (size || 14) + '" aria-hidden="true">' + (PGST_IC[ic] || PGST_IC.ring) + "</svg>"; }
function pgStE(t){ return String(t == null ? "" : t).replace(/[&<>"]/g, function(c){ return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); }
/* o: { menu: 1 → the pill you click, attrs: raw attributes for it, sub: words after it ("· Ordered"), cls, title, label, tone, ic, size, iconOnly } */
function pgSt(kind, s, o){
  o = o || {}; var S = pgStOf(kind, s, o), tag = o.menu ? "button" : "span";
  var subT = o.sub ? String(o.sub).replace(/^(\s*[·•]\s*)?(.+)$/, function(_, d, w){ var ks = [kind, "part", "ro", "claim"]; for(var i = 0; i < ks.length; i++){ var k2 = pgStKey(ks[i], w); if(pgStMap(ks[i])[k2]) return (d || "") + pgStOf(ks[i], k2).label; } return (d || "") + w; }) : "";
  var sub = subT ? '<span class="pgst-s">' + pgStE(subT) + "</span>" : "";
  var lab = o.iconOnly ? "" : '<span class="pgst-l">' + pgStE(S.label) + "</span>";
  var cv = o.menu ? '<svg class="pgst-cv" viewBox="0 0 12 12" width="11" height="11" aria-hidden="true"><path d="M3 4.6 6 7.6 9 4.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>' : "";
  var tt = o.title || (o.iconOnly ? S.label : "");
  return "<" + tag + (o.menu ? ' type="button" aria-haspopup="menu"' : "") + ' class="pgst' + (o.menu ? " m" : "") + " t-" + S.tone + (o.cls ? " " + o.cls : "") + '" data-st="' + pgStE(S.key) + '"'
    + (tt ? ' title="' + pgStE(tt) + '"' : "") + (o.iconOnly ? ' aria-label="' + pgStE(S.label) + '"' : "") + (o.attrs ? " " + o.attrs : "") + ">"
    + pgStIc(S.ic, o.size) + lab + sub + cv + "</" + tag + ">";
}
function pgStEl(kind, s, o){ var t = document.createElement("template"); t.innerHTML = pgSt(kind, s, o); var n = t.content.firstChild;
  if(o && o.onClick) n.addEventListener("click", o.onClick); return n; }
