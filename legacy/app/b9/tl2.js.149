  /* ---------- drawing ---------- */
  const pos = (m, a, b) => ((m - a) / (b - a) * 100).toFixed(3) + '%';
  const wid = (x, y, a, b) => (Math.max(0, y - x) / (b - a) * 100).toFixed(3) + '%';
  const av = (t, cls) => t === 'ALL' ? `<span class="tk-av all${cls ? ' ' + cls : ''}">${ic('users', 12)}</span>` : `<span class="tk-av${cls ? ' ' + cls : ''}" title="${esc(t)}">${esc(PG.ini(t))}</span>`;
  const roLbl = p => p.ro === 'SHOP' ? 'Shop' : p.ro;
  function strip(c){ const a = 360, b = 1080; let h = '';
    c.ps.forEach(p => { h += `<i class="${p.ro === 'SHOP' ? 'shop' : 'job'}" style="left:${pos(Math.max(p.s, a), a, b)};width:${wid(Math.max(p.s, a), Math.min(p.e2, b), a, b)}"></i>`; });
    c.air.forEach(x => { h += `<i class="air" style="left:${pos(Math.max(x[0], a), a, b)};width:${wid(Math.max(x[0], a), Math.min(x[1], b), a, b)}"></i>`; });
    if(c.fixes.some(f => f.k === 'noout') && c.ps.length){ const ls = Math.max(...c.ps.map(p => p.e2)); h += `<i class="prob" style="left:${pos(Math.max(a, Math.min(ls, b)), a, b)};right:0"></i>`; }
    return `<div class="tk-strip">${h}</div>`; }
  function track(c, a, b, opts){
    opts = opts || {}; let h = '';
    c.segs.forEach(x => { const e = x[1] == null ? b : Math.min(x[1], b); h += `<span class="tk-clk" style="left:${pos(Math.max(a, x[0]), a, b)};width:${wid(Math.max(a, x[0]), e, a, b)}"></span>`; });
    c.lunch.forEach(x => { h += `<span class="tk-lunch${x[3] ? ' auto' : ''}" data-tip="${esc((x[2] === 'Lunch' ? 'Lunch' : x[2] || 'Off the clock') + ' · ' + hm(x[0]) + '–' + hm(x[1]) + ' · ' + dur(x[1] - x[0]))}" style="left:${pos(x[0], a, b)};width:${wid(x[0], x[1], a, b)}">${x[2] === 'Lunch' ? ic('coffee', 14) : ''}</span>`; });
    c.air.forEach(x => { if(x[0] >= b) return; const e = Math.min(x[1], b); h += `<span class="tk-b air${opts.live && x[1] - x[0] >= 20 ? ' long' : ''}" data-tip="${esc('Air · ' + hm(x[0]) + '–' + hm(x[1]) + ' · ' + dur(x[1] - x[0]) + '|On the clock, not on a job')}" style="left:${pos(Math.max(a, x[0]), a, b)};width:${wid(Math.max(a, x[0]), e, a, b)}"></span>`; });
    const over = new Set(); c.fixes.forEach(f => { if(f.k === 'over'){ over.add(f.a); over.add(f.b); } });
    c.ps.forEach(p => { const e = Math.min(p.e2, b), w = (e - p.s) / (b - a) * (opts.w || 800), shp = p.ro === 'SHOP', sel = U.sel === p.id && opts.live;
      const lbl = opts.live && w > 46 ? roLbl(p) : '';
      h += `<span class="tk-b ${shp ? 'shop' : 'job'}${p.e == null ? ' run' : ''}${sel ? ' sel' : ''}${opts.live && U.hov === p.id ? ' hov' : ''}${opts.live && U.drag && U.drag.pid === p.id ? ' drg' : ''}${over.has(p.id) && opts.live ? ' prob' : ''}" ${opts.live ? `data-a="psel" data-p="${p.id}"` : ''} data-tip="${esc((shp ? 'Shop · ' + p.shop : p.ro + ' · ' + p.cm) + '|' + hm(p.s) + '–' + (p.e == null ? 'now' : hm(p.e)) + ' · ' + dur(p.e2 - p.s) + (shp ? '' : ' · ' + p.sr + (p.er ? ' → ' + p.er : '')))}" style="left:${pos(Math.max(a, p.s), a, b)};width:${wid(Math.max(a, p.s), e, a, b)}">${esc(lbl)}${opts.live ? `<i class="h l${U.drag && U.drag.pid === p.id && U.drag.edge === 's' ? ' on' : ''}" data-h="s" data-p="${p.id}" title="Drag to change the start"></i>${p.e != null ? `<i class="h r${U.drag && U.drag.pid === p.id && U.drag.edge === 'e' ? ' on' : ''}" data-h="e" data-p="${p.id}" title="Drag to change the stop"></i>` : ''}` : ''}</span>`; });
    if(opts.live) h += dragLayer(c, a, b);
    if(opts.flags){ c.segs.forEach((x, i) => { h += `<span class="tk-flag" style="left:${pos(Math.max(a, x[0]), a, b)}">IN</span>`; if(x[3] != null) h += `<span class="tk-flag out" style="left:${pos(Math.min(b, x[1]), a, b)}">OUT</span>`; });
      if(c.open && !c.today && c.fixes.some(f => f.k === 'noout') && c.ps.length){ const ls = Math.max(...c.ps.map(p => p.e2)); h += `<span class="tk-flag bad" style="left:${pos(Math.min(ls + 10, b - 5), a, b)}">NO OUT</span>`; } }
    if(opts.live && c.open && !c.today && c.ps.length && c.fixes.some(f => f.k === 'noout')){ const ls = Math.max(...c.ps.map(p => p.e2)); h += `<span class="tk-ghost" data-tip="Not counted · after ${hm(ls)}|The day counts to the last punch until the clock out is fixed" style="left:${pos(ls, a, b)};width:${wid(ls, b, a, b)}"><em>not counted</em></span>`; }
    if(opts.live) c.fixes.forEach(f => { if(f.k === 'over') h += `<span class="tk-ovl" data-tip="Counted twice · ${hm(f.from)}–${hm(f.to)}|${Math.round(f.to - f.from)} min on two punches at once" style="left:${pos(f.from, a, b)};width:${wid(f.from, f.to, a, b)}"><em>${Math.round(f.to - f.from)} min twice</em></span>`; });
    if(opts.live && c.today && c.on && c.shEnd > a && c.shEnd < b) h += `<span class="tk-shend${c.over >= 30 ? ' late' : ''}" style="left:${pos(c.shEnd, a, b)}"><em>SHIFT ENDS ${hm(c.shEnd)}</em></span>`;
    if(c.today && NOW > a && NOW < b) h += `<span class="tk-now" style="left:${pos(NOW, a, b)}" title="Now ${hm(NOW)}"></span>`;
    return h;
  }
  function dragLayer(c, a, b){
    let h = '';
    const dg = U.drag; if(dg){ const p0 = c.ps.find(x => x.id === dg.pid); if(p0){ const oe = dg.orig.e == null ? NOW : dg.orig.e;
      h += `<span class="tk-gh" style="left:${pos(dg.orig.s, a, b)};width:${wid(dg.orig.s, Math.min(oe, b), a, b)}"></span>`;
      const t = dg.edge === 'e' ? p0.e2 : p0.s, delta = Math.round(t - (dg.edge === 'e' ? oe : dg.orig.s)), hit = dg.hit;
      if(hit && hit.k !== 'min') h += `<span class="tk-guide${hit.k === 'meet' ? ' meet' : ' stop'}" style="left:${pos(t, a, b)}"></span>`;
      const why = !hit ? '' : hit.k === 'meet' ? `meets ${hit.p.ro === 'SHOP' ? 'shop time' : hit.p.ro}` : hit.k === 'in' ? `clocked in ${hm(hit.t)} — can’t start earlier` : hit.k === 'out' ? `${hit.why === 'Lunch' ? 'out to lunch' : 'clocked out'} ${hm(hit.t)} — can’t run later` : hit.k === 'now' ? 'that’s now' : '5 min is the shortest punch';
      h += `<span class="tk-bub${hit ? (hit.k === 'meet' ? ' meet' : ' stop') : ''}" style="left:${pos(t, a, b)}"><b>${dg.edge === 'e' ? 'Stop' : 'Start'} ${hm(t)}</b><small>${dur(p0.e2 - p0.s)} long · ${delta === 0 ? 'no change' : Math.abs(delta) + ' min ' + (delta > 0 ? 'later' : 'earlier')}</small>${why ? `<em>${why}</em>` : ''}</span>`; } }
    if(U.kh && U.sel){ const pk = c.ps.find(x => x.id === U.sel); if(pk) h += `<span class="tk-bub kh" style="left:${pos((pk.s + pk.e2) / 2, a, b)}"><small><span class="k">${kbd('Alt')}${kbd('←')}${kbd('→')}</span> moves the stop</small><small><span class="k">${kbd('Alt')}${kbd('⇧')}${kbd('←')}${kbd('→')}</span> moves the start</small></span>`; }
    return h; }
  function remind(){ const m = ME(); if(!m.tech || !isMine(U.who) || U.view === 'shop') return ''; const c = calc(m.tech, TODAY); if(!c || !c.on || c.over == null || c.over < 0 || U.otAsk || NOW < U.snz) return '';
    const ro = c.run ? (c.run.ro === 'SHOP' ? 'shop time' : c.run.ro) : null;
    if(c.over >= 30) return `<div class="tk-remind warn"><span class="i">${ic('flag', 16)}</span><div><b>${Math.round(c.over)} min past your shift</b><p>Still on ${ro || 'the clock'}${c.run ? ' — ' + dur(NOW - c.run.s) : ''}. Past 30 minutes, ${esc(PG.first(lead()))} sees it in the Shop view.</p><div class="r"><button class="btn btn-sm btn-primary" data-a="clkat">Clock out at ${hm(c.shEnd)}</button><button class="btn btn-sm" data-a="clkout">Clock out now</button><button class="btn btn-sm tg-gh" data-a="ot">It’s overtime</button></div></div></div>`;
    return `<div class="tk-remind"><span class="i">${ic('clock', 16)}</span><div><b>Your shift ended at ${hm(c.shEnd)}</b><p>You’re still on the clock${ro ? ' — on ' + ro + ' for ' + dur(NOW - c.run.s) : ''}.</p><div class="r"><button class="btn btn-sm btn-primary" data-a="clkout">${ro ? 'Stop and clock out' : 'Clock out'}</button><button class="btn btn-sm" data-a="remsnz">Still working · ask at ${hm(NOW + 30)}</button></div></div></div>`; }
  function signBar(L){
    const t = sgT(), per = U.per, P = PER(per), sg = sign()[t + '|' + P[0]] || {}, me = isMine(t), nm = TF(t), ended = P[2] < TODAY, fm = PG.first(lead());
    const fixD = L.filter(k => { const c = calc(t, k); return c && c.fixes.length; }), mn = missNotes(t, L), blocked = fixD.length + mn.length > 0;
    const step = (n, lbl, sub, st) => `<div class="tk-stp ${st}"><span class="dot">${st.includes('done') ? ic(n === 3 ? 'lock' : 'check', 12) : n}</span><span><b>${lbl}</b><small>${sub}</small></span></div>`;
    const s1 = sg.tech ? 'done' : ended ? 'now' : '', s2 = sg.fm ? 'done' : sg.tech ? 'now' : '', s3 = sg.fm ? 'done lk' : '';
    const canApprove = role() === 'foreman' && !me && (typeof can !== 'function' || can('t.approve'));   /* Parsec 13 */
    let act = '';
    if(!ended) act = `<span class="tk-sgn-n">Signing opens ${short(addD(P[2], 1))}, when the period ends</span>`;
    else if(sg.fm) act = canApprove ? `<button class="btn btn-sm" data-a="treopen">${ic('history', 14)}Reopen</button>` : `<span class="tk-sgn-n">${ic('lock', 13)}Locked — ask ${esc(fm)} if something’s wrong</span>`;
    else if(sg.tech) act = me ? `<button class="btn btn-sm tg-gh" data-a="tunsign">Take back my signature</button>` : canApprove ? `<button class="btn btn-sm btn-primary" data-a="tapprove">${ic('check', 14)}Approve and lock</button>` : '';
    else act = me ? (blocked ? `${fixD.length ? `<button class="btn btn-sm btn-primary" data-a="gofix" data-k="${fixD[0]}">Fix them</button>` : `<button class="btn btn-sm btn-primary" data-a="pop" data-p="notes">Add the notes…</button>`}<button class="btn btn-sm" data-a="pop" data-p="signnote">${ic('pencil', 14)}Sign with a note…</button>` : `<button class="btn btn-sm btn-primary" data-a="tsign">${ic('pencil', 14)}Sign my timesheet</button>`) : `<span class="tk-sgn-n">Waiting for ${esc(nm)} to sign</span>`;   /* Parsec 14.6: sign with a note */
    const pv = PER('prev'), ps = sign()[t + '|' + pv[0]] || {}, due = per === 'cur' && !ps.fm && allDays(t).some(k => k >= pv[0] && k <= pv[2]) ? `<div class="tk-sgn-due">${ic('flag', 14)}<span><b>${pv[1]}</b> is waiting for ${ps.tech ? (me ? esc(fm) + ' to approve' : 'your approval') : (me ? 'your signature' : esc(nm) + '’s signature')} · due ${short(addD(pv[2], 5))}</span><button class="btn btn-sm" data-a="per" data-v="prev">Open it</button></div>` : '';
    const sgn = sg.note ? `<div class="tk-sgn-note">${ic('note', 13)}<span><b>${me ? 'Your note' : esc(PG.first(t)) + '’s note'}:</b> ${esc(sg.note)}</span></div>` : '';
    const blk = (!sg.tech || (sg.note && !sg.fm)) && blocked ? `<div class="tk-blk"><span class="t">${sg.tech ? 'Still open' : ended ? (me ? 'Before you can sign' : 'Before ' + esc(nm) + ' can sign') : 'Before this can be signed'}</span>${fixD.map(k => `<button class="tk-bk bad" data-a="gofix" data-k="${k}">${ic('flag', 12)}${short(k)} · ${esc(calc(t, k).fixes[0].t)}</button>`).join('')}${mn.length ? `<button class="tk-bk warn" data-a="pop" data-p="notes">${ic('note', 12)}${mn.length} punch${mn.length > 1 ? 'es' : ''} without a work note · Add them…</button>` : ''}</div>` : '';
    return `<div class="tk-sgn">${due}<div class="tk-sgr">${step(1, me ? 'You sign' : esc(nm) + ' signs', sg.tech ? 'Signed ' + esc(sg.tech) + (sg.note ? ' · with a note' : '') : ended ? (blocked ? 'Fix these, or sign with a note' : 'Ready') : 'After the period ends', s1)}<i class="tk-sl${sg.tech ? ' done' : ''}"></i>${step(2, me ? esc(fm) + ' approves' : 'You approve', sg.fm ? 'Approved ' + esc(sg.fm) : sg.tech ? 'Waiting' : 'After the signature', s2)}<i class="tk-sl${sg.fm ? ' done' : ''}"></i>${step(3, 'Locked', sg.fm ? 'No more changes' : 'Changes close after approval', s3)}<span class="sp"></span>${act}</div>${sgn}${blk}</div>`; }
  function sigLines(){ const sg = sign()[sgK()] || {}, t = sgT();
    return `<div class="tk-sig"><div>${sg.tech ? `<i>${esc(t)}<small>${esc(sg.tech)}</small></i>` : ''}Technician</div><div>${sg.fm ? `<i>${esc(sg.fmBy || lead())}<small>${esc(sg.fm)}</small></i>` : ''}Foreman / manager</div></div>`; }
  function effTrend(){
    const t = sgT(), ws = wkStart(TODAY), W = [];
    for(let i = 7; i >= 0; i--){ const k = addD(ws, -7 * i); let j = 0, q = 0, n = 0; for(let d = 0; d < 7; d++){ const c = calc(t, addD(k, d)); if(c){ j += c.jq; q += c.q; n++; } }
      W.push({ k, e: j ? q / (j / 60) : null, j: j / 60, q, cur: i === 0 }); }
    const V = W.filter(w => w.e != null), vals = V.map(w => w.e);
    if(!V.length) return `<div class="tk-trend"><div class="tk-trh"><b>Efficiency, week by week</b><small>quoted hours ÷ hours on finished jobs · 100% is right on the quote</small></div><div class="tk-trb"><div class="tk-trs"><small>No job time in the last 8 weeks yet.</small></div></div></div>`;
    const lo = Math.min(.8, Math.floor((Math.min(...vals) - .04) * 10) / 10), hi = Math.max(1.2, Math.ceil((Math.max(...vals) + .04) * 10) / 10);
    const avg = vals.reduce((s, v) => s + v, 0) / vals.length, cur = W[7].e, prev = W[6].e, dl = cur != null && prev != null ? Math.round((cur - prev) * 100) : null;
    const sum = `<div class="tk-trs"><small>This week so far</small><b>${effTxt(cur)}</b>${dl != null ? `<small><span class="${dl >= 0 ? 'up' : 'dn'}">${dl >= 0 ? '▲' : '▼'} ${Math.abs(dl)} pts</span> on last week</small>` : ''}<small>8-week average ${effTxt(avg)}</small></div>`;
    let body;
    if(U.trTbl || V.length < 2) body = `<table class="tk-trt"><thead><tr><th>Week of</th><th>On jobs</th><th>Quoted</th><th>Efficiency</th></tr></thead><tbody>${W.slice().reverse().map(w => { const d = dOf(w.k); return `<tr><td>${MN[d.getMonth()]} ${d.getDate()}${w.cur ? ' · so far' : ''}</td><td>${w.j.toFixed(1)} h</td><td>${w.q.toFixed(1)} h</td><td>${effTxt(w.e)}</td></tr>`; }).join('')}</tbody></table>`;
    else { const Wd = 640, H = 150, L = 44, R = 64, T = 12, B = 24, X = i => L + i * (Wd - L - R) / 7, Y = v => T + (hi - v) / (hi - lo) * (H - T - B); let g = '';
      for(let v = lo; v <= hi + 1e-9; v += .1){ const y = Y(v), one = Math.abs(v - 1) < 1e-6; if(!one) g += `<line class="gl" x1="${L}" x2="${Wd - R + 10}" y1="${y.toFixed(1)}" y2="${y.toFixed(1)}"/>`; g += `<text class="${one ? 'rl' : 'ax'}" x="${L - 8}" y="${(y + 3.5).toFixed(1)}" text-anchor="end">${Math.round(v * 100)}%</text>`; }
      const y1 = Y(1); g += `<line class="ref" x1="${L}" x2="${Wd - R + 10}" y1="${y1.toFixed(1)}" y2="${y1.toFixed(1)}"/>`;
      const pt = W.map((w, i) => w.e == null ? null : [X(i), Y(w.e)]), f = q => q[0].toFixed(1) + ' ' + q[1].toFixed(1);
      const done = pt.slice(0, 7).filter(Boolean); if(done.length > 1) g += `<path class="tln" d="M${done.map(f).join(' L')}"/>`;
      if(pt[7] && done.length) g += `<path class="tln so" d="M${f(done[done.length - 1])} L${f(pt[7])}"/>`;
      W.forEach((w, i) => { const d = dOf(w.k); g += `<text class="ax" x="${X(i).toFixed(1)}" y="${H - 5}" text-anchor="middle">${d.getMonth() + 1}/${d.getDate()}</text>`; });
      pt.forEach((q, i) => { if(q) g += `<circle class="pt${W[i].cur ? ' cur' : ''}" cx="${q[0].toFixed(1)}" cy="${q[1].toFixed(1)}" r="4.5"/>`; });
      const lp = pt[7] || done[done.length - 1];
      if(lp) g += `<text class="vl" x="${(lp[0] + 11).toFixed(1)}" y="${(lp[1] + 1).toFixed(1)}">${effTxt(pt[7] ? cur : V[V.length - 1].e)}</text>${pt[7] ? `<text class="rl" x="${(lp[0] + 11).toFixed(1)}" y="${(lp[1] + 14).toFixed(1)}">so far</text>` : ''}`;
      const sw = (Wd - L - R) / 7; W.forEach((w, i) => { const d = dOf(w.k); g += `<rect class="hit" x="${(X(i) - sw / 2).toFixed(1)}" y="${T - 6}" width="${sw.toFixed(1)}" height="${H - T - B + 12}" rx="6" data-tip="Week of ${MN[d.getMonth()]} ${d.getDate()}${w.cur ? ' · so far' : ''}|${w.e == null ? 'no job time' : effTxt(w.e) + ' · ' + w.q.toFixed(1) + ' h quoted for ' + w.j.toFixed(1) + ' h on jobs'}"/>`; });
      body = `<svg width="${Wd}" height="${H}" viewBox="0 0 ${Wd} ${H}" role="img" aria-label="Efficiency per week, last 8 weeks">${g}</svg>`; }
    return `<div class="tk-trend"><div class="tk-trh"><b>Efficiency, week by week</b><small>quoted hours ÷ hours on finished jobs · 100% is right on the quote</small><span class="sp"></span><span class="tg-seg3"><button class="${U.trTbl ? '' : 'on'}" data-a="trtbl" data-v="0">Chart</button><button class="${U.trTbl ? 'on' : ''}" data-a="trtbl" data-v="1">Table</button></span></div><div class="tk-trb">${sum}${body}</div></div>`; }
  /* ---------- Parsec 14.6: Fix these — on top of the Day view, for the person, the open day and the pay period ---------- */
  function fxBtns(it){ const { k, f, c } = it, t = U.who, fk = f.k + '|' + (f.a || ''), pend = reqOpen(t, k).find(r => r.fk === fk || (f.k === 'noout' && r.x === 'out'));
    if(pend) return `<span class="tk-pend">${ic('clock', 12)}Asked ${esc(PG.first(lead()))} · waiting</span>`;
    const B = (lbl, x, ex, pri) => `<button class="btn btn-sm${pri ? ' btn-primary' : ''}" data-a="fxdo" data-x="${x}" data-k="${k}" data-fk="${esc(fk)}" data-l="${esc(lbl + ' · ' + short(k))}"${ex || ''}>${esc(lbl)}</button>`;
    const nm = q => q.ro === 'SHOP' ? 'Shop time' : q.ro;
    if(f.k === 'noout'){ const b = bestEv(evid(t, k, c)); return (b ? B('Clock out ' + hm(b.m), 'out', ` data-m="${b.m}" title="${esc(b.l + (b.d ? ' — ' + b.d : ''))}"`, 1) : '') + `<button class="btn btn-sm" data-a="gofix" data-k="${k}" data-f="noout">Pick a time…</button>`; }
    if(f.k === 'over'){ const A = c.ps.find(x => x.id === f.a), Bp = c.ps.find(x => x.id === f.b); if(!A || !Bp) return ''; const inside = Bp.e != null && A.e2 >= Bp.e, n0 = Math.round(f.to - f.from);
      return B(`${nm(A)} ends ${hm(Bp.s)}`, 'over', ` data-fa="${f.a}" data-o="0"`, 1) + (inside ? '' : B(`${nm(Bp)} starts ${hm(A.e2)}`, 'over', ` data-fa="${f.a}" data-o="1"`) + B(`Split the ${n0} min`, 'over', ` data-fa="${f.a}" data-o="2"`)); }
    if(f.k === 'outin') return B('Move clock-in to ' + hm(f.at), 'inmv', ` data-m="${f.at}"`, 1) + B('Trim the punch', 'trimin', ` data-fa="${f.a}"`);
    if(f.k === 'outout') return B('Move clock-out to ' + hm(f.at), 'outmv', ` data-m="${f.at}"`, 1) + B('Trim the punch', 'trimout', ` data-fa="${f.a}"`);
    if(f.k === 'lunch') return (f.at != null ? B(`Lunch ${hm(f.at)}–${hm(f.at + 30)}`, 'lunch', ` data-m="${f.at}"`, 1) : '') + B('Worked through lunch', 'lunchok', '');
    if(f.k === 'notes') return `<button class="btn btn-sm btn-primary" data-a="pop" data-p="notes">Add them…</button>`;
    return ''; }
  function fxStrip(){ const t = U.who; if(!t || t === 'ALL') return ''; const I = fxItems(t), R0 = reqOpen(t), lead0 = !isMine(t) && role() === 'foreman' && mayFix(t);
    if(!I.length && !R0.length) return '';
    const per = PER('cur'), n = I.length + R0.length, show = U.fxAll ? I : I.slice(0, 4);
    const rq = R0.map(r => `<div class="tk-fxi rq"><div class="tx"><b>${lead0 ? esc(PG.first(r.who)) + ' asks' : 'You asked ' + esc(PG.first(lead()))} · ${esc(short(r.k))}</b><small>${esc(r.label)}${r.why ? ' · ' + esc(r.why) : ''}</small></div><div class="bt">${lead0 ? `<button class="btn btn-sm btn-primary" data-a="rqok" data-id="${r.id}">Approve</button><button class="btn btn-sm" data-a="rqno" data-id="${r.id}">Decline</button>` : isMine(r.who) ? `<span class="tk-pend">${ic('clock', 12)}waiting</span><button class="btn btn-sm tg-gh" data-a="rqback" data-id="${r.id}">Take back</button>` : `<span class="tk-pend">waiting for ${esc(PG.first(lead()))}</span>`}</div></div>`).join('');
    const it = x => `<div class="tk-fxi${x.f.k === 'notes' || x.f.k === 'lunch' ? ' info' : ''}${x.k === U.day ? ' cur' : ''}"><div class="tx"><b><button class="tk-fxd" data-a="day" data-k="${x.k}" title="Open the day">${x.k === TODAY ? 'Today' : short(x.k)}</button> — ${esc(x.f.t)}</b><small>${esc(x.f.why)}</small></div><div class="bt">${fxBtns(x)}</div></div>`;
    return `<div class="tk-fx${U.fxShut ? ' shut' : ''}"><button class="tk-fxh" data-a="fxfold" aria-expanded="${U.fxShut ? 'false' : 'true'}"><b>Fix these</b><span>${esc(PG.first(t))} · ${per[1]}</span><span class="n">${n}</span>${mustAsk(t) ? `<small>each fix goes to ${esc(PG.first(lead()))} to approve</small>` : ''}<span class="sp"></span>${ic(U.fxShut ? 'chevD' : 'chevU', 14)}</button>${U.fxShut ? '' : `<div class="tk-fxl">${rq}${show.map(it).join('')}${I.length > 4 ? `<button class="tk-fxm" data-a="fxall">${U.fxAll ? 'Show fewer' : 'Show all ' + I.length}</button>` : ''}</div>`}</div>`; }
  function axis(a, b, step){ let h = ''; for(let m = Math.ceil(a / 60) * 60; m <= b; m += 60 * (step || 1)){ h += `<span class="hr" style="left:${pos(m, a, b)}">${p2(m / 60)}</span>`; } return `<div class="tk-ax">${h}</div>`; }
  function gridL(a, b){ let h = ''; for(let m = Math.ceil(a / 60) * 60; m <= b; m += 60) h += `<i style="left:${pos(m, a, b)}"></i>`; return `<div class="tk-grid">${h}</div>`; }
  function setup(){
    flush(); const T = techs(), m0 = ME();
    if(U._me !== m0.name){ U._me = m0.name; U.who = null; U.day = null; U.view = 'day'; U.pop = null; U.sel = null; U.drag = null; U.per = 'cur'; }
    const mine0 = () => { const m = ME(); return [m.tech, m.name].filter(Boolean).map(n => T.find(t => techSame(t, n))).filter(Boolean)[0] || null; };   /* Parsec 14.2: the signed-in person's own times */
    if(UI.tlMe){ UI.tlMe = null; const mm = mine0(); if(mm){ U.who = mm; if(U.view === 'shop') U.view = 'day'; U.day = null; } }
    if(!U.who || (U.who !== 'ALL' && !T.some(t => techSame(t, U.who)))){ const mm = mine0(); U.who = mm || (role() === 'foreman' ? 'ALL' : (T[0] || null)); if(U.who === 'ALL') U.view = 'shop'; }
    if(U.drag && U.drag.pending && (!U.pop || U.pop.type !== 'why')) U.drag = null;
    if(UI.tlWho){ if(role() !== 'tech' || isMine(UI.tlWho)) U.who = UI.tlWho; UI.tlWho = null; }
    if(UI.tlDay){ U.day = UI.tlDay; UI.tlDay = null; if(U.who === 'ALL'){ U.who = T[0] || null; } U.view = 'day'; }
    if(UI.tlView){ U.view = UI.tlView; UI.tlView = null; if(U.view !== 'shop' && U.who === 'ALL') U.who = T[0] || null; }
    if(UI.tlPer){ U.per = UI.tlPer; UI.tlPer = null; }
    if(role() === 'tech' && U.view === 'shop') U.view = 'day';
    if(!U.day) U.day = TODAY;
    if(U.who && U.who !== 'ALL' && U.view === 'day' && !dayOf(U.who, U.day)){ const L = days(); if(L.length && U.day !== TODAY) U.day = L[0]; }
  }
  function view(){
    setup();
    const v = U.view;
    if(!U.who) return `<div class="tg tk" data-pg="timelog">${head()}<div class="tg-body"><div class="tg-main"><div class="tg-blank"><div class="tg-empty"><span class="tg-ring0">${ic('clock', 22)}</span><h3>No technicians yet</h3><p>Add people on the Settings page, or start a clock on the Console.</p></div></div></div></div></div>`;
    const body = v === 'week' ? vWeek() : v === 'sheet' ? vSheet() : v === 'shop' ? vShop() : vDay();
    const showList = v === 'day' || v === 'week';
    return `<div class="tg tk${U.drag ? ' dragging' : ''}" data-pg="timelog">${head()}<div class="tg-body v-${v}">${showList ? list() : ''}<div class="tg-main">${body}</div>${pop()}</div>${remind()}</div>`;
  }
  function head(){
    const all = U.who === 'ALL', t = all ? null : U.who, c = t ? calc(t, TODAY) : null, ws = wkStart(TODAY); let wk = 0; if(t) for(let i = 0; i < 7; i++){ const x = calc(t, addD(ws, i)); if(x) wk += x.clocked; }
    const nf = t ? groups().fix.length : 0, T = techs();
    const vs = [['day', 'clock', 'Day'], ['week', 'calendar', 'Week'], ['sheet', 'sheet', 'Timesheet'], ['shop', 'users', 'Shop']].filter(x => role() !== 'tech' || x[0] !== 'shop');
    const who = all ? `${av('ALL')}Whole shop` : t ? `${av(t)}${isMine(t) ? 'You · ' : ''}${esc(t)}` : '—';
    let facts = '';
    if(all || U.view === 'shop'){ const on = T.filter(x => { const y = calc(x, TODAY); return y && y.on; }).length, off = offNow(); facts = `<span class="tg-hf"><b>${on} of ${T.length}</b>on the clock</span>${off.length ? `<i>·</i><span class="tg-hf"><b>${off.length}</b>off — ${esc(off[0][1].toLowerCase())}</span>` : ''}`; }
    else if(t) facts = `${c && c.on && c.over >= 30 ? `<span class="tg-hf bad"><b>${Math.round(c.over)} min</b>past the shift</span><i>·</i>` : ''}${c && c.on ? `<span class="tg-hf tk-hb"><span class="tk-live"></span><b data-tk="clk">${dur(c.clocked)}</b>on the clock</span><i>·</i>` : ''}<span class="tg-hf"><b>${dur(wk)}</b>this week</span>${c && c.on && c.over >= 30 ? '' : `<i>·</i><span class="tg-hf"><b>${c ? effTxt(c.eff) : '—'}</b>efficiency today</span>`}${nf ? `<i>·</i><button class="tg-hf w" data-a="tofix"><b>${nf}</b>to fix</button>` : ''}`;
    return `<header class="tg-head"><h1 class="tg-h1">Time Log</h1>${role() === 'tech' ? `<span class="tk-who st" title="Your own time — a technician sees only their own log">${who}<span class="tk-mine">only yours</span></span>` : `<button class="tk-who" data-a="pop" data-p="who">${who}${ic('chevD', 14)}</button>`}<span class="tg-facts">${facts}</span>
    <div class="tg-views">${vs.map((x, i) => `<button class="${U.view === x[0] ? 'on' : ''}" data-a="view" data-v="${x[0]}" title="${x[2]} (${i + 1})">${ic(x[1], 14)}${x[2]}</button>`).join('')}</div><span class="tg-hsep"></span>
    <button class="btn ib tg-srch-b" data-a="pop" data-p="add" title="Add a punch or a clock segment (A)">${ic('plus', 16)}</button><button class="btn ib tg-srch-b" data-a="pop" data-p="exp" title="Print and export">${ic('download', 16)}</button>${role() !== 'tech' && t ? `<button class="btn ib tg-srch-b tk-mv" data-action="tx-open" data-from="${esc(t)}" data-day="${U.day || TODAY}" title="Move ${esc(TF(t))}’s time to someone else">${ic('swap', 16)}</button>` : ''}</header>`;
  }
  function offNow(){ return techs().map(t => { const sh = shiftsForDate(TODAY).filter(s => shOwn(s, t)), l = sh[sh.length - 1]; return l && l.out && l.outReason && !/End of day|Home/.test(l.outReason) ? [t, l.outReason + (l.backBy ? ' until ' + hm(PG.mod(new Date(l.backBy).getTime())) : '')] : null; }).filter(Boolean); }
  function list(){
    const G = groups(), s = U.day;
    const item = k => { const c = calc(U.who, k); if(!c) return ''; const d = dOf(k), on = k === s, f = c.fixes[0] || null, today = k === TODAY;
      const why = f ? `<span class="why bad">${ic('flag', 12)}${esc(f.t)} · ${esc(f.k === 'noout' ? 'since ' + hm(c.D.sh[0][0]) : f.k === 'over' ? Math.round(f.to - f.from) + ' min' : 'at ' + hm(f.at))}</span>`
        : today && c.on ? `<span class="why">${c.run ? `On ${c.run.ro === 'SHOP' ? 'shop time' : c.run.ro} · ${dur(NOW - c.run.s)}` : 'On the clock, not on a job'}</span>`
        : c.miss ? `<span class="why warn">${ic('note', 12)}${c.miss} punch${c.miss > 1 ? 'es' : ''} without a work note</span>` : `<span class="why">${hm(c.first)} – ${c.last != null ? hm(c.last) : '—'} · ${c.ps.filter(p => p.ro !== 'SHOP').length} jobs</span>`;
      return `<div class="tk-di${on ? ' on' : ''}${on && U.kb ? ' kb' : ''}${today ? ' today' : ''}" data-a="day" data-k="${k}"><span class="tk-dt"><small>${DN[d.getDay()]}</small><b>${d.getDate()}</b></span>
        <span class="r1">${today ? 'Today' : DNL[d.getDay()]}${isLocked(U.who, k) ? `<span class="tk-lk" title="Approved and locked">${ic('lock', 12)}</span>` : ''}${today && c.on ? '<span class="tk-pill">On the clock</span>' : ''}<small>${MN[d.getMonth()]} ${d.getDate()}</small></span>
        <span class="tot">${dur(c.clocked)}<small>${effTxt(c.eff)}</small></span>${strip(c)}${why}</div>`; };
    let body = '';
    const grp = (t, L) => L.length ? `<div class="tg-grp">${t}<span>${L.length}</span></div>` + L.map(item).join('') : '';
    body += grp('To fix', G.fix) + grp('This week', G.wk) + grp('Last week', G.last);
    if(G.old.length) body += `<div class="tg-sec${U.open.old ? ' open' : ''}" data-a="open" data-k="old">${ic('chevR', 12)}<span>Earlier</span><span class="n">${G.old.length}</span></div>` + (U.open.old ? G.old.slice(0, 120).map(item).join('') : '');
    if(!body) body = `<div class="tg-empty"><span class="tg-ring0">${ic('clock', 22)}</span><h3>Nothing clocked yet</h3><p>Days show up here once there’s a clock in or a punch.</p></div>`;
    const keys = `<div class="tg-keys"><span>${kbd('J')}${kbd('K')}day</span><span>${kbd('E')}edit</span><span>${kbd('A')}add</span><span>${kbd('1')}–${kbd(role() === 'tech' ? '3' : '4')}views</span></div>`;
    return `<section class="tg-list"><div class="tg-lh">Days<span class="n">${days().length}</span>${G.fix.length ? `<button class="tg-fchip w" data-a="tofix">${G.fix.length} to fix</button>` : ''}</div><div class="tg-scroll">${body}</div>${keys}</section>`;
  }
  function vDay(){
    const k = U.day, c = calc(U.who, k), d = dOf(k);
    if(!c) return `<div class="tk-day">${fxStrip()}<div class="tk-dh"><h2>${k === TODAY ? 'Today · ' : ''}${DNL[d.getDay()]}, ${MNL[d.getMonth()]} ${d.getDate()}</h2><span class="sp"></span><span class="nav"><button class="btn btn-sm ib" data-a="dnav" data-d="-1" title="Day before (←)">${ic('chevL', 15)}</button><button class="btn btn-sm ib" data-a="dnav" data-d="1" title="Day after (→)"${k >= TODAY ? ' disabled' : ''}>${ic('chevR', 15)}</button></span></div><div class="tg-blank"><div class="tg-empty"><span class="tg-ring0">${ic('clock', 22)}</span><h3>Nothing clocked</h3><p>No clock in and no punches this day.</p></div></div></div>`;
    let a = Math.min(390, Math.floor(((c.first == null ? 420 : c.first) - 20) / 60) * 60), b = Math.max(1020, Math.ceil(((c.today ? NOW : c.open && c.ps.length ? Math.max(...c.ps.map(p => p.e2)) : (c.last || 1000)) + 30) / 60) * 60);
    a = Math.max(0, a); b = Math.min(1440, b);
    if(U.drag && U.ab){ a = U.ab[0]; b = U.ab[1]; } else U.ab = [a, b];
    const pct = c.clocked ? Math.round(c.job / c.clocked * 100) : 0, lk = isLocked(U.who, k);
    const st = c.today && c.on ? `<span class="tk-pill">${ic('clock', 11)}On the clock since ${hm(c.segs[c.segs.length - 1][0])}</span>` : c.open && !c.today && !c.D.virt ? `<span class="tk-pill bad">${ic('flag', 11)}No clock out</span>` : `<span class="tk-pill off">${c.D.virt ? 'Punches only — no day clock' : 'Closed out ' + (c.last != null ? hm(c.last) : '')}</span>`;
    const stat = (l, v, sub, cls, sw) => `<div class="tk-stat${cls ? ' ' + cls : ''}"><small>${sw ? `<i class="sw" style="background:var(--tk-${sw})"></i>` : ''}${l}</small><b>${v}${sub ? `<em>${sub}</em>` : ''}</b></div>`;
    let h = `<div class="tk-day${lk ? ' locked' : ''}" data-scroll="day">${fxStrip()}<div class="tk-dh"><h2>${c.today ? 'Today · ' : ''}${DNL[d.getDay()]}, ${MNL[d.getMonth()]} ${d.getDate()}</h2>${st}${lk ? `<span class="tk-pill lock">${ic('lock', 11)}Locked · approved</span>` : ''}<span class="sp"></span><span class="nav"><button class="btn btn-sm ib" data-a="dnav" data-d="-1" title="Day before (←)">${ic('chevL', 15)}</button><button class="btn btn-sm ib" data-a="dnav" data-d="1" title="Day after (→)"${k >= TODAY ? ' disabled' : ''}>${ic('chevR', 15)}</button></span><button class="btn btn-sm" data-action="open-report" data-date="${k}">${ic('print', 14)}Day report</button></div>`;
    h += `<div class="tk-stats">${stat('Clocked', dur(c.clocked), c.open && !c.today && !c.D.virt ? 'to the last punch' : '')}${stat('On jobs', dur(c.job), pct + '%', '', 'job')}${stat('Air', dur(c.airM), '', '', 'air')}${stat('Shop', dur(c.shop), '', '', 'shop')}${stat('Lunch', dur(c.lunchM), '')}${stat('Efficiency', effTxt(c.eff), c.q.toFixed(1) + ' h quoted', c.eff >= 1 ? 'good' : '')}</div>`;
    h += `<div class="tk-tl"><div class="tk-trk">${gridL(a, b)}${track(c, a, b, { live: 1, flags: 1, w: 740 })}</div>${axis(a, b)}<div class="tk-leg"><span><i class="job"></i>On a job</span><span><i class="air"></i>Air — on the clock, off a job</span><span><i class="shop"></i>Shop time</span><span><i class="lunch"></i>Lunch · off the clock</span><span class="sp"></span><span class="tk-snap">Drag an edge, or Alt ← → · snap <span class="tg-seg3"><button class="${U.snap === 1 ? 'on' : ''}" data-a="snap" data-v="1">1 min</button><button class="${U.snap === 5 ? 'on' : ''}" data-a="snap" data-v="5">5 min</button></span></span></div></div>`;
    const sp = U.sel && !lk && c.ps.find(q => q.id === U.sel);   /* Parsec 14.6: split · merge · fill the air, right on the selected punch */
    if(sp){ const f0 = findP(sp.id), an = c.air.find(x => Math.abs(x[0] - sp.e2) < 1 && x[1] - x[0] >= 3), dg = U.drag && U.drag.pid === sp.id && U.drag.nud && U.drag.v != null;
      h += `<div class="tk-selb"><span class="w"><i class="tk-sw ${sp.ro === 'SHOP' ? 'shop' : 'job'}"></i><b>${esc(sp.ro === 'SHOP' ? 'Shop time' : sp.ro)}</b>${hm(sp.s)}–${sp.e == null ? 'now' : hm(sp.e)}</span>${sp.e != null && f0 ? toolsRow(f0) : ''}${an ? `<button class="btn btn-sm" data-a="pop" data-p="air" data-from="${an[0]}" data-to="${an[1]}">${ic('plus', 13)}Fill the ${dur(an[1] - an[0])} after</button>` : ''}<span class="sp"></span><span class="k">${dg ? `<b>${kbd('↵')} save</b> · ${kbd('Esc')} put back` : `${kbd('Alt')}${kbd('←')}${kbd('→')} the stop · with ${kbd('⇧')} the start`}</span><button class="btn btn-sm" data-a="pop" data-p="edit" data-pid="${sp.id}">${ic('pencil', 13)}Edit</button></div>`; }
    c.fixes.forEach(f => { h += `<div class="tk-fix">${ic('flag', 16)}<p><b>${esc(f.t)}.</b> ${esc(f.why)}.</p><span class="tk-fixb">${lk ? '' : fxBtns({ k, f, c })}</span></div>`; });
    c.soft.forEach(s => { h += `<div class="tk-fix warn">${ic('info', 16)}<p><b>${dur(s.to - s.from)} of air</b> from ${hm(s.from)} to ${hm(s.to)} — on the clock, not on a job.</p><button class="btn btn-sm" data-a="pop" data-p="air" data-from="${s.from}" data-to="${s.to}">Fill it…</button><button class="btn btn-sm tg-gh" data-a="airok" data-from="${s.from}">It’s right</button></div>`; });
    if(c.noLunch && !c.today) h += `<div class="tk-fix warn auto">${ic('coffee', 16)}<p><b>No lunch clocked.</b> ${dur(c.clocked)} on the clock without a lunch clock-out.${c.noLunch.at != null ? ` There’s a gap with no job at ${hm(c.noLunch.at)}.` : ''}</p>${lk ? '' : reqOpen(U.who, k).some(r => r.fk === 'lunch|') ? `<span class="tk-pend">${ic('clock', 12)}Asked ${esc(PG.first(lead()))} · waiting</span>` : `${c.noLunch.at != null ? `<button class="btn btn-sm" data-a="lunchadd" data-at="${c.noLunch.at}">Take 30 min at ${hm(c.noLunch.at)}</button>` : ''}<button class="btn btn-sm tg-gh" data-a="lunchok">I worked through it</button>`}</div>`;
    const R = []; c.segs.forEach((x, i) => { if(!c.D.virt) R.push({ t: x[0], kind: 'in', i }); if(x[3] != null && !c.D.virt) R.push({ t: x[1], kind: 'out', why: x[2] }); });
    c.ps.forEach(p => R.push({ t: p.s, kind: 'p', p })); c.air.forEach(x => { if(x[1] - x[0] >= 3) R.push({ t: x[0], kind: 'air', x }); });
    R.sort((x, y) => x.t - y.t || (x.kind === 'out' ? -1 : 0));
    const over = new Set(), overO = {}; c.fixes.forEach(f => { if(f.k === 'over'){ over.add(f.a); over.add(f.b); overO[f.a] = 0; overO[f.b] = 1; } });
    const rp = runningPunch();
    const row = r => {
      if(r.kind === 'in'){ const sid = c.D.shIds[r.i], sh = sid ? shiftList().find(s => s.id === sid) : null, run = !!sh && !sh.out && c.today && !lk;   /* Parsec 12.7: change the running day clock's start */
        return `<div class="tk-r edge${run ? ' shin' : ''}"><span class="tm">${hm(r.t)}</span><span></span><span class="wh"><span class="l1">${ic('clock', 13)}Clocked in${r.i ? ' · back' : ''}${shBadge(sh, k)}</span></span><span class="ac">${run ? `<button class="btn btn-sm ib" data-a="pop" data-p="shin" data-sid="${sh.id}" title="Change when ${otherT() ? esc(TF(U.who)) + ' clocked' : 'you clocked'} in">${ic('pencil', 14)}</button>` : ''}</span></div>`; }
      if(r.kind === 'out') return `<div class="tk-r edge"><span class="tm">${hm(r.t)}</span><span></span><span class="wh"><span class="l1">${ic(r.why === 'Lunch' ? 'coffee' : 'exit', 13)}Clocked out${r.why ? ' · ' + esc(r.why) : ''}</span></span><span></span></div>`;
      if(r.kind === 'air') return `<div class="tk-r air"><span class="tm">${hm(r.x[0])} – ${hm(r.x[1])}</span><span class="du">${dur(r.x[1] - r.x[0])}</span><span class="wh"><span class="l1"><i class="tk-sw air"></i><b>Air — on the clock, not on a job</b></span></span><span class="ac">${r.x[1] - r.x[0] >= 10 && !lk ? `<button class="btn btn-sm tg-gh" data-a="pop" data-p="air" data-from="${r.x[0]}" data-to="${r.x[1]}">${ic('plus', 13)}Fill</button>` : ''}</span></div>`;
      const p = r.p, shp = p.ro === 'SHOP', run = p.e == null, m = p.e2 - p.s;
      return `<div class="tk-r${U.sel === p.id ? ' sel' : ''}${run ? ' run' : ''}${over.has(p.id) ? ' prob' : ''}" data-a="psel" data-p="${p.id}"><span class="tm">${hm(p.s)} – ${run ? 'now' : hm(p.e)}</span><span class="du">${dur(m)}</span>
        <span class="wh"><span class="l1"><i class="tk-sw ${shp ? 'shop' : 'job'}"></i>${shp ? `<b>Shop time</b><span class="cm">${esc(p.shop)}</span>` : `<span class="no">${esc(p.ro)}</span><span class="cm">${esc(p.cm)}</span>`}${edBadge(p)}${reqOpen(U.who, k).some(r => r.a && r.a.pid === p.id) ? `<span class="tk-ed rq">${ic('clock', 10)}asked · waiting</span>` : ''}</span>
        <span class="l2">${shp ? '' : `<span class="tk-rs">${esc(p.sr)}<i>→</i>${run ? '<b style="color:var(--tg-good);font-weight:500">running</b>' : esc(p.er || '')}</span><span>·</span>`}${shp ? '<span class="nt">Counts as shop time, not on an RO</span>' : p.note ? `<span class="nt">${esc(p.note.split('\n').pop())}</span>` : run ? '<span class="nt">Notes go in when the clock stops</span>' : '<span class="nt miss">No work note</span>'}</span></span>
        <span class="ac">${run ? (rp && rp.id === p.id ? `<button class="btn btn-sm" data-action="open-stop-punch">${ic('stop', 13)}Stop</button>` : '') + (lk ? '' : `<button class="btn btn-sm ib" data-a="pop" data-p="edit" data-pid="${p.id}" title="Edit — the start, stop it earlier, the reason, the operation (E)">${ic('pencil', 14)}</button>`) : lk ? '' : (overO[p.id] != null ? `<button class="btn btn-sm" data-a="pop" data-p="fix" data-f="over" data-fa="${c.fixes.find(f => f.k === 'over' && (f.a === p.id || f.b === p.id)).a}" data-o="${overO[p.id]}">${ic('split', 13)}Trim…</button>` : '') + `<button class="btn btn-sm ib" data-a="pop" data-p="edit" data-pid="${p.id}" title="Edit (E)">${ic('pencil', 14)}</button>`}</span></div>`; };
    h += `<div class="tk-st"><div class="tk-sth">The day, in order<span class="sp"></span><span style="font-weight:400">Click a row or a block to select it · E edits</span></div>${R.map(row).join('')}</div>`;
    const O = {}; c.ps.forEach(p => { if(p.ro === 'SHOP') return; const key = p.ro + '|' + p.opId, o = O[key] || (O[key] = { b: 0, q: 0, ro: p.ro, cm: p.cm, oq: 0, opId: p.opId }); o.b += (p.e2 - p.s) / 60; o.q += p.q; });
    Object.values(O).forEach(o => { const op = (getRO(c.ps.find(p => p.opId === o.opId).roId) || { operations: [] }).operations.find(x => x.id === o.opId); o.oq = op ? +op.quoted || 0 : 0; });
    const ks = Object.keys(O);
    if(ks.length) h += `<div class="tk-ops"><div class="tk-sth" style="margin-bottom:4px">By operation today<span class="sp"></span><span style="font-weight:400">clocked against what it pays · the line is the quote</span></div>${ks.map(r => { const o = O[r], mx = Math.max(o.b, o.oq, 0.1) * 1.15; return `<div class="tk-opr"><span class="cm"><span class="no">${esc(o.ro)}</span>${esc(o.cm)}</span><span class="tk-bar" title="${o.b.toFixed(2)} h clocked today · ${o.oq.toFixed(1)} h quoted"><i style="width:${(o.b / mx * 100).toFixed(1)}%"></i><u style="left:${(o.oq / mx * 100).toFixed(1)}%"></u></span><span class="v">${o.b.toFixed(2)} / ${o.oq.toFixed(1)} h</span></div>`; }).join('')}</div>`;
    return h + '</div>';
  }
  function vWeek(){
    const ws = wkStart(U.day), a = 360, b = 1080; let T = { c: 0, j: 0, air: 0, s: 0, q: 0 };
    const rows = [0, 1, 2, 3, 4, 5, 6].map(i => { const k = addD(ws, i), d = dOf(k), c = calc(U.who, k);
      if(c){ T.c += c.clocked; T.j += c.job; T.air += c.airM; T.s += c.shop; T.q += c.q; T.jq = (T.jq || 0) + c.jq; }
      const fut = k > TODAY;
      return `<div class="tk-wr${k === U.day ? ' on' : ''}" data-a="${c ? 'wday' : ''}" data-k="${k}"><span class="dl"><b>${DN[d.getDay()]} ${d.getMonth() + 1}/${d.getDate()}</b><small>${c ? (c.fixes.length ? `<span style="color:var(--tg-bad);font-weight:500">${esc(c.fixes[0].t)}</span>` : k === TODAY ? 'today' : hm(c.first) + ' – ' + (c.last != null ? hm(c.last) : '—')) : fut ? '—' : 'off'}</small></span>
        <span class="tk-wt">${c ? track(c, a, b, { w: 560 }) : ''}</span>${c ? `<span class="v">${dur(c.clocked)}<small>clocked</small></span><span class="v">${dur(c.job)}<small>${c.clocked ? Math.round(c.job / c.clocked * 100) + '% on jobs' : 'on jobs'}</small></span><span class="v">${effTxt(c.eff)}<small>eff.</small></span>` : '<span></span><span></span><span></span>'}</div>`; }).join('');
    const d0 = dOf(ws), d6 = dOf(addD(ws, 6)), cap = 40 * 60;
    return `<div class="tk-wk"><div class="tk-dh"><h2>Week of ${MNL[d0.getMonth()]} ${d0.getDate()} – ${d0.getMonth() === d6.getMonth() ? '' : MN[d6.getMonth()] + ' '}${d6.getDate()}</h2><span class="sp"></span><span class="nav"><button class="btn btn-sm ib" data-a="wnav" data-d="-7">${ic('chevL', 15)}</button><button class="btn btn-sm ib" data-a="wnav" data-d="7"${ws === wkStart(TODAY) ? ' disabled' : ''}>${ic('chevR', 15)}</button></span></div>
      <div class="tk-cap"><div class="m"><small><b style="color:var(--tg-ink);font:600 15px/1 var(--tg-mono)">${dur(T.c)}</b> of 40:00 · ${T.c > cap ? 'overtime ' + dur(T.c - cap) : dur(Math.max(0, cap - T.c)) + ' to go before overtime'}</small><div class="tk-capb"><i style="width:${Math.min(100, T.c / cap * 100).toFixed(1)}%"></i></div></div>
      <div class="tk-stats" style="padding:0;gap:6px 26px"><div class="tk-stat"><small><i class="sw" style="background:var(--tk-job)"></i>On jobs</small><b>${dur(T.j)}<em>${T.c ? Math.round(T.j / T.c * 100) : 0}%</em></b></div><div class="tk-stat"><small><i class="sw" style="background:var(--tk-air)"></i>Air</small><b>${dur(T.air)}</b></div><div class="tk-stat"><small><i class="sw" style="background:var(--tk-shop)"></i>Shop</small><b>${dur(T.s)}</b></div><div class="tk-stat${T.jq && T.q / (T.jq / 60) >= 1 ? ' good' : ''}"><small>Efficiency</small><b>${T.jq ? effTxt(T.q / (T.jq / 60)) : '—'}</b></div></div></div>
      <div class="tk-wg"><div class="tk-wr h"><span></span><span class="tk-wt" style="height:18px">${axis(a, b, 2)}</span><span class="v mut" style="font-family:var(--tg-sans)">Clocked</span><span class="v mut" style="font-family:var(--tg-sans)">On jobs</span><span class="v mut" style="font-family:var(--tg-sans)">Eff.</span></div>${rows}</div>
      ${effTrend()}<div class="tk-st" style="margin-top:12px"><div class="tk-sth" style="font-weight:400">Click a day to open it · the timeline runs 06:00–18:00</div></div></div>`;
  }
  function vSheet(){
    const t = sgT(); if(!t) return '';
    const P = PER(U.per), L = perDays(U.per);
    let T = { c: 0, j: 0, air: 0, s: 0, l: 0 }, W = { c: 0, j: 0, air: 0, s: 0, l: 0 }, wkN = 0; const rows = [];
    L.forEach((k, i) => { const c = calc(t, k), d = dOf(k), fut = k > TODAY;
      if(c){ ['c', 'j', 'air', 's', 'l'].forEach((f, j) => { const v = [c.clocked, c.job, c.airM, c.shop, c.lunchM][j]; T[f] += v; W[f] += v; }); }
      const prob = c && c.fixes.length;
      rows.push(c ? `<tr class="${prob ? 'prob' : ''}"><td>${DN[d.getDay()]} ${d.getMonth() + 1}/${d.getDate()}</td><td>${hm(c.first)}</td><td>${c.open ? (c.today ? 'on' : '—') : hm(c.last)}</td><td>${dur(c.lunchM)}</td><td>${dur(c.clocked)}</td><td>${dur(c.job)}</td><td>${dur(c.airM)}</td><td>${dur(c.shop)}</td><td class="fl">${prob ? esc(c.fixes[0].t) + ' — fix before printing' : c.today && c.on ? 'still on the clock' : ''}</td></tr>`
        : `<tr><td>${DN[d.getDay()]} ${d.getMonth() + 1}/${d.getDate()}</td><td class="mut" colspan="7" style="text-align:left;font-family:var(--tg-sans)">${fut ? '' : 'off'}</td><td></td></tr>`);
      if(d.getDay() === 0 || i === L.length - 1){ wkN++; rows.push(`<tr class="wk"><td>Week ${wkN}</td><td></td><td></td><td>${dur(W.l)}</td><td>${dur(W.c)}</td><td>${dur(W.j)}</td><td>${dur(W.air)}</td><td>${dur(W.s)}</td><td class="fl${W.c > 2400 ? ' ot' : ''}">${W.c > 2400 ? 'Overtime ' + dur(W.c - 2400) : 'No overtime'}</td></tr>`); W = { c: 0, j: 0, air: 0, s: 0, l: 0 }; } });
    const shopName = String(STATE.shopName || (STATE.settings && STATE.settings.shopName) || '').trim();
    return `<div class="tk-ts"><div class="tk-tsbar"><span class="nav"><button class="btn btn-sm ib" data-a="per" data-v="prev" title="The period before"${U.per === 'prev' ? ' disabled' : ''}>${ic('chevL', 15)}</button><button class="btn btn-sm ib" data-a="per" data-v="cur" title="This period"${U.per === 'cur' ? ' disabled' : ''}>${ic('chevR', 15)}</button></span><b>Pay period · ${P[1]}</b><span class="tg-hf" style="cursor:default">${U.per === 'prev' ? 'ended ' + short(P[2]) + ' · due ' + short(addD(P[2], 5)) : 'paid ' + PG.perWord() + ' · set on the Manager page'}</span><span class="sp"></span><button class="btn btn-sm" data-action="export-csv">${ic('download', 14)}Export CSV</button><button class="btn btn-sm btn-primary" data-a="tsprint">${ic('print', 14)}Print</button></div>${signBar(L)}
     <article class="tk-paper"><header><div><span class="lg">${typeof PX_LOGO !== 'undefined' ? PX_LOGO : ''}</span><b>Timesheet</b><small>${esc(shopName || 'Parsec')}</small></div><div class="r"><b>${esc(t)}</b><small>Technician</small><small>${P[1]}, ${dOf(P[0]).getFullYear()}</small>${(sign()[sgK()] || {}).fm ? `<span class="tk-stamp">${ic('lock', 11)}Approved · locked</span>` : ''}</div></header>
     <table><thead><tr><th>Day</th><th>In</th><th>Out</th><th>Lunch</th><th>Clocked</th><th>On jobs</th><th>Air</th><th>Shop</th><th style="text-align:left">Note</th></tr></thead><tbody>${rows.join('')}<tr class="tot"><td>Period</td><td></td><td></td><td>${dur(T.l)}</td><td>${dur(T.c)}</td><td>${dur(T.j)}</td><td>${dur(T.air)}</td><td>${dur(T.s)}</td><td class="fl">${T.c ? Math.round(T.j / T.c * 100) + '% on jobs' : ''}</td></tr></tbody></table>
     ${sigLines()}<footer>Printed from Parsec · times from the clock in / out and the punches · ${(() => { const ne = STATE.punches.filter(q => q.edited && techSame(punchWho(q), t) && localDay(q.start) >= P[0] && localDay(q.start) <= P[2]).length; return ne ? ne + ' edited punch' + (ne > 1 ? 'es' : '') + ' — each shows who, why and the time before on the day report' : 'no edited punches'; })()}</footer></article></div>`;
  }
  function vShop(){
    const k = U.day, a = 360, b = 1080, d = dOf(k), T = techs(), off = k === TODAY ? offNow() : [];
    const crewOk = T.some(t => !isMine(t) && mayFix(t)), U0 = U.crew || {}, ck = t => crewOk ? `<button class="tk-ck${U0[t] ? ' on' : ''}" data-a="crew" data-t="${esc(t)}" role="checkbox" aria-checked="${U0[t] ? 'true' : 'false'}" aria-label="Pick ${esc(PG.first(t))}">${U0[t] ? ic('check', 11) : ''}</button>` : '';   /* Parsec 14.6 */
    const rows = T.map(t => { const c = calc(t, k); if(!c) return `<div class="tk-sr" data-a="who" data-t="${esc(t)}"><span class="nm">${ck(t)}${av(t, 'lg')}<span><b>${esc(t)}</b><small>Not in</small></span></span><span></span><span class="v">—</span><span class="v">—</span><span class="v">—</span></div>`;
      const lastOut = c.segs[c.segs.length - 1] || [];
      const now = k === TODAY && c.on && c.over >= 30 ? `<small class="bad">${ic('flag', 11)}${Math.round(c.over)} min past shift · ${c.run ? (c.run.ro === 'SHOP' ? 'shop time' : c.run.ro) : 'no job'}</small>` : k === TODAY ? (c.run ? `<small class="on">On ${c.run.ro === 'SHOP' ? 'shop time' : c.run.ro} · ${dur(NOW - c.run.s)}</small>` : c.on ? `<small class="warn">On the clock, no job${c.ps.length ? ' for ' + dur(NOW - Math.max(...c.ps.map(p => p.e2))) : ''}</small>` : `<small>Off the clock${lastOut[2] ? ' — ' + esc(String(lastOut[2]).toLowerCase()) : ''}${c.D.back ? ', back by ' + c.D.back : ''}</small>`) : `<small>${hm(c.first)} – ${c.last != null ? hm(c.last) : '—'}</small>`;
      const n = nfx(t), na = reqOpen(t).length;
      return `<div class="tk-sr${U0[t] ? ' tk-pkd' : ''}" data-a="who" data-t="${esc(t)}"><span class="nm">${ck(t)}${av(t, 'lg')}<span><b>${esc(t)}${n ? ` <span class="tk-pill bad">${n} to fix</span>` : ''}${na ? ` <span class="tk-pill warn">${na} ask${na > 1 ? 's' : ''}</span>` : ''}</b>${now}</span></span><span class="tk-wt">${track(c, a, b, { w: 520 })}</span><span class="v">${dur(c.clocked)}<small>clocked</small></span><span class="v">${dur(c.job)}<small>${c.clocked ? Math.round(c.job / c.clocked * 100) : 0}% on jobs</small></span><span class="v">${effTxt(c.eff)}<small>eff.</small></span></div>`; }).join('');
    const all = T.map(t => calc(t, k)).filter(Boolean), cl = all.reduce((s, c) => s + c.clocked, 0), jb = all.reduce((s, c) => s + c.job, 0), air = all.reduce((s, c) => s + c.airM, 0);
    const late = k === TODAY ? T.filter(t => { const x = calc(t, k); return x && x.on && x.over >= 30; }).length : 0;
    return `<div class="tk-sh"><div class="tk-dh"><h2>${k === TODAY ? 'Today · ' : ''}${DNL[d.getDay()]}, ${MNL[d.getMonth()]} ${d.getDate()}</h2><span class="sp"></span><span class="nav"><button class="btn btn-sm ib" data-a="dnav" data-d="-1">${ic('chevL', 15)}</button><button class="btn btn-sm ib" data-a="dnav" data-d="1"${k >= TODAY ? ' disabled' : ''}>${ic('chevR', 15)}</button></span><button class="btn btn-sm btn-primary" data-action="open-report" data-date="${k}">${ic('print', 14)}Day report</button></div>
     <div class="tk-sum"><span><b>${dur(cl)}</b>clocked across the shop</span><span><b>${cl ? Math.round(jb / cl * 100) : 0}%</b>on jobs</span><span class="warn"><b>${dur(air)}</b>air</span>${late ? `<span class="bad"><b>${late}</b>clock${late > 1 ? 's' : ''} 30+ min past the shift</span>` : ''}${off.map(o => `<span><b>1</b>off — ${esc(PG.first(o[0]))}, ${esc(o[1].toLowerCase())}</span>`).join('')}</div>
     ${crewOk ? (() => { const N = T.filter(t => U0[t]); return `<div class="tk-crew${N.length ? ' on' : ''}"><button class="tk-ck${N.length === T.length ? ' on' : N.length ? ' some' : ''}" data-a="crewall" role="checkbox" aria-checked="${N.length === T.length ? 'true' : N.length ? 'mixed' : 'false'}" aria-label="Pick everyone">${N.length === T.length ? ic('check', 11) : N.length ? '<i></i>' : ''}</button>${N.length ? `<b>${N.length} picked</b><span class="sp"></span><button class="btn btn-sm btn-primary" data-a="pop" data-p="crew" data-m="out">${ic('exit', 13)}Clock out…</button><button class="btn btn-sm" data-a="pop" data-p="crew" data-m="lunch">${ic('coffee', 13)}Lunch…</button><button class="btn btn-sm" data-a="pop" data-p="crew" data-m="shop">${ic('users', 13)}Shop time…</button>` : `<span class="mut">Pick people to fix them at once — a clock-out, a lunch, a shop meeting</span>`}</div>`; })() : ''}
     <div class="tk-wg"><div class="tk-sr h"><span>${crewOk ? '<i class="tk-ckw"></i>' : ''}Technician</span><span class="tk-wt" style="height:18px">${axis(a, b, 2)}</span><span class="v" style="font-family:var(--tg-sans);color:var(--tg-ink3)">Clocked</span><span class="v" style="font-family:var(--tg-sans);color:var(--tg-ink3)">On jobs</span><span class="v" style="font-family:var(--tg-sans);color:var(--tg-ink3)">Eff.</span></div>${rows}</div>
     <div class="tk-st" style="margin-top:12px"><div class="tk-sth" style="font-weight:400">Click a tech to open their day · the foreman and the manager see this view, a tech sees only their own time</div></div></div>`;
  }
