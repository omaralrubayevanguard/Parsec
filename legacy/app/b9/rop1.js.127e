  var live = ropLive(), job = S.jobs.filter(function (j) { return j.id === S.ui.card && live.indexOf(j) > -1; })[0] || live.filter(function (j) { return ropRun(j); })[0] || live.filter(function (j) { return !opDoneNow(j); })[0];
  var acts = el('div', { class: 'rop-acts' });
