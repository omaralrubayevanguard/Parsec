  var rows = live.map(function (op) { var m = 0; try { m = opMoney(op).total; } catch (e) {} var a = op.asistApproval;
    return '<span>Op ' + ropN(op) + ' · ' + esc(opJobType(op)) + ' · ' + ropH1(+op.quoted || 0) + ' h' + (op.appr && op.appr.at ? (op.appr.s === 'no' ? ' <em class="b">declined</em>' : ' <em class="g">approved</em>') : need.indexOf(op) > -1 ? ' <em class="w">not approved</em>' : '') + (a ? ' <em class="rop-asist" title="ASIST’s approval — shown only">ASIST: ' + esc(a) + '</em>' : '') + '</span><b>' + esc(pxMoney(m)) + '</b>'; }).join('');
  var wr = ropWriter();
