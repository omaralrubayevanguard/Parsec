/* ============================== Parsec 12: the RO page in your layout (b9/rop1.js — inside the RO page, JC) ==============================
   From the RO page mock-up. The middle: Operations, Parts on this RO, Fault codes, Photos & codes, Messages about this RO, Truck history,
   Warranty claim, Customer, Estimate & approval, Ready to close. The right: Truck & status, the stage bar, Who has it, People, Schedule,
   Vehicle, Money. Next step and Paperwork are off — Paperwork's fields went to Customer (case, PO, auth, tech support), Schedule (the dates)
   and Vehicle (department). Activity stays the header button (11.3). An open operation: Time (each punch with its notes between start and
   stop), Parts, Files. And picking (the selecting mock-up): a box on each operation and part, Ctrl / Shift click, a bar along the bottom. */
var ROP_IC = {
  camera: '<path d="M4 8.5A1.5 1.5 0 0 1 5.5 7h2l1.2-1.8A1 1 0 0 1 9.5 5h5a1 1 0 0 1 .8.4L16.5 7h2A1.5 1.5 0 0 1 20 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17.5z"/><circle cx="12" cy="13" r="3.2"/>',
  flag: '<path d="M5 21V4M5 4h11l-2 4 2 4H5"/>',
  send: '<path d="M4 12l16-8-6 16-2.5-6.5z"/><path d="M11.5 13.5L20 4"/>',
  undo: '<path d="M9 7L4.5 11.5 9 16"/><path d="M5 11.5h9a5 5 0 0 1 0 10h-2"/>',
  wrench: '<path d="M14.7 6.3a4 4 0 0 0-5.2 5.2l-5 5a1.8 1.8 0 0 0 2.5 2.5l5-5a4 4 0 0 0 5.2-5.2l-2.4 2.4-2.3-.3-.3-2.3z"/>',
  image: '<rect x="3.5" y="4.5" width="17" height="15" rx="2.5"/><circle cx="9" cy="10" r="1.7"/><path d="M4 17l4.5-4 3.5 3 3-2.5 5 4"/>',
  file: '<path d="M7 3.5h7l4 4v12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1v-15a1 1 0 0 1 1-1z"/><path d="M14 3.5v4h4"/>',
  clockPlus: '<path d="M20 12a8 8 0 1 1-6.2-7.8"/><path d="M12 8v4l2.5 1.5"/><path d="M18.5 3v5M16 5.5h5"/>',
  notePlus: '<path d="M13.5 4.5H6a1.5 1.5 0 0 0-1.5 1.5v12A1.5 1.5 0 0 0 6 19.5h12a1.5 1.5 0 0 0 1.5-1.5v-7.5"/><path d="M8 10h5M8 13.5h7"/><path d="M18 3v5M15.5 5.5h5"/>',
  box: '<path d="M4 8l8-4 8 4v8l-8 4-8-4z"/><path d="M4 8l8 4 8-4M12 12v8"/>',
  scan: '<path d="M7 3.5H5.5a2 2 0 0 0-2 2V7M17 3.5h1.5a2 2 0 0 1 2 2V7M7 20.5H5.5a2 2 0 0 1-2-2V17M17 20.5h1.5a2 2 0 0 0 2-2V17"/><path d="M8 9h8M8 12h8M8 15h5"/>',
  upload: '<path d="M12 15.5V4.5M7.5 9 12 4.5 16.5 9"/><path d="M4.5 15v3a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-3"/>',
  paste: '<rect x="6" y="5" width="12" height="15.5" rx="2"/><path d="M9.5 5V4a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v1"/><path d="M9 11h6M9 14.5h4"/>',
  partAsk: '<path d="M4 8l8-4 8 4v8l-8 4-8-4z"/><path d="M4 8l8 4 8-4M12 12v8"/><circle cx="18.5" cy="18.5" r="3.5" fill="currentColor" stroke="none" opacity=".18"/>',
  chevDn: '<path d="M7 10l5 5 5-5"/>', chevUp: '<path d="M7 14l5-5 5 5"/>'
};
function ri(k, sz) { if (!ROP_IC[k]) return pxI(k, sz); sz = sz || 16; return '<svg class="px-ico" width="' + sz + '" height="' + sz + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + ROP_IC[k] + '</svg>'; }
var ROPS = { ro: null, o: {}, p: {}, pOp: null, last: null };
var ROPU = { msgTo: '', msgAll: false, histAll: false, fcOp: null };
var ROP_TH = {};
function ropH1(v) { return (Math.round((+v || 0) * 10) / 10).toFixed(1); }
function ropN(job) { return S.jobs.indexOf(job) + 1; }
function ropFirst(n) { return String(n || '').trim().split(/\s+/)[0] || ''; }
function ropMe() { try { return PG.me().name; } catch (e) { return punchByName() || 'Admin'; } }
function ropIsMe(n) { try { return PG.isMe(n); } catch (e) { return false; } }
function ropPerson(role) { try { return PG.person(role) || ''; } catch (e) { return ''; } }
function ropWriter() { var w = ''; try { w = rtPerson('writer') || ''; } catch (e) {} return w; }
function ropAgo(t) { try { return PG.ago(t); } catch (e) { return pxWhen(t); } }
function ropDay(t) { try { return PG.day(t); } catch (e) { return new Date(t).toLocaleDateString(); } }
function ropClk(t) { var d = new Date(t); if (isNaN(d)) return ''; return d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }).toLowerCase().replace(/\s/g, ' '); }
function ropLive() { var L = []; try { L = raLive(RO); } catch (e) { L = (S.jobs || []).filter(function (j) { return j && !j.declined; }); } return L; }
function ropRun(job) { return STATE.punches.filter(function (p) { return p.opId === job.id && !p.stop; })[0] || null; }
function ropNone(t) { return el('div', { class: 'rop-none', text: t }); }
function ropNote(to, k, job, t, b, q) { if (typeof IB === 'undefined' || !to) return false; try { IB.send({ to: to, k: k, src: 'ros', ro: RO.id, op: job ? job.id : null, t: t, b: b || '', q: q || '' }); return true; } catch (e) { console.error(e); return false; } }
/* Undo takes the whole change back — with whatever an automation did because of it (it adds its own undo step after ours) */
function ropUndo(msg) { var t0 = Date.now() - 3000;
  toast(msg, { label: 'UNDO', run: function () {
    try { var g = 8; while (g-- && UNDO.length > 1) { var u = UNDO[UNDO.length - 1]; if ((u.label === 'automation' || u.auto) && u.at >= t0) UNDO.pop(); else break; } } catch (e) {}
    restoreSnapshot(); } }); }
function ropNo() { return (RO && RO.roNumber) || tgNum(RO); }   /* the full RO number, as on the band */
function ropAv(n) { return '<span class="px-av" title="' + esc(n || '') + '">' + esc(ivInit(n || '?')) + '</span>'; }
/* a block in the middle: its heading, then its rows */
function ropSec(key, title, sub, body, act) {
  var head = el('div', { class: 'px-sec rop-sech' }, [el('h3', { text: title })].concat(sub ? [el('span', { class: 'n', text: sub })] : []).concat(act ? [act] : []));
  return el('section', { class: 'rop-blk rop-k-' + key }, [head].concat(body));
}

/* ---------- the middle ---------- */
function ropParts() {
  var L = []; ropLive().forEach(function (j) { (j.parts || []).forEach(function (p) { if (p && (p.description || p.partNumber)) L.push({ j: j, p: p }); }); });
  var inH = L.filter(function (x) { return pxPartIn(x.p); }).length, ext = L.some(function (x) { return +x.p.core > 0 || x.p.salesman; });
  var box = el('div', { class: 'px-list rop-pl' + (ext ? ' is-ext' : '') });
  if (L.length && ext) box.appendChild(el('div', { class: 'rop-plh', html: '<span>Part</span><span class="r">Core</span><span>Salesman</span><span>Status</span>' }));
  L.forEach(function (x) {
    var st = x.p.status || 'Not Ordered';
    var b = el('button', { class: 'px-pstat', type: 'button', title: 'Part status and options', html: pxPsi(st) + '<span>' + esc(pxCase(st)) + '</span>' + pxI('chevD', 12).replace('class="px-ico"', 'class="px-ico px-chev"') });
    b.addEventListener('click', function (e) { e.stopPropagation(); pxPartMenu(b, x.j, x.p); });
    var nm = el('button', { class: 'rop-nm', type: 'button', title: 'Open Op ' + ropN(x.j) + ' — its parts', html: '<b>' + esc(ptName(x.p)) + '</b><small>' + (x.p.partNumber ? '<span class="px-id">' + esc(x.p.partNumber) + '</span> · ' : '') + 'qty ' + esc(x.p.qty || '1') + ' · Op ' + ropN(x.j) + '</small>', onClick: function (e) { e.stopPropagation(); pxGoto(x.j.id, 'parts'); } });
    box.appendChild(el('div', { class: 'px-li rop-pr' }, [nm].concat(ext ? [el('span', { class: 'r px-num rop-mu', text: +x.p.core > 0 ? pxMoney(+x.p.core) : '' }), el('span', { class: 'rop-mu rop-ell', text: x.p.salesman || '' })] : []).concat([b])));
  });
  if (!L.length) box.appendChild(ropNone('No parts on this RO yet.'));
  var cur = S.jobs.filter(function (j) { return j.id === S.ui.card; })[0] || ropLive()[0];
  var ask = cur ? ropIb('partAsk', 'Ask Parts for a part', function () { ropAsk('parts', [cur], []); }) : null;
  return ropSec('parts', 'Parts on this RO', L.length ? inH + ' of ' + L.length + ' in hand' : '', [box], ask);
}
function ropDtc() {
  var L = []; ropLive().forEach(function (j) { (j.faults || []).forEach(function (f) { L.push({ j: j, f: f }); }); });
  var files = S.log.filter(function (e) { return e.task === 'dtc'; }).reduce(function (n, e) { return n + (e.files || []).length; }, 0);
  var box = el('div', { class: 'px-list' });
  L.forEach(function (x) {
    var rm = el('button', { class: 'rop-x', type: 'button', title: 'Take this code off', 'aria-label': 'Remove ' + fcLabel(x.f), html: pxI('x', 13), onClick: function (e) {
      e.stopPropagation(); pushUndo('fault code'); x.j.faults = (x.j.faults || []).filter(function (f) { return f !== x.f; }); save(true); render(); ropUndo(fcLabel(x.f) + ' taken off Op ' + ropN(x.j)); } });
    box.appendChild(el('div', { class: 'px-li rop-dc' }, [el('span', { class: 'px-id rop-code', text: fcLabel(x.f) }), el('span', { class: 'rop-dt', html: '<b>' + esc(faultMeaning(x.f)) + '</b><small>Op ' + ropN(x.j) + ' · ' + esc(x.j.complaint || 'Operation') + '</small>' }), rm]));
  });
  if (!L.length) box.appendChild(ropNone('No codes on this RO yet.'));
  var live = ropLive(); if (!live.length) return ropSec('dtc', 'Fault codes', '', [box]);
  if (!ROPU.fcOp || !live.some(function (j) { return j.id === ROPU.fcOp; })) ROPU.fcOp = (live.filter(function (j) { return j.id === S.ui.card; })[0] || live[0]).id;
  var inp = el('input', { class: 'rop-in__i', placeholder: 'Add a code — 3226/2 or P0401, Enter', 'aria-label': 'Add a fault code' });
  var sel = el('select', { class: 'rop-sel', 'aria-label': 'Which operation' }); live.forEach(function (j) { sel.appendChild(el('option', { value: j.id, text: 'Op ' + ropN(j) })); }); sel.value = ROPU.fcOp;
  sel.addEventListener('change', function () { ROPU.fcOp = sel.value; });
  inp.addEventListener('keydown', function (e) {
    e.stopPropagation(); if (e.key !== 'Enter') return; e.preventDefault();
    var f = parseFault(inp.value), j = S.jobs.filter(function (x) { return x.id === sel.value; })[0];
    if (!f) { toast('Type it as SPN/FMI — 3226/2 — or a P-code like P0401.'); return; }
    if (j && addFault(j, f)) { ropUndo(fcLabel(f) + ' added to Op ' + ropN(j)); requestAnimationFrame(function () { var i2 = R.querySelector('.rop-k-dtc .rop-in__i'); if (i2) i2.focus(); }); }
  });
  var row = el('label', { class: 'rop-in' }, [el('span', { html: pxI('plus', 14) }), inp].concat(live.length > 1 ? [sel] : []));
  return ropSec('dtc', 'Fault codes', (L.length ? L.length + ' code' + (L.length === 1 ? '' : 's') : '') + (files ? (L.length ? ' · ' : '') + files + ' DTC file' + (files === 1 ? '' : 's') : ''), [box, row]);
}
function ropThumb(f) {
  var isImg = /^image\//.test(f.type || '') || /\.(jpe?g|png|webp|gif|heic)$/i.test(f.name || '');
  var b = el('button', { class: 'rop-th' + (isImg ? '' : ' is-file'), type: 'button', title: f.name || 'File', onClick: function (e) { e.stopPropagation(); openAttachments(f.id); } });
  if (!isImg) { b.innerHTML = ri('file', 16) + '<small>' + esc(String(f.name || 'File').slice(0, 18)) + '</small>'; return b; }
  var im = el('img', { alt: f.name || 'Picture' }); b.appendChild(im);
  if (ROP_TH[f.id]) im.src = ROP_TH[f.id];
  else getBlob(f).then(function (bl) { if (bl) { ROP_TH[f.id] = URL.createObjectURL(bl); im.src = ROP_TH[f.id]; } else b.classList.add('is-gone'); }, function () { b.classList.add('is-gone'); });
  return b;
}
function ropPhotos() {
  var T = [['dashpic', 'Dash picture'], ['pics', 'Pictures'], ['dtc', 'DTCs']], all = [];
  T.forEach(function (t) { S.log.filter(function (e) { return e.task === t[0]; }).forEach(function (e) { (e.files || []).forEach(function (f) { all.push({ f: f, t: t }); }); }); });
  var grid = el('div', { class: 'rop-ph' });
  all.slice(-10).forEach(function (x) { var th = ropThumb(x.f); th.appendChild(el('em', { text: x.t[1] })); grid.appendChild(th); });
  var body = [all.length ? grid : ropNone('No dash picture, pictures or DTC files yet.')];
  var adds = el('span', { class: 'rop-tacts rop-sacts' });
  T.forEach(function (t) {
    var inp = el('input', { type: 'file', multiple: 'multiple', accept: t[0] === 'dtc' ? 'image/*,.pdf,application/pdf,.txt,.csv' : 'image/*,video/*', style: 'display:none', onChange: function () { var arr = Array.prototype.slice.call(inp.files || []); if (!arr.length) return; pushUndo('attach files'); addFiles(pgEntryFor(t[0], true).oid, arr); } });
    adds.appendChild(inp); adds.appendChild(ropIb(t[0] === 'dtc' ? 'file' : t[0] === 'pics' ? 'image' : 'camera', 'Add ' + (t[0] === 'dtc' ? 'DTC files' : t[1].toLowerCase()), function () { inp.click(); }));
  });
  var nn = 0; try { nn = trkNotesOf(RO).length; } catch (e) {}
  if (nn) { var nb = ropIb('note', nn + ' note' + (nn === 1 ? '' : 's') + ' on the truck', function () { try { trkInspOpen(RO); } catch (er) {} }, 'has-n'); nb.insertAdjacentHTML('beforeend', '<small class="rop-ibn">' + nn + '</small>'); adds.appendChild(nb); }
  adds.addEventListener('click', function (e) { e.stopPropagation(); });
  return ropSec('photos', 'Photos & codes', all.length ? all.length + ' file' + (all.length === 1 ? '' : 's') : '', body, adds);
}
function ropInbox() {
  var L = []; try { L = IB.store().items.filter(function (n) { return n.ro === RO.id; }).sort(function (a, b) { return new Date(b.at) - new Date(a.at); }); } catch (e) {}
  var box = el('div', { class: 'px-list' });
  L.slice(0, ROPU.msgAll ? 40 : 4).forEach(function (n) {
    box.appendChild(el('div', { class: 'px-li rop-ms', html: ropAv(n.from) + '<span><b>' + esc(ropFirst(n.from)) + ' → ' + esc(ropFirst(n.to)) + '</b><small>' + esc(n.q || n.b || n.t || '') + '</small></span><time>' + esc(ropAgo(n.at)) + '</time>' }));
  });
  if (!L.length) box.appendChild(ropNone('No messages about this RO yet.'));
  var body = [box];
  if (L.length > 4) body.push(el('div', { class: 'px-adds rop-more' }, [ropIb(ROPU.msgAll ? 'chevUp' : 'chevDn', ROPU.msgAll ? 'Show fewer' : 'Show all ' + L.length, function () { ROPU.msgAll = !ROPU.msgAll; render(); })]));
  var ppl = [[ropPerson('Foreman'), 'Foreman'], [ropPerson('Parts'), 'Parts'], [ropWriter() || RO.createdBy || '', 'Advisor'], [RO.assignedTech || '', 'Technician']].filter(function (x) { return x[0] && !ropIsMe(x[0]); });
  var seen = {}; ppl = ppl.filter(function (x) { var k = x[0].toLowerCase(); if (seen[k]) return false; seen[k] = 1; return true; });
  if (ppl.length) {
    if (!ROPU.msgTo || !ppl.some(function (x) { return x[0] === ROPU.msgTo; })) ROPU.msgTo = ppl[0][0];
    var to = el('div', { class: 'rop-to' }, [el('span', { text: 'To' })].concat(ppl.map(function (x) { return el('button', { class: ROPU.msgTo === x[0] ? 'is-on' : '', type: 'button', html: esc(ropFirst(x[0])) + '<small>' + x[1] + '</small>', onClick: function (e) { e.stopPropagation(); ROPU.msgTo = x[0]; render(); } }); })));
    var inp = el('input', { class: 'rop-in__i', placeholder: 'Message about ' + (RO.roNumber || 'this RO') + '… Enter sends it', 'aria-label': 'Message' });
    inp.addEventListener('keydown', function (e) {
      e.stopPropagation(); if (e.key !== 'Enter' || !inp.value.trim()) return; e.preventDefault();
      var job = S.jobs.filter(function (j) { return j.id === S.ui.card; })[0] || null, who = ROPU.msgTo;
      if (ropNote(who, 'men', job, ropFirst(ropMe()) + ' wrote about ' + ropNo(), (RO.customerName || '') + (job ? ' · Op ' + ropN(job) + ' — ' + (job.complaint || '') : ''), inp.value.trim())) { toast('Sent to ' + ropFirst(who) + ' — it’s under Messages on this RO.'); render(); requestAnimationFrame(function () { var i2 = R.querySelector('.rop-k-inbox .rop-in__i'); if (i2) i2.focus(); }); }
    });
    body.push(to, el('label', { class: 'rop-in' }, [el('span', { html: ri('send', 14) }), inp]));
  }
  return ropSec('inbox', 'Messages about this RO', L.length ? String(L.length) : '', body);
}
function ropOpenRo(id) { UI.view = 'ros'; UI.selectedRo = id; UI.modal = null; tecRender(); }
function ropHistory() {
  var vin = String(RO.vin || '').trim(), unit = String(RO.unitNumber || '').trim();
  var L = STATE.ros.filter(function (x) { return x.id !== RO.id && !x.shop && x.id !== SHOP_RO_ID && ((vin && String(x.vin || '').trim() === vin) || (!vin && unit && String(x.unitNumber || '').trim() === unit && x.customerName === RO.customerName)); }).sort(function (a, b) { return new Date(b.dateOpened || 0) - new Date(a.dateOpened || 0); });
  var keys = {}; ropLive().forEach(function (op) { var k = op.complaint && fixKeyOf(op.complaint); if (k) keys[k] = 1; (op.faults || []).forEach(function (f) { keys['fc:' + fcLabel(f)] = 1; }); });
  var box = el('div', { class: 'px-list' });
  L.slice(0, ROPU.histAll ? 20 : 5).forEach(function (x) {
    var ops = []; try { ops = raLive(x); } catch (e) {}
    var b = 0; ops.forEach(function (op) { try { b += opCalc(op).burntHrs; } catch (e) {} });
    var same = ops.some(function (op) { return (op.complaint && keys[fixKeyOf(op.complaint)]) || (op.faults || []).some(function (f) { return keys['fc:' + fcLabel(f)]; }); });
    box.appendChild(el('button', { class: 'px-li rop-hr', type: 'button', title: 'Open ' + roLabel(x), onClick: function (e) { e.stopPropagation(); ropOpenRo(x.id); },
      html: '<span class="px-id">' + esc(tgNum(x)) + '</span><span><b>' + esc((ops[0] || {}).complaint || '—') + (ops.length > 1 ? ' <em>+' + (ops.length - 1) + '</em>' : '') + '</b><small>' + (x.dateOpened ? esc(ropDay(x.dateOpened)) + ' · ' : '') + (roIsDone(x) ? 'done' : 'open') + ' · ' + ropH1(b) + ' h</small></span>' + (same ? '<span class="rop-tag w">same problem</span>' : '<span></span>') }));
  });
  if (!L.length) box.appendChild(ropNone('First visit for this truck in Parsec.'));
  var body = [box]; if (L.length > 5) body.push(el('div', { class: 'px-adds rop-more' }, [ropIb(ROPU.histAll ? 'chevUp' : 'chevDn', ROPU.histAll ? 'Show fewer' : 'Show all ' + L.length, function () { ROPU.histAll = !ROPU.histAll; render(); })]));
  return ropSec('history', 'Truck history', L.length ? (unit ? 'Unit ' + unit + ' · ' : '') + L.length + ' visit' + (L.length === 1 ? '' : 's') : '', body);
}
function ropWarranty() {
  var L = []; try { L = wcOps(RO); } catch (e) {} if (!L.length) return null;
  var box = el('div', { class: 'px-list' });
  L.forEach(function (op) {
    var s = '', st = { l: '', i: 0 }; try { s = wcStatus(RO, op); st = WC_ST[s] || { l: s, i: 0 }; } catch (e) {}
    var trk = WC_STAGES.map(function (g, i) { return '<span class="' + (i < st.i ? 'd' : i === st.i ? 'n' : '') + '"><i></i>' + esc(g[1]) + '</span>'; }).join('');
    box.appendChild(el('div', { class: 'px-li rop-wa', html: '<div class="h"><b>Op ' + ropN(op) + ' · ' + esc(op.complaint || '') + '</b><span class="rop-tag' + (st.i >= 3 ? ' g' : st.i >= 1 ? ' a' : '') + '">' + esc(st.l || s) + '</span></div><div class="rop-wst">' + trk + '</div>' }));
  });
  var go = el('button', { class: 'px-btn px-btn--ghost px-btn--sm rop-go', type: 'button', html: pxI('warranty', 14) + 'Open in Warranty', onClick: function (e) { e.stopPropagation(); UI.view = 'warranty'; UI.wxRo = RO.id; UI.modal = null; tecRender(); } });
  return ropSec('warranty', 'Warranty claim', L.length + ' operation' + (L.length === 1 ? '' : 's'), [box], go);
}
function ropCustomer() {
  var c = RO.customerName || '', mine = STATE.ros.filter(function (x) { return c && x.customerName === c && !x.shop && x.id !== SHOP_RO_ID; }), open = mine.filter(function (x) { return x.id !== RO.id && !roIsDone(x); });
  var ct = (RO.contacts || []).slice(-1)[0];
  var warr = pxToggle(!!RO.warranty, function (v) { pushUndo('warranty RO'); RO.warranty = v; save(true); render(); tecRender(); }, 'Warranty RO');
  var props = el('div', { class: 'rop-props' }, [
    pxProp('Customer', c || 'Add customer', { empty: !c, edit: pxField2('customerName') }),
    pxProp('Cust #', RO.custNo || 'Add', { id: !!RO.custNo, empty: !RO.custNo, edit: pxField2('custNo') }),
    pxProp('Case #', RO.caseNumber || 'Add case', { id: !!RO.caseNumber, empty: !RO.caseNumber, copy: RO.caseNumber || null, edit: pxField2('caseNumber') }),
    pxProp('PO #', RO.poNumber || 'Add PO', { id: !!RO.poNumber, empty: !RO.poNumber, edit: pxField2('poNumber') }),
    pxProp('Auth #', RO.authNumber || 'Add auth', { id: !!RO.authNumber, empty: !RO.authNumber, edit: pxField2('authNumber') }),
    pxProp('Tech support', RO.techSupportCase || 'Add case', { id: !!RO.techSupportCase, empty: !RO.techSupportCase, edit: pxField2('techSupportCase') }),
    pxProp('Warranty RO', warr)]);
  var body = [props, el('div', { class: 'rop-cu', html: '<small>' + mine.length + ' RO' + (mine.length === 1 ? '' : 's') + ' in Parsec' + (open.length ? ' · ' + open.length + ' other open' : '') + '</small>' + (ct ? '<small>Last contact: ' + esc(ct.kind || 'Contact') + (ct.out ? ' — ' + esc(ct.out) : '') + (ct.note ? ' · ' + esc(ct.note) : '') + ' · ' + esc(ropAgo(ct.at)) + '</small>' : '') })];
  if (open.length) { var box = el('div', { class: 'px-list' }); open.slice(0, 3).forEach(function (x) { box.appendChild(el('button', { class: 'px-li rop-hr', type: 'button', title: 'Open ' + roLabel(x), onClick: function (e) { e.stopPropagation(); ropOpenRo(x.id); }, html: '<span class="px-id">' + esc(tgNum(x)) + '</span><span><b>' + (x.unitNumber ? 'Unit ' + esc(x.unitNumber) + ' · ' : '') + esc(roStatus(x).status) + '</b><small>' + esc(((raLive(x)[0]) || {}).complaint || '') + '</small></span><span></span>' })); }); body.push(box); }
  return ropSec('customer', 'Customer', '', body);
}
function ropEstimate() {
