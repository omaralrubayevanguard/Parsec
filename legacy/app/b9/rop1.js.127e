  C.forEach(function (c) { var b = el('button', { class: 'px-li rop-ck' + (c.ok ? ' is-ok' : ''), type: 'button', html: (c.ok ? pxI('check', 14) : '<i></i>') + '<span><b>' + esc(c.t) + '</b><small>' + esc(c.d || '') + '</small></span>' });
    if (c.op) b.addEventListener('click', function (e) { e.stopPropagation(); pxGoto(c.op.id, c.k === 'parts' ? 'parts' : 'time'); }); else b.disabled = true;
    box.appendChild(b); });
