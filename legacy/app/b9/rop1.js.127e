  return ropSec('estimate', 'Estimate & approval', '', [el('div', { class: 'rop-es', html: rows + '<span class="t">Total</span><b class="t">' + esc(pxMoney(M.total)) + '</b>' }), foot]);
}
function ropReady() {
  var C = []; try { C = tyCloseChecks(RO); } catch (e) {} if (!C.length) return null;
  var ok = C.filter(function (c) { return c.ok; }).length, box = el('div', { class: 'px-list rop-rd' });
