  function vRet(){
    const fl = U.rflt, L = retStore().filter(t => fl === 'all' || t.kind === fl);
    const G = [['todo', 'To do', t => needs(t)], ['hold', 'Holding for Volvo', t => t.st === 'hold' && !needs(t)], ['cr', 'Shipped — credit due', t => t.st === 'shipped' && t.kind !== 'warranty'], ['done', 'Done', t => ['credited', 'scrapped', 'back'].includes(t.st) || (t.st === 'shipped' && t.kind === 'warranty')]];
    const due = retStore().filter(t => t.kind !== 'warranty' && ['ra', 'ship', 'shipped'].includes(t.st)).reduce((s, t) => s + (+t.credit || 0), 0);
    const row = t => { const a = retAct(t), r = t.ro && getRO(t.ro);
      return `<div class="pt-rr${U.rsel === t.id ? ' hl' : ''}" data-tid="${t.id}"><span class="m">${esc(t.id)}</span><span class="d"><b>${esc(t.desc)}${t.qty > 1 ? ' × ' + t.qty : ''}</b><small>${esc(t.pn)} · shelf ${esc(t.shelf)}</small></span><span><span class="pt-kind ${t.kind}">${KIND[t.kind]}</span></span><span class="d"><b>${r ? `<span class="tg-no">${esc(tgNum(r))}</span> ${esc(r.customerName || '')}` : 'Stock'}</b><small>${esc(t.why)}</small></span><span class="d"><b>${esc(t.to)}</b><small>${t.ra ? 'RA ' + esc(t.ra) : t.kind === 'warranty' ? 'claim ' + esc(t.claim || '—') : t.kind === 'core' ? 'no RA needed' : 'no RA yet'}</small></span><span class="dt${retLate(t) ? ' late' : ''}">${t.st === 'credited' ? 'credited ' + esc(t.credited || '') : t.shipped && t.st !== 'ship' ? 'shipped ' + esc(String(t.shipped).split(' · ')[0]) : t.by ? (t.st === 'hold' ? 'hold until ' : 'by ') + short(t.by) : '—'}</span><span class="m r">${t.credit ? usd(t.credit) : '—'}</span><span><span class="pt-st ${rstCls(t)}" style="cursor:default"><i></i>${rstTxt(t)}</span></span><span class="ac">${a ? `<button class="btn btn-sm" data-a="rdo" data-tid="${t.id}">${a[1]}</button>` : r ? `<button class="btn btn-sm tg-gh" data-a="open" data-ro="${t.ro}" data-k="ro">Open RO</button>` : ''}</span></div>`; };
    const tbl = G.map(g => { const X = L.filter(g[2]); if(!X.length) return ''; return `<div class="pt-tg${g[0] === 'todo' ? ' late' : ''}">${g[1]}<span>${X.length}</span></div>${X.map(row).join('')}`; }).join('') || '<div class="pt-none">No returns yet. Start one when a part goes back — warranty, a core or a supplier return.</div>';
    const n = k => retStore().filter(t => k === 'all' || t.kind === k).length;
    return `<div class="pt-full pg-scroll"><div class="pt-fh"><h2>Returns</h2><span class="tg-hf" style="cursor:default">Parts runs every return — warranty, cores and supplier returns. Warranty sees its own on the claim.</span><span class="sp"></span><button class="btn btn-sm btn-primary" data-a="pop" data-p="newret">${ic('plus', 14)}Start a return</button></div>
     <div class="pt-cbar"><span class="tg-seg3">${[['all', 'All'], ['warranty', 'Warranty'], ['core', 'Cores'], ['supplier', 'Supplier']].map(x => `<button class="${U.rflt === x[0] ? 'on' : ''}" data-a="rflt" data-v="${x[0]}">${x[1]} · ${n(x[0])}</button>`).join('')}</span><span class="sp"></span><div class="pt-sum" style="margin:0"><span class="warn"><b>${retStore().filter(needs).length}</b>to do</span><span><b>${usd0(due)}</b>credit coming back</span><span><b>${retStore().filter(t => t.st === 'hold').length}</b>held for Volvo</span></div></div>
     ${riskCard()}<div class="pt-tbl"><div class="pt-rr h"><span>Tag</span><span>Part</span><span>Kind</span><span>RO · why</span><span>Back to</span><span>Due</span><span class="r">Credit</span><span>Status</span><span></span></div>${tbl}</div></div>`;
  }
  function vSetup(){
    const S_ = [
      ['Suppliers', 'Where parts come from, when to order, when they land', [['sup_pdc', 'Volvo PDC · stock order', 'Order by 15:00 · next business day 07:00'], ['sup_vor', 'Volvo PDC · rush (VOR)', 'Order by 17:00 · next morning 07:00'], ['sup_fp', 'FleetPride', 'Order by 12:00 · same day 16:00']]],
      ['Deliveries', 'When trucks come in and receiving is open', [['del_pdc', 'Volvo PDC trucks', '07:00 and 15:00'], ['del_rcv', 'Receiving hours', '06:30 – 17:00']]],
      ['Bins and shelves', 'What the Shelf view and the Returns tags use', [['bin_a', 'Staging bins', 'A1 – A8'], ['bin_w', 'Warranty return shelves', 'W1 – W6'], ['bin_k', 'Core shelves', 'K1 – K4'], ['bin_r', 'Supplier return shelves', 'R1 – R4']]],
      ['Returns', 'Parts runs every return', [['ret_hold', 'Hold a failed part for Volvo', '30 days'], ['ret_core', 'Send a core back within', '30 days'], ['ret_fee', 'Supplier restocking fee', '15%'], ['ret_cr', 'Credit should land within', '14 days']]]
    ];
    const card = s => `<div class="pt-set"><div class="pt-seth"><b>${s[0]}</b>${s[1] ? `<small>${s[1]}</small>` : ''}</div>${s[2].map(x => { const v = set()[x[0]]; return `<label class="pt-setr"><span>${x[1]}</span><input data-in="set" data-k="${x[0]}" placeholder="${esc(x[2])}" value="${esc(v || '')}"><span class="pt-ph${v ? ' set' : ''}">${v ? 'set' : 'default'}</span></label>`; }).join('')}</div>`;
    const RL = [['approval', 'Approval done', 'Parts', 'the writer is asked first'], ['parts', 'All parts received', 'Foreman', 'Parts is asked first']];
    const rules = `<div class="pt-set"><div class="pt-seth"><b>Hand-off rules</b><small>Parts sits between the writer and the foreman · the same rules as Settings → Hand-offs</small></div>${RL.map(x => { const rl = rtCfg().rules.find(y => y.k === x[0]) || {}; return `<div class="pt-setr"><span>${x[1]} → ${x[2]}<small>${x[3]}</small></span><span class="tg-seg3">${[['ask', 'Ask first'], ['auto', 'Automatic'], ['off', 'Off']].map(m => `<button class="${rl.mode === m[0] ? 'on' : ''}" data-a="rulem" data-k="${x[0]}" data-v="${m[0]}">${m[1]}</button>`).join('')}</span><span class="pt-ph set">${esc(rl.mode || '')}</span></div>`; }).join('')}</div>`;
    return `<div class="pt-full pg-scroll"><div class="pt-fh"><h2>Parts setup</h2><span class="tg-hf" style="cursor:default">Grey text is the default — type the real value over it.</span><span class="sp"></span><button class="btn btn-sm" data-a="view" data-v="desk">Done</button></div><div class="pt-setg"><div>${card(S_[0])}${card(S_[1])}${rules}</div><div>${card(S_[2])}${card(S_[3])}</div></div></div>`;
  }
  function askCard(){ const L = (U.ask || []).map(get).filter(r => r && stateOf(r) === 'in' && !rcvd(r).length); if(!L.length) return '';
    return `<div class="pt-ask"><div class="h"><span class="i">${ic('swap', 15)}</span><span><b>${L.length === 1 ? `${esc(L[0].no)} has every part` : `${L.length} ROs have every part`}</b><small>All parts received → Foreman asks first</small></span></div>${L.map(r => `<div class="r"><b class="tg-no">${esc(r.no)}</b><span>${esc(r.cust)} · bin ${esc(binOf(r) || '—')}</span><button class="btn btn-sm${L.length === 1 ? ' btn-primary' : ''}" data-a="asksend" data-ro="${r.id}">Send to ${esc(fm())}</button></div>`).join('')}<div class="a"><button class="btn btn-sm tg-gh" data-a="askno">Not yet</button>${L.length > 1 ? `<button class="btn btn-sm btn-primary" data-a="askall">${L.length === 2 ? 'Send both' : 'Send all ' + L.length} to ${esc(fm())}</button>` : ''}</div></div>`; }
  /* usually goes with this job: parts used on past jobs with the same complaint */
  function suggest(r){ const out = [], have = new Set(lines(r).map(p => invPnKey(p.pn)));
    r.ops.forEach(o => { const key = invDescKey(o.cmp); if(!key) return; const past = [];
      STATE.ros.forEach(ro => { if(ro.id === r.id) return; (ro.operations || []).forEach(op => { if(invDescKey(op.complaint) === key && opRealParts(op).length && opDoneNow(op)) past.push(op); }); });
      const last = past.slice(-5); if(last.length < 2) return; const cnt = {};
      last.forEach(op => new Set(opRealParts(op).map(p => invPnKey(p.partNumber))).forEach(k => { if(k) cnt[k] = (cnt[k] || 0) + 1; }));
      Object.keys(cnt).forEach(k => { if(have.has(k) || cnt[k] < 2) return; const src = last.flatMap(op => opRealParts(op)).find(p => invPnKey(p.partNumber) === k); out.push({ op: o, pn: src.partNumber, desc: src.description, n: cnt[k], of: last.length, price: priceOf(src.price), qty: src.qty || '1' }); }); });
    return out; }
  function extraCards(r){ const st = stateOf(r); let h = '';
    if(st === 'counter'){ const a = counterAsk(r); h += `<div class="pt-msg">${PG.av(a.from, 'md')}<div class="bd"><div class="hd"><b>${esc(a.from)}</b><span>asked ${esc(tm(a.at))}</span>${r.spot !== '—' ? `<span class="tg-spot${r.bay ? ' bay' : ''}">${ic('pin', 11)}${esc(r.spot)}</span>` : ''}<span class="tg-late">waiting ${PG.ageW(Date.now() - new Date(a.at))}</span></div><p>${esc(a.q || a.t)}</p>${a.b ? `<div class="mt">${esc(a.b)}</div>` : ''}</div></div>`; }
    const sg = (st === 'order' || st === 'sent' || st === 'quiet') && !U.sg[r.id] ? suggest(r) : [];
    if(sg.length) h += `<div class="pt-sug"><div class="h">${ic('history', 14)}<b>Usually goes with this job</b><small>same complaint on past ROs</small><span class="sp"></span><button class="btn btn-sm tg-gh" data-a="sgno" data-ro="${r.id}">Not needed</button>${sg.length > 1 ? `<button class="btn btn-sm" data-a="sgall" data-ro="${r.id}">Add ${sg.length === 2 ? 'both' : 'all ' + sg.length}</button>` : ''}</div>${sg.map((x, i) => { const c = cat(x.pn) || {}; return `<div class="r"><span class="d"><b>${esc(x.desc)}</b><small>${esc(x.pn)}</small></span><span class="u" data-tip="${esc(x.desc)}|Used on ${x.n} of the last ${x.of} jobs like this"><i style="width:${x.n / x.of * 100}%"></i></span><span class="uc">${x.n} of ${x.of} jobs</span><span class="s">${c.oh ? c.oh + ' on hand' + (c.bin ? ' · ' + esc(c.bin) : '') : 'none on hand'}</span><span class="pr">${usd(x.price)}</span><button class="btn btn-sm" data-a="sgadd" data-ro="${r.id}" data-i="${i}">${ic('plus', 13)}Add</button></div>`; }).join('')}</div>`;
    return h; }
  function stockCards(){ const C = catAll(), low = C.filter(c => c.min && c.oh < c.min), mx = c => c.min * 2, tot = low.reduce((s, c) => s + (mx(c) - c.oh) * c.price, 0);
    const shelves = [...new Set(C.map(c => (c.bin || '')[0]).filter(Boolean))].sort(), day = Math.floor(Date.now() / 86400000), sh = shelves.length ? shelves[day % shelves.length] : null, cnt = sh ? C.filter(c => (c.bin || '')[0] === sh) : [];
    const so = set().soSent && localDay(set().soSent) === TODAY() ? set().soSent : null, counted = set().counted && set().counted.day === TODAY() ? set().counted : null;
    return `<div class="pt-cgrid"><div class="pt-reo pt-tbl"><div class="pt-ch"><b>Next stock order</b><small>${esc(supName('pdc'))} · back up to max (twice the min)</small><span class="sp"></span>${so ? `<span class="pt-st in" style="cursor:default"><i></i>Sent ${esc(tm(so))}</span>` : low.length ? `<button class="btn btn-sm btn-primary" data-a="sosend">Send · ${usd0(tot)}</button>` : ''}</div><div class="pt-rl h"><span>Part</span><span class="r">On hand / min</span><span class="r">Order</span><span class="r">Cost</span></div>${low.map(c => `<div class="pt-rl"><span class="d"><b>${esc(c.desc)}</b><small>${esc(c.pn)}${c.bin ? ' · ' + esc(c.bin) : ''}</small></span><span class="oh low">${c.oh} / ${c.min}</span><span class="q">+${mx(c) - c.oh}</span><span class="m r">${usd((mx(c) - c.oh) * c.price)}</span></div>`).join('') || '<div class="pt-none">Nothing below its min. Set a min on a part in the catalog to keep it stocked.</div>'}<div class="pt-cf">${ic('info', 12)}A part joins this order by itself when it drops below its min.</div></div>
    <div class="pt-cnt pt-tbl"><div class="pt-ch"><b>Count today${sh ? ' · shelf ' + esc(sh) : ''}</b><small>one shelf a day · every shelf in turn</small><span class="sp"></span>${counted ? `<span class="pt-st in" style="cursor:default"><i></i>Counted ${esc(tm(counted.at))}</span>` : cnt.length ? `<button class="btn btn-sm" data-a="ccsave" data-sh="${esc(sh)}">Save count</button>` : ''}</div><div class="pt-rl h"><span>Part</span><span class="r">Parsec says</span><span class="r">Counted</span><span class="r"></span></div>${cnt.map(c => { const v = U.cc[c.id], d = v === '' || v == null ? null : (+v - c.oh); return `<div class="pt-rl"><span class="d"><b>${esc(c.desc)}</b><small>${esc(c.pn)} · ${esc(c.bin)}</small></span><span class="oh">${c.oh}</span><input class="pt-ccin" data-in="cc" data-id="${c.id}" value="${esc(v == null ? '' : v)}" placeholder="—"${counted ? ' disabled' : ''}><span class="dv${d == null ? '' : d ? ' off' : ' ok'}">${d == null ? '' : d === 0 ? 'matches' : (d > 0 ? '+' : '') + d}</span></div>`; }).join('') || '<div class="pt-none">Give parts a bin in the catalog to count them shelf by shelf.</div>'}<div class="pt-cf">${ic('info', 12)}A count that’s off fixes the on-hand number.</div></div></div>`; }
  function barcode(s){ let x = 8, h = ''; const W = []; for(const ch of s){ const c = ch.charCodeAt(0); W.push(1 + (c & 3), 1 + ((c >> 2) & 1), 1 + ((c >> 3) & 3), 1 + ((c >> 5) & 1)); }
    W.forEach((w, i) => { if(i % 2 === 0) h += `<rect x="${x}" y="0" width="${w * 1.6}" height="40"/>`; x += w * 1.6; });
    return `<svg class="pt-bc" viewBox="0 0 ${x + 8} 40" width="${x + 8}" height="40" preserveAspectRatio="none" aria-label="barcode ${esc(s)}">${h}</svg><div class="pt-bct">${esc(s)}</div>`; }
  function dueLines(){ const R = [], T = TODAY(); allLines().forEach(x => { if(x.q.st === 'Ordered' && (!x.q.eta || x.q.eta <= T || late(x.q))) R.push({ r: x.r, p: x.q }); else if(x.q.st === 'Backordered') R.push({ r: x.r, p: x.q }); }); return R; }
  function parseSlip(t){ const L = dueLines(); return String(t || '').split(/\n/).map(l => { const m = /([A-Z0-9][A-Z0-9\-]{4,})\b.*?(?:QTY|×|\bx)\s*(\d+)/i.exec(l); if(!m) return null; const k = invPnKey(m[1]); const hit = L.find(x => invPnKey(x.p.pn) === k), c = cat(m[1]); return { pn: m[1], q: +m[2], m: hit || null, stock: !hit && c ? c : null }; }).filter(Boolean); }
  function slipSel(p){ p.sel = {}; parseSlip(p.slip || '').forEach(x => { if(x.m) p.sel[x.m.p.id] = true; }); }
  function chkHead(p){ const seg = `<div class="pt-mode"><span class="tg-seg3"><button class="${p.mode !== 'slip' ? 'on' : ''}" data-a="cmode" data-v="scan">${ic('scan', 13)} Scan</button><button class="${p.mode === 'slip' ? 'on' : ''}" data-a="cmode" data-v="slip">${ic('file', 13)} Packing slip</button></span></div>`;
    if(p.mode !== 'slip') return seg + `<div class="pt-scan">${ic('scan', 16)}<input data-in="scan" placeholder="Scan or type a part #" value="${esc(p.q || '')}" autocomplete="off"><small>${kbd('↵')} ticks it</small></div>`;
    const R = parseSlip(p.slip || '');
    return seg + `<textarea data-in="slip" class="pt-slip" placeholder="Paste the packing slip here — part number and QTY on each line" spellcheck="false">${esc(p.slip || '')}</textarea>${R.length ? `<div class="pt-slr"><b>${R.filter(x => x.m).length} of ${R.length} lines match open orders</b>${R.map(x => `<span class="${x.m ? 'ok' : x.stock ? 'stk' : 'no'}">${ic(x.m ? 'check' : x.stock ? 'box' : 'x', 11)}${esc(x.pn)} × ${x.q} → ${x.m ? esc(x.m.r.no) : x.stock ? 'stock · ' + esc(x.stock.desc.toLowerCase()) : 'not on any order'}</span>`).join('')}</div>` : ''}`; }
  /* supplier on-time, from the orders Parsec has seen */
  function scores(){ const since = Date.now() - 90 * 86400000, S0 = {};
    STATE.ros.forEach(ro => (ro.operations || []).forEach(op => (op.parts || []).forEach(p => { if(!p.sup || p.sup === 'stock' || !p.ordAt || new Date(p.ordAt) < since) return; const s = S0[p.sup] || (S0[p.sup] = { n: 0, ok: 0, late: 0, dl: 0 });
      if(!p.rcvAt) return; s.n++; const prom = p.eta0 || p.eta; const lateD = prom ? Math.max(0, dd(prom, localDay(p.rcvAt))) : 0; if(lateD) { s.late++; s.dl += lateD; } else s.ok++; })));
    return S0; }
  function orderCards(){ const S0 = scores(), lateNow = k => allLines().filter(x => late(x.q) && x.q.sup === k).length;
    const rowsS = SUPK.map(k => { const s = S0[k] || { n: 0, ok: 0, late: 0, dl: 0 }; const pct = s.n ? Math.round(s.ok / s.n * 100) : null; return `<div class="pt-scr" data-tip="${esc(supName(k))}|${pct == null ? 'no deliveries yet' : pct + '% on time · ' + s.n + ' lines · ' + (s.late ? (s.dl / s.late).toFixed(1) : '0.0') + ' d late on average'}"><span class="n">${esc(supName(k))}</span><span class="bar"><i style="width:${pct || 0}%"></i></span><b>${pct == null ? '—' : pct + '%'}</b><span class="m">${s.late ? (s.dl / s.late).toFixed(1) : '0.0'} d late avg</span><span class="m">${s.n} lines</span><span class="ln">${lateNow(k) ? lateNow(k) + ' late now' : ''}</span></div>`; }).join('');
    const sc = `<div class="pt-sc pt-tbl"><div class="pt-ch"><b>Suppliers · last 90 days</b><small>on time = in by the day they promised</small></div>${rowsS}<div class="pt-cf">${ic('info', 12)}Built from the orders checked in here — it fills in as Parts uses Check in.</div></div>`;
    const held = rows().filter(r => r.bay && stateOf(r) === 'late'), BL = STATE.ptBayLog || {}, wk = [];
    for(let i = 4; i >= 0; i--){ const s = addD(TODAY(), -7 * i - ((dOf(TODAY()).getDay() + 6) % 7)); let n = 0; for(let d = 0; d < 7; d++) n += BL[addD(s, d)] || 0; wk.push([md(s), n]); }
    const mx = Math.max(1, ...wk.map(x => x[1]));
    const bd = `<div class="pt-bay pt-tbl"><div class="pt-ch"><b>Bays held for parts</b><small>${esc(fm())} sees it on the Floor · the manager sees the month</small></div><div class="pt-bayb"><div class="now">${held.map(r => { const p = lines(r).find(late); return `<div class="pt-bh"><span class="tg-spot bay">${ic('pin', 11)}${esc(r.spot)}</span><b>${esc(r.no)}</b><span>${esc(lc(p.desc))} ${late(p).t}</span></div>`; }).join('') || '<div class="pt-none">No bay is waiting on a part.</div>'}<div class="tot"><b>${wk.slice(-4).reduce((s, x) => s + x[1], 0)}</b>bay-days lost to parts · last 4 weeks</div></div><div class="pt-cols">${wk.map((x, i) => `<div class="c" data-tip="Week of ${x[0]}${i === wk.length - 1 ? ' · so far' : ''}|${x[1]} bay-day${x[1] === 1 ? '' : 's'} waiting on parts"><span class="v">${x[1]}</span><i style="height:${Math.round(x[1] / mx * 58)}px"${i === wk.length - 1 ? ' class="cur"' : ''}></i><small>${x[0]}</small></div>`).join('')}</div></div></div>`;
    return `<div class="pt-cgrid">${sc}${bd}</div>`; }
  function bayLog(){ const n = rows().filter(r => r.bay && stateOf(r) === 'late').length, BL = STATE.ptBayLog || (STATE.ptBayLog = {}); if((BL[TODAY()] || 0) < n){ BL[TODAY()] = n; persistLocal(); } }
  function riskCard(){ const wk = addD(TODAY(), 7);
    const items = retStore().filter(t => ['ship', 'ra', 'shipped'].includes(t.st)).map(t => ({ t, amt: t.kind === 'warranty' ? (+t.claimAmt || 0) : (+t.credit || 0), why: t.kind === 'warranty' ? `claim ${t.claim || '—'} — Volvo can charge it back if the part doesn’t ship` : t.st === 'shipped' ? `credit not in yet · shipped ${String(t.shipped || '').split(' · ')[0]}` : t.kind === 'core' ? 'core credit — lost if the core doesn’t go back' : t.st === 'ra' ? 'credit if the supplier takes it — no RA yet' : 'credit once it ships' })).filter(x => x.amt > 0).sort((a, b) => (a.t.by || '9') < (b.t.by || '9') ? -1 : 1);
    if(!items.length) return '';
    const sum = f => items.filter(f).reduce((s, x) => s + x.amt, 0);
    const tiles = [['Due back this week', sum(x => x.t.st !== 'shipped' && x.t.by && x.t.by <= wk), 'warn'], ['Shipped — credit not in', sum(x => x.t.st === 'shipped'), ''], ['Waiting on an RA', sum(x => x.t.st === 'ra'), '']];
    return `<div class="pt-risk pt-tbl"><div class="pt-ch"><b>Money at risk</b><small>owed back to us, and what’s lost if a part doesn’t go back</small></div><div class="pt-tiles">${tiles.map(x => `<div class="${x[2]}"><small>${x[0]}</small><b>${usd(x[1])}</b></div>`).join('')}</div>${items.slice(0, 4).map(x => { const a = retAct(x.t); return `<div class="pt-rk"><span class="dt${retLate(x.t) ? ' late' : ''}">${x.t.by && x.t.st !== 'shipped' ? short(x.t.by) : x.t.st === 'shipped' ? 'waiting' : 'no date'}</span><span class="m">${esc(x.t.id)}</span><span class="d"><b>${esc(x.t.desc)}</b><small>${esc(x.why)}</small></span><span class="m r">${usd(x.amt)}</span>${a ? `<button class="btn btn-sm" data-a="rdo" data-tid="${x.t.id}">${a[1]}</button>` : '<span></span>'}</div>`; }).join('')}</div>`; }
  function kitPrice(k){ return k.kids.reduce((s, x) => { const c = cat(x[0]); return s + ((c ? c.price : priceOf(x[2].price)) || 0) * x[1]; }, 0); }
  function vCat(){
    const C = catAll(), q = U.cq.trim().toLowerCase(), hay = c => [c.pn, c.desc, c.fit, c.bin].join(' ').toLowerCase();
    let L = C.filter(c => !q || hay(c).includes(q)); if(U.cflt === 'low') L = L.filter(c => c.min && c.oh < c.min);
    const K = kits(), KL = U.cflt === 'low' ? [] : K.filter(k => !q || [k.pn, k.desc, k.fit].join(' ').toLowerCase().includes(q) || k.kids.some(x => [x[0], x[2].desc].join(' ').toLowerCase().includes(q)));
    const nLow = C.filter(c => c.min && c.oh < c.min).length;
    const ed = (c, f, v, w, ph) => `<input class="pt-ced" data-in="cat" data-id="${c.id}" data-f="${f}" value="${esc(v)}" placeholder="${ph || ''}" style="width:${w}px" title="Click to change">`;
    const row = c => { const low = c.min && c.oh < c.min; return `<div class="pt-cr"><span></span><span class="d"><b>${esc(c.desc || '—')}</b>${low ? '<span class="pt-low">Low</span>' : ''}</span><span class="m">${esc(c.pn || '—')}</span><span class="oh${low ? ' low' : ''}">${ed(c, 'oh', c.oh, 34)}<span style="color:var(--tg-ink4);font-weight:400">/</span>${ed(c, 'min', c.min || '', 30, 'min')}</span><span class="m">${ed(c, 'bin', c.bin, 44, '—')}</span><span class="m r">${usd(c.price)}<span class="pt-cc2">${ed(c, 'cost', c.cost || '', 52, 'cost')}</span></span><span class="fit">${esc(c.fit)}</span><span class="ac">${low ? `<button class="btn btn-sm" data-a="reorder" data-id="${c.id}">Reorder</button>` : ''}</span></div>`; };
    const krow = k => { const o = U.kopen[k.id] === true; const ohs = k.kids.map(x => { const c = cat(x[0]); return c ? Math.floor(c.oh / x[1]) : 0; }); return `<div class="pt-cr"><button class="car${o ? ' open' : ''}" data-a="kit" data-id="${k.id}" title="Show the parts in this kit">${ic('chevR', 13)}</button><span class="d"><span class="pt-kitb">KIT · ${k.kids.length}</span><b>${esc(k.desc)}</b></span><span class="m">${esc(k.pn)}</span><span class="oh">${ohs.length ? Math.min(...ohs) : 0}</span><span class="m">—</span><span class="m r">${usd(kitPrice(k))}</span><span class="fit">${esc(k.fit)}</span><span class="ac"></span></div>` + (o ? k.kids.map(x => { const c = cat(x[0]); return `<div class="pt-cr kid"><span></span><span class="d"><b>${esc(c ? c.desc : x[2].desc)}</b><span style="color:var(--tg-ink3)">× ${x[1]}</span></span><span class="m">${esc(x[0] || '—')}</span><span class="oh">${c ? c.oh : 0}</span><span class="m">${esc(c && c.bin || '—')}</span><span class="m r">${usd(c ? c.price : priceOf(x[2].price))}</span><span class="fit">fits the kit</span><span></span></div>`; }).join('') : ''); };
    return `<div class="pt-full pg-scroll"><div class="pt-fh"><h2>Catalog</h2><span class="tg-hf" style="cursor:default">${C.length} parts · ${K.length} kits · what we stock, where it sits, what it costs</span><span class="sp"></span><button class="btn btn-sm" data-a="oldparts">${ic('sheet', 14)}Edit the full list</button></div>
     ${stockCards()}<div class="pt-cbar"><input data-in="cq" placeholder="Search part #, description, engine, bin…" value="${esc(U.cq)}"><span class="tg-seg3"><button class="${U.cflt === 'all' ? 'on' : ''}" data-a="cflt" data-v="all">All</button><button class="${U.cflt === 'low' ? 'on' : ''}" data-a="cflt" data-v="low">Low stock · ${nLow}</button></span><span class="sp"></span><small style="color:var(--tg-ink3)">On hand, min and bin change right in the row.</small></div>
     <div class="pt-tbl"><div class="pt-cr h"><span></span><span>Description</span><span>Part #</span><span class="r">On hand / min</span><span>Bin</span><span class="r">Price · cost</span><span>Fits</span><span></span></div>${KL.map(krow).join('')}${L.slice(0, 400).map(row).join('') || '<div class="pt-none">Nothing matches.</div>'}</div></div>`;
  }
