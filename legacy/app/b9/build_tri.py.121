# Parsec 12.1 — Triage: transfer one step at a time (department → employee → why → back by), the road test and the truck checks.
# The code: b9/tri1.js (top level, next to the Triage pop-overs); styles: b9/tri.css. Runs inside build12.py (uses js, rep, b9, EXTRA_CSS, LOG).

js = rep(js, "function tgPopHtml(){\n", b9("tri1.js") + "\nfunction tgPopHtml(){\n")

# Needs action: a Road test group and a Truck checks group, between the customers and Ready to go
js = rep(js, 'var TG_GROUPS = [["sent", "Sent to you"], ["cust", "Waiting on customers"], ["go", "Ready to go"], ["held", "Held too long"], ["in", "Coming in"]];',
         'var TG_GROUPS = [["sent", "Sent to you"], ["cust", "Waiting on customers"], ["road", "Road test"], ["checks", "Truck checks"], ["go", "Ready to go"], ["held", "Held too long"], ["in", "Coming in"]];')
js = rep(js, '    else if(c === "rdy") it = { g: "go"', '    else if((it = trxNeed(ro, c, lt, a))){}\n    else if(c === "rdy") it = { g: "go"')
# past back by: the red countdown on the row
js = rep(js, "+ '<button class=\"btn btn-sm' + (x.btn === \"Release\" ? ' btn-primary' : '') + ' tg-go\" data-action=\"tg-do\"",
         "+ trxPill(x) + '<button class=\"btn btn-sm' + (x.btn === \"Release\" ? ' btn-primary' : '') + ' tg-go\" data-action=\"tg-do\"")
js = rep(js, 'else if(x.act === "nudge")', 'else if(x.act === "road" || x.act === "checks") tgOpenPop(x.act, id); else if(x.act === "nudge")')

# the pop-overs
js = rep(js, 'if(type === "release") UI.tgRL = {}; if(type === "xfer") UI.tgXS = {};',
         'if(type === "release") UI.tgRL = {}; if(type === "xfer") UI.tgXS = {}; if(type === "road") UI.trxR = null; if(type === "checks") UI.trxQ = null;')
js = rep(js, '  else if(P.type === "xfer") h = tgXferPop(ro, head, style);',
         '  else if(P.type === "xfer") h = trxXferPop(ro, head, style);\n  else if(P.type === "road") h = trxRoadPop(ro, head, style);\n  else if(P.type === "checks") h = trxChecksPop(ro, head, style);')
_a0 = js.index('    case "tg-xf": { var X = UI.tgXS || (UI.tgXS = {}), f2 = t.dataset.f, v2 = t.dataset.v;')
_a1 = js.index('    case "tg-xf-go": tgXferGo(); return true;\n', _a0) + len('    case "tg-xf-go": tgXferGo(); return true;\n')
js = js[:_a0] + '''    case "tg-xf": trxXfSet(t.dataset.f, t.dataset.v); render(); return true;
    case "tg-xf-go": trxXferGo(); return true;
    case "tg-rt": trxRtSet(t.dataset.f, t.dataset.v); render(); return true;
    case "tg-rt-go": trxRtGo(t.dataset.v); return true;
    case "tg-qc": trxQcSet(t.dataset.f, t.dataset.v); render(); if(t.dataset.f === "edit" || t.dataset.f === "add") trxFocusAdd(); return true;
    case "tg-qc-go": { var r9 = tgRoById(id || (P && P.ro)); if(r9) tgOpenPop("release", r9.id); return true; }
''' + js[_a1:]
# keys: the transfer steps (1–9 picks, Enter next / send, Backspace a step back); Enter adds a walk-around check
_k0 = js.index('    if(P.type === "xfer"){\n      var X = UI.tgXS || {};\n      if(k === "Enter"){ tgXferGo(); return stop(); }')
_k1 = js.index('    /* menus: snooze, assign, check-in */', _k0)
js = js[:_k0] + '''    if(P.type === "xfer"){
      if(k === "Tab") return;
      if(k === "Enter"){ if(inF && t.type === "datetime-local") return; trxXferKey("Enter"); return stop(); }
      if(inF) return;
      trxXferKey(k); return stop();
    }
    if(P.type === "road" || P.type === "checks"){
      if(k === "Tab") return;
      if(P.type === "checks" && k === "Enter" && t.dataset && t.dataset.tgIn === "trx-qadd"){ trxQcSet("add"); render(); trxFocusAdd(); return stop(); }
      if(inF) return; return stop();
    }
''' + js[_k1:]
js = rep(js, '  if(k === "xf-note"){ (UI.tgXS || (UI.tgXS = {})).note = v; return; }',
         '  if(k === "xf-note"){ (UI.tgXS || (UI.tgXS = {})).note = v; return; }\n  if(/^trx-/.test(k)){ trxInput(k, v); trxSync(); return; }')

# the selected RO: Road test and Truck checks buttons; where they stand, and back by, in the thread
js = rep(js, '''<span class="sp"></span><button class="btn btn-sm" data-action="tg-pop" data-p="xfer" data-ro="' + ro.id + '">' + tgI("swap", 14) + 'Transfer…</button>''',
         '''<span class="sp"></span>' + trxBtns(ro) + '<button class="btn btn-sm" data-action="tg-pop" data-p="xfer" data-ro="' + ro.id + '">' + tgI("swap", 14) + 'Transfer…</button>''')
js = rep(js, "+ etaRow + tgApprCard(ro) + '</div>'", "+ etaRow + tgApprCard(ro) + trxCards(ro) + '</div>'")
# the Desk: the buttons in its head, and Road test… on the Ready to close card
js = rep(js, "'</span></div><h2>' + esc(ro.customerName || \"—\") + '</h2></div>'", "'</span></div><h2>' + esc(ro.customerName || \"—\") + '</h2><div class=\"trx-b\">' + trxBtns(ro) + '</div></div>'")
js = rep(js, """'<div class="tg-cl' + (c.ok ? ' ok' : '') + '"><i></i><span>' + esc(c.t) + '</span><small>' + esc(c.d) + '</small></div>'""",
         """'<div class="tg-cl' + (c.ok ? ' ok' : '') + '"><i></i><span>' + esc(c.t) + '</span><small>' + esc(c.d) + '</small>' + (c.k === "road" ? '<button class="tg-link" data-action="tg-pop" data-p="road" data-ro="' + ro.id + '">' + (c.ok ? 'Change' : 'Road test…') + '</button>' : '') + '</div>'""")

# Release: a failed road test isn't done; the truck checks are a line (open ones need a reason, like the rest); the links open the pop-overs
js = rep(js, '{ k: "road", t: "Road test done", ok: !!rt,', '{ k: "road", t: "Road test passed", ok: !!rt && rt.result !== "Fail",')
js = rep(js, '  if(gaps.length) L.push({ k: "gaps", ok: false, t: "Paperwork"', '  L.push(trxRelCheck(ro));\n  if(gaps.length) L.push({ k: "gaps", ok: false, t: "Paperwork"')
js = rep(js, """(c.k === "gaps" ? '<button class="tg-link" data-action="goto-ro" data-ro="' + ro.id + '">Open RO</button>' : '<button class="tg-link" data-action="tg-rl" data-f="fix" data-v="' + c.k + '">' + c.fix + '</button>')""",
         """(c.k === "gaps" ? '<button class="tg-link" data-action="goto-ro" data-ro="' + ro.id + '">Open RO</button>' : c.k === "road" || c.k === "qc" ? '<button class="tg-link" data-action="tg-pop" data-p="' + (c.k === "qc" ? 'checks' : 'road') + '" data-ro="' + ro.id + '">' + (c.k === "qc" ? 'Truck checks…' : 'Road test…') + '</button>' : '<button class="tg-link" data-action="tg-rl" data-f="fix" data-v="' + c.k + '">' + c.fix + '</button>')""")

# routing: a named person in any department, or the department's queue ("Anyone in Parts"); no accepting (the Manager can turn it back on)
js = rep(js, '  if(k === "tech" && who) ro.assignedTech = who;', '  if(k === "tech" && who && who !== "*") ro.assignedTech = who;')
js = rep(js, 'ro.route = { to: k, who: k === "tech" ? (who || ro.assignedTech || "") : "", by:',
         'ro.route = { to: k, who: who === "*" ? "" : k === "tech" ? (who || ro.assignedTech || "") : (who || ""), queue: who === "*", by:')
js = rep(js, '  return { to: r.to, who: r.who || "" };', '  return { to: r.to, who: r.who || "", q: !!r.queue };')
js = rep(js, 'function rtHolderName(h, ro){ return h.to === "tech" ? (h.who || (ro && ro.assignedTech) || "Technician") : (rtPerson(h.to) || RT_DEPT[h.to]); }',
         'function rtHolderName(h, ro){ if(h.q) return "Anyone in " + (TRX_DN[h.to] || RT_DEPT[h.to]); return h.to === "tech" ? (h.who || (ro && ro.assignedTech) || "Technician") : (h.who || rtPerson(h.to) || RT_DEPT[h.to]); }')
js = rep(js, 'function rtWhoText(ro){ var r = ro.route; if(!r) return ""; return r.to === "tech" ? (r.who || ro.assignedTech || "a technician") : (rtPerson(r.to) || RT_DEPT[r.to]); }',
         'function rtWhoText(ro){ var r = ro.route; if(!r) return ""; if(r.queue) return "anyone in " + (TRX_DN[r.to] || RT_DEPT[r.to]); return r.to === "tech" ? (r.who || ro.assignedTech || "a technician") : (r.who || rtPerson(r.to) || RT_DEPT[r.to]); }')
js = rep(js, '  if(c.needAccept === undefined) c.needAccept = true;',
         '  if(c.needAccept === undefined) c.needAccept = true;\n  if(!c.na121){ c.needAccept = false; c.na121 = 1; }   /* Parsec 12.1: it is theirs when you send it — Manager → hand-offs can turn accepting back on */')

# the truck checks are Triage's: the Foreman's QC group is off
js = rep(js, '&& fmQcApplies(ro)){', '&& fmQcApplies(ro) && !TRX_QC_TRIAGE){')
# the shop's walk-around list rides in the shop file
js = rep(js, '"truckPics", "truckPicsV"]', '"truckPics", "truckPicsV", "truckCheckList"]')

EXTRA_CSS.append(b9("tri.css"))
HOOK_NAMES += ["trxPeople", "trxQc", "trxRoadState", "trxNeed", "trxTechOf", "tgNeedsAll", "tgOpenPop", "rtHolder", "rtHolderName", "tgRelChecks"]
LOG.append("Triage: transfer step by step, the road test and the truck checks (b9/tri1.js)")
