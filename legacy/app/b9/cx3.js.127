  /* ---------- shop: the team now, and every open RO by stage ---------- */
  function vShop(){
    const B = boardOf(), T = teamOf(), L = B.filter(r => !U.mine || S.lead || techSame(r.tech, S.me));
    const wp = B.filter(r => roStatus(r.ro).status === 'Waiting – Parts'), bo = wp.filter(r => raLive(r.ro).some(op => opRealParts(op).some(p => p.status === 'Backordered'))).length;
    const wa = B.filter(r => roStatus(r.ro).status === 'Waiting – Customer'), oldest = wa.map(r => r.ro.status && r.ro.status.setAt).filter(Boolean).sort()[0];
    const cin = B.filter(r => r.ro.dateOpened && PG.isToday(r.ro.dateOpened)).length;
    const closed = STATE.ros.filter(r => roStatus(r).status === 'Complete – Released' && r.status && PG.isToday(r.status.setAt)).length;
    let q = 0, bb = 0; STATE.ros.forEach(r => raLive(r).forEach(op => { if(!opDoneNow(op)) return; const dp = opPunches(op.id).filter(p => p.stop && /^Complete/.test(p.stopReason || '')).slice(-1)[0]; if(dp && PG.isToday(dp.stop)){ q += +op.quoted || 0; bb += opCalc(op).burntHrs; } }));
    const effT = bb > 0.1 ? Math.round(q / bb * 100) : null, gC = STATE.goals && STATE.goals._shop && +STATE.goals._shop.closedDay;
    const tile = (l, v, s, cl) => `<div class="cx-kp"><small>${l}</small><b class="${cl || ''}">${v}</b><span>${s}</span></div>`;
    const tm = t => { const me = S.me && techSame(t.n, S.me); const st = t.st;
      return `<div class="cx-tm ${st}"><div class="h">${PG.av(t.n, 'md')}<span class="n"><b>${esc(t.n)}${me ? ' <small>you</small>' : ''}</b><small><span class="cx-dot ${st}"></span>${st === 'job' ? 'On ' + esc(t.no) + ' · <span data-tk="tm" data-since="' + t.since + '">' + dur((Date.now() - t.since) / 60000) + '</span>' : st === 'air' ? 'Not on a job · <span data-tk="tm" data-since="' + t.since + '">' + dur((Date.now() - t.since) / 60000) + '</span>' : st === 'shop' ? 'Shop time · ' + esc(t.cmp) : esc(t.txt)}</small></span></div>
        ${st === 'job' ? `<div class="w">${esc(t.cmp)}</div><div class="cx-mb"><i class="${sev(t.b - t.q)}" style="width:${t.q ? Math.min(100, t.b / t.q * 100).toFixed(1) : 0}%"></i></div><div class="f"><span>${h1(t.b)} of ${h1(t.q)} h</span><span>${t.day} today${t.eff != null ? ' · ' + t.eff + '%' : ''}</span></div>` : `<div class="w mute">${st === 'air' ? 'Last off a job at ' + clk(t.since) : st === 'shop' ? '—' : '—'}</div><div class="cx-mb"></div><div class="f"><span>${st === 'air' && S.lead ? `<button class="cr-add" style="margin:0" data-a="askwho" data-n="${esc(t.n)}">Ask ${esc(PG.first(t.n))}</button>` : ''}</span><span>${t.day} today${t.eff != null ? ' · ' + t.eff + '%' : ''}</span></div>`}</div>`; };
    return `<div class="mg-full"><div class="mg-sec">Team now<span>live · <span data-tk="clock">${clk(Date.now())}</span></span><span class="sp"></span><button class="btn btn-sm${U.hl === 'tvb' ? ' hl' : ''}" data-a="tv" title="For the TV on the shop floor">${ic('tv', 13)}Display mode</button></div><div class="cx-team${U.hl === 'team' ? ' hl' : ''}" data-sec="team">${T.map(tm).join('') || '<div class="mg-none">No technicians yet — add them under Manager → Staff.</div>'}</div>
      <div class="mg-sec">Shop today<span>${esc(PG.dayLong(Date.now()))} · the whole shop</span></div><div class="cx-kps">${tile('Open ROs', B.length, cin + ' checked in today')}${tile('On jobs now', T.filter(t => t.st === 'job').length + ' of ' + T.length, T.filter(t => t.st === 'air').length + ' not on a job', '')}${tile('Waiting on parts', wp.length, bo ? bo + ' backordered' : 'none backordered', wp.length ? 'w' : '')}${tile('Waiting approval', wa.length, oldest ? 'oldest ' + PG.ageW(Date.now() - new Date(oldest)) : '—', wa.length ? 'w' : '')}${tile('Closed today', closed, gC ? 'goal ' + gC : 'released today')}${tile('Shop efficiency', effT == null ? '—' : effT + '%', 'jobs finished today', effT == null ? '' : effT >= 100 ? 'ok' : effT < 85 ? 'w' : '')}</div>
      <div class="mg-card cx-board${U.hl === 'board' ? ' hl' : ''}" data-sec="board"><div class="mg-ch"><b>Repair orders</b><small>${L.length} open${U.mine && !S.lead ? ' · yours' : ''} · by stage</small><span class="sp"></span><span class="mg-leg"><span><i class="cx-l done"></i>Done</span><span><i class="cx-l work"></i>On it</span><span><i class="cx-l wait"></i>Waiting</span><span><i class="cx-l next"></i>Up next</span></span>${S.lead ? '' : `<span class="tg-seg3 cr-seg"><button class="${U.mine ? 'on' : ''}" data-a="mine" data-v="1">Mine</button><button class="${U.mine ? '' : 'on'}" data-a="mine" data-v="0">All</button></span>`}</div><div class="mg-cb">
       <div class="cx-bh"><span>RO</span><span>Customer</span><span class="sg">${STG.map(s => `<span>${s}</span>`).join('')}</span><span>Where it is</span><span>Tech</span><span>Days</span></div>
       ${L.map(r => `<button class="cx-br" data-a="openro" data-ro="${r.id}"><span class="tg-no">${esc(r.no)}</span><b>${esc(r.cust)}</b><span class="sg">${STG.map((s, i) => { const cs = r.cells[i]; return `<i class="${cs === 'd' ? 'done' : cs === 'x' ? 'skip' : i === r.stage ? r.state : ''}" title="${s}${cs === 'x' ? ' — not needed' : ''}"></i>`; }).join('')}</span><span class="lb ${r.state}">${esc(r.label)}</span><span class="tk">${r.tech ? `${PG.av(r.tech)}${esc(PG.first(r.tech))}` : '<em>Not assigned</em>'}</span><span class="d">${r.days}</span></button>`).join('') || '<div class="mg-none">No open repair orders.</div>'}</div></div></div>`;
  }
  /* air-time nudge */
  function nudge(){ if(S.rp || S.out || airNow() < 10) return ''; const n = nextOps()[0];
    return `<div class="cx-nudge">${ic('clock', 15)}<span><b>Not on a job · <em data-tk="air">${dur(airNow())}</em></b>Air time counts against your efficiency — pick the next one or start shop time.</span>${n ? `<button class="btn btn-sm btn-primary" data-a="startid" data-id="${n.id}">${ic('play', 13)}${n.paused ? 'Resume' : 'Start'} ${esc(n.no)}</button>` : ''}<button class="btn btn-sm" data-a="shopt" data-id="${shopRo().operations[0].id}">Shop time</button></div>`; }
  /* photos and codes — the RO's bulletins */
  function photoCard(o, s){
    const a = o.ph, files = t => (o.ro.bulletins || []).filter(e => e.task === t).reduce((L, e) => L.concat(e.files || []), []);
    const th = n => Array.from({ length: Math.min(n, 4) }, (_, i) => `<i class="cx-th t${i % 4}"></i>`).join('');
    const dash = files('dashpic'), dt = files('dtc');
    const tile = (k, task, title, have, sub, btn) => `<div class="cx-pt${have ? ' ok' : ''}"><div class="h"><b>${title}</b>${have ? `<span class="ib-k auto">${ic('check', 11)}${esc(sub)}</span>` : '<small>not yet</small>'}</div><div class="th">${k === 'dtc' ? (have ? `<span class="cx-dtc">${ic('file', 14)}${esc((dt[dt.length - 1] || {}).name || 'DTC file')}</span>` : '') : th(k === 'dash' ? (have ? 1 : 0) : a[1])}</div>${s === 'done' ? '' : `<button class="btn btn-sm" data-a="ph" data-k="${task}">${ic(k === 'dtc' ? 'plus' : 'camera', 13)}${btn}</button>`}</div>`;
    return `<div class="mg-card cx-ph${U.hl === 'photos' ? ' hl' : ''}" data-sec="photos"><div class="mg-ch"><b>Photos &amp; codes</b><small>the RO’s bulletins — no need to open it</small></div><div class="mg-cb"><div class="cx-tiles">${tile('dash', 'dashpic', 'Dash picture', a[0] > 0, dash.length ? String(dash[dash.length - 1].ts || '').slice(-8, -3) || 'on the RO' : '', a[0] ? 'Retake' : 'Take it')}${tile('pics', 'pics', 'Pictures', a[1] > 0, a[1] + ' on the RO', 'Add photos')}${tile('dtc', 'dtc', 'DTCs', a[2] > 0, a[2] + ' file' + (a[2] === 1 ? '' : 's'), 'Upload DTCs')}</div></div></div>`;
  }
  /* start my day */
  function morningCard(){
    const fm = PG.person('Foreman'), fmF = fm ? PG.first(fm) : 'The foreman';
    const order = typeof fmUpNext === 'function' ? fmUpNext(S.me) : [];
    const firstOp = ro => raLive(ro).filter(op => !opDoneNow(op))[0];
    const rows = order.slice(0, 4).map(ro => ({ ro, op: firstOp(ro) })).filter(x => x.op);
    const q = sum(rows, x => +x.op.quoted || 0), more = Math.max(0, order.length - rows.length);
    const mine = STATE.ros.filter(r => !r.shop && r.id !== SHOP_RO_ID && !roIsDone(r) && techSame(r.assignedTech, S.me));
    const staged = mine.filter(r => raLive(r).some(op => opRealParts(op).some(p => p.status === 'Staged' || p.status === 'Received')));
    const bays = mine.filter(r => bayLike(r.location));
    const waiting = S.ops.filter(o => o.st === 'wait').length, nIb = typeof IB !== 'undefined' ? IB.count(S.me) : 0, tdate = PG.dayLong(Date.now());
    const note = STATE.fmNote && STATE.fmNote.d === todayStr() && STATE.fmNote.text ? STATE.fmNote : null;
    const ty2 = op => TYPE[opJobType(op)] || TYPE.OP;
    const first = rows[0];
    return `<div class="mg-pane"><div class="cx-morn"><small>${esc(tdate)} · ${clk(Date.now())}</small><h2>Good ${new Date().getHours() < 12 ? 'morning' : new Date().getHours() < 17 ? 'afternoon' : 'evening'}, ${esc(PG.first(S.me))}</h2><p>${order.length ? esc(fmF) + ' has your order ready. Here’s the day before you clock in.' : 'Here’s the day before you clock in.'}</p>
      ${note ? `<div class="cx-why" style="margin-bottom:12px">${ic('chat', 13)}<span><b>From ${esc(note.by || fmF)}:</b> ${esc(note.text)}</span></div>` : ''}
      <div class="cx-mg"><div><small>${esc(fmF)}’s order</small><b>${order.length} job${order.length === 1 ? '' : 's'}</b><span>${rows.length ? h1(q) + ' h in the first ' + rows.length : 'nothing yet'}</span></div><div><small>Parts in for you</small><b>${staged.length}</b><span>${staged.length ? 'at the counter' : 'none waiting'}</span></div><div><small>Trucks in your bays</small><b>${bays.length}</b><span>${esc(bays.map(r => r.location).slice(0, 3).join(' · ') || '—')}</span></div><div><small>Waiting</small><b>${waiting}</b><span>parts, approval, support</span></div><div><small>Inbox</small><b>${nIb}</b><span>for you</span></div></div>
      ${rows.length ? `<div class="mg-card"><div class="mg-ch"><b>First up</b><small>in ${esc(fmF)}’s order</small><span class="sp"></span>${more ? `<small>+${more} more after these</small>` : ''}</div><div class="mg-cb">${rows.map((x, i) => { const st = opRealParts(x.op).some(p => p.status === 'Staged') ? 'Parts staged' : ''; return `<div class="cx-mo"><span class="cx-n">${i + 1}</span><span class="tg-no">${esc(tgNum(x.ro))}</span><span class="n"><b>${esc(x.ro.customerName || '')}</b><small><span class="cr-ty ${ty2(x.op)[1]}">${ty2(x.op)[0]}</span>${esc(x.op.complaint || '')}</small></span><span class="lc">${esc(x.ro.location || '—')}</span>${st ? `<span class="cx-ps st"><i></i>${st}</span>` : '<span></span>'}<span class="q">${h1(+x.op.quoted || 0)} h</span></div>`; }).join('')}</div></div>` : ''}
      <div class="cx-mact"><button class="btn btn-primary" data-a="morning">${ic('play', 15)}Start my day</button><span>Clocks you in now${first ? ' and opens #1 — ' + esc(tgNum(first.ro)) + (first.ro.location ? ' in ' + esc(first.ro.location) : '') : ''}.</span><button class="btn btn-sm" data-a="skipm" style="margin-left:auto">Not yet</button></div></div></div>`;
  }
  /* end of day */
  function eodSheet(){
    const D = dayStats(), run = S.rp && opBy(S.rp.opId);
    const worked = S.ops.filter(o => o.st === 'done' || isRun(o) || S.day.ps.some(p => p.opId === o.id));
    const ros = []; worked.forEach(o => { if(ros.indexOf(o.ro) < 0) ros.push(o.ro); });
    const done = k => ros.length && ros.every(r => (r.bulletins || []).some(e => e.task === k && e.done));
    const C = ros.length ? [['keys', 'Keys in the key box — ' + ros.map(r => tgNum(r) + (r.keyTag ? ' tag ' + r.keyTag : '')).join(', '), 'Keys stored'], ['location', 'Truck locations are right — ' + ros.map(r => tgNum(r) + ' ' + (r.location || 'no spot')).join(', '), 'Update location'], ['eod', 'End-of-day notes on each RO', 'EOD']] : [];
    const nd = C.filter(c => done(c[0])).length;
    return `<div class="mg-rep cx-eod"><div class="mg-repbar"><b>End of day</b><span style="font-size:12.5px;color:var(--tg-ink3)">${esc(PG.dayLong(Date.now()))}</span><span class="sp"></span><button class="btn btn-sm ib" data-a="eodx" title="Not yet (Esc)">${ic('x', 14)}</button></div>
     <div class="mg-repsc"><div class="cx-eodc">
      <div class="cx-stats">${[['Clocked', dur(D.cl)], ['On jobs', dur(D.job)], ['Air', dur(D.air)], ['Hours sold', h1(D.sold) + ' h'], ['Efficiency', D.eff == null ? '—' : Math.round(D.eff) + '%']].map(x => `<span><small>${x[0]}</small><b>${x[1]}</b></span>`).join('')}</div>
      <div class="mg-card"><div class="mg-ch"><b>Your jobs today</b><small>${worked.length}</small></div><div class="mg-cb">${worked.map(o => { const st = stOf(o); return `<div class="cx-ej"><span class="tg-no">${esc(o.no)}</span><span class="n"><b>${esc(o.cmp)}</b><small>${esc(o.cust)}</small></span><span class="cx-st ${st === 'run' ? 'wk' : st === 'done' ? 'dn' : st === 'wait' ? 'wt' : 'nx'}"><i></i>${st === 'run' ? 'Still running — stops when you clock out' : st === 'done' ? 'Done ' + o.at : st === 'wait' ? 'Waiting – ' + esc(o.hold.k) : o.paused ? 'Paused' : 'Not finished'}</span><span class="m">${h1(o.q)} / ${h1(burnt(o))} h</span></div>`; }).join('') || '<div class="mg-none">No jobs today.</div>'}</div></div>
      ${run ? `<div class="mg-card"><div class="mg-ch"><b>What’s left on ${esc(run.no)}</b><small>goes on the RO for tomorrow — ${esc(PG.person('Foreman') ? PG.first(PG.person('Foreman')) : 'the foreman')} sees it</small></div><div class="mg-cb"><label class="cx-in" style="margin-top:0">${ic('pencil', 13)}<input data-in="left" value="${esc(U.left)}" placeholder="Hoses replaced, regen still to run…"></label></div></div>` : ''}
      ${C.length ? `<div class="mg-card"><div class="mg-ch"><b>Before you go</b><small>${nd} of ${C.length}</small><span class="sp"></span><small>the RO bulletins</small></div><div class="mg-cb">${C.map(c => `<button class="cx-ck2${done(c[0]) ? ' on' : ''}" data-a="eodc" data-k="${c[0]}"><span class="bx">${done(c[0]) ? ic('check', 12) : ''}</span><span class="n"><b>${esc(c[1])}</b><small>${c[2]}</small></span></button>`).join('')}</div></div>` : ''}
      <div class="cx-mact"><button class="btn btn-primary" data-a="eodgo">${ic('clock', 15)}Clock out for the day</button><button class="btn" data-a="eodx">Not yet</button><span>${nd < C.length ? `${C.length - nd} still open — you can clock out anyway.` : 'All set.'}</span></div></div></div></div>`;
  }
  /* the shop floor display */
  function tvBoard(){
    const B = boardOf(), T = teamOf(), cols = [['Check-in & diag', [0, 1]], ['Approval', [2]], ['Parts', [3]], ['Repair', [4]], ['Road test & close', [5, 6]]];
    return `<div class="cx-tv"><div class="hd"><span class="lg">${PX_LOGO}</span><b>Service floor</b><span>Vanguard Truck Center · Greensboro</span><span class="sp"></span><b class="tm" data-tk="clock">${clk(Date.now())}</b><span>${esc(PG.dayLong(Date.now()))}</span><button class="x" data-a="tvx" title="Exit display (Esc)">${ic('x', 18)}</button></div>
     <div class="tm-row">${T.map(t => `<div class="tc ${t.st}"><span class="av">${esc(PG.ini(t.n))}</span><div><b>${esc(PG.first(t.n))}</b><small>${t.st === 'job' ? 'on ' + esc(t.no) : t.st === 'air' ? 'not on a job' : t.st === 'shop' ? 'shop time' : 'out'}</small></div></div>`).join('')}</div>
     <div class="cols">${cols.map(([n, ix]) => { const L = B.filter(r => ix.includes(r.stage)); return `<div class="col"><div class="ch">${n}<span>${L.length}</span></div>${L.map(r => `<div class="rc ${r.state}"><div class="r1"><b>${esc(r.no)}</b><span>${r.tech ? esc(PG.first(r.tech)) : '—'}</span></div><div class="cu">${esc(r.cust)}</div><div class="lb">${esc(r.label)}</div></div>`).join('')}</div>`; }).join('')}</div></div>`;
  }
  /* ---------- popovers ---------- */
  function pop(){
    const p = U.pop; if(!p) return ''; const o = opBy(U.sel), fm = PG.person('Foreman'), fmF = fm ? PG.first(fm) : 'the foreman';
    if(p.type === 'chk') return `<div class="tg-pop xf mg-pop-w"><div class="tg-ph"><b>To fix in the Time Log</b><span class="cu">so your hours come out right</span><button class="btn btn-sm ib" data-a="popx">${ic('x', 14)}</button></div>${S.chk.length ? S.chk.map(c => `<div class="mg-chk"><span class="gi">${ic(c.icn, 14)}</span><b>${esc(c.t)}</b><p>${esc(c.b)}</p><div class="r"><button class="btn btn-sm" data-a="fixchk" data-d="${c.day}">${esc(c.btn)}</button><button class="btn btn-sm tg-gh" data-a="okchk" data-c="${c.id}">It’s right</button></div></div>`).join('') : `<div class="mg-none">${ic('check', 14)} All clean.</div>`}</div>`;
    if(p.type === 'out'){ const R = [['Lunch', 'Lunch · 30 min', 'Parsec reminds you at ' + clk(Date.now() + 30 * 60000)], ['End of day', 'End of day', 'Today goes to the Time Log'], ['Home', 'Home', 'Leaving early'], ['Appointment', 'Appointment', 'Tell ' + fmF + ' when you’ll be back'], ['Emergency', 'Emergency', '']];
      return `<div class="tg-pop menu mg-pop-m"><div class="tg-ph"><b>Clock out</b>${S.rp ? `<span class="cu">${esc(S.shop ? 'Shop time' : tgNum(getRO(S.rp.roId) || {}))} stops too</span>` : ''}</div>${R.map(x => `<button class="tg-mi cx-mi" data-a="out" data-v="${x[0]}"><b>${x[1]}</b><span class="meta">${esc(x[2])}</span></button>`).join('')}<div class="tg-pft">${ic('info', 12)}Shift ends at ${clkM((+(STATE.shiftEnd || '15:30').split(':')[0]) * 60 + (+(STATE.shiftEnd || '15:30').split(':')[1] || 0))}.</div></div>`; }
    if(p.type === 'scan') return `<div class="tg-pop xf mg-pop-m cx-scan"><div class="tg-ph"><b>Scan a job jacket</b><span class="cu">switches your clock to it</span><button class="btn btn-sm ib" data-a="popx">${ic('x', 14)}</button></div><div class="cx-vf"><video class="cx-cam" autoplay playsinline muted></video><i class="c a"></i><i class="c b"></i><i class="c d"></i><i class="c e"></i><span class="ln"></span><small class="cx-camtx">${U.camErr ? esc(U.camErr) : 'Hold the QR on the job jacket up to the camera'}</small></div><label class="cx-in">${ic('search', 13)}<input data-in="scan" placeholder="Or type an RO number, Enter"></label></div>`;
    if(p.type === 'ask'){ const ro = S.rp ? opBy(S.rp.opId) : o; return `<div class="tg-pop xf mg-pop-w"><div class="tg-ph"><b>Ask ${esc(fmF)}</b><span class="cu">about ${ro ? esc(ro.no) : ''}</span><button class="btn btn-sm ib" data-a="popx">${ic('x', 14)}</button></div><div class="cx-chips">${['Second opinion', 'Need a hand', 'Quote looks short', 'Parts question'].map(k => `<button class="${U.askk === k ? 'on' : ''}" data-a="asks" data-v="${k}">${k}</button>`).join('')}</div><textarea class="cx-ta" data-in="ask" placeholder="What do you need? ${esc(fmF)} sees the RO, your notes and the photos."></textarea><label class="ib-ck"><input type="checkbox" data-in="askrun" checked> Keep my clock running while I wait</label><div class="tg-acts"><button class="btn btn-sm" data-a="popx">Cancel</button><button class="btn btn-sm btn-primary" data-a="asksend">${ic('send', 13)}Send to ${esc(fmF)}</button></div></div>`; }
    if(p.type === 'part'){ const pt = PG.person('Parts'), ptF = pt ? PG.first(pt) : 'Parts'; return `<div class="tg-pop xf mg-pop-w"><div class="tg-ph"><b>Ask ${esc(ptF)} for a part</b><span class="cu">on ${o ? esc(o.no) : ''}</span><button class="btn btn-sm ib" data-a="popx">${ic('x', 14)}</button></div><div class="cx-chips">${['Need a part', 'Wrong part', 'Part number check', 'Is it here yet?'].map(k => `<button class="${U.partk === k ? 'on' : ''}" data-a="partk" data-v="${k}">${k}</button>`).join('')}</div><textarea class="cx-ta" data-in="part" placeholder="Part, number, how many — ${esc(ptF)} sees the RO and the operation."></textarea><div class="tg-acts"><button class="btn btn-sm" data-a="popx">Cancel</button><button class="btn btn-sm btn-primary" data-a="partsend">${ic('send', 13)}Send to ${esc(ptF)}</button></div></div>`; }
    if(p.type === 'hold'){ const pt = PG.person('Parts'), wr = PG.person('Service writer') || PG.person('Triage');
      return `<div class="tg-pop menu mg-pop-m"><div class="tg-ph"><b>Put ${o ? esc(o.no) : ''} on hold</b><span class="cu">it goes to Waiting</span></div>${[['Waiting – Parts', 'Parts', (pt ? PG.first(pt) : 'Parts') + ' sees it — the part’s status shows here'], ['Waiting – Approval', 'Approval', (wr ? PG.first(wr) : 'The writer') + ' gets it to send the estimate'], ['Waiting – Tech Support', 'Tech support', 'Waiting on a Volvo case'], ['Waiting – Foreman', 'Second opinion', fmF + ' gets it in the Inbox']].map(x => `<button class="tg-mi cx-mi" data-a="hold" data-v="${x[0]}"><b>${x[0]}</b><span class="meta">${esc(x[2])}</span></button>`).join('')}</div>`; }
    if(p.type === 'sw'){ const L = S.ops.filter(x => !isRun(x) && (x.st === 'next' || x.st === 'wait')).sort((a, b) => (a.st === 'next' ? (a.paused ? 0 : a.ord || 50) : 99) - (b.st === 'next' ? (b.paused ? 0 : b.ord || 50) : 99));
      return `<div class="tg-pop menu mg-pop-w"><div class="tg-ph"><b>Switch to</b><span class="cu">${S.rp ? 'this one stops at ' + clk(Date.now()) : ''}</span></div>${L.map(x => `<button class="tg-mi cx-mi" data-a="startid" data-id="${x.id}"><span class="tg-no">${esc(x.no)}</span><b>${esc(x.cmp)}</b><span class="meta">${x.st === 'wait' ? 'waiting – ' + esc(x.hold.k.toLowerCase()) : x.paused ? 'paused' : (x.ord ? '#' + x.ord + ' · ' : '') + h1(x.q) + ' h'}</span></button>`).join('') || '<div class="mg-none" style="padding:8px 10px">Nothing else on your list.</div>'}<div class="tg-pft">${kbd('↵')}starts the one you picked on the left.</div></div>`; }
    return '';
  }
