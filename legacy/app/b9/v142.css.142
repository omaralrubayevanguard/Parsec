/* Parsec 14.2 — words and quoted hours that change in place (b9/v142.js), the Technician page's add-a-part pops */
.rif,.qte{cursor:text;border-radius:4px;transition:background-color .12s ease,box-shadow .12s ease;outline:none;}
.rif:hover,.qte:hover,.rif:focus-visible,.qte:focus-visible{background:var(--tg-fill,var(--fill,rgba(127,120,110,.12)));box-shadow:inset 0 -1px 0 var(--tg-ink4,var(--ink-4,#A8A398));}
.rif.rif-e{color:var(--tg-ink4,var(--ink-4,#A8A398));}
.rif.on,.qte.on{background:none;box-shadow:none;}
.rif-in,.qte-in{box-sizing:content-box;font:inherit;color:inherit;letter-spacing:inherit;line-height:inherit;background:var(--tg-raised,var(--raised,#fff));border:1px solid var(--tg-acc,var(--accent,#86643A));border-radius:5px;padding:0 4px;margin:-2px -5px;outline:none;box-shadow:0 0 0 3px color-mix(in srgb,var(--tg-acc,var(--accent,#86643A)) 18%,transparent);min-width:3ch;max-width:100%;vertical-align:baseline;}
.qte-in{width:5.5ch;text-align:right;font-variant-numeric:tabular-nums;}
@media (prefers-reduced-motion:reduce){.rif,.qte{transition:none;}}
/* the pops */
.pq-pop{position:fixed;z-index:10040;width:340px;max-width:calc(100vw - 24px);background:var(--tg-raised,#fff);color:var(--tg-ink,#1D1C1A);border:1px solid var(--tg-border,#DDD8CE);border-radius:12px;box-shadow:0 12px 36px rgba(20,18,14,.18),0 2px 6px rgba(20,18,14,.08);font-size:13px;}
.pq-pop.w{width:440px;}
.pq-h{display:flex;align-items:baseline;gap:8px;padding:12px 14px 8px;}
.pq-h b{font-weight:600;font-size:13.5px;white-space:nowrap;}
.pq-h small{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--tg-ink3,#67625A);font-size:12px;}
.pq-x{margin-left:auto;width:24px;height:24px;flex:none;border:0;border-radius:6px;background:none;color:var(--tg-ink3,#67625A);font-size:17px;line-height:1;cursor:pointer;}
.pq-x:hover{background:var(--tg-fill,rgba(0,0,0,.05));color:var(--tg-ink,#1D1C1A);}
.pq-b{padding:0 14px 14px;display:flex;flex-direction:column;gap:8px;}
.pq-in,.pq-ta{box-sizing:border-box;width:100%;padding:0 10px;height:34px;border:1px solid var(--tg-border,#DDD8CE);border-radius:8px;background:var(--tg-panel,#FBFAF7);color:inherit;font:inherit;outline:none;}
.pq-ta{height:auto;padding:8px 10px;resize:vertical;line-height:1.45;font-family:var(--tg-mono,ui-monospace,monospace);font-size:12px;}
.pq-in:focus,.pq-ta:focus{border-color:var(--tg-acc,#86643A);box-shadow:0 0 0 3px color-mix(in srgb,var(--tg-acc,#86643A) 16%,transparent);}
.pq-n,.pq-st{color:var(--tg-ink3,#67625A);font-size:12px;}
.pq-list{max-height:300px;overflow:auto;margin:0 -6px;}
.pq-r{display:grid;grid-template-columns:minmax(0,1fr) 52px auto;align-items:center;gap:8px;padding:6px;border-radius:8px;}
.pq-r.x{grid-template-columns:18px minmax(0,1fr);cursor:pointer;}
.pq-r:hover{background:var(--tg-fill,rgba(0,0,0,.04));}
.pq-d{min-width:0;display:flex;flex-direction:column;gap:2px;}
.pq-d b{font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.pq-d small{color:var(--tg-ink3,#67625A);font-size:11.5px;font-family:var(--tg-mono,ui-monospace,monospace);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.pq-kit{font-style:normal;font:600 10.5px/1 var(--tg-mono,ui-monospace,monospace);color:var(--tg-acc,#86643A);}
.pq-q{box-sizing:border-box;width:52px;height:28px;padding:0 6px;border:1px solid var(--tg-border,#DDD8CE);border-radius:6px;background:var(--tg-panel,#FBFAF7);color:inherit;font:inherit;font-variant-numeric:tabular-nums;}
.pq-e{padding:14px 6px;color:var(--tg-ink3,#67625A);}
.pq-tools{display:flex;align-items:center;gap:10px;}
.pq-f{display:flex;justify-content:flex-end;gap:8px;padding-top:4px;}
