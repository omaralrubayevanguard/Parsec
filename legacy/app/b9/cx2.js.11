  /* ---------- drawing ---------- */
  function view(){
    const me0 = PG.me().name; if(U._me !== me0){ U._me = me0; U.view = 'today'; U.sel = null; U.pop = null; U.eod = false; U.tv = false; }
    build();
    const v = U.view;
    let body;
    if(S.morning) body = `<div class="tg-main">${morningCard()}</div>`;
    else if(v === 'today' && !S.lead) body = wList() + `<div class="tg-main">${wDetail()}</div>`;
    else body = `<div class="tg-main">${vShop()}</div>`;
    return `<div class="tg mg cr cx" data-pg="console">${head()}<div class="tg-body">${body}${pop()}${U.eod ? eodSheet() : ''}</div>${U.tv ? tvBoard() : ''}${filePick()}</div>`;
  }
  function filePick(){ return '<input type="file" class="cx-file" data-in="file" hidden multiple>'; }
  function head(){
    const D = dayStats(), n = nChk(), M = S.M, w = M.name, todayW = PG.dayLong(Date.now());
    let f;
    if(S.lead){
      const T = teamOf(), on = T.filter(t => t.st !== 'out').length, jb = T.filter(t => t.st === 'job').length, air = T.filter(t => t.st === 'air'), B = boardOf();
      f = `<span class="tg-hf" style="cursor:default">${PG.av(w)}${esc(w)}<span class="ib-role">${esc(M.role === 'Admin' ? 'Every page' : M.role)} · ${esc(todayW)}</span></span><i>·</i><span class="tg-hf" style="cursor:default"><b>${on} of ${T.length}</b>with time today</span><i>·</i><span class="tg-hf" style="cursor:default"><b>${jb}</b>on jobs</span>${air.length ? `<i>·</i><span class="tg-hf w" style="cursor:default"><b>${air.length}</b>not on a job</span>` : ''}<i>·</i><span class="tg-hf" style="cursor:default"><b>${B.length}</b>open ROs</span>${M.role !== 'Admin' ? `<i>·</i><span class="tg-hf cx-home" style="cursor:default" title="Where ${esc(PG.first(w))} lands when signing in">${ic('pin', 12)}Home: ${esc(navPageName(PG.homeOf(M.role)))}</span>` : ''}`;
    } else f = `<span class="tg-hf" style="cursor:default">${PG.av(w)}${esc(w)}<span class="ib-role">${esc(todayW)}</span></span><i>·</i>${S.morning ? `<span class="tg-hf" style="cursor:default"><span class="cx-dot off"></span>Not clocked in yet</span>` : S.out ? `<span class="tg-hf" style="cursor:default"><span class="cx-dot off"></span>Clocked out${S.out.at ? ' · ' + esc(String(S.out.why).toLowerCase()) + ' since ' + clk(S.out.at) : ''}</span>` : `<span class="tg-hf" style="cursor:default"><span class="cx-dot"></span><b data-tk="cl">${dur(D.cl)}</b>on the clock</span>`}${S.morning ? '' : `<i>·</i><span class="tg-hf" style="cursor:default"><b>${D.eff == null ? '—' : Math.round(D.eff) + '%'}</b>efficiency today</span>`}${n ? `<i>·</i><button class="tg-hf w${U.pop && U.pop.type === 'chk' ? ' on' : ''}" data-a="pop" data-p="chk"><b>${n}</b>to fix in the Time Log</button>` : ''}`;
    const scan = S.lead || S.morning || S.out ? '' : `<button class="btn btn-sm${U.pop && U.pop.type === 'scan' ? ' on' : ''}" data-a="pop" data-p="scan" style="height:30px" title="Scan a job jacket to switch">${ic('qr', 14)}Scan</button>`;
    const tabs = S.lead ? '' : `<div class="tg-views">${[['today', 'timelog', 'Today'], ['shop', 'grid', 'Shop']].map((x, i) => `<button class="${U.view === x[0] ? 'on' : ''}" data-a="view" data-v="${x[0]}" title="${x[2]} (${i + 1})">${ic(x[1], 14)}${x[2]}</button>`).join('')}</div><span class="tg-hsep"></span>`;
    const hm = PG.homeOf(M.role);
    const ck = S.lead ? (M.role !== 'Admin' && hm !== 'console' ? `<button class="btn btn-sm" data-a="go" data-v="${hm}" style="height:30px">${ic(hm, 14)}${esc(navPageName(hm))} page</button>` : '') : S.morning ? `<button class="btn btn-sm btn-primary" data-a="morning" style="height:30px">${ic('play', 14)}Start my day</button>` : S.out ? `<button class="btn btn-sm btn-primary" data-a="cin" style="height:30px">${ic('play', 14)}Clock in</button>` : `<button class="btn btn-sm${U.pop && U.pop.type === 'out' ? ' on' : ''}" data-a="pop" data-p="out" style="height:30px">${ic('clock', 14)}Clock out${ic('chevD', 13)}</button>`;
    return `<header class="tg-head"><h1 class="tg-h1">Console</h1><span class="tg-facts">${f}</span>${tabs}${scan}${ck}</header>`;
  }
  function navPageName(v){ const p = NAV_PAGES.filter(x => x[0] === v)[0]; return p ? p[1] : v; }
  /* ---------- today: your work on the left ---------- */
  function groups(){
    const O = S.ops, run = O.filter(isRun), nx = nextOps(), wt = O.filter(o => !isRun(o) && o.st === 'wait'), dn = O.filter(o => o.st === 'done');
    const fm = PG.person('Foreman'), fmw = fm ? PG.first(fm) + '’s order' : 'the foreman’s order';
    return [[S.shop ? 'On shop time' : 'On it now', run, 'run'], [nx.some(o => o.paused) ? 'Next · paused first, then ' + fmw : 'Next · ' + fmw, nx, 'next'], ['Waiting', wt, 'wait'], ['Done today', dn, 'done']].filter(g => g[1].length || g[2] === 'run');
  }
  const flat = () => groups().flatMap(g => g[1]);
  const locOf = o => o.ro.cxBring && !bayLike(o.spot) ? 'coming to a bay' : o.spot || 'no spot';
  function item(o){
    const s = stOf(o), on = o.id === U.sel, b = burnt(o), l = b - o.q;
    const T = (o.tags || []).filter(t => t[0] !== 'in');
    const rt = s === 'run' ? '<b class="run" data-tk="runm">' + dur(b * 60) + '</b><small>of ' + h1(o.q) + ' h</small>'
      : s === 'done' ? `<b class="${sev(l)}">${o.b0 >= .05 ? Math.round(o.q / o.b0 * 100) + '%' : '—'}</b><small>${h1(o.q)} / ${h1(o.b0)} h</small>`
      : s === 'wait' ? `<small class="cx-hk">${esc(o.hold.k)}</small><small>${esc(o.hold.left)}</small>`
      : o.paused ? `<b>${dur(o.b0 * 60)}</b><small>paused ${o.paused}</small>`
      : `<small>${h1(o.q)} h · ${esc(locOf(o))}</small>${T.length ? `<small class="cx-tg ${T[T.length - 1][0]}">${esc(T[T.length - 1][1])}</small>` : ''}`;
    return `<div class="tg-it cr-it cx-it${on ? ' on' : ''}${on && U.kb ? ' kb' : ''}" data-a="sel" data-id="${o.id}"><span class="cr-rail ${s === 'run' ? 'rn' : s === 'wait' ? 'wt' : s === 'done' ? sev(l) : 'nx'}"></span><span class="tg-t">${s === 'next' && o.paused ? `<span class="cx-n pz" title="Paused">${ic('pause', 10)}</span>` : s === 'next' && o.ord ? `<span class="cx-n">${o.ord}</span>` : ''}${o.back ? '<span class="ib-k auto">back</span>' : ''}<span class="tg-no">${esc(o.no)}</span><b>${esc(o.cust)}</b></span><span class="tg-w"><span class="cr-ty ${ty(o)[1]}">${ty(o)[0]}</span>${esc(o.cmp)}</span><span class="cr-m">${rt}</span></div>`;
  }
  function wList(){
    const G = groups(), L = flat(), n = L.length;
    if(!U.sel || !L.some(o => o.id === U.sel)) U.sel = (L[0] || {}).id || null;
    const SH = shopRo().operations;
    const fn = STATE.fmNote && STATE.fmNote.d === todayStr() && STATE.fmNote.text && U.noteX !== (STATE.fmNote.at || todayStr()) ? STATE.fmNote : null;
    return `<section class="tg-list"><div class="tg-lh">Your work<span class="n">${n}</span></div><div class="tg-scroll">${fn ? `<div class="cx-why cx-fmn" style="margin:8px 12px 4px">${ic('chat', 13)}<span><b>From ${esc(PG.first(fn.by || PG.person('Foreman') || 'the foreman'))}:</b> ${esc(fn.text)}</span><button class="btn btn-sm ib tg-gh" data-a="notex" title="Hide for today" style="margin-left:auto;flex:none">${ic('x', 13)}</button></div>` : ''}${G.map(([g, L2, k]) => `<div class="tg-grp">${g}<span>${L2.length || ''}</span></div>` + (k === 'run' && !L2.length ? runEmpty() : L2.map(item).join(''))).join('')}${n ? '' : `<div class="cx-empty">${ic('console', 18)}<b>Nothing on your list</b><small>${esc(PG.person('Foreman') ? PG.first(PG.person('Foreman')) : 'The foreman')} gives you work on the Foreman page — it shows here.</small></div>`}</div>
     <div class="cx-shop"><span>${ic('gear2', 13)}Shop</span>${SH.map(op => { const on = S.rp && S.rp.opId === op.id; const nm = op.complaint.replace(/^Shop /, ''); return `<button class="${on ? 'on' : ''}" data-a="shopt" data-id="${op.id}"${S.out ? ' disabled' : ''} title="${esc(op.complaint)}">${on ? `<i></i>${esc(nm)} <b data-tk="shop">${TK.shop()}</b>` : esc(nm)}</button>`; }).join('')}</div>
     <div class="tg-keys"><span>${kbd('J')}${kbd('K')}move</span><span>${kbd('↵')}start</span><span>${kbd('S')}stop</span><span>${kbd('Ctrl')}${kbd('↵')}done</span><span>${kbd('1')}${kbd('2')}views</span></div></section>`;
  }
  function runEmpty(){
    if(S.out) return `<div class="cx-air off">${ic('clock', 14)}<span><b>Clocked out</b>${esc(S.out.why)}${S.out.at ? ' since ' + clk(S.out.at) : ''}</span><button class="btn btn-sm btn-primary" data-a="cin">Clock in</button></div>`;
    if(S.shop) return `<div class="cx-air shop">${ic('gear2', 14)}<span><b>${esc(S.shop)}</b>shop time · <b data-tk="shop" style="display:inline">${TK.shop()}</b></span><button class="btn btn-sm" data-a="stop">Stop</button></div>`;
    return `<div class="cx-air">${ic('info', 14)}<span><b>Not on a job · <em data-tk="air">${dur(airNow())}</em></b>Air time counts against you — start the next one.</span></div>`;
  }
  /* ---------- today: the operation on the right ---------- */
  function effBar(o){
    const b = burnt(o), l = b - o.q, sv = sev(l), mx = Math.max(o.q, b) * 1.15 || 1, pq = o.q / mx * 100, pb = Math.min(b, o.q) / mx * 100, po = Math.max(0, b - o.q) / mx * 100;
    return `<div class="cr-bar"><span class="tr"><i class="b" style="width:${pb.toFixed(1)}%"></i>${po ? `<i class="o ${sv}" style="left:${pq.toFixed(1)}%;width:${po.toFixed(1)}%"></i>` : ''}<em style="left:${pq.toFixed(1)}%"></em></span><span class="nums"><span>Quoted <b>${h1(o.q)} h</b><small>${hmH(o.q)}</small></span><span>Burnt <b>${h1(b)} h</b><small>${hmH(b)}</small></span><span>${l > 0 ? 'Over' : 'Remaining'} <b class="${sv}">${h1(Math.abs(l))} h</b><small>${hmH(Math.abs(l))}</small></span>${o.st === 'done' ? `<span>Efficiency <b class="${sv}">${b ? Math.round(o.q / b * 100) : '—'}%</b></span>` : ''}</span></div>`;
  }
  function wDetail(){
    const o = opBy(U.sel);
    if(!o) return `<div class="tg-blank"><div class="tg-empty"><span class="tg-ring0">${ic('console', 22)}</span><h3>Nothing on your list</h3><p>${esc(PG.person('Foreman') ? PG.first(PG.person('Foreman')) + '’s' : 'The foreman’s')} order for today shows here.</p></div></div>`;
    const s = stOf(o), fm = PG.person('Foreman'), fmF = fm ? PG.first(fm) : 'the foreman';
    const stl = { run: ['wk', 'Working · ' + (o.sr || 'Repairing')], next: ['nx', o.paused ? 'Paused · stays on top of Next' : o.back ? 'Back from Waiting' + (o.ord ? ' · #' + o.ord : '') : o.ord ? 'Next · #' + o.ord + ' in ' + (fm ? fmF + '’s' : 'the foreman’s') + ' order' : 'Not started'], wait: ['wt', 'Waiting – ' + (o.hold ? o.hold.k : '')], done: ['dn', 'Complete · ' + o.at] }[s];
    let hero = '';
    if(s === 'run') hero = `<div class="cx-hero run"><div class="tm"><b data-tk="run">${TK.run()}</b><small><i></i>On it since ${clk(S.rp.start)} · burnt on this operation</small></div><span class="sp"></span><button class="btn${U.pop && U.pop.type === 'ask' ? ' on' : ''}" data-a="pop" data-p="ask" title="Ask ${esc(fmF)} — your clock keeps running">${ic('chat', 15)}Ask ${esc(fmF)}</button><button class="btn${U.pop && U.pop.type === 'hold' ? ' on' : ''}" data-a="pop" data-p="hold" title="Put it on hold (H)">${ic('clock', 15)}Hold${ic('chevD', 13)}</button><button class="btn${U.pop && U.pop.type === 'sw' ? ' on' : ''}" data-a="pop" data-p="sw">${ic('swap', 15)}Switch${ic('chevD', 13)}</button><button class="btn" data-a="stop" title="Stop (S)">${ic('stop', 15)}Stop</button><button class="btn btn-primary" data-a="done" title="Done (Ctrl ↵)">${ic('check', 15)}Done</button></div>`;
    else if(s === 'next'){ const yard = !bayLike(o.spot) && !o.ro.cxBring; hero = `<div class="cx-hero"><div class="tm">${o.paused ? `<b class="q">${dur(o.b0 * 60)}</b><small>burnt of ${h1(o.q)} h · paused at ${o.paused}${o.spot ? ' · ' + esc(o.spot) : ''}</small>` : `<b class="q">${h1(o.q)} h</b><small>quoted · ${o.ro.cxBring && !bayLike(o.spot) ? 'Triage is bringing it to a bay' : yard ? (o.spot ? 'still out at ' + esc(o.spot) : 'no spot yet') : 'truck in ' + esc(o.spot)}</small>`}</div><span class="sp"></span>${yard ? `<button class="btn${U.hl === 'bring' ? ' hl' : ''}" data-a="bring" title="Ask Triage to bring it to a bay">${ic('triage', 15)}Bring it in</button>` : ''}<button class="btn btn-primary" data-a="start"${S.out ? ' disabled' : ''} title="Start (Enter)">${ic('play', 15)}${o.paused ? 'Resume' : S.rp ? 'Switch to this' : 'Start'}</button></div>`; }
    else if(s === 'wait') hero = `<div class="cx-hero wt"><div class="tm"><b class="q">${esc(o.hold.k)}</b><small>${esc(o.hold.txt)}</small></div><span class="sp"></span>${o.hold.who ? `<button class="btn" data-a="askholder" title="It goes to ${esc(PG.first(o.hold.who))}’s Inbox">${ic('chat', 15)}Ask ${esc(PG.first(o.hold.who))}</button>` : `<button class="btn" data-a="openro">${ic('link', 15)}Open the case</button>`}<button class="btn" data-a="start"${S.out ? ' disabled' : ''}>${ic('play', 15)}Start anyway</button></div>`;
    else hero = `<div class="cx-hero dn"><div class="tm"><b class="q ${sev(o.b0 - o.q)}">${o.b0 >= .05 ? Math.round(o.q / o.b0 * 100) + '%' : '—'}</b><small>done at ${o.at} · ${h1(o.q)} h sold, ${h1(o.b0)} h burnt</small></div><span class="sp"></span><button class="btn" data-a="reopen">${ic('undo', 15)}Reopen</button></div>`;
    const nextUp = U.justDone && U.justDone === o.id ? (() => { const n = nextOps()[0]; return n ? `<div class="cx-nextup">${ic('spark', 14)}<span>Next${n.paused ? ' — paused' : ' in ' + (fm ? fmF + '’s' : 'the foreman’s') + ' order'}: <span class="tg-no">${esc(n.no)}</span> <b>${esc(n.cmp)}</b> · ${h1(n.q)} h${n.tags && n.tags.length ? ` · ${esc(n.tags.map(t => t[1]).join(' · '))}` : ''}</span><button class="btn btn-sm btn-primary" data-a="startid" data-id="${n.id}">${ic('play', 13)}Start it</button></div>` : ''; })() : '';
    const fx = o.fix && s !== 'done' ? `<div class="cx-fix${o.fixUsed ? ' used' : ''}${U.hl === 'fix' ? ' hl' : ''}" data-sec="fix"><span class="gi">${ic('fixes', 15)}</span><span class="n"><b>${o.fixUsed ? 'Past fix in use' : 'A past fix matches'} — ${esc(o.fix.t)}</b><small>Fixed ${o.fix.n}× before${o.fix.by && o.fix.by !== '—' ? ' · last by ' + esc(o.fix.by) : ''}${o.fix.at ? ' · ' + esc(o.fix.at) : ''}${o.fix.avg ? ' · about ' + h1(o.fix.avg) + ' h' : ''}</small></span>${o.fixUsed ? `<span class="ib-k auto">${ic('check', 11)}Steps added to your notes</span>` : `<button class="btn btn-sm" data-a="viewfix">View</button><button class="btn btn-sm btn-primary" data-a="usefix">Use fix</button>`}</div>` : '';
    const why = o.why && s === 'next' ? `<div class="cx-why">${ic('info', 13)}<span>${esc(o.why)}</span></div>` : '';
    const notes = o.notes;
    const parts = o.parts || [];
    const PS = p => { const k = p.status || 'Not Ordered'; return { 'Not Ordered': ['wt', 'Not ordered'], 'Ordered': ['wt', 'Ordered' + (p.eta ? ' · due ' + PG.day(p.eta + 'T12:00:00') : '')], 'Backordered': ['bo', 'Backordered' + (p.eta ? ' · ' + PG.day(p.eta + 'T12:00:00') : '')], 'Received': ['in', 'Received'], 'Staged': ['st', 'Staged at the counter'], 'Picked up': ['ok', 'Picked up'], 'Installed': ['ok', 'Installed'], 'Returned': ['in', 'Returned'] }[k] || ['in', k]; };
    const D = dayStats();
    return `<div class="mg-pane"><div class="tg-top"><div class="r1"><span class="cx-st ${stl[0]}"><i></i>${esc(stl[1])}</span><span>${esc(o.truck)} · Unit ${esc(o.unit)}${o.spot && s !== 'done' ? ' · ' + esc(o.spot) : ''}</span><span class="sp"></span><button class="btn btn-sm" data-a="openro">${ic('ros', 14)}Open RO</button></div><h2><span class="tg-no" style="font-size:20px;margin-right:8px">${esc(o.no)}</span>${esc(o.cust)}</h2>
      <div class="cx-cmp"><span class="cr-ty ${ty(o)[1]}">${ty(o)[0]}</span><b>${esc(o.cmp)}</b><small class="cx-opn">Op ${o.opn}</small></div>${hero}${(s === 'next' || s === 'wait') && !(o.b0 > 0) ? '' : effBar(o)}</div>
     <div class="mg-pad">${nudge()}${nextUp}${why}${fx}
      <div class="cx-two"><div class="mg-card"><div class="mg-ch"><b>Work performed</b><small>Enter adds the time</small></div><div class="mg-cb">${notes.map(n => `<div class="cx-nl"><small>${esc(n[0])}</small><span>${esc(n[1])}</span></div>`).join('') || '<div class="mg-none" style="padding:4px 0 8px">Nothing written yet.</div>'}${s === 'done' ? '' : `<label class="cx-in${U.dict ? ' dict' : ''}">${ic('pencil', 13)}<input data-in="note" value="${esc(U.draft)}" placeholder="${U.dict ? 'Listening…' : 'What you found, what you did…'}"><button class="cx-mic${U.dict ? ' on' : ''}" data-a="dict" title="Dictate — talk, then Enter to save">${ic('mic', 14)}</button></label>`}</div></div>
       <div class="mg-card${U.hl === 'parts' ? ' hl' : ''}" data-sec="parts"><div class="mg-ch"><b>Parts</b><small>${parts.length ? parts.length + ' on this operation' : 'none yet'}</small></div><div class="mg-cb">${parts.map(p => { const k = PS(p); return `<div class="cx-pr"><span class="n"><b>${esc(p.description || p.partNumber)}</b><small>${p.partNumber ? esc(p.partNumber) + ' · ' : ''}qty ${esc(p.qty || 1)}</small></span><span class="cx-ps ${k[0]}"><i></i>${esc(k[1])}</span>${p.status === 'Staged' ? `<button class="btn btn-sm" data-a="pickup" data-pt="${p.id}">Picked up</button>` : ''}</div>`; }).join('') || '<div class="mg-none" style="padding:4px 0">No parts on this one.</div>'}${s === 'done' ? '' : `<button class="cr-add" data-a="pop" data-p="part">${ic('plus', 13)}Ask Parts for a part</button>`}</div></div></div>
      ${photoCard(o, s)}${dayCard(D)}</div></div>`;
  }
  /* your day — the Time Log bar, and the goal */
  function dayCard(D){
    const sh = S.day.sh, firstIn = sh.length ? PG.mod(new Date(sh[0].in)) : nowM(), a = Math.min(360, Math.floor(firstIn / 60) * 60), z = Math.max(1020, Math.ceil(nowM() / 60) * 60 + 60), m = nowM();
    const X = v => ((Math.min(z, Math.max(a, v)) - a) / (z - a) * 100).toFixed(2), Mo = t => PG.mod(new Date(t));
    let bars = '';
    sh.forEach(s => { const e = s.out ? Mo(s.out) : m; bars += `<i class="cx-b air" style="left:${X(Mo(s.in))}%;width:${(X(e) - X(Mo(s.in))).toFixed(2)}%" data-tip="Air|on the clock, not on a job"></i>`; });
    for(let i = 1; i < sh.length; i++){ const l0 = sh[i - 1].out, l1 = sh[i].in; if(l0) bars += `<i class="cx-b lunch" style="left:${X(Mo(l0))}%;width:${(X(Mo(l1)) - X(Mo(l0))).toFixed(2)}%" data-tip="${esc(sh[i - 1].outReason || 'Clocked out')}|${clk(l0)} – ${clk(l1)}"></i>`; }
    S.day.ps.forEach(p => { const s0 = Mo(p.start), e = p.stop ? Mo(p.stop) : m, w = X(e) - X(s0), ro = getRO(p.roId), op = getOp(p.roId, p.opId), shop = isShopPunch(p), lbl = shop ? (op ? op.complaint : 'Shop') : ro ? tgNum(ro) : 'RO';
      bars += `<i class="cx-b ${shop ? 'shop' : 'job'}${p.stop ? '' : ' live'}" style="left:${X(s0)}%;width:${w.toFixed(2)}%" data-tip="${esc(lbl + ' · ' + (op ? op.complaint : ''))}|${clk(p.start)} – ${p.stop ? clk(p.stop) : 'now'} · ${dur(e - s0)}">${w > 5.5 ? esc(lbl) : ''}</i>`; });
    const hrs = []; for(let h = Math.ceil(a / 60); h <= Math.floor(z / 60); h++) hrs.push(`<span style="left:${X(h * 60)}%">${h % 12 || 12}${h === 12 ? ' pm' : h === Math.ceil(a / 60) ? (h < 12 ? ' am' : ' pm') : ''}</span>`);
    const run = S.rp && opBy(S.rp.opId), sold = D.sold, add = run ? run.q : 0, G = goal(), gp = Math.min(100, sold / G * 100), ap = Math.min(100 - gp, add / G * 100);
    const shEnd = STATE.shiftEnd || '15:30', se = (+shEnd.split(':')[0]) * 60 + (+shEnd.split(':')[1] || 0);
    return `<div class="mg-card cx-day${U.hl === 'day' ? ' hl' : ''}" data-sec="day"><div class="mg-ch"><b>Your day</b><small>${S.out ? 'clocked out' : sh.length ? 'on the clock since ' + clk(sh[0].in) : 'not clocked in'}</small><span class="sp"></span><span class="mg-leg"><span><i class="cx-l job"></i>On a job</span><span><i class="cx-l air"></i>Air</span><span><i class="cx-l shop"></i>Shop</span><span><i class="cx-l lunch"></i>Lunch</span></span><button class="btn btn-sm" data-a="go" data-v="timelog">${ic('timelog', 13)}Time Log</button></div><div class="mg-cb">
      <div class="cx-stats"><span><small>Clocked</small><b data-tk="cl">${dur(D.cl)}</b></span><span><small><i class="cx-l job"></i>On jobs</small><b>${dur(D.job)}<em>${D.cl ? Math.round(D.job / D.cl * 100) : 0}%</em></b></span><span><small><i class="cx-l air"></i>Air</small><b>${dur(D.air)}</b></span><span><small><i class="cx-l shop"></i>Shop</small><b>${dur(D.shop)}</b></span><span><small>Lunch</small><b>${dur(D.lunch)}</b></span><span><small>Efficiency</small><b>${D.eff == null ? '—' : Math.round(D.eff) + '%'}<em>${h1(D.sold)} h sold</em></b></span></div>
      <div class="cx-tl"><div class="cx-track">${bars}<em class="sh" style="left:${X(se)}%"><small>Shift ends ${clkM(se).replace(' pm', '').replace(' am', '')}</small></em>${S.out ? '' : `<em class="now" style="left:${X(m)}%"></em>`}</div><div class="cx-grid">${hrs.join('')}</div></div>
      <div class="cx-goal"><span class="t">${ic('spark', 13)}Hours sold today <b>${h1(sold)} h</b> of your ${h1(G)} h goal${run ? ` · <span class="tg-no">${esc(run.no)}</span> brings it to <b>${h1(sold + add)} h</b> when it’s done` : ''}</span><span class="b"><i class="f" style="width:${gp.toFixed(1)}%"></i>${ap ? `<i class="p" style="left:${gp.toFixed(1)}%;width:${ap.toFixed(1)}%"></i>` : ''}</span></div>
      ${nChk() ? `<button class="cx-chk" data-a="pop" data-p="chk">${ic('flag', 13)}<span><b>${nChk()} to fix in the Time Log</b> — fix them so your hours and efficiency come out right.</span>${ic('chevR', 14)}</button>` : ''}</div></div>`;
  }
