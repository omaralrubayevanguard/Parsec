/* ============================== Parsec 12.4 — the operation clock card ==============================
   One card on the RO page (inside the RO page's shadow root) and on the Technician page (the main page), from the
   clock card mock-up's picks: the ring around Start / Stop, rolling digits, the bar made of the punches in the Time
   tab's colors, over quoted, time left (tap the time), when quoted runs out, the card breathes, hold to stop, who's
   on the clock, milestones. Motion follows the computer's "reduce motion" setting.
   The card is markup (ockHtml) both pages put in; one ticker moves every card in place once a second; the pages
   hand over their own start / stop / reason / quoted edits (OCK_CB.jc, OCK_CB.tc). The main page is redrawn by
   morphing, so the markup always carries the state of "now" — a redraw changes nothing the ticker set. What runs
   once (the check drawing itself, a milestone, the over chip, a new person) only plays when it just happened. */
var OCK_ST = {}, OCK_CB = {}, OCK_ROOTS = [document], OCK_RAF = 0, OCK_HOLD = 700, OCK_FRESH = 900, OCK_LABMS = 6000;
var OCK_RC = 2 * Math.PI * 23, OCK_INF = { "ock-breathe": 1, "ock-edge": 1, "ock-stripes": 1, "ock-blink": 1, "ock-live": 1 };
var OCK_PLAY = "M8 5.5 L19 12 L19 12 L8 18.5 Z", OCK_STOP = "M6.5 6.5 L17.5 6.5 L17.5 17.5 L6.5 17.5 Z";
var OCK_MODE = { run: "st-run", wait: "st-wait", done: "st-done", idle: "st-idle", lock: "st-lock" };
var OCK_MS = [[0.5, "Halfway"], [0.75, "Last quarter"], [1, "At quoted"]];
var OCK_VIEW = (function(){ try{ return localStorage.getItem("parsec.ockView") === "left" ? "left" : "el"; }catch(e){ return "el"; } })();
var OCK_RM = null;
function ockCalm(){ try{ OCK_RM = OCK_RM || window.matchMedia("(prefers-reduced-motion: reduce)"); return !!OCK_RM.matches; }catch(e){ return false; } }
function ockE(s){ return String(s == null ? "" : s).replace(/[&<>"']/g, function(c){ return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }
function ockHms(s){ s = Math.max(0, Math.floor(s)); return Math.floor(s / 3600) + ":" + String(Math.floor(s / 60) % 60).padStart(2, "0") + ":" + String(s % 60).padStart(2, "0"); }
function ockMs(s){ s = Math.max(0, Math.floor(s)); return s >= 3600 ? ockHms(s) : Math.floor(s / 60) + ":" + String(s % 60).padStart(2, "0"); }
function ockHm(s){ s = Math.max(0, Math.floor(s / 60)); return Math.floor(s / 60) + ":" + String(s % 60).padStart(2, "0"); }
function ockClk(t){ try{ if(typeof PG !== "undefined" && PG.clk) return PG.clk(t); }catch(e){} var d = new Date(t), h = d.getHours(); return (h % 12 || 12) + ":" + String(d.getMinutes()).padStart(2, "0") + " " + (h >= 12 ? "pm" : "am"); }
function ockIni(n){ return String(n || "?").trim().split(/\s+/).map(function(x){ return x[0] || ""; }).join("").slice(0, 2).toUpperCase() || "?"; }
function ockFirst(n){ return String(n || "").trim().split(/\s+/)[0] || "—"; }
function ockIc(k){
  var P = { clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>', flag: '<path d="M5.5 20.5V4.5"/><path d="M5.5 5h11l-2 4 2 4h-11"/>', check: '<path d="M5.5 12.5l4 4 9-9.5"/>',
    lock: '<rect x="5.5" y="10.5" width="13" height="9.5" rx="2"/><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5"/>', x: '<path d="M6.5 6.5l11 11M17.5 6.5l-11 11"/>', parts: '<path d="M12 3.5l7.5 4.2v8.6L12 20.5l-7.5-4.2V7.7z"/><path d="M4.8 7.9L12 12l7.2-4.1M12 12v8.3"/>' };
  return '<svg class="ock-i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + (P[k] || "") + '</svg>';
}
function ockRv(r){ try{ return reasonVar(r); }catch(e){ return "var(--o-ink3)"; } }
function ockState(key){ return OCK_ST[key] || (OCK_ST[key] = { init: 0, hit: {}, whoAt: {} }); }
function ockFresh(at, now){ return !!at && now - at < OCK_FRESH && !ockCalm(); }
function ockRoot(r){ if(r && OCK_ROOTS.indexOf(r) < 0) OCK_ROOTS.push(r); }
function ockEach(fn){
  OCK_ROOTS = OCK_ROOTS.filter(function(r){ return r === document || (r.host && r.host.isConnected); });
  OCK_ROOTS.forEach(function(r){ Array.prototype.forEach.call(r.querySelectorAll(".ock[data-op]"), fn); });
}
/* ---------- the numbers: hours the way each page counts them ---------- */
function ockModel(op, hr){
  var now = Date.now(), ps = (STATE.punches || []).filter(function(p){ return p.opId === op.id; }).sort(function(a, b){ return new Date(a.start) - new Date(b.start); });
  var ms = 0, runMs = 0, runs = [];
  ps.forEach(function(p){ var a = +new Date(p.start), b = p.stop ? +new Date(p.stop) : now; ms += Math.max(0, b - a); if(!p.stop){ runs.push(p); runMs += Math.max(0, now - a); } });
  var h;
  if(hr === "tc") h = typeof op.burnt === "number" ? Math.max(0, op.burnt + runMs / 3600000) : ms / 3600000;    /* opCalc's rule (the Technician page) */
  else if(typeof op.burntAdj === "number") h = Math.max(0, op.burntAdj + ms / 3600000);                       /* the RO page's rule */
  else h = Math.max(parseFloat(op.burnt) || 0, ms / 3600000);
  var q = parseFloat(op.quoted) || 0;
  return { op: op, ps: ps, ms: ms, runs: runs, run: runs.length > 0, h: h, q: q, over: q > 0 && h > q + 1e-6, now: now };
}
function ockStName(op){ try{ var s = opStatus(op); return typeof s === "string" ? s : (s && s.status) || ""; }catch(e){ return ""; } }
/* remember what was on the card, so a redraw doesn't replay what already happened */
function ockTrack(st, m, mode){
  var now = m.now, who = m.runs.map(function(p){ return p.by || "—"; });
  if(!st.init){
    st.init = 1; st.mode = mode; st.modeAt = 0; st.over = m.over; st.overAt = 0; st.lab = null;
    OCK_MS.forEach(function(x){ if(m.q > 0 && m.h >= m.q * x[0]) st.hit[x[0]] = 1; });
    who.forEach(function(n){ st.whoAt[n] = 0; });
    return;
  }
  if(mode && mode !== st.mode){ st.mode = mode; st.modeAt = now; }
  if(m.over !== st.over){ st.over = m.over; st.overAt = m.over && m.run ? now : 0; }
  OCK_MS.forEach(function(x){ var hit = m.q > 0 && m.h >= m.q * x[0];
    if(hit && !st.hit[x[0]]){ st.hit[x[0]] = 1; if(m.run) st.lab = { p: x[0], t: x[1], at: now }; }
    else if(!hit && st.hit[x[0]]) delete st.hit[x[0]]; });
  who.forEach(function(n){ if(!(n in st.whoAt)) st.whoAt[n] = now; });
  Object.keys(st.whoAt).forEach(function(n){ if(who.indexOf(n) < 0) delete st.whoAt[n]; });
  if(st.lab && (now - st.lab.at > OCK_LABMS || !st.hit[st.lab.p])) st.lab = null;
}
/* ---------- the pieces (the same for the markup and for the ticker) ---------- */
function ockCls(m, mode){ return "ock" + (m.run ? " run" : "") + (m.over ? " over" : "") + " " + (OCK_MODE[mode] || "st-idle") + (m.q > 0 ? "" : " noq"); }
function ockBigTxt(m){ if(OCK_VIEW === "left" && m.q > 0){ var l = (m.q - m.h) * 3600; return l >= 0 ? ockHms(Math.ceil(l - 1e-6)) : "+" + ockHms(-l); } return ockHms(m.h * 3600); }
function ockShape(t){ return t.replace(/\d/g, "0"); }
function ockDigits(txt){
  var n = txt.length, out = "";
  for(var i = 0; i < n; i++){
    var c = txt.charAt(i), fe = n - 1 - i;
    if(/\d/.test(c)){
      var b = fe === 1 || fe === 4 ? 6 : 10, v = +c, cells = "";
      for(var k = 0; k <= b; k++) cells += "<span>" + (k % b) + "</span>";
      out += '<span class="d"><span class="dc" data-b="' + b + '" data-v="' + v + '" style="transform:translateY(' + (-v) + 'em)">' + cells + "</span></span>";
    } else out += '<span class="c' + (c === ":" ? " k" : "") + '">' + ockE(c) + "</span>";
  }
  return out;
}
function ockLbl(m, mode, n){
  if(OCK_VIEW === "left" && m.q > 0) return m.h <= m.q ? "Time left · of <b>" + ockHms(m.q * 3600) + "</b> quoted" : "Over quoted · <b>" + ockHms(m.q * 3600) + "</b> quoted";
  return (mode === "lock" ? "Locked until the part is in" : "On this operation") + " · " + n + " entr" + (n === 1 ? "y" : "ies") + (m.q > 0 ? " · <b>tap the time</b> for time left" : "");
}
function ockRing(m){ var p = m.q > 0 ? Math.min(1, m.h / m.q) : 0; return { off: (OCK_RC * (1 - p)).toFixed(2), col: p >= 1 ? "var(--o-bad)" : p >= 0.9 ? "var(--o-warn)" : "var(--o-good)" }; }
function ockScale(m){ return m.q > 0 ? Math.max(m.q * 1.12, m.h * 1.03) : Math.max(m.h * 1.05, 0.25); }
function ockPct(x, sc){ return Math.max(0, x / sc * 100).toFixed(3) + "%"; }
/* the bar: one piece per punch in its start reason's color (typed-in time first, in grey); past quoted the stripes take over */
function ockSegs(m){
  var hrs = m.ms / 3600000, L = [], k = hrs > 0 && m.h < hrs ? m.h / hrs : 1, extra = m.h - hrs;
  if(extra > 0.004) L.push({ h: extra, c: "var(--o-ink4)", t: "Typed in by hand · " + ockHm(extra * 3600), live: 0 });
  m.ps.forEach(function(p){ var a = +new Date(p.start), b = p.stop ? +new Date(p.stop) : m.now, d = Math.max(0, b - a) / 3600000 * k;
    L.push({ h: d, c: ockRv(p.startReason), t: (p.startReason || "Working") + (p.stop ? " → " + (p.stopReason || "stopped") : " · on the clock") + " · " + ockHm(d * 3600), live: !p.stop }); });
  var sc = ockScale(m), cap = m.q > 0 ? m.q : Infinity, acc = 0;
  L.forEach(function(x, i){ var w = Math.max(0, Math.min(x.h, cap - acc)); acc += x.h; x.w = w; x.z = w / sc * 100 < 0.15; x.css = "--c:" + x.c + ";width:max(0px, calc(" + ockPct(w, sc) + " - " + (i < L.length - 1 ? 2 : 0) + "px))"; });
  return L;
}
function ockSegHtml(L){ return L.map(function(x){ return '<i class="' + (x.live ? "live" : "") + (x.z ? " z" : "") + '" style="' + x.css + '" title="' + ockE(x.t) + '"></i>'; }).join(""); }
function ockBar(m){
  var sc = ockScale(m), q = m.q;
  return { ov: "left:" + ockPct(q, sc) + ";width:" + (m.over ? ockPct(m.h - q, sc) : "0%"), gh: "left:" + ockPct(Math.min(m.h, q), sc) + ";width:" + (q > 0 && m.h < q ? ockPct(q - m.h, sc) : "0%"),
    qt: "left:" + ockPct(q, sc), ms: [0.5, 0.75].map(function(p){ return "left:" + ockPct(q * p, sc); }) };
}
function ockWhoKey(m){ return m.runs.map(function(p){ return p.by || "—"; }).join("|"); }
function ockWhoHtml(m, st){
  return m.runs.map(function(p){ var n = p.by || "—", me = false; try{ me = PG.isMe(n); }catch(e){}
    return '<span class="ock-who' + (ockFresh(st.whoAt[n], m.now) ? " in" : "") + '" title="' + ockE(n) + " — on the clock since " + ockE(ockClk(new Date(p.start))) + '"><span class="av">' + ockE(ockIni(n)) + "</span><b>" + ockE(me ? "You" : ockFirst(n)) + '</b><span class="m">' + ockMs((m.now - new Date(p.start)) / 1000) + "</span></span>"; }).join("");
}
function ockPace(m){
  if(!(m.q > 0)) return "";
  if(m.run && !m.over) return ockIc("clock") + "<span>Quoted runs out about <b>" + ockE(ockClk(m.now + (m.q - m.h) * 3600000)) + "</b></span>";
  if(m.run) return ockIc("clock") + "<span>Quoted ran out at <b>" + ockE(ockClk(m.now - (m.h - m.q) * 3600000)) + "</b></span>";
  if(!m.over) return ockIc("clock") + "<span><b>" + ockHm((m.q - m.h) * 3600) + "</b> left on the quote</span>";
  return "";
}
function ockOvTxt(m){ return "+" + ockMs((m.h - m.q) * 3600) + " over"; }
function ockOvHtml(m, st){ return m.over ? '<span class="ock-ovl' + (ockFresh(st.overAt, m.now) ? " in" : "") + '">' + ockIc("flag") + "<span>" + ockOvTxt(m) + "</span></span>" : ""; }
function ockMlHtml(m, st){ var l = st.lab; return l && m.now - l.at < OCK_LABMS ? '<span class="ock-mlb' + (ockFresh(l.at, m.now) ? " in" : "") + '" data-p="' + l.p + '">' + ockIc("check") + ockE(l.t) + "</span>" : ""; }
function ockKv(m){
  var q = m.q, h = m.h, over = m.over, ef = q > 0 && h >= 0.05 ? Math.round(q / h * 100) : null;
  return { b: h.toFixed(2) + "<em>h</em>", lk: over ? "Over" : "Left", l: q > 0 ? (over ? "+" + (h - q).toFixed(2) : (q - h).toFixed(2)) + "<em>h</em>" : "—", lc: over ? "r" : q > 0 && q - h < 0.5 ? "w" : "",
    e: ef == null ? "—" : ef + "<em>%</em>", ec: ef == null ? "" : ef >= 100 ? "g" : ef >= 85 ? "w" : "r" };
}
function ockStops(p){ if(p && typeof isShopPunch === "function" && isShopPunch(p)) return ["Done", "Switched job"]; var L = []; try{ L = STOP_REASONS_BREAK.concat(STOP_REASONS_EXPLICIT); }catch(e){ L = ["Lunch", "End of day", "Waiting – Parts", "Complete"]; } return L; }
/* the reasons after a hold: only while that punch is still this operation's last one and nothing runs */
function ockRsnOk(st, m){ var r = st.rsn; if(!r) return null; var last = m.ps[m.ps.length - 1]; if(m.run || !last || last.id !== r.pid || !last.stop){ st.rsn = null; return null; } return last; }
/* ---------- the markup ---------- */
function ockHtml(roId, opId, o){
  o = o || {};
  var op = null; try{ op = getOp(roId, opId); }catch(e){}
  if(!op) return "";
  var hr = o.hr || "jc", m = ockModel(op, hr), nm = ockStName(op), run = m.run;
  var mode = run ? "run" : /^Complete/.test(nm) ? "done" : /^Waiting/.test(nm) ? "wait" : o.lock ? "lock" : "idle";
  var key = roId + "|" + opId, st = ockState(key); ockTrack(st, m, mode);
  var can = !!o.can, n = m.ps.length, txt = ockBigTxt(m), rg = ockRing(m), bar = ockBar(m), kv = ockKv(m), fr = ockFresh(st.modeAt, m.now);
  var title = run ? "Stop — press and hold" : mode === "lock" ? o.lock : o.off || "Start the clock on this operation";
  var ico = mode === "lock" ? ockIc("lock") : '<svg class="ock-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="' + (run ? OCK_STOP : OCK_PLAY) + '" style="d:path(\'' + (run ? OCK_STOP : OCK_PLAY) + '\')"/></svg>';
  var side;
  if(mode === "done") side = '<span class="ock-ck' + (fr ? " draw" : "") + '" title="' + ockE(nm || "Complete") + '"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 12.5l4 4 8-9"/></svg></span>';
  else if(mode === "wait") side = can && !o.off ? '<button type="button" class="ock-wt" data-ock="go" title="' + ockE(nm) + ' — click to start the clock anyway">WAIT</button>' : '<span class="ock-wt" title="' + ockE(nm) + '">WAIT</span>';
  else side = '<div class="ock-rg' + (st.holding ? " holding" : "") + '"><svg class="ock-ring" viewBox="0 0 52 52" aria-hidden="true"><circle class="t" cx="26" cy="26" r="23"/>'
    + (m.q > 0 ? '<circle class="p" cx="26" cy="26" r="23" style="stroke-dasharray:' + OCK_RC.toFixed(2) + ";stroke-dashoffset:" + rg.off + ";--rc:" + rg.col + '"/>' : "")
    + '<circle class="h" cx="26" cy="26" r="23" style="stroke-dasharray:' + OCK_RC.toFixed(2) + ";stroke-dashoffset:" + OCK_RC.toFixed(2) + '"/></svg>'
    + (can ? '<button type="button" class="ock-pb' + (run ? " on" : "") + (mode === "lock" ? " lk" : "") + '" data-ock="go"' + (o.off && !run ? " disabled" : "") + ' title="' + ockE(title) + '" aria-label="' + ockE(title) + '"' + (mode === "lock" ? ' aria-disabled="true"' : "") + ">" + ico + "</button>"
      : '<span class="ock-pb ro' + (run ? " on" : "") + '" title="' + (run ? "On the clock" : "Not running") + '">' + ico + "</span>") + "</div>";
  var hint = st.holding ? "Keep holding…" : st.hint && st.hint.until > m.now ? st.hint.t : run && can ? "Hold to stop" : "";
  var rp = ockRsnOk(st, m), rsn = "";
  if(rp) rsn = '<span class="ock-rq">Why did it stop?</span>' + ockStops(rp).map(function(r, i){ return '<button type="button" class="ock-r' + (rp.stopReason === r ? " on" : "") + (ockFresh(st.rsn.at, m.now) ? " in" : "") + '" data-ock-r="' + ockE(r) + '" style="--c:' + ockRv(r) + ";--d:" + (i * 35) + 'ms"><i></i>' + ockE(r) + "</button>"; }).join("")
    + '<button type="button" class="ock-rx" data-ock="rx" title="Leave it as it is" aria-label="Leave it as it is">' + ockIc("x") + "</button>";
  var h = '<div class="' + ockCls(m, mode) + '" data-key="ock-' + ockE(opId) + '" data-ro="' + ockE(roId) + '" data-op="' + ockE(opId) + '" data-hr="' + hr + '" data-ockp="' + ockE(o.pg || "") + '" data-mode="' + mode + '" style="--o-wt:' + ockRv(mode === "wait" ? nm : "Waiting – Parts") + '">';
  h += '<div class="ock-tm"><button type="button" class="ock-big" data-ock="big" data-t="' + txt + '" data-sh="' + ockShape(txt) + '" title="' + (m.q > 0 ? "Tap to switch between the time on it and the time left" : "The time on this operation") + '" aria-label="' + txt + '"><span class="rd" aria-hidden="true">' + ockDigits(txt) + "</span></button></div>";
  h += '<div class="ock-lbl">' + ockLbl(m, mode, n) + "</div>";
  h += '<div class="ock-side" data-mode="' + mode + '"><span class="ock-hint">' + ockE(hint) + "</span>" + side + "</div>";
  var L = ockSegs(m), lab = st.lab && m.now - st.lab.at < 1200 && !ockCalm() ? st.lab.p : 0;
  h += '<div class="ock-bar" role="img" aria-label="' + (m.q > 0 ? Math.round(m.h / m.q * 100) + "% of quoted" : m.h.toFixed(2) + " h, no quote") + '"><span class="ock-segs">' + ockSegHtml(L) + '</span><span class="ock-ov" style="' + bar.ov + '"></span><span class="ock-gh" style="' + bar.gh + '"></span>'
    + [0.5, 0.75].map(function(p, i){ return '<span class="ock-ms' + (st.hit[p] ? " hit" : "") + (lab === p ? " pop" : "") + '" data-p="' + p + '" style="' + bar.ms[i] + '"></span>'; }).join("") + '<span class="ock-qt' + (lab === 1 ? " pop" : "") + '" style="' + bar.qt + '" title="Quoted"></span></div>';
  h += '<div class="ock-x"><span class="ock-whos" data-k="' + ockE(ockWhoKey(m)) + '">' + ockWhoHtml(m, st) + '</span><span class="ock-pace">' + ockPace(m) + '</span><span class="ock-ovs">' + ockOvHtml(m, st) + '</span><span class="ock-mls">' + ockMlHtml(m, st) + "</span></div>";
  h += '<div class="ock-rsn">' + rsn + "</div>";
  h += '<div class="ock-kv"><div class="ock-k' + (o.editQ ? ' ed" data-ock="q" role="button" tabindex="0" title="Quoted hours — click to change"' : '"') + "><small>Quoted</small><b>" + (m.q > 0 ? m.q.toFixed(2) + "<em>h</em>" : "—") + "</b></div>"
    + '<div class="ock-k"><small>Burnt</small><b data-ock="kb">' + kv.b + '</b></div><div class="ock-k"><small data-ock="kk">' + kv.lk + '</small><b data-ock="kl" class="' + kv.lc + '">' + kv.l + '</b></div><div class="ock-k"><small>Efficiency</small><b data-ock="ke" class="' + kv.ec + '">' + kv.e + "</b></div></div>";
  if(mode === "lock" && o.lock) h += '<div class="ock-lock">' + ockIc("parts") + "<span>" + ockE(o.lock) + "</span></div>";
  h += "</div>";
  if(!OCK_RAF) OCK_RAF = requestAnimationFrame(ockSync);
  return h;
}
/* ---------- the ticker: every card, in place, on the second ---------- */
function ockSet(el, prop, v){ if(!el) return; if(prop === "cls"){ if(el.className !== v) el.className = v; return; } if(el["_ock" + prop] !== v){ el["_ock" + prop] = v; if(prop === "html") el.innerHTML = v; else el.setAttribute(prop, v); } }
function ockCol(col, v){
  var p = +col.getAttribute("data-v"), b = +col.getAttribute("data-b"); if(p === v) return;
  col.setAttribute("data-v", v);
  var put = function(x){ col.style.transform = "translateY(" + (-x) + "em)"; };
  if(ockCalm()){ put(v); return; }
  if(p === b - 1 && v === 0){ put(b); setTimeout(function(){ if(col.getAttribute("data-v") !== "0") return; col.style.transition = "none"; put(0); void col.offsetHeight; col.style.transition = ""; }, 480); }
  else if(p === 0 && v === b - 1){ col.style.transition = "none"; put(b); void col.offsetHeight; col.style.transition = ""; put(v); }
  else put(v);
}
function ockRoll(big, txt){
  if(big.getAttribute("data-t") === txt) return;
  var rd = big.querySelector(".rd"), cols = rd ? rd.querySelectorAll(".dc") : [];
  big.setAttribute("data-t", txt); big.setAttribute("aria-label", txt);
  if(!rd || big.getAttribute("data-sh") !== ockShape(txt)){ big.setAttribute("data-sh", ockShape(txt)); if(rd) rd.innerHTML = ockDigits(txt); return; }
  var k = 0; txt.split("").forEach(function(c){ if(/\d/.test(c)){ if(cols[k]) ockCol(cols[k], +c); k++; } });
}
function ockTick(card){
  var roId = card.getAttribute("data-ro"), opId = card.getAttribute("data-op"), op = null; try{ op = getOp(roId, opId); }catch(e){}
  if(!op) return;
  var m = ockModel(op, card.getAttribute("data-hr")), st = ockState(roId + "|" + opId), mode = card.getAttribute("data-mode");
  if(m.run !== (mode === "run")) return;                                   /* a redraw is on its way */
