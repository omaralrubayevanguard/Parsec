  var big = card.querySelector('[data-ock="big"]'); if(big) ockRoll(big, ockBigTxt(m));
  var lb = card.querySelector(".ock-lbl"); if(lb) ockSet(lb, "html", ockLbl(m, mode, m.ps.length));
  var p = card.querySelector(".ock-ring .p"); if(p){ var rg = ockRing(m); p.style.strokeDashoffset = rg.off; p.style.setProperty("--rc", rg.col); }
  var hn = card.querySelector(".ock-hint"); if(hn && !st.holding){ var ht = st.hint && st.hint.until > m.now ? st.hint.t : m.run && card.querySelector('.ock-pb[data-ock="go"]') ? "Hold to stop" : ""; if(hn.textContent !== ht) hn.textContent = ht; }
  var sg = card.querySelector(".ock-segs");
  if(sg){ var L = ockSegs(m);
    if(sg.children.length !== L.length) sg.innerHTML = ockSegHtml(L);
    else L.forEach(function(x, i){ var e = sg.children[i]; e.style.cssText = x.css; e.classList.toggle("live", !!x.live); e.classList.toggle("z", !!x.z); if(e.getAttribute("title") !== x.t) e.setAttribute("title", x.t); }); }
  var bar = ockBar(m), q;
  if((q = card.querySelector(".ock-ov"))) q.style.cssText = bar.ov;
  if((q = card.querySelector(".ock-gh"))) q.style.cssText = bar.gh;
  if((q = card.querySelector(".ock-qt"))) q.style.cssText = bar.qt;
  var popAt = st.lab && m.now - st.lab.at < 1200 && !ockCalm() ? st.lab.p : 0;
  [0.5, 0.75].forEach(function(pp, i){ var e = card.querySelector('.ock-ms[data-p="' + pp + '"]'); if(!e) return; e.style.cssText = bar.ms[i]; e.classList.toggle("hit", !!st.hit[pp]);
    if(popAt === pp && !e.classList.contains("pop")) e.classList.add("pop"); else if(popAt !== pp) e.classList.remove("pop"); });
  if((q = card.querySelector(".ock-qt"))){ if(popAt === 1) q.classList.add("pop"); else q.classList.remove("pop"); }
  var ba = card.querySelector(".ock-bar"); if(ba) ba.setAttribute("aria-label", m.q > 0 ? Math.round(m.h / m.q * 100) + "% of quoted" : m.h.toFixed(2) + " h, no quote");
  /* the extras: chips are patched, not rebuilt, so their animations run once */
  var wb = card.querySelector(".ock-whos");
  if(wb){ var wk = ockWhoKey(m); if(wb.getAttribute("data-k") !== wk){ wb.setAttribute("data-k", wk); wb.innerHTML = ockWhoHtml(m, st); }
    else m.runs.forEach(function(r, i){ var t = wb.children[i] && wb.children[i].querySelector(".m"), v = ockMs((m.now - new Date(r.start)) / 1000); if(t && t.textContent !== v) t.textContent = v; }); }
  var pc = card.querySelector(".ock-pace"); if(pc) ockSet(pc, "html", ockPace(m));
  var ov = card.querySelector(".ock-ovs");
  if(ov){ var chip = ov.firstElementChild; if(m.over && !chip) ov.innerHTML = ockOvHtml(m, st); else if(!m.over && chip) ov.innerHTML = ""; else if(chip){ var s2 = chip.querySelector("span"), ot = ockOvTxt(m); if(s2 && s2.textContent !== ot) s2.textContent = ot; } }
  var ml = card.querySelector(".ock-mls");
  if(ml){ var cur = ml.firstElementChild, want = st.lab && m.now - st.lab.at < OCK_LABMS ? String(st.lab.p) : "";
    if(want !== (cur ? cur.getAttribute("data-p") : "")) ml.innerHTML = want ? ockMlHtml(m, st) : ""; }
  var kv = ockKv(m), kb = card.querySelector('[data-ock="kb"]'), kk = card.querySelector('[data-ock="kk"]'), kl = card.querySelector('[data-ock="kl"]'), ke = card.querySelector('[data-ock="ke"]');
  if(kb) ockSet(kb, "html", kv.b); if(kk && kk.textContent !== kv.lk) kk.textContent = kv.lk;
  if(kl){ ockSet(kl, "html", kv.l); if(kl.className !== kv.lc) kl.className = kv.lc; }
  if(ke){ ockSet(ke, "html", kv.e); if(ke.className !== kv.ec) ke.className = kv.ec; }
}
/* the endless ones (breathing, the live edge, the stripes, the colons, the live dot) keep one beat: a redraw that
   makes a new element picks up where the old one was instead of starting over */
function ockSync(){
  OCK_RAF = 0;
  ockEach(function(card){ if(!card.getAnimations) return; card.getAnimations({ subtree: true }).forEach(function(a){ if(OCK_INF[a.animationName] && !a._ockL){ a._ockL = 1; try{ a.startTime = 0; }catch(e){} } }); });
}
function ockTickAll(){ ockEach(function(c){ try{ ockTick(c); }catch(e){ console.error(e); } }); ockSync(); }
(function ockLoop(){ setTimeout(function(){ try{ if(typeof STATE !== "undefined" && STATE) ockTickAll(); }catch(e){} ockLoop(); }, 1000 - (Date.now() % 1000) + 8); })();
/* ---------- what you do on the card ---------- */
var OCK_H = null, OCK_SKIP = false;   /* OCK_SKIP: the click that ends a press on Stop does nothing (the hold did it) */
function ockTgt(e){ var p = e.composedPath ? e.composedPath() : [e.target], t = p[0] || e.target; return t && t.nodeType === 1 ? t : (t && t.parentElement) || null; }
function ockOf(t){ var c = t && t.closest ? t.closest(".ock[data-op]") : null; return c ? { el: c, ro: c.getAttribute("data-ro"), op: c.getAttribute("data-op"), cb: OCK_CB[c.getAttribute("data-ockp")] || {}, key: c.getAttribute("data-ro") + "|" + c.getAttribute("data-op") } : null; }
function ockHint(c, t, ms){ var st = ockState(c.key); st.hint = ms ? { t: t, until: Date.now() + ms } : null; var hn = c.el.querySelector(".ock-hint"); if(hn) hn.textContent = t; }
function ockHoldEnd(cancel){
  var H = OCK_H; if(!H) return; OCK_H = null; clearTimeout(H.timer);
  var st = ockState(H.c.key); st.holding = false;
  var rg = H.go.closest(".ock-rg"); if(rg) rg.classList.remove("holding");
  if(cancel) ockHint(H.c, "Hold it — 0.7 s", 1400);
}
function ockStopNow(c){
  var op = null; try{ op = getOp(c.ro, c.op); }catch(e){}
  var p = op ? ockModel(op, c.el.getAttribute("data-hr")).runs[0] : null; if(!p || !c.cb.stop) return;
  var st = ockState(c.key); st.rsn = { pid: p.id, at: Date.now() }; st.hint = null;
  c.cb.stop(c.ro, c.op, p);
  if(!p.stop) st.rsn = null;
}
document.addEventListener("pointerdown", function(e){
  if(e.button) return;
  var t = ockTgt(e), go = t && t.closest && t.closest('[data-ock="go"]'); OCK_SKIP = false; if(!go || go.disabled) return;
  var c = ockOf(go); if(!c || !go.classList.contains("on")) return;          /* only Stop is held; Start is a tap */
  e.preventDefault(); OCK_SKIP = true;
  try{ go.setPointerCapture(e.pointerId); }catch(er){}
  ockHoldEnd(false);
  var st = ockState(c.key); st.holding = true; st.hint = null;
  var rg = go.closest(".ock-rg"); if(rg){ rg.classList.remove("holding"); void rg.offsetWidth; rg.classList.add("holding"); }
  var hn = c.el.querySelector(".ock-hint"); if(hn) hn.textContent = "Keep holding…";
  OCK_H = { c: c, go: go, id: e.pointerId, timer: setTimeout(function(){ var H = OCK_H; if(!H) return; ockHoldEnd(false); ockStopNow(H.c); }, OCK_HOLD) };
}, true);
document.addEventListener("pointerup", function(e){ if(OCK_H && OCK_H.id === e.pointerId) ockHoldEnd(true); }, true);
document.addEventListener("pointercancel", function(e){ if(OCK_H && OCK_H.id === e.pointerId) ockHoldEnd(true); }, true);
document.addEventListener("pointermove", function(e){
  if(!OCK_H || OCK_H.id !== e.pointerId) return;
  var r = OCK_H.go.getBoundingClientRect(); if(e.clientX < r.left - 14 || e.clientX > r.right + 14 || e.clientY < r.top - 14 || e.clientY > r.bottom + 14) ockHoldEnd(true);
}, true);
document.addEventListener("contextmenu", function(e){ var t = ockTgt(e); if(t && t.closest && t.closest('.ock [data-ock="go"]')) e.preventDefault(); }, true);
document.addEventListener("click", function(e){
  var t = ockTgt(e); if(!t || !t.closest) return;
  var c = ockOf(t); if(!c) return;
  var a = t.closest("[data-ock],[data-ock-r]"); if(!a || !c.el.contains(a)) return;
  if(t.closest("input")) { e.stopPropagation(); return; }
  e.preventDefault(); e.stopPropagation();
  var k = a.getAttribute("data-ock"), r = a.getAttribute("data-ock-r");
  if(r != null){ var st = ockState(c.key), pid = st.rsn && st.rsn.pid; st.rsn = null; if(pid && c.cb.reason) c.cb.reason(c.ro, c.op, pid, r); return; }
  if(k === "go"){
    if(a.disabled) return;
    if(e.detail !== 0 && OCK_SKIP){ OCK_SKIP = false; return; }
    if(a.classList.contains("on")){ if(e.detail === 0) ockStopNow(c); return; }     /* a key press stops at once; a pointer has to hold */
    if(c.cb.start) c.cb.start(c.ro, c.op);
